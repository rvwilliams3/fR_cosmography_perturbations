821d4265428b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nPoints", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xTodayThreshold", "=", 
   RowBox[{"-", "0.25"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995342627359343*^9, 3.995342629434383*^9}, 
   3.99534282208852*^9, {3.995343132965698*^9, 3.995343133953027*^9}, {
