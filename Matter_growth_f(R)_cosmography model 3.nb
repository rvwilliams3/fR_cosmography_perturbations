Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBackgroundSolutions", "[", 
    RowBox[{
    "model_String", ",", "bgResults_Association", ",", "datasets_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "plotX", ",", "plotOmega"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotX", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
             "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotOmega", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", 
              "\"\<\[CapitalOmega]\>\"", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<\[CapitalOmega](z)\>\""}], "}"}]}], 
         ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"plotX", ",", "plotOmega"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
