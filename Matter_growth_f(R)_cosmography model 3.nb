        RowBox[{"OptionValue", "[", "\"\<MaxAbsX\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxOm", "=", 
        RowBox[{"OptionValue", "[", "\"\<MaxOmega\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domainTol", "=", 
        RowBox[{"OptionValue", "[", "\"\<DomainTol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domain", "=", 
        RowBox[{
         RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"domainMin", "=", 
        RowBox[{"domain", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"domainMax", "=", 
        RowBox[{"domain", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "solution", " ", "must", " ", "actually", " ", "reach", " ", "z"}], 
          "=", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", "z"}], "=", 
           RowBox[{
            RowBox[{"zi", "--"}], " ", "no", " ", 
            RowBox[{"extrapolation", ".", "DomainTol"}], " ", 
            RowBox[{"(", "strict", ")"}], " ", "judges", " ", 
            "validity"}]}]}], ";", 
         RowBox[{
         "ZMin", " ", "only", " ", "sets", " ", "sample", " ", "spacing", " ", 
          RowBox[{"below", "."}]}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"domainMin", ">", "domainTol"}], "||", 
          RowBox[{"domainMax", "<", "zi"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<label\>\"", "->", "\"\<Diverged\>\""}], ",", 
