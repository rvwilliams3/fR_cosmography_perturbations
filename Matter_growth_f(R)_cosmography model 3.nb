            RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], 
           RowBox[{"DeltaFn", "[", "z", "]"}]]}], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"OmmFn", "[", "z", "]"}], "]"}]]}], "]"}]}], "]"}]}], 
