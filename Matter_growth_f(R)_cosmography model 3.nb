Cell[CellGroupData[{

Cell["Growth function", "Subsection",
 CellChangeTimes->{{3.996651932880522*^9, 3.9966519381579227`*^9}, {
  3.996733918475832*^9, 
  3.996733919546754*^9}},ExpressionUUID->"ccb710a6-c7a6-48ee-8a96-\
77963c8799b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SFunc", "[", 
    RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
         "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], "/", 
       RowBox[{"DeltaFn", "[", "z", "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996735267359165*^9, 3.996735271140725*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"c96cea70-f234-4689-a443-f77b3242cb36"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotSAllModes", "[", 
    RowBox[{"dataset_String", ",", 
     RowBox[{"zmax_", ":", "6"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "dashings", ",", "curves", ",", "styles", ",", "legFn", 
       ",", "legend"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dashings", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Dashing", "[", 
          RowBox[{"{", "}"}], "]"}], ",", 
         RowBox[{"Dashing", "[", 
          RowBox[{"{", 
           RowBox[{"0.02", ",", "0.015"}], "}"}], "]"}], ",", 
         RowBox[{"Dashing", "[", 
          RowBox[{"{", 
           RowBox[{"0.005", ",", "0.01"}], "}"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"SFunc", "[", 
           RowBox[{"dataset", ",", "lab", ",", "kp", ",", "zz"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"lab", ",", "labels"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "j", "]"}], ",", 
             RowBox[{"dashings", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "labels", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "kPhys", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"legFn", "=", 
       RowBox[{
        RowBox[{"Framed", "[", 
         RowBox[{"#", ",", 
          RowBox[{"RoundingRadius", "->", "0"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"GrayLevel", "[", "0.5", "]"}]}], ",", 
          RowBox[{"Background", "->", 
           RowBox[{"GrayLevel", "[", 
            RowBox[{"1", ",", "0.9"}], "]"}]}], ",", 
          RowBox[{"FrameMargins", "->", "4"}]}], "]"}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "kPhys", "]"}], "]"}]}], ",", "kLabels",
              ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", "dashings"}],
              ",", "labels", ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"Spacings", "->", "0.3"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"zz", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"0.83", ",", "0.32"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", "1", "}"}]}], "}"}]}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Dashed", ",", 
           RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<S(z)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotLabel", "->", "dataset"}], ",", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996724357467222*^9, 3.996724357469207*^9}, {
   3.996724401662894*^9, 3.9967244178754053`*^9}, 3.9967245334274807`*^9, {
   3.99672483812147*^9, 3.996724846340371*^9}, {3.996724881811762*^9, 
