Cell[TextData[{
 "Following 21 cm paper: (2606.03729v1)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "(", "1000", ")"}], "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]],ExpressionUUID->
  "6d605bc5-35d9-4594-8381-59d13c549d24"],
 ", \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "'"}], 
     RowBox[{"(", "1000", ")"}]}], "=", 
    RowBox[{
     RowBox[{"-", "9.99"}], "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], TraditionalForm]],ExpressionUUID->
  "9da5d800-ed9f-4be5-8391-d60f3db63cb9"],
 "\n\nAt high redshift indistuinguishable from GR -->\n\[ScriptCapitalR]hat = \
3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "2"], 
    SubscriptBox["\[CapitalOmega]", "m"]}], TraditionalForm]],ExpressionUUID->
  "bcef6da6-183c-41da-a62e-7d5eac6978f0"],
 "\[CapitalDelta],\t\t\[ScriptCapitalR]hat \[OpenCurlyQuote] = 3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "^", "2"}], " ", 
    SubscriptBox["\[CapitalOmega]", "m"], 
    FractionBox["\[CapitalDelta]", 
     RowBox[{"1", "+", "z"}]]}], TraditionalForm]],ExpressionUUID->
  "47c67e78-d2ad-4e8d-83c4-6009b4a337d7"],
 "[3+(1+z) ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", "'"}], "\[CapitalDelta]"], TraditionalForm]],
  ExpressionUUID->"0dfaff45-55ef-4400-9ebb-f1e5e16be05f"],
 "]"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.996577682534783*^9, 3.996577688698234*^9}, {
  3.9965777312002993`*^9, 3.996577791059173*^9}, {3.996577828900903*^9, 
  3.996577918528096*^9}, {3.996581973940897*^9, 3.9965819882665586`*^9}, {
  3.99658228635635*^9, 3.99658228892657*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"3dcf1440-f75d-424b-b26c-781a86311ac7"],

Cell["\<\
We can only do this if Omega_m(z) matches GR so then we need to use the \
source matching Omega_m0 - not jess\[CloseCurlyQuote]s value.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9965795042339287`*^9, 3.99657953531554*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"3f3dbd1b-2ee9-4fbb-a9a5-884afcc38091"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Checking", " ", "that", " ", "Rhat", " ", "is", " ", "correct", " ", "in",
     " ", "GR", " ", "limit"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"grLimit", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ReqnSolveDust", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", "0"}], ",", 
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"1", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "1"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", 
          RowBox[{
           RowBox[{"-", "7"}], "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", 
          RowBox[{"35", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", "1"}]}], "}"}]}], 
      "//", "Cancel"}]}], ",", " ", 
    RowBox[{"z", ">=", "0"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996578910245099*^9, 3.996578942139704*^9}, {
   3.996579112456634*^9, 3.996579149895555*^9}, {3.996582316061736*^9, 
   3.996582419464799*^9}, 3.997255078840687*^9},
 CellLabel->
