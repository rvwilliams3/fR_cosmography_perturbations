 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DTableAtZ", "[", 
     RowBox[{"zval_", ":", "10"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rows", "}"}], ",", 
