Cell[CellGroupData[{

Cell["Models of j", "Subsubsection",
 CellChangeTimes->{{3.986261299922324*^9, 
  3.98626130195702*^9}},ExpressionUUID->"a425c9c2-3a37-4ba7-a540-\
f16b1f555832"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"j0", "[", "z_", "]"}], "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j1", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"q", "[", "z", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j2", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", "\[Epsilon]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j3", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "[", "z", "]"}], "-", 
       FractionBox["1", "2"]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986000268584011*^9, 3.986000340711521*^9}, {
   3.98600037864811*^9, 3.986000391962826*^9}, 3.986261339015687*^9, {
