Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeXOmegaTodayPlot", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "sweepResult_Association", 
     ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{"ImageSize", "->", "350"}], "}"}], "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"table", ",", "xiVals", ",", "x0Vals", ",", "Omega0Vals"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"sweepResult", "[", "\"\<found\>\"", "]"}]}], "||", 
         RowBox[{
          RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], "===", 
          RowBox[{"{", "}"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{"\"\<No viable points: \>\"", "<>", "dataset"}], "]"}], 
           ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"OptionValue", "[", "ImageSize", "]"}]}]}], "]"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"table", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiVals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0Vals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Omega0Vals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<\[CapitalOmega]Today\>\""}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xiVals", ",", "x0Vals"}], "}"}], "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xiVals", ",", "Omega0Vals"}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<x\[Null](0)\>\"", ",", 
