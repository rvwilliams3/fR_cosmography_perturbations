 RowBox[{
  RowBox[{
   RowBox[{"qAssocByModel", "[", "\"\<Model 0\>\"", "]"}], "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "->", 
       RowBox[{"qLCDMFunc", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", "]"}],
          "[", 
