   3.996547407274033*^9, 3.996547407387683*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"f5391a3a-6251-4c93-b13b-a49bb367a810"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allSelected", "=", 
   RowBox[{"<|", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allPlots", "=", 
   RowBox[{"<|", "|>"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995346353697708*^9, 3.995346353699492*^9}, 
   3.995601950300888*^9, {3.997240632041621*^9, 3.997240632253632*^9}},
 CellLabel->
