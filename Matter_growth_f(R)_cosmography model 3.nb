 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"3dcf1440-f75d-424b-b26c-781a86311ac7"],

Cell["\<\
We can only do this if Omega_m(z) matches GR so then we need to use the \
source matching Omega_m0 - not jess\[CloseCurlyQuote]s value.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9965795042339287`*^9, 3.99657953531554*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"3f3dbd1b-2ee9-4fbb-a9a5-884afcc38091"],

