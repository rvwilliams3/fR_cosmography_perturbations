  RowBox[{
   RowBox[{"GammaFn", "[", 
    RowBox[{"dataset_", ",", "label_", ",", "kp_"}], "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DeltaFn", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}],
           "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ",", 
       RowBox[{"OmmFn", "=", 
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "\"\<Model 3\>\"", "]"}], "[", "dataset",
          "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
