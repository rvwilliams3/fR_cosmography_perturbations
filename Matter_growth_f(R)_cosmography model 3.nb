Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FEndpointTable", "[", 
    RowBox[{"model_String", ",", "datasets_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fmt", ",", "rows"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"fmt", "[", "v_", "]"}], ":=", 
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", "v", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"7", ",", "5"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Fm", ",", "Fs", ",", "zi"}], "}"}], ",", 
               RowBox[{
                RowBox[{"Fm", "=", 
                 RowBox[{"FOfz", "[", 
                  RowBox[{"dataset", ",", "s", ",", 
                   RowBox[{"Om0MeanData", "[", 
                    RowBox[{"model", ",", "dataset"}], "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Fs", "=", 
                 RowBox[{"FOfz", "[", 
                  RowBox[{"dataset", ",", "s", ",", 
                   RowBox[{"Om0SourceMatch", "[", 
                    RowBox[{"model", ",", "dataset"}], "]"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"zi", "=", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"s", ",", "\"\<zinitial\>\"", ",", "1000"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"dataset", ",", 
                  RowBox[{"ScientificForm", "[", 
                   RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"s", "[", "\"\<xi\>\"", "]"}]}], ",", "3"}], 
                   "]"}], ",", 
                  RowBox[{"fmt", "[", 
                   RowBox[{"Fm", "[", "0", "]"}], "]"}], ",", 
                  RowBox[{"fmt", "[", 
                   RowBox[{"Fm", "[", "zi", "]"}], "]"}], ",", 
                  RowBox[{"fmt", "[", 
                   RowBox[{"Fs", "[", "0", "]"}], "]"}], ",", 
                  RowBox[{"fmt", "[", 
                   RowBox[{"Fs", "[", "zi", "]"}], "]"}]}], "}"}]}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", 
               RowBox[{"SortedSols", "[", "dataset", "]"}]}], "}"}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", 
             RowBox[{"Item", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<MCMC \[CapitalOmega]\\!\\(\\*SubscriptBox[\\(\\), \
\\(m0\\)]\\)\>\"", ",", "Bold"}], "]"}], ",", 
               RowBox[{"ItemSize", "->", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
             "SpanFromLeft", ",", 
             RowBox[{"Item", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                "\"\<source-matched \
\[CapitalOmega]\\!\\(\\*SubscriptBox[\\(\\), \\(m0\\)]\\)\>\"", ",", "Bold"}],
                 "]"}], ",", 
               RowBox[{"ItemSize", "->", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
             "SpanFromLeft"}], "}"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
            RowBox[{"{", 
             RowBox[{"\"\<Dataset\>\"", ",", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
              "\"\<F(0)\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<F(\>\"", ",", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<z\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                 "\"\<)\>\""}], "}"}], "]"}], ",", "\"\<F(0)\>\"", ",", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<F(\>\"", ",", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<z\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                 "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], "}"}], ",", "rows"}],
          "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", 
