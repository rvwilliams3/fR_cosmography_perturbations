Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBand", "[", 
    RowBox[{
    "model_String", ",", "bandAssoc_Association", ",", "ylab_String", ",", 
     RowBox[{"legendPos_", ":", 
      RowBox[{"{", 
       RowBox[{"0.6", ",", "0.25"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dsets", ",", "cols", ",", "bands", ",", "means"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dsets", "=", 
       RowBox[{"Keys", "[", "bandAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cols", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", "97", "]"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "dsets", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bands", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"bandAssoc", "[", 
               RowBox[{"dsets", "[", 
