Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForwDE", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "qSol_", ",", "OmegaMSol_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"Function", "[", 
      RowBox[{"zval", ",", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", 
           RowBox[{"qSol", "[", "zval", "]"}]}], "-", "1"}], ")"}], 
        RowBox[{"3", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"OmegaMSol", "[", "zval", "]"}]}], ")"}]}]]}], "]"}]}], 
