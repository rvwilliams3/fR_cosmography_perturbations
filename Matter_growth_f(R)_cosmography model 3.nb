         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotOmega", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", 
