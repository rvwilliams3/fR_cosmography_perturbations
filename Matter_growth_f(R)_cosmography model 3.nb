            RowBox[{"{", 
             RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", "kDashings"}], 
           ",", 
           RowBox[{"kLabels", "[", 
            RowBox[{"[", "kIdx", "]"}], "]"}], ",", 
           RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
