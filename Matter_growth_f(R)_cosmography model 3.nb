 RowBox[{
  RowBox[{
   RowBox[{"j1", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"q", "[", "z", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j2", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", "\[Epsilon]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j3", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "[", "z", "]"}], "-", 
       FractionBox["1", "2"]}], ")"}]}]}]}], ";"}]}], "Input",
