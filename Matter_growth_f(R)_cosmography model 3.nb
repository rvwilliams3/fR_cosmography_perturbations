Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "i"], "plot", " ", "comparing", " ", "to", " ", "model", 
   " ", "0"}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"92d74928-2481-47fc-8422-df478c7c40b2"]], \
"Subsubsection",
 CellChangeTimes->{{3.9971843533229647`*^9, 
  3.99718435830015*^9}},ExpressionUUID->"afe2a1a4-96f7-4832-96dc-\
ddd2af9bc75f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MakeXOmegaComparePlot", "[", 
     RowBox[{"dataset_String", ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ImageSize", "->", "600"}], ",", 
         RowBox[{"\"\<Models\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Model 3\>\"", ",", "\"\<Model 0\>\""}], "}"}]}], ",", 
         
         RowBox[{"\"\<Dashing\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "Small", "}"}]}], "}"}]}]}], "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "models", ",", "dashes", ",", "sweeps", ",", "curves", ",", "styles", 
        ",", "labels", ",", "colors"}], "}"}], ",", 
      RowBox[{
       RowBox[{"models", "=", 
        RowBox[{"OptionValue", "[", "\"\<Models\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dashes", "=", 
        RowBox[{"OptionValue", "[", "\"\<Dashing\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"colors", "=", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sweeps", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"sweepResultsByModel", "[", "#", "]"}], "[", "dataset", 
           "]"}], "&"}], "/@", "models"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"sweeps", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"#", "[", "\"\<found\>\"", "]"}]}], "||", 
              RowBox[{
               RowBox[{"#", "[", "\"\<table\>\"", "]"}], "===", 
               RowBox[{"{", "}"}]}]}], ")"}], "&"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{"\"\<No viable points: \>\"", "<>", "dataset"}], "]"}], 
            ",", 
            RowBox[{"ImageSize", "->", 
             RowBox[{"OptionValue", "[", "ImageSize", "]"}]}]}], "]"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"curves", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"sw", ",", "m"}], "}"}], ",", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", "tb", "}"}], ",", 
                RowBox[{
                 RowBox[{"tb", "=", 
                  RowBox[{"SortBy", "[", 
                   RowBox[{
                    RowBox[{"sw", "[", "\"\<table\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}], ",", 
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}]}], 
                    "}"}], "]"}], ",", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}], ",", 
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<\[CapitalOmega]Today\>\""}], 
                    "]"}], "]"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"sweeps", ",", "models"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"styles", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"d", ",", "m"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"colors", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"Dashing", "[", "d", "]"}]}], "]"}], ",", 
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"colors", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"Dashing", "[", "d", "]"}]}], "]"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"dashes", ",", "models"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"labels", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "m", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<x(0), \>\"", "<>", "m"}], ",", 
                RowBox[{"\"\<\[CapitalOmega](0), \>\"", "<>", "m"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"{", "models", "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"curves", ",", 
         RowBox[{"PlotStyle", "->", "styles"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"styles", ",", "labels", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}], ",", 
              RowBox[{"LabelStyle", "->", 
               RowBox[{"{", 
                RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.15", ",", "0.25"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "\"\<\\!\\(\\*SubscriptBox[\\(x\\), \\(i\\)]\\) = x(\>\"", "<>", 
             RowBox[{"ToString", "[", "zinitial", "]"}], "<>", "\"\<)\>\""}], 
            ",", "\"\<\>\""}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Gray", ",", "Thin"}], "]"}]}], "}"}], "}"}]}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "dataset"}], ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"OptionValue", "[", "ImageSize", "]"}]}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"1", "/", "2"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"xOmegaComparePlots", "=", 
   RowBox[{"MakeXOmegaComparePlot", "/@", "viablePlanckDatasets"}]}], 
  ";"}], "\n", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"Partition", "[", 
    RowBox[{"xOmegaComparePlots", ",", "2"}], "]"}], ",", 
   RowBox[{"ImageSize", "->", "1200"}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"40", ",", "40"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997184359830868*^9, 3.997184435416648*^9}, {
  3.997186181989766*^9, 3.997186182455987*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"c153ef3b-f5e5-48b2-b673-bbe41670f19b"],

