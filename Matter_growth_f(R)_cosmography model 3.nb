d06ff6cdad3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 0\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 1\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "+", "1"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 2\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "j0"}]}], ";", 
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "-", 
       FractionBox["1", "2"]}], ")"}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995085286300021*^9, 3.995085289395958*^9}, {
  3.995600533259322*^9, 3.995600580817732*^9}, {3.996827452193603*^9, 
