          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "zi"}], ")"}], 
           FractionBox["DeltaPrimei", "DeltaIn"]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]i\>\"", "->", "DeltaIn"}], ",", 
