           RowBox[{"LegendLabel", "->", "\"\<initial condition\>\""}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"{", 
             RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
