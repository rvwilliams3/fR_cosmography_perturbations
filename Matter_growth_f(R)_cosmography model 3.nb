            RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "#", "]"}]}], 
          "]"}]}], "&"}], ",", "datasets"}], "]"}], "]"}]}], ";"}]}]], "Input",\

 CellLabel->"In[83]:=",ExpressionUUID->"72eb14fb-c789-4ca8-a468-3179f10110e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotOmegaM", "[", 
    RowBox[{
    "model_String", ",", "OmAssoc_Association", ",", "label_String", ",", 
     RowBox[{"zmax_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"datasets", ",", "colours", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"Keys", "[", "OmAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"colours", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{"colours", ",", "datasets", ",", 
         RowBox[{"LegendMarkerSize", "->", "20"}], ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"RoundingRadius", "->", "0"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"FrameStyle", "->", "Gray"}]}], "]"}], "&"}], ")"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OmAssoc", "[", "dset", "]"}], "[", "z", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dset", ",", "datasets"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colours"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"1.15", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
        ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<z\>\"", ",", 
           "\"\<\\!\\(\\*SubscriptBox[\\(\[CapitalOmega]\\), \\(m\\)]\\)(z)\>\
\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"model", "<>", "\"\<, \>\"", "<>", "label"}]}], ",", 
        RowBox[{"ImageSize", "->", "1000"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
