Cell[CellGroupData[{

Cell["Fitting parameterisation", "Subsection",
 CellChangeTimes->{{3.9973465008392572`*^9, 
  3.9973465058648567`*^9}},ExpressionUUID->"53c435d3-07d6-488f-b8e1-\
54dd4ae3e74e"],

Cell[TextData[{
 "Using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[CapitalOmega]", "m"], "\[Gamma]"], 
     RowBox[{
      SuperscriptBox["Q", "\[Eta]"], ":"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c29407f-d6d2-4f08-95cc-0df4e70ed931"],
 "\n\t Log(S) = \[Gamma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "(", 
    SubscriptBox["\[CapitalOmega]", "m"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f96f432-8621-424f-897b-d4a701073fa9"],
 " + \[Eta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "(", "Q", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "250d0724-e9c2-496a-8767-4685a29658d7"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
