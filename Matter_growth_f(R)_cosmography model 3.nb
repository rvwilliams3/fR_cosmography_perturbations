Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FEndpointTable", "[", 
    RowBox[{"datasets_List", ",", "Om0Func_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "rows", "}"}], ",", 
     RowBox[{
      RowBox[{"rows", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "sols", "}"}], ",", 
             RowBox[{
              RowBox[{"sols", "=", 
               RowBox[{"SortedSols", "[", "dataset", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"F", ",", "zi"}], "}"}], ",", 
                  RowBox[{
                   RowBox[{"F", "=", 
                    RowBox[{"FOfz", "[", 
                    RowBox[{"dataset", ",", "s", ",", 
                    RowBox[{"Om0Func", "[", "dataset", "]"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"zi", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"s", ",", "\"\<zinitial\>\"", ",", "1000"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"dataset", ",", 
                    RowBox[{"s", "[", "\"\<xi\>\"", "]"}], ",", 
                    RowBox[{"F", "[", "0", "]"}], ",", "zi", ",", 
                    RowBox[{"F", "[", "zi", "]"}]}], "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<Dataset\>\"", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
             "\"\<F(0)\>\"", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<z\>\"", ",", "\"\<init\>\""}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<F(\>\"", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", "\"\<init\>\""}], "]"}], ",", 
                "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}], ",", 
        RowBox[{"Background", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.9", ",", "0.9", ",", "0.9"}], "]"}], ",", "None"}], 
            "}"}]}], "}"}]}], ",", 
        RowBox[{"ItemStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"FontSize", "->", "11"}], "]"}]}], ",", 
        RowBox[{"Spacings", "->", 
         RowBox[{"{", 
          RowBox[{"1.2", ",", "0.8"}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
