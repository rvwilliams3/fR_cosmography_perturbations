Cell[CellGroupData[{

Cell["Modules for DE solving", "Subsection",
 CellChangeTimes->{{3.992249939108923*^9, 
  3.992249948424613*^9}},ExpressionUUID->"9096ae05-ef91-4c46-ba5c-\
17d4273ab556"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForEh", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "odeEh", ",", "sol", ",", "\[Epsilon]Val", 
       ",", " ", "q0Val", ",", " ", "j0Val"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<q0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<j0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Epsilon]Val", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", 
         RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
         RowBox[{"j0Val_", "?", "NumericQ"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"odeEh", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dEh", "/.", " ", 
            RowBox[{"q", "->", "qFn"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}], ",", " ", 
             RowBox[{"q0", "->", "q0Val"}]}], "}"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeEh", ",", "Eh", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Eh", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
   3.991448764350067*^9, 3.99144876680994*^9}, {3.991448918938006*^9, 
   3.991448923543747*^9}, {3.991448978914154*^9, 3.991449107877153*^9}, {
   3.991471440100438*^9, 3.991471448695713*^9}, {3.991471490762517*^9, 
   3.991471491056706*^9}, {3.991471728459805*^9, 3.991471781350174*^9}, {
   3.991471882983693*^9, 3.991471923577379*^9}, {3.991471956762825*^9, 
   3.9914719879513206`*^9}, {3.991707403008647*^9, 3.991707403266122*^9}, {
   3.991707498576212*^9, 3.991707558737364*^9}, {3.9953345037878532`*^9, 
   3.995334565691124*^9}, {3.995334605181372*^9, 3.9953346063637943`*^9}, 
   3.995334832563757*^9, {3.995335710543806*^9, 3.995335741086665*^9}, {
   3.9953359141636133`*^9, 3.995335916191827*^9}, {3.995335954560268*^9, 
   3.995336011528123*^9}, {3.9953360439541907`*^9, 3.995336055175151*^9}, 
   3.995336218294992*^9, {3.995336692225669*^9, 3.9953367271728697`*^9}, {
