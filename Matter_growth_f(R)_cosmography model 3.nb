Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qkIdx", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"k", "=", "0.01"}], ",", "0.2"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PlotQScales", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "legLabels", ",", "kSel", ",", "kSelLabels", ",", 
       "curves", ",", "styles", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
          "]"}], "[", "dataset", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"legLabels", "=", 
       RowBox[{"labels", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kSel", "=", 
       RowBox[{"kPhys", "[", 
        RowBox[{"[", "qkIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kSelLabels", "=", 
       RowBox[{"kLabels", "[", 
        RowBox[{"[", "qkIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QParts", "[", 
            RowBox[{
            "model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
            "]"}], "[", "\"\<Q\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"lab", ",", "labels"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"kp", ",", "kSel"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ",", 
             RowBox[{"kDashings", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "labels", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "kSel", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "labels", "]"}], "]"}]}], ",", 
             "legLabels", ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"Background", "->", "White"}], ",", 
                  RowBox[{"FrameStyle", "->", 
                   RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", 
              "kDashings"}], ",", "kSelLabels", ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"Background", "->", "White"}], ",", 
                  RowBox[{"FrameStyle", "->", 
                   RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"Spacings", "->", "0.3"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"zv", ",", "0", ",", "10"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<Q(z)\>\""}], "}"}]}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
        ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"0.78", ",", "0.7"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "500"}], ",", 
        RowBox[{"PlotLabel", "->", "dataset"}]}], "]"}]}]}], "]"}]}], 
