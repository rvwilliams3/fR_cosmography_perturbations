       RowBox[{
        RowBox[{
         RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], "/", 
        RowBox[{"DeltaFn", "[", "z", "]"}]}]}]}], "]"}]}], ";"}], 
  "*)"}]], "Input",
