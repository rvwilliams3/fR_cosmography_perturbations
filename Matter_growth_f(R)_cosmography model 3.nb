Cell[CellGroupData[{

Cell["Determining physically viable x(z) and \[CapitalOmega](z) \
trajectories:", "Section",
 CellChangeTimes->{{3.9917309225591097`*^9, 3.991730929312442*^9}, {
  3.991731057031872*^9, 3.991731068745043*^9}, {3.995523213379004*^9, 
  3.995523226626054*^9}},ExpressionUUID->"3ed98c46-b1c9-4ff7-98bd-\
4a5f93482ffe"],

Cell[CellGroupData[{

Cell["Modules", "Subsection",
 CellChangeTimes->{{3.991791720779071*^9, 
  3.9917917219267683`*^9}},ExpressionUUID->"1c6ac925-173d-4baf-8d7d-\
23304a981588"],

Cell[CellGroupData[{

Cell["Matter dominated fixed point selection modules", "Subsubsection",
 CellChangeTimes->{{3.991726373941082*^9, 3.9917263874138927`*^9}, {
  3.9917265366132383`*^9, 
  3.991726537972209*^9}},ExpressionUUID->"bfcc3fe5-6cc2-4cee-ba11-\
7111722e5fd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FixedPointsStabilityEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "jExpr", ",", "jAlg", ",", "fps", ",", "jacMat", ",", "jacFn", ",", 
       "xx", ",", "OO", ",", "qq"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"substitute", " ", "onto", " ", "private", " ", 
         RowBox[{"symbols", ":", "qq"}]}], ",", "xx", ",", 
        RowBox[{
        "OO", " ", "cannot", " ", "collide", " ", "with", " ", "the", " ", 
         "global", " ", "x"}], ",", "\[CapitalOmega]", ",", 
        RowBox[{
        "q", " ", "used", " ", "as", " ", "ODE", " ", "function", " ", 
         "names"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"jAlg", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"jExpr", "/.", " ", 
          RowBox[{
           RowBox[{"q", "[", "n", "]"}], "->", "qq"}]}], ")"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Fx", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"F\[CapitalOmega]", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"Fq", "[", 
             RowBox[{"qq", ",", "jAlg"}], "]"}], "==", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], ",", "Reals"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jacMat", "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Fx", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"F\[CapitalOmega]", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"Fq", "[", 
            RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"jacFn", "=", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xv", ",", "Ov", ",", "qv"}], "}"}], ",", 
         RowBox[{"jacMat", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xx", "->", "xv"}], ",", 
            RowBox[{"OO", "->", "Ov"}], ",", 
            RowBox[{"qq", "->", "qv"}]}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<jAlg\>\"", "->", "jAlg"}], ",", 
        RowBox[{"\"\<fixedPoints\>\"", "->", "fps"}], ",", 
        RowBox[{"\"\<vars\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}]}], ",", 
        RowBox[{"\"\<Jac\>\"", "->", "jacFn"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991726082177257*^9, 3.991726141855951*^9}, {
   3.9947424573092327`*^9, 3.994742478304962*^9}, {3.9949201798119*^9, 
   3.994920185127494*^9}, 3.9953396413370256`*^9},
 CellLabel->
  "In[101]:=",ExpressionUUID->"1f9dccea-6d99-4e09-9d70-bf47b9623bff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFPEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"MatterDominatedFPEps", "[", 
     RowBox[{"model", ",", "epsVal"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "fpResult", ",", "fps", ",", "vars", ",", "Jac", ",", "ptVals", ",", 
        "target", ",", "distances", ",", "bestIdx", ",", "vals", ",", "eig", 
        ",", "eigvecs", ",", "type"}], "}"}], ",", 
      RowBox[{
       RowBox[{"fpResult", "=", 
        RowBox[{"FixedPointsStabilityEps", "[", 
         RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "=", 
        RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
       RowBox[{"vars", "=", 
        RowBox[{"fpResult", "[", "\"\<vars\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Jac", "=", 
        RowBox[{"fpResult", "[", "\"\<Jac\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ptVals", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"vars", "/.", " ", "#"}], "]"}], "&"}], ",", "fps"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"target", "=", 
        RowBox[{"N", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#", "-", "target"}], "]"}], "&"}], ",", "ptVals"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"ptVals", "[", 
         RowBox[{"[", "bestIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
        RowBox[{
         RowBox[{"Eigensystem", "[", 
          RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"type", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
