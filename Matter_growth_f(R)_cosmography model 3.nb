Cell[CellGroupData[{

Cell["Perturbation system", "Subsubsection",
 CellChangeTimes->{{3.9965766337723417`*^9, 3.996576637385913*^9}, {
  3.996583058222735*^9, 
  3.996583061096446*^9}},ExpressionUUID->"419d50a8-4d63-4a05-8941-\
bb12c49b923e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildPertSystem", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "store", ",", "cg", ",", "jE", ",", "sE", ",", "lE", ",", "bg", ",", 
       "label", ",", "xFn", ",", "OmFn", ",", "qFn", ",", "EhFn", ",", 
       "cgRules", ",", "bgRules"}], "}"}], ",", 
     RowBox[{
      RowBox[{"store", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
         "]"}], "[", "dataset", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cg", "=", 
       RowBox[{
        RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}]}], " ", 
      
      RowBox[{"(*", 
       RowBox[{"cosmographic", " ", 
        RowBox[{"(", 
         RowBox[{"s", ",", "l"}], ")"}], " ", "functions"}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"jE", ",", "sE", ",", "lE"}], "}"}], "=", 
       RowBox[{"cg", "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<j\>\"", ",", "\"\<s\>\"", ",", "\"\<l\>\""}], "}"}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "store", "]"}], "[", 
        RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "idx", " ", "associates", " ", "which", " ", "initial", " ", 
        "condition", " ", "on", " ", "x", " ", "is", " ", "being", " ", 
        "used"}], "*)"}], 
      RowBox[{"bg", "=", 
       RowBox[{"store", "[", "label", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"x", " ", "and", " ", "Omega", " ", "functions"}], "*)"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"xFn", "=", 
       RowBox[{"bg", "[", "\"\<x\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"OmFn", "=", 
       RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"bg", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EhFn", "=", 
       RowBox[{
        RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"cgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "jE"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sE"}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", "lE"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"cosmography", " ", 
         RowBox[{"first", ":", " ", "j"}]}], ",", "s", ",", 
        RowBox[{"l", " ", "still", " ", "contain", " ", "free", " ", 
         RowBox[{"q", "[", "z", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"qFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", 
          RowBox[{"xFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", 
          RowBox[{"OmFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "z", "]"}], "->", 
          RowBox[{"EhFn", "[", "z", "]"}]}], ",", 
         RowBox[{"khat", "->", "khatVal"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"then", " ", "bind", " ", "the", " ", "interpolants"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eqR\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ReqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<eqD\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DeltaeqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"bg", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", 
         RowBox[{"bg", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", 
         RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}]}], ",", 
        RowBox[{"\"\<eps\>\"", "->", 
         RowBox[{"cg", "[", "\"\<eps\>\"", "]"}]}], ",", 
        RowBox[{"\"\<q0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<q0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<j0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<j0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", 
         RowBox[{"EhFn", "[", 
          RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}], "]"}]}]}], "|>"}]}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996577281073994*^9, 3.996577300952786*^9}, {
  3.996577333689823*^9, 3.996577386791966*^9}, {3.996577475052778*^9, 
  3.996577488721834*^9}, {3.996579377334917*^9, 3.996579379263138*^9}, {
  3.997255009879788*^9, 3.9972550696026297`*^9}},
 CellLabel->
  "In[308]:=",ExpressionUUID->"07f0a82a-140e-4a49-8476-30a29d32d4f5"]
}, Closed]],

Cell[CellGroupData[{

Cell["Initial conditions", "Subsubsection",
 CellChangeTimes->{{3.9965776792685137`*^9, 
  3.9965776812827272`*^9}},ExpressionUUID->"9295e969-7093-419d-a2d8-\
5884bace4f85"],

Cell[TextData[{
 "Following 21 cm paper: (2606.03729v1)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "(", "1000", ")"}], "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]],ExpressionUUID->
  "6d605bc5-35d9-4594-8381-59d13c549d24"],
 ", \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "'"}], 
     RowBox[{"(", "1000", ")"}]}], "=", 
    RowBox[{
     RowBox[{"-", "9.99"}], "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], TraditionalForm]],ExpressionUUID->
  "9da5d800-ed9f-4be5-8391-d60f3db63cb9"],
 "\n\nAt high redshift indistuinguishable from GR -->\n\[ScriptCapitalR]hat = \
3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "2"], 
    SubscriptBox["\[CapitalOmega]", "m"]}], TraditionalForm]],ExpressionUUID->
  "bcef6da6-183c-41da-a62e-7d5eac6978f0"],
 "\[CapitalDelta],\t\t\[ScriptCapitalR]hat \[OpenCurlyQuote] = 3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "^", "2"}], " ", 
    SubscriptBox["\[CapitalOmega]", "m"], 
    FractionBox["\[CapitalDelta]", 
     RowBox[{"1", "+", "z"}]]}], TraditionalForm]],ExpressionUUID->
  "47c67e78-d2ad-4e8d-83c4-6009b4a337d7"],
 "[3+(1+z) ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", "'"}], "\[CapitalDelta]"], TraditionalForm]],
  ExpressionUUID->"0dfaff45-55ef-4400-9ebb-f1e5e16be05f"],
 "]"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.996577682534783*^9, 3.996577688698234*^9}, {
  3.9965777312002993`*^9, 3.996577791059173*^9}, {3.996577828900903*^9, 
  3.996577918528096*^9}, {3.996581973940897*^9, 3.9965819882665586`*^9}, {
  3.99658228635635*^9, 3.99658228892657*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"3dcf1440-f75d-424b-b26c-781a86311ac7"],

Cell["\<\
We can only do this if Omega_m(z) matches GR so then we need to use the \
source matching Omega_m0 - not jess\[CloseCurlyQuote]s value.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9965795042339287`*^9, 3.9965795353155403`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"3f3dbd1b-2ee9-4fbb-a9a5-884afcc38091"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Checking", " ", "that", " ", "Rhat", " ", "is", " ", "correct", " ", "in",
     " ", "GR", " ", "limit"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"grLimit", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ReqnSolveDust", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", "0"}], ",", 
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"1", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "1"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", 
          RowBox[{
           RowBox[{"-", "7"}], "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", 
          RowBox[{"35", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", "1"}]}], "}"}]}], 
      "//", "Cancel"}]}], ",", " ", 
    RowBox[{"z", ">=", "0"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996578910245099*^9, 3.996578942139704*^9}, {
   3.996579112456634*^9, 3.996579149895555*^9}, {3.996582316061736*^9, 
   3.996582419464799*^9}, 3.997255078840687*^9},
 CellLabel->
  "In[309]:=",ExpressionUUID->"f15087cf-dd39-4f25-a346-2d4ef0486483"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalR]hat", "[", "z", "]"}], "\[Equal]", 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"Eh", "[", "z", "]"}], "2"], " ", 
   RowBox[{"\[CapitalDelta]", "[", "z", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.996578911891279*^9, 3.996578942710918*^9}, 
   3.996579206309873*^9, {3.996582312832731*^9, 3.996582420000675*^9}, 
   3.996659991290661*^9, 3.996674943892021*^9, 3.996677160810743*^9, 
   3.996724375382166*^9, 3.997184138712339*^9, 3.997239772535223*^9, 
   3.997254935649248*^9, 3.997255079293404*^9, 3.997260969803545*^9, 
   3.997333849142333*^9, 3.997340323950039*^9, 3.997431587182047*^9, 
   3.9974351931150723`*^9},
 CellLabel->
  "Out[309]=",ExpressionUUID->"427c61e5-0783-4350-816b-2a54c0aad307"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "This", " ", "is", " ", "only", " ", "true", " ", "for", " ", "Omega", 
    RowBox[{"(", "z", ")"}]}], "->", "1"}], "*)"}]], "Input",
