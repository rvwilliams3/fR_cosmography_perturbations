Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SelectEvenXi", "[", 
    RowBox[{"sweepResult_Association", ",", "nPoints_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filtered", ",", "xiVals", ",", "targets", ",", "idx"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"filtered", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], ">=", 
           "xTodayThreshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"filtered", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"filtered", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiVals", "=", 
       RowBox[{"filtered", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "filtered", "]"}], "<=", "nPoints"}], ",", 
        RowBox[{"Return", "[", "filtered", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"targets", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"Min", "[", "xiVals", "]"}], ",", 
         RowBox[{"Max", "[", "xiVals", "]"}], ",", 
         RowBox[{"nPoints", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"xiVals", "-", "#"}], "]"}], ",", "1"}], "]"}], "]"}], 
          "&"}], "/@", "targets"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995342581787116*^9, 3.995342593687205*^9}, {
   3.995342780847473*^9, 3.995342781419993*^9}, {3.995343085279057*^9, 
   3.995343087267094*^9}, 3.9953433559472427`*^9, {3.995345706032874*^9, 
   3.995345708231103*^9}, 3.995345876303337*^9, 3.996542488825172*^9},
 CellLabel->
  "In[106]:=",ExpressionUUID->"dbcb93d7-2bbf-4e60-bf5b-66dfec5e9c60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "zi", ",", "ic", ",", "xi", ",", 
       "\[CapitalOmega]i", ",", "qi", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd", ",", "wp", ",", "q0Val", ",", 
       "j0Val"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", "30"}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{
        RowBox[{"qAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"zi", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]i", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}], ",", "wp"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"qi", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "14"}], ",", 
               RowBox[{"AccuracyGoal", "->", "14"}], ",", 
               RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
