Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SLegend", "[", 
    RowBox[{"dataset_String", ",", "kIdx_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "labels", "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "labels", "]"}], "]"}]}], ",", 
           RowBox[{"labels", "[", 
            RowBox[{"[", 
