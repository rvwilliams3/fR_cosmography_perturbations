ddd2af9bc75f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MakeXOmegaComparePlot", "[", 
     RowBox[{"dataset_String", ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ImageSize", "->", "600"}], ",", 
         RowBox[{"\"\<Models\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Model 3\>\"", ",", "\"\<Model 0\>\""}], "}"}]}], ",", 
         
         RowBox[{"\"\<Dashing\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "Small", "}"}]}], "}"}]}]}], "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "models", ",", "dashes", ",", "sweeps", ",", "curves", ",", "styles", 
        ",", "labels", ",", "colors"}], "}"}], ",", 
      RowBox[{
       RowBox[{"models", "=", 
        RowBox[{"OptionValue", "[", "\"\<Models\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dashes", "=", 
        RowBox[{"OptionValue", "[", "\"\<Dashing\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"colors", "=", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sweeps", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"sweepResultsByModel", "[", "#", "]"}], "[", "dataset", 
           "]"}], "&"}], "/@", "models"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"sweeps", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"#", "[", "\"\<found\>\"", "]"}]}], "||", 
              RowBox[{
               RowBox[{"#", "[", "\"\<table\>\"", "]"}], "===", 
               RowBox[{"{", "}"}]}]}], ")"}], "&"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{"\"\<No viable points: \>\"", "<>", "dataset"}], "]"}], 
            ",", 
            RowBox[{"ImageSize", "->", 
             RowBox[{"OptionValue", "[", "ImageSize", "]"}]}]}], "]"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"curves", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"sw", ",", "m"}], "}"}], ",", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", "tb", "}"}], ",", 
                RowBox[{
                 RowBox[{"tb", "=", 
                  RowBox[{"SortBy", "[", 
                   RowBox[{
                    RowBox[{"sw", "[", "\"\<table\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], 
                 ";", "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}], ",", 
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}]}], 
                    "}"}], "]"}], ",", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}], ",", 
                    RowBox[{"tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<\[CapitalOmega]Today\>\""}], 
                    "]"}], "]"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"sweeps", ",", "models"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"styles", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"d", ",", "m"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"colors", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"Dashing", "[", "d", "]"}]}], "]"}], ",", 
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"colors", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"Dashing", "[", "d", "]"}]}], "]"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"dashes", ",", "models"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"labels", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "m", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<x(0), \>\"", "<>", "m"}], ",", 
                RowBox[{"\"\<\[CapitalOmega](0), \>\"", "<>", "m"}]}], 
               "}"}]}], "]"}], ",", 
