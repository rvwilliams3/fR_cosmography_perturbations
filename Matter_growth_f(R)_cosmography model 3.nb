Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildPertICs", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "sys_Association", ",", 
     RowBox[{"DeltaIn_", ":", 
      SuperscriptBox["10", 
       RowBox[{"-", "5"}]]}], ",", 
     RowBox[{"\[Gamma]_", ":", 
      FractionBox["6", "11"]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "zi", ",", "Omi", ",", "Ehi", ",", "DeltaPrimei", ",", "Ri", ",", 
       "RPrimei"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zi", "=", 
       RowBox[{"sys", "[", "\"\<zinitial\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Ehi", "=", 
       RowBox[{"sys", "[", "\"\<Ehi\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Omi", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zi", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"Source", " ", "matching", " ", "\[CapitalOmega]m", 
        RowBox[{"(", "z", ")"}]}], "*)"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"DeltaPrimei", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"-", "DeltaIn"}], " "}], 
         RowBox[{"1", "+", "zi"}]], 
        SuperscriptBox["Omi", "\[Gamma]"]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "Derived", " ", "from", " ", "definition", " ", "of", " ", "S", " ", 
        "eqn", " ", "11", " ", "of", " ", "2606.03729", "v1"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Ri", "=", 
       RowBox[{"3", " ", 
        SuperscriptBox["Ehi", "2"], " ", "Omi", " ", "DeltaIn"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RPrimei", "=", 
       RowBox[{
        FractionBox["Ri", 
         RowBox[{"1", "+", "zi"}]], 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "zi"}], ")"}], 
           FractionBox["DeltaPrimei", "DeltaIn"]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]i\>\"", "->", "DeltaIn"}], ",", 
        RowBox[{"\"\<\[CapitalDelta]primei\>\"", "->", "DeltaPrimei"}], ",", 
        RowBox[{"\"\<Ri\>\"", "->", "Ri"}], ",", 
        RowBox[{"\"\<Rprimei\>\"", "->", "RPrimei"}], ",", 
        RowBox[{"\"\<zi\>\"", "->", "zi"}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", "Ehi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]mi\>\"", "->", "Omi"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996579416288781*^9, 3.996579416290544*^9}, {
  3.996579592835923*^9, 3.996579631460242*^9}, {3.996580731653688*^9, 
