Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "odeQ", ",", "sol", ",", "q0Val", ",", "j0Val", ",", 
       "epsVal"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"odeQ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"dq", "/.", " ", 
           RowBox[{"j", "->", 
            RowBox[{"jModelMap", "[", "model", "]"}]}]}], "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Epsilon]", "->", "epsVal"}], ",", 
            RowBox[{"q0", "->", "q0Val"}], ",", 
            RowBox[{"j0", "->", "j0Val"}]}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"q", "[", "0", "]"}], "==", "q0Val"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeQ", ",", "q", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
