       RowBox[{"Print", "[", "pX", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "pOmega", "]"}], ";"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], "]"}], 
