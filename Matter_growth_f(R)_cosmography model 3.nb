Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForEh", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "odeEh", ",", "sol", ",", "\[Epsilon]Val", 
       ",", " ", "q0Val", ",", " ", "j0Val"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<q0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<j0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Epsilon]Val", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", 
         RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
         RowBox[{"j0Val_", "?", "NumericQ"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"odeEh", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dEh", "/.", " ", 
            RowBox[{"q", "->", "qFn"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}], ",", " ", 
             RowBox[{"q0", "->", "q0Val"}]}], "}"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeEh", ",", "Eh", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Eh", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
