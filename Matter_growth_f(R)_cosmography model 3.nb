Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotNormalisedD", "[", 
    RowBox[{"dataset_String", ",", "label_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"byK", ",", "curves"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"byK", "=", 
       RowBox[{
        RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "z", "]"}], "/", 
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "0", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
