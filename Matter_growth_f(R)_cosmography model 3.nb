             RowBox[{"{", 
              RowBox[{"\"\<Column\>\"", ",", "1"}], "}"}]}]}], "]"}], ",", 
          "legendPos"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
