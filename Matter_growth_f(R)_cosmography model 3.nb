Cell[TextData[{
 "We have 2 selection modules for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "507e1de4-afd9-4862-9f3d-f0da0f301042"],
 "values (all choosing ones in the range yielding ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "(", "0", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cca193c3-fae3-4c82-b5b4-97da2c26bc09"],
 " <=1:\[LineSeparator]1. SelectEvenXi[]: selects n evenly spaced initial \
conditions within the viable window\n2. SelectXi[]: chooses the 2 intiial \
conditions near the edge of the viable window, and chooses 2 targets that \
have x(0)=-0.1, x(0)=-0.5"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.998364320402115*^9, 3.998364448949418*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"6158fae8-e629-4a78-8acf-75eec7ae5c3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Module", " ", "to", " ", "select", " ", "n", " ", "evenly", " ", "spaced",
     " ", "xintiial", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SelectEvenXi", "[", 
     RowBox[{"sweepResult_Association", ",", "nPoints_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"filtered", ",", "xiVals", ",", "targets", ",", "idx"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"filtered", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], ">=", 
            "xTodayThreshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"filtered", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"filtered", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{"filtered", ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xiVals", "=", 
        RowBox[{"filtered", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "filtered", "]"}], "<=", "nPoints"}], ",", 
         RowBox[{"Return", "[", "filtered", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"targets", "=", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"Min", "[", "xiVals", "]"}], ",", 
          RowBox[{"Max", "[", "xiVals", "]"}], ",", 
          RowBox[{"nPoints", "-", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"idx", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"xiVals", "-", "#"}], "]"}], ",", "1"}], "]"}], "]"}], 
           "&"}], "/@", "targets"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"filtered", "[", 
        RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.995342581787116*^9, 3.995342593687205*^9}, {
   3.995342780847473*^9, 3.995342781419993*^9}, {3.995343085279057*^9, 
   3.995343087267094*^9}, 3.9953433559472427`*^9, {3.995345706032874*^9, 
   3.995345708231103*^9}, 3.995345876303337*^9, 3.996542488825172*^9, {
   3.998364281785263*^9, 3.9983643037359543`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"dbcb93d7-2bbf-4e60-bf5b-66dfec5e9c60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xiTargets", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.1"}], ",", 
      RowBox[{"-", "0.5"}]}], "}"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"target", " ", "x", 
    RowBox[{"(", "0", ")"}], " ", "values", " ", "for", " ", "the", " ", 
    "interior", " ", "points"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeInset", "=", "0.015"}], ";"}], "          ", 
  RowBox[{"(*", 
   RowBox[{
   "1.5", "%", " ", "of", " ", "the", " ", "viable", " ", "x_i", " ", 
    "window", " ", "width"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SelectXi", "[", 
    RowBox[{"sweep_Association", ",", "targets_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pts", ",", "sorted", ",", "xiMin", ",", "xiMax", ",", "width", ",", 
       "xTodayRange", ",", "nearestXi", ",", "nearestXToday", ",", "picks"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"sweep", "[", "\"\<found\>\"", "]"}], "]"}], "===", 
         "False"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pts", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"sweep", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], ">=", 
           "xTodayThreshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pts", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sorted", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"pts", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiMin", "=", 
       RowBox[{
        RowBox[{"First", "[", "sorted", "]"}], "[", "\"\<xi\>\"", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"xiMax", "=", 
       RowBox[{
        RowBox[{"Last", "[", "sorted", "]"}], "[", "\"\<xi\>\"", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"width", "=", 
       RowBox[{"xiMax", "-", "xiMin"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xTodayRange", "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"sorted", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nearestXi", "[", "target_", "]"}], ":=", 
       RowBox[{"First", "[", 
        RowBox[{"MinimalBy", "[", 
         RowBox[{"sorted", ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "-", "target"}], "]"}], 
           "&"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nearestXToday", "[", "target_", "]"}], ":=", 
       RowBox[{"First", "[", 
        RowBox[{"MinimalBy", "[", 
         RowBox[{"sorted", ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], "-", "target"}], 
            "]"}], "&"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"picks", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"nearestXi", "[", 
             RowBox[{"xiMin", "+", 
              RowBox[{"edgeInset", " ", "width"}]}], "]"}], ",", 
            RowBox[{"\"\<tag\>\"", "->", "\"\<min\>\""}]}], "]"}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"targets", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "<", 
               RowBox[{"First", "[", "xTodayRange", "]"}]}], "||", 
              RowBox[{
               RowBox[{"targets", "[", 
                RowBox[{"[", "m", "]"}], "]"}], ">", 
               RowBox[{"Last", "[", "xTodayRange", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<  x(0) = \>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"targets", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "]"}], "<>", 
                  "\"\< outside attainable range \>\"", "<>", 
                  RowBox[{"ToString", "[", "xTodayRange", "]"}], "<>", 
                  "\"\< - skipped\>\""}], ",", 
                 RowBox[{"Darker", "[", "Orange", "]"}]}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", "Nothing"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"nearestXToday", "[", 
                RowBox[{"targets", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], "]"}], ",", 
               RowBox[{"\"\<tag\>\"", "->", 
                RowBox[{"\"\<x(0)\[TildeTilde]\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"targets", "[", 
                   RowBox[{"[", "m", "]"}], "]"}], "]"}]}]}]}], "]"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"Length", "[", "targets", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"nearestXi", "[", 
             RowBox[{"xiMax", "-", 
              RowBox[{"edgeInset", " ", "width"}]}], "]"}], ",", 
            RowBox[{"\"\<tag\>\"", "->", "\"\<max\>\""}]}], "]"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DeleteDuplicatesBy", "[", 
       RowBox[{
        RowBox[{"SortBy", "[", 
         RowBox[{"picks", ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998364262231954*^9, 3.998364262234065*^9}, 
   3.998364411924696*^9},
 CellLabel->
  "In[145]:=",ExpressionUUID->"7c5153a4-3e6f-43ff-a374-fe23ee63a010"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "zi", ",", "ic", ",", "xi", ",", 
       "\[CapitalOmega]i", ",", "qi", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd", ",", "wp", ",", "q0Val", ",", 
       "j0Val"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", "30"}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{
        RowBox[{"qAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"zi", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]i", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}], ",", "wp"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"qi", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "14"}], ",", 
               RowBox[{"AccuracyGoal", "->", "14"}], ",", 
               RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], ",", 
        RowBox[{"\"\<qi\>\"", "->", "qi"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953427219563*^9, 3.99534275611684*^9}, {
   3.995346488448003*^9, 3.995346488690901*^9}, {3.995346702465871*^9, 
   3.995346704343001*^9}, 3.9953467417432957`*^9, {3.995347706655174*^9, 
   3.99534774703548*^9}, {3.99534808329198*^9, 3.995348257670144*^9}, {
   3.995600668737981*^9, 3.995600674278298*^9}, {3.995600725939093*^9, 
   3.995600840228261*^9}, 3.995600874182691*^9, 3.99560102012549*^9, {
   3.995601064504258*^9, 3.9956010955772743`*^9}, {3.996542338134515*^9, 
   3.996542339071118*^9}, {3.996542664528526*^9, 3.996542668534398*^9}, {
   3.996543333473983*^9, 3.996543350714696*^9}, {3.996543401747546*^9, 
   3.996543404432798*^9}, {3.99683944059057*^9, 3.996839449224405*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"f958fc57-2cd7-416a-9884-2ad67d7c1bab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBackgroundSolutions", "[", 
    RowBox[{
    "model_String", ",", "bgResults_Association", ",", "datasets_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "plotX", ",", "plotOmega"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotX", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
             "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotOmega", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", 
              "\"\<\[CapitalOmega]\>\"", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
