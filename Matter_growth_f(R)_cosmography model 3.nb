Cell[CellGroupData[{

Cell["Growth index parameter", "Subsubsection",
 CellChangeTimes->{{3.996735329793926*^9, 
  3.996735333110924*^9}},ExpressionUUID->"651c282f-bae3-48a2-9d0c-\
48082c7d053e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GammaFn", "[", 
    RowBox[{"dataset_", ",", "label_", ",", "kp_"}], "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DeltaFn", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}],
           "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ",", 
       RowBox[{"OmmFn", "=", 
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "\"\<Model 3\>\"", "]"}], "[", "dataset",
          "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
      RowBox[{"z", ",", 
       FractionBox[
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "+", "z"}], ")"}]}], " ", 
          FractionBox[
           RowBox[{
            RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], 
           RowBox[{"DeltaFn", "[", "z", "]"}]]}], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"OmmFn", "[", "z", "]"}], "]"}]]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996652242357788*^9, 3.996652250261537*^9}, {
  3.996652429707982*^9, 3.99665249481446*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"ecbb66c1-4efc-40fd-9e2b-46e61e69d8eb"],

Cell[CellGroupData[{

