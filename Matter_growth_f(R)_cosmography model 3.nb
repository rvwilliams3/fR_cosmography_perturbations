 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "This", " ", "is", " ", "only", " ", "true", " ", "for", " ", "Omega", 
    RowBox[{"(", "z", ")"}]}], "->", "1"}], "*)"}]], "Input",
