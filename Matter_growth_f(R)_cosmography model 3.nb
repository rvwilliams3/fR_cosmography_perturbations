Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolvePerturbations", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sys", ",", "ics", ",", "zi", ",", "sol", ",", "DeltaFn", ",", "RFn"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"sys", "=", 
       RowBox[{"BuildPertSystem", "[", 
        RowBox[{"model", ",", "dataset", ",", "idx", ",", "khatVal"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ics", "=", 
       RowBox[{"BuildPertICs", "[", 
        RowBox[{"model", ",", "dataset", ",", "sys"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zi", "=", 
       RowBox[{"ics", "[", "\"\<zi\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sys", "[", "\"\<eqD\>\"", "]"}], ",", 
           RowBox[{"sys", "[", "\"\<eqR\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<\[CapitalDelta]i\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[CapitalDelta]", "'"}], "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<\[CapitalDelta]primei\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[ScriptCapitalR]hat", "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<Ri\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ScriptCapitalR]hat", "'"}], "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<Rprimei\>\"", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CapitalDelta]", ",", "\[ScriptCapitalR]hat"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "8"}], ",", " ", 
         RowBox[{"AccuracyGoal", "->", "8"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"sol", ",", 
           RowBox[{"{", 
            RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{"\[CapitalDelta]", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"RFn", "=", 
       RowBox[{"\[ScriptCapitalR]hat", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]\>\"", "->", "DeltaFn"}], ",", 
        RowBox[{"\"\<\[ScriptCapitalR]hat\>\"", "->", "RFn"}], ",", 
        RowBox[{"\"\<domainEnd\>\"", "->", 
         RowBox[{
          RowBox[{"DeltaFn", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<label\>\"", "->", 
         RowBox[{"sys", "[", "\"\<label\>\"", "]"}]}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"sys", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<ics\>\"", "->", "ics"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996660037597343*^9, 3.996660037599374*^9}, {
  3.99836737356343*^9, 3.998367378447158*^9}, {3.9983702678406487`*^9, 
  3.9983702800178843`*^9}, {3.998370483470539*^9, 3.9983705077288446`*^9}, {
  3.998371305308836*^9, 3.9983713071749563`*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"36e64a24-155d-498b-bf4e-42b0c42f56d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveAllPerturbations", "[", 
    RowBox[{"model_String", ",", "datasets_List", ",", "khatList_List", ",", 
     RowBox[{"nIdx_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"dataset", "->", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "label", "}"}], ",", 
            RowBox[{
             RowBox[{"label", "=", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"bgRun", "[", "model", "]"}], "[", 
                  "\"\<bgResults\>\"", "]"}], "[", "dataset", "]"}], "]"}], 
               "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"label", "->", 
              RowBox[{"Association", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"kp", ",", "khv"}], "}"}], ",", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "r", "}"}], ",", 
                    RowBox[{
                    RowBox[{"r", "=", 
                    RowBox[{"SolvePerturbations", "[", 
                    RowBox[{"model", ",", "dataset", ",", "i", ",", "khv"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"r", "===", "$Failed"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "dataset", ",", "\"\<  |  \>\"", ",", "label", ",", 
                    "\"\<  |  k = \>\"", ",", "kp", ",", 
                    "\"\< h/Mpc  (khat = \>\"", ",", "khv", ",", 
                    "\"\<):  FAILED\>\""}], "}"}], "]"}], ",", "Red"}], "]"}],
                     "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"kp", "->", "r"}]}]}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"kPhys", ",", "khatList"}], "}"}]}], "]"}], 
               "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"nIdx", "===", "Automatic"}], ",", 
              RowBox[{"Length", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"bgRun", "[", "model", "]"}], "[", 
                 "\"\<bgResults\>\"", "]"}], "[", "dataset", "]"}], "]"}], 
              ",", "nIdx"}], "]"}]}], "}"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99836500575449*^9, 3.998365031449869*^9}, 
   3.998367361083074*^9},
 CellLabel->
  "In[241]:=",ExpressionUUID->"490981ac-c449-41a6-9d4f-88f6d9761979"],

