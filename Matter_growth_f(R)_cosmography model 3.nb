Cell[CellGroupData[{

Cell["Initial condition relations", "Chapter",
 CellChangeTimes->{{3.99742495508827*^9, 
  3.997424958802743*^9}},ExpressionUUID->"d9a87127-6af1-4280-8613-\
63ee81f79540"],

Cell[CellGroupData[{

Cell["Relating model 0 and model 3 x initial condition", "Subsection",
 CellChangeTimes->{{3.997434390460046*^9, 3.9974344043547783`*^9}, {
  3.9974942377442636`*^9, 
  3.997494241559784*^9}},ExpressionUUID->"bf552249-65e4-4787-874e-\
2a3cac1aade4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"xiModel0", "=", 
    RowBox[{"-", 
     SuperscriptBox["10", 
      RowBox[{"-", "14"}]]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"value", " ", "form", " ", "21", "cm"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9974318885191507`*^9, 3.997431923574072*^9}, {
  3.997433463426649*^9, 3.997433463979444*^9}},
 CellLabel->
  "In[344]:=",ExpressionUUID->"4376f465-d364-4091-96be-cf97aeeaf5c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xiModel3", "[", 
     RowBox[{"q0_", ",", "j0_", ",", " ", "qfunc_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", " ", "qi"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Epsilon]", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"\"\<Model 3\>\"", ",", "q0", ",", "j0"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Use", " ", "values", " ", "of", " ", "q0"}], ",", " ", 
         RowBox[{
         "j0", " ", "today", " ", "from", " ", "MCMC", " ", "to", " ", 
          "determine", " ", "\[Epsilon]"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"qi", "=", 
        RowBox[{"qfunc", "[", "1000", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xiModel0", " ", "*", " ", 
        FractionBox[
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox["3", "2"], "\[Epsilon]"}], "+", 
          RowBox[{"qi", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"3", "\[Epsilon]"}]}], ")"}]}]}], 
         RowBox[{"qi", "+", "1"}]]}]}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"xi", " ", "evaluated", " ", "at", " ", "intial", " ", "z"}], "=", 
    RowBox[{
     RowBox[{"1000", " ", "-", " ", 
      RowBox[{"so", " ", "use", " ", "qi"}]}], "=", 
     RowBox[{"q", 
      RowBox[{"(", "1000", ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9974249601324053`*^9, 3.997425060403088*^9}, {
  3.99743155345728*^9, 3.997431595519557*^9}, {3.99743189571504*^9, 
  3.997431909828464*^9}, {3.9974328532463827`*^9, 3.997432891106628*^9}, {
  3.997433265642864*^9, 3.9974332669492903`*^9}, {3.9974334319874353`*^9, 
  3.9974334925952053`*^9}, {3.997433570813139*^9, 3.997433605034268*^9}},
 CellLabel->
  "In[345]:=",ExpressionUUID->"daa77325-1473-4784-8c8d-8dfb8ba6b105"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xInitModel3Assoc", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "->", 
       RowBox[{"xiModel3", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", 
            "]"}], "[", "\"\<q0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}], ",", 
         
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", 
            "]"}], "[", "\"\<j0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}], ",", 
         
