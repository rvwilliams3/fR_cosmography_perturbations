                 RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"vals", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "zval", "]"}], "/", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "0", "]"}]}], ",", 
                  
                  RowBox[{"{", 
                   RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"dataset", ",", "label"}], "}"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"NumberForm", "[", 
                    RowBox[{"#", ",", "6"}], "]"}], "&"}], "/@", "vals"}]}], 
                "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
