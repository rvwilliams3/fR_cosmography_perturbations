Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sigma80", "=", "0.78"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FS8Func", "[", 
    RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
         "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], "}"}], 
     ",", 
     RowBox[{"sigma80", " ", 
      RowBox[{"SFunc", "[", 
       RowBox[{"dataset", ",", "lab", ",", "kp", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"DeltaFn", "[", "z", "]"}], "/", 
       RowBox[{"DeltaFn", "[", "0", "]"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998405064391531*^9, 3.9984050675343847`*^9}, {
  3.998405906577951*^9, 3.998405907888296*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"c9e766f3-2f75-40ba-ab35-f8528964f484"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFS8", "[", 
    RowBox[{"dataset_String", ",", "kIdx_List", ",", 
     RowBox[{"zmax_", ":", "2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "kSel", ",", "kSelLabels", ",", "curves", ",", "styles", 
       ",", "legFn", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kSel", "=", 
       RowBox[{"kPhys", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kSelLabels", "=", 
       RowBox[{"kLabels", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"FS8Func", "[", 
           RowBox[{"dataset", ",", "lab", ",", "kp", ",", "zz"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"lab", ",", "labels"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"kp", ",", "kSel"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ",", 
             RowBox[{"kDashings", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "labels", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "kSel", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"legFn", "=", 
       RowBox[{
        RowBox[{"Framed", "[", 
         RowBox[{"#", ",", 
          RowBox[{"RoundingRadius", "->", "0"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"GrayLevel", "[", "0.5", "]"}]}], ",", 
          RowBox[{"Background", "->", 
           RowBox[{"GrayLevel", "[", 
            RowBox[{"1", ",", "0.9"}], "]"}]}], ",", 
          RowBox[{"FrameMargins", "->", "4"}]}], "]"}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "labels", "]"}], "]"}]}], ",", "labels",
              ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", 
              "kDashings"}], ",", "kSelLabels", ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"Spacings", "->", "0.3"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"zz", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"0.8", ",", "0.75"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<z\>\"", ",", 
           "\"\<\!\(\*SubscriptBox[\(f\[Sigma]\), \(8\)]\)(z)\>\""}], "}"}]}],
         ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
        ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", "dataset", "}"}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
