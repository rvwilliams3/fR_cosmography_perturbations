Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"core", " ", "\[CapitalOmega]mFun", " ", "builder"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]mFun", "[", 
     RowBox[{"\[CapitalOmega]m0_", ",", "Efunc_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Om0", "=", "\[CapitalOmega]m0"}], ",", 
        RowBox[{"Ef", "=", "Efunc"}]}], "}"}], ",", 
      RowBox[{"Function", "[", 
       RowBox[{"zz", ",", 
        FractionBox[
         RowBox[{"Om0", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "zz"}], ")"}], "3"]}], 
         SuperscriptBox[
          RowBox[{"Ef", "[", "zz", "]"}], "2"]]}], "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.997334865784585*^9, 3.997334921196412*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"a03fadee-e520-497a-846a-ad3eaf9f5130"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Amatch", "[", 
    RowBox[{"\[Epsilon]val_", ",", " ", "q0val_"}], "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"3", "\[Epsilon]val"}], "-", "2", "-", 
     RowBox[{"2", "q0val"}]}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"\[Epsilon]val", "-", "1"}], ")"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{3.997335045743999*^9},
 CellLabel->"In[80]:=",ExpressionUUID->"a45b7c0d-6dc9-4753-a0c6-7b3fc48d8c67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "two", " ", "Om0", " ", "sources"}], ",", " ", 
    RowBox[{"from", " ", "MCMC", " ", "and", " ", "SM"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Om0MeanData", "[", 
      RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], "[", 
       "\"\<Om0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Om0SourceMatch", "[", 
      RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q0", ",", "j0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"q0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
           "[", "\"\<q0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"j0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
           "[", "\"\<j0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Amatch", "[", 
         RowBox[{
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0", ",", "j0"}], "]"}], ",", "q0"}], 
         "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.997334924837487*^9, 3.997334960510362*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"e2f1e83d-e6eb-48c5-920c-9c5fef9ee0a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "one"}]}], " ", "assembler"}], ",", 
    RowBox[{
     RowBox[{
     "Om0Fn", " ", "is", " ", "either", " ", "of", " ", "the", " ", "two", 
      " ", 
      RowBox[{"above", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BuildOmegaM", "[", 
     RowBox[{"model_String", ",", "Om0Fn_", ",", "datasets_List"}], "]"}], ":=", 
    RowBox[{"Association", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "->", 
         RowBox[{"\[CapitalOmega]mFun", "[", 
          RowBox[{
           RowBox[{"Om0Fn", "[", 
            RowBox[{"model", ",", "#"}], "]"}], ",", 
           RowBox[{
            RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "#", "]"}]}], 
          "]"}]}], "&"}], ",", "datasets"}], "]"}], "]"}]}], ";"}]}]], "Input",\

 CellLabel->"In[83]:=",ExpressionUUID->"72eb14fb-c789-4ca8-a468-3179f10110e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotOmegaM", "[", 
    RowBox[{
    "model_String", ",", "OmAssoc_Association", ",", "label_String", ",", 
     RowBox[{"zmax_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"datasets", ",", "colours", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"Keys", "[", "OmAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"colours", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{"colours", ",", "datasets", ",", 
         RowBox[{"LegendMarkerSize", "->", "20"}], ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"RoundingRadius", "->", "0"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"FrameStyle", "->", "Gray"}]}], "]"}], "&"}], ")"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OmAssoc", "[", "dset", "]"}], "[", "z", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dset", ",", "datasets"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colours"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"1.15", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
        ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<z\>\"", ",", 
           "\"\<\\!\\(\\*SubscriptBox[\\(\[CapitalOmega]\\), \\(m\\)]\\)(z)\>\
\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"model", "<>", "\"\<, \>\"", "<>", "label"}]}], ",", 
        RowBox[{"ImageSize", "->", "1000"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
