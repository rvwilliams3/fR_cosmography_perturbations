 CellLabel->"In[38]:=",ExpressionUUID->"1144a60f-0fb6-4923-bac1-78a0374cc72f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "odeQ", ",", "sol", ",", "q0Val", ",", "j0Val", ",", 
       "epsVal"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"odeQ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"dq", "/.", " ", 
           RowBox[{"j", "->", 
            RowBox[{"jModelMap", "[", "model", "]"}]}]}], "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Epsilon]", "->", "epsVal"}], ",", 
            RowBox[{"q0", "->", "q0Val"}], ",", 
            RowBox[{"j0", "->", "j0Val"}]}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"q", "[", "0", "]"}], "==", "q0Val"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeQ", ",", "q", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
   3.991448764350067*^9, 3.99144876680994*^9}, {3.991448918938006*^9, 
   3.991448923543747*^9}, {3.991448978914154*^9, 3.991449107877153*^9}, {
   3.991471440100438*^9, 3.991471448695713*^9}, {3.991471490762517*^9, 
   3.991471491056706*^9}, {3.991706810612037*^9, 3.991706821947378*^9}, {
   3.995334597286139*^9, 3.995334598218159*^9}, {3.995334758735853*^9, 
   3.995334760380708*^9}, {3.9953348148148117`*^9, 3.995334824473936*^9}, {
   3.9953360281298943`*^9, 3.9953360861630383`*^9}, {3.995336135933708*^9, 
   3.995336234113899*^9}, {3.995336267027359*^9, 3.995336286239932*^9}, {
   3.995336320331607*^9, 3.995336393217447*^9}, {3.99533643247759*^9, 
   3.995336432967917*^9}, {3.995336539811194*^9, 3.995336606769472*^9}, 
