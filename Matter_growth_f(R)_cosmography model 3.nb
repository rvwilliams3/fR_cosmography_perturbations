Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", 
     RowBox[{"keys_", ":", 
      RowBox[{"{", 
       RowBox[{"\"\<mean\>\"", ",", "\"\<mean\>\""}], "}"}]}]}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "odeQ", ",", "sol", ",", "q0Val", ",", "j0Val", ",", 
       "epsVal", ",", "qKey", ",", "jKey"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"qKey", ",", "jKey"}], "}"}], "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringQ", "[", "keys", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"keys", ",", "keys"}], "}"}], ",", "keys"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
