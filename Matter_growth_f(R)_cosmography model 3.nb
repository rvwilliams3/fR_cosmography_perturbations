Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 0\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", "0"}], 
