   3.996548906150378*^9, 3.996548906484234*^9}, 3.996548960626481*^9, {
   3.996574558445432*^9, 3.9965745753861322`*^9}, {3.9965746163099823`*^9, 
   3.9965749870349417`*^9}, {3.996575040873722*^9, 3.996575183734396*^9}, {
   3.996575215855798*^9, 3.996575267887788*^9}, {3.996575307758801*^9, 
