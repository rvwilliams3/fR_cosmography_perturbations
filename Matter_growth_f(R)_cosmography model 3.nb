 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"SFunc", "[", 
     RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
      RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"DeltaFn", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
          "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], "/", 
        RowBox[{"DeltaFn", "[", "z", "]"}]}]}]}], "]"}]}], ";"}], 
  "*)"}]], "Input",
