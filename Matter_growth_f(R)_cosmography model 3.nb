Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"Dataset\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox[
      SubscriptBox["\<\"x\"\>", "\<\"i\"\>"],
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"F(0) [MCMC]\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
