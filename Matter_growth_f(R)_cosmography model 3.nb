   RowBox[{"\[CapitalOmega]m0_", ",", " ", "Efunc_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[CapitalOmega]func", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalOmega]func", "[", "z_", "]"}], ":=", 
      RowBox[{
       FractionBox["\[CapitalOmega]m0", 
        SuperscriptBox[
         RowBox[{"Efunc", "[", "z", "]"}], "2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], "3"]}]}], ";", "\[IndentingNewLine]",
      "\[CapitalOmega]func"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
