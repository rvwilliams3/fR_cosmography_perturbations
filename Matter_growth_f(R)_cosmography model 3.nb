Cell[CellGroupData[{

Cell["Classification of eigenvectors:", "Subsubsection",
 CellChangeTimes->{{3.9917333812941527`*^9, 
  3.9917333913488603`*^9}},ExpressionUUID->"b99d9a95-d02e-4d72-a7b6-\
51f0aca7443d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
       RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unstableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qComponents", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], "<=", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vxOmega", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vxOmega"}], ",", "vxOmega"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vq", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vq"}], ",", "vq"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
        RowBox[{"\"\<vxOmega\>\"", "->", "vxOmega"}], ",", 
        RowBox[{"\"\<vStable\>\"", "->", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", "stableIdx", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaQ\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaXOmega\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996839535509368*^9, 3.996839551256282*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"e55ba3cc-5b2e-43b2-a3ed-3bd971c1c045"]
}, Closed]],

Cell[CellGroupData[{

Cell["Scan of ICs", "Subsubsection",
 CellChangeTimes->{{3.991733431058099*^9, 3.991733439041154*^9}, {
  3.991791735333887*^9, 3.991791737840498*^9}, {3.995339938669035*^9, 
  3.995339940350081*^9}},ExpressionUUID->"7bb38129-07ae-43d4-8f70-\
35fa9fc6a0e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanICs", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "c2Range_List", ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", 
        RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
        RowBox[{"\"\<AccuracyGoal\>\"", "->", "25"}], ",", 
        RowBox[{"\"\<MaxSteps\>\"", "->", 
         SuperscriptBox["10", "8"]}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "j0Val", ",", "q0Val", ",", "nSamp", ",", "singTol", ",",
        "pg", ",", "ag", ",", "maxSt", ",", "wp", ",", "fp", ",", "cl", ",", 
       "vq", ",", "vxOmega", ",", "qFn", ",", "deltaQ", ",", "c3", ",", 
       "results"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"j0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", " ", "dataset", ",", " ", "\"\<j0\>\"", ",", " ", 
         "\"\<mean\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", " ", "dataset", ",", " ", "\"\<q0\>\"", ",", " ", 
         "\"\<mean\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"nSamp", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxSt", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxSteps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fp", "=", 
       RowBox[{"MatterDominatedFPEps", "[", 
        RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cl", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cl", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<label\>\"", "->", "\"\<DegenerateFP\>\""}]}], 
            "|>"}], ",", 
           RowBox[{"{", 
            RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"qFn", "=", 
         RowBox[{"qSolPlanckSets3", "[", "ds", "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{
        RowBox[{"qAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"deltaQ", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "zi", "]"}], "-", 
        RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c3", "=", 
       RowBox[{"deltaQ", "/", 
        RowBox[{"vq", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "xi", ",", "\[CapitalOmega]i", ",", "sol", ",", "xFn", ",", 
             "\[CapitalOmega]Fn", ",", "viability"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"xi", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
                RowBox[{"c2", " ", 
                 RowBox[{"vxOmega", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                RowBox[{"c3", " ", 
                 RowBox[{"vq", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]i", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
                RowBox[{"c2", " ", 
                 RowBox[{"vxOmega", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "+", 
                RowBox[{"c3", " ", 
                 RowBox[{"vq", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"sol", "=", 
             RowBox[{"Block", "[", 
              RowBox[{
               RowBox[{"{", "q", "}"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"q", "[", "zz_", "]"}], ":=", 
                 RowBox[{"qFn", "[", "zz", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Quiet", "[", 
                 RowBox[{
                  RowBox[{"NDSolve", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                    "\[CapitalOmega]i"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "[", "z", "]"}], "]"}], ">", 
                    RowBox[{"10", "^", "3"}]}], ",", 
                    "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], ">", "10"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "<", "0"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
                    RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
                    RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
                    RowBox[{"MaxSteps", "->", "maxSt"}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"NDSolve", "::", "ndsz"}], ",", 
                    RowBox[{"NDSolve", "::", "mxst"}], ",", 
                    RowBox[{"NDSolve", "::", "precw"}], ",", 
                    RowBox[{"NDSolve", "::", "ndtol"}], ",", 
                    RowBox[{"NDSolve", "::", "nlnum"}], ",", 
                    RowBox[{"NDSolve", "::", "ndcf"}]}], "}"}]}], "]"}]}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"MatchQ", "[", 
                RowBox[{"sol", ",", 
                 RowBox[{"{", 
                  RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
                RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
                RowBox[{
                "\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], ",", 
                RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
                RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
                RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
                RowBox[{"\"\<label\>\"", "->", "\"\<Failed\>\""}]}], "|>"}], 
              ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xFn", "=", 
                 RowBox[{"x", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"\[CapitalOmega]Fn", "=", 
                 RowBox[{"\[CapitalOmega]", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"viability", "=", 
                 RowBox[{"ClassifyTrajectoryViability", "[", 
                  RowBox[{
                  "model", ",", "j0Val", ",", "q0Val", ",", "xFn", ",", 
                   "\[CapitalOmega]Fn", ",", "qFn", ",", "zi", ",", 
                   RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
                   RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}]}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
                    RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
                    RowBox[{
                    "\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}]}], 
                   "|>"}], ",", "viability"}], "]"}]}], ")"}]}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "results"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994748176350764*^9, 3.994748192968132*^9}, {
   3.994748301265675*^9, 3.994748307882498*^9}, {3.994748405633508*^9, 
   3.994748407427803*^9}, {3.994748502697263*^9, 3.994748504908838*^9}, {
   3.994748955338813*^9, 3.994748956307416*^9}, 3.994749278457863*^9, {
   3.994761113415764*^9, 3.994761127035657*^9}, {3.99490697167679*^9, 
   3.994906987115777*^9}, {3.994907022821605*^9, 3.994907025086266*^9}, {
   3.9949070750039997`*^9, 3.9949071026948643`*^9}, 3.994907924868127*^9, 
   3.9949080782773*^9, 3.9949950893279657`*^9, 3.994995425125615*^9, 
   3.9950852603635073`*^9, {3.9950853439427834`*^9, 3.995085344091556*^9}, {
   3.995085384998199*^9, 3.99508538534019*^9}, {3.995085495064963*^9, 
   3.995085503068851*^9}, {3.995085631528084*^9, 3.995085631723854*^9}, {
   3.99524484729762*^9, 3.995244857942257*^9}, {3.995244892243965*^9, 
   3.995244893351142*^9}, {3.995340453135955*^9, 3.995340496305465*^9}, {
   3.99534061777059*^9, 3.9953407043164062`*^9}, {3.996542686342248*^9, 
   3.996542694908943*^9}, {3.9965427328244963`*^9, 3.996542739117747*^9}, 
   3.99654316973082*^9, {3.996834701871883*^9, 3.996834715906556*^9}, {
   3.996839245278453*^9, 3.99683924639766*^9}, {3.997153800075368*^9, 
   3.997153813593197*^9}, {3.99715517958237*^9, 3.997155181622757*^9}, {
   3.997155412317523*^9, 3.997155418460133*^9}, {3.997155508851883*^9, 
   3.997155509112742*^9}},
