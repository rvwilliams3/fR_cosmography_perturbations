Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFitOverlay", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_", ",", 
     RowBox[{"kps_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ks", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kps", "===", "Automatic"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "@", "kPhys"}], ",", 
           RowBox[{"Last", "@", "kPhys"}]}], "}"}], ",", "kps"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"fitOne", "[", 
            RowBox[{"model", ",", "dataset", ",", "lab", ",", "#"}], "]"}], 
           "&"}], "/@", "ks"}]}], "}"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "@", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"QParts", "[", 
                RowBox[{"model", ",", "dataset", ",", "lab", ",", 
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "zv"}], "]"}], "[", 
               "\"\<S\>\"", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"g", "=", 
