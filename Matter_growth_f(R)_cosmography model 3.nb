             RowBox[{
              RowBox[{"sols", "=", 
               RowBox[{"SortedSols", "[", "dataset", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"F", ",", "zi"}], "}"}], ",", 
                  RowBox[{
                   RowBox[{"F", "=", 
                    RowBox[{"FOfz", "[", 
                    RowBox[{"dataset", ",", "s", ",", 
                    RowBox[{"Om0Func", "[", "dataset", "]"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"zi", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"s", ",", "\"\<zinitial\>\"", ",", "1000"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"dataset", ",", 
                    RowBox[{"s", "[", "\"\<xi\>\"", "]"}], ",", 
                    RowBox[{"F", "[", "0", "]"}], ",", "zi", ",", 
                    RowBox[{"F", "[", "zi", "]"}]}], "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
