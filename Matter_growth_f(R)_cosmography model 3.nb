Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildqBand", "[", 
    RowBox[{"model_String", ",", " ", "dataset_String"}], "]"}], " ", ":=", 
   " ", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"corners", ",", " ", "sols"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"corners", " ", "=", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", " ", "\"\<max\>\""}], "}"}], ",", " ", 
          
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", " ", "\"\<max\>\""}], "}"}]}], "}"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"sols", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"SolveForq", "[", 
          RowBox[{"model", ",", " ", "dataset", ",", " ", "#"}], "]"}], " ", 
         "&"}], " ", "/@", " ", "corners"}]}], ";", "\n", "   ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ss", " ", "=", " ", "sols"}], "}"}], ",", "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<mean\>\"", " ", "->", " ", 
           RowBox[{
            RowBox[{"qAssocByModel", "[", "model", "]"}], "[", "dataset", 
            "]"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<lo\>\"", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ss", "[", "#", "]"}], "]"}], "]"}], " ", "&"}], 
            ")"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<hi\>\"", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ss", "[", "#", "]"}], "]"}], "]"}], " ", "&"}], 
            ")"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<corners\>\"", " ", "->", " ", "ss"}]}], "|>"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"4f1779ae-b02b-4937-807b-505591bca61c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plotModels", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Planck + DESY5\>\"", ",", " ", 
     "\"\<Planck + Union3 + Pantheon+ + DESY5\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qBandAssoc3", " ", "=", " ", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", "->", " ", 
        RowBox[{"BuildqBand", "[", 
         RowBox[{"\"\<Model 3\>\"", ",", " ", "#"}], "]"}]}], " ", "&"}], ",",
       " ", "plotModels"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"2f1a6a5f-7a5d-4e2a-9082-24cbfd36c2ac"],

