Cell[CellGroupData[{

Cell["Q function", "Subsection",
 CellChangeTimes->{{3.997333792931529*^9, 
  3.99733379487667*^9}},ExpressionUUID->"5d91e7b8-3951-4d59-afc5-\
c8be2883e75c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QParts", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "lab_", ",", 
     RowBox[{"kp_", "?", "NumericQ"}], ",", 
     RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bg", ",", "pr", ",", "Dl", ",", "Rh", ",", "khat", ",", "S", ",", "T", 
       ",", "x", ",", "Om", ",", "qv", ",", "Eh", ",", "j", ",", "s", ",", 
       "Ommat", ",", "fR", ",", "DD", ",", "M", ",", "P", ",", "\[Tau]", ",", 
       "brk", ",", "A3", ",", "A4", ",", "d2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bg", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
          "]"}], "[", "dataset", "]"}], "[", "lab", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
        "[", "kp", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Dl", "=", 
       RowBox[{"pr", "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ";", 
      RowBox[{"Rh", "=", 
       RowBox[{"pr", "[", "\"\<\[ScriptCapitalR]hat\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"khat", "=", 
       RowBox[{"pr", "[", "\"\<khat\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<x\>\"", "]"}], "[", "zv", "]"}]}], ";", 
      RowBox[{"Om", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "[", "zv", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qv", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<q\>\"", "]"}], "[", "zv", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Eh", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", "s"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
            "[", "\"\<j\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
            "[", "\"\<s\>\"", "]"}]}], "}"}], "/.", " ", 
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", "qv"}]}], "/.", " ", 
        RowBox[{"z", "->", "zv"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Ommat", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fR", "=", 
       RowBox[{"Ommat", "/", "Om"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DD", "=", 
       RowBox[{"j", "-", "qv", "-", "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
         RowBox[{"Dl", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"T", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Rh", "'"}], "[", "zv", "]"}], "/", 
         RowBox[{"Rh", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"M", "=", 
       FractionBox[
        RowBox[{
         SuperscriptBox["khat", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}], "2"], "x"}], 
        RowBox[{"6", " ", "DD", " ", 
         SuperscriptBox["Eh", "2"]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{
        SuperscriptBox["j", "2"], "-", 
        RowBox[{"8", " ", "x"}], "-", 
        RowBox[{"s", " ", "x"}], "-", 
        RowBox[{
         SuperscriptBox["qv", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "x"}]}], ")"}]}], "+", 
        RowBox[{"6", " ", "Om"}], "+", 
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "qv"}], ")"}], " ", "x"}], "-", 
           RowBox[{"3", " ", "Om"}]}], ")"}]}], "+", 
        RowBox[{"qv", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "-", 
           RowBox[{"11", " ", "x"}], "+", 
           RowBox[{"3", " ", "Om"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A3", "=", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["khat", "2"], " ", "x"}], 
           RowBox[{"6", " ", "DD", " ", 
            SuperscriptBox["Eh", "4"]}]], "+", 
          FractionBox["P", 
           RowBox[{"2", " ", 
            SuperscriptBox["DD", "2"], " ", 
            SuperscriptBox["Eh", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "zv"}], ")"}], "2"]}]]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A4", "=", 
       FractionBox["x", 
        RowBox[{"2", " ", "DD", " ", 
         SuperscriptBox["Eh", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d2", "=", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"qv", "+", "x"}], ")"}]}], 
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}]], " ", 
         RowBox[{
          RowBox[{"Dl", "'"}], "[", "zv", "]"}]}], "+", 
        RowBox[{
         FractionBox[
          RowBox[{"3", " ", "Om", " "}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "zv"}], ")"}], "2"]], 
         RowBox[{"Dl", "[", "zv", "]"}]}], "+", 
        RowBox[{"A3", " ", 
         RowBox[{"Rh", "[", "zv", "]"}]}], "+", 
        RowBox[{"A4", " ", 
         RowBox[{
          RowBox[{"Rh", "'"}], "[", "zv", "]"}]}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", "''"}], " ", "equation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[Tau]", "=", 
       RowBox[{
        RowBox[{"Rh", "[", "zv", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"3", " ", 
          RowBox[{"Eh", "^", "2"}], " ", "Ommat", " ", 
          RowBox[{"Dl", "[", "zv", "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"brk", "=", 
       RowBox[{
        RowBox[{"2", " ", "M"}], "+", 
        RowBox[{"P", "/", 
         RowBox[{"DD", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", " ", "T"}], ")"}], "/", "DD"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "->", "S"}], ",", 
        RowBox[{"\"\<T\>\"", "->", "T"}], ",", 
        RowBox[{"\"\<\[Tau]\>\"", "->", "\[Tau]"}], ",", 
        RowBox[{"\"\<M\>\"", "->", "M"}], ",", 
        RowBox[{"\"\<fR\>\"", "->", "fR"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]m\>\"", "->", "Ommat"}], ",", 
        RowBox[{"\"\<d2\>\"", "->", "d2"}], ",", 
        RowBox[{"\"\<Qgrav\>\"", "->", 
         RowBox[{"2", "/", "fR"}]}], ",", 
        RowBox[{"\"\<Qcurv\>\"", "->", 
         RowBox[{
          RowBox[{"-", "\[Tau]"}], " ", "brk"}]}], ",", 
        RowBox[{"\"\<Q\>\"", "->", 
         RowBox[{
          RowBox[{"2", "/", "fR"}], "-", 
          RowBox[{"\[Tau]", " ", "brk"}]}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9972601502662697`*^9, 3.997260158204157*^9}, {
  3.9972606144459133`*^9, 3.9972607343238482`*^9}, {3.997261108991887*^9, 
  3.997261109742477*^9}, {3.997261874722346*^9, 3.9972618840438747`*^9}, {
  3.997261983404905*^9, 3.997262002673483*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"d875d282-d4f2-4c24-b283-a6202ca49812"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QOf", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"QParts", "[", 
     RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
     "]"}], "[", "\"\<Q\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997259036019343*^9, 3.997259047164523*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"f3a5fcd4-5543-4e66-877f-281fa4f23fe0"],

Cell[CellGroupData[{

Cell["Confirming (numerically) equations and Q(z)", "Subsubsection",
 CellChangeTimes->{{3.9972608611359367`*^9, 3.9972608645159082`*^9}, {
  3.997261782721047*^9, 
  3.997261795171447*^9}},ExpressionUUID->"25d10911-fdf7-4c84-b401-\
d2ac4656b37b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"To", " ", "confirm", " ", "that", " ", "the", " ", "Q", 
    RowBox[{"(", "z", ")"}], " ", "above", " ", "is", " ", "calcualted", " ", 
    "correctly"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PertResidual", "[", 
     RowBox[{"model_String", ",", "dataset_String", ",", "lab_", ",", 
      RowBox[{"kp_", "?", "NumericQ"}], ",", 
      RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Dl", ",", "qv", ",", "x", ",", "S", ",", "p", ",", "lhs", ",", 
        "rhs"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Dl", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
          "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
             "]"}], "[", "dataset", "]"}], "[", "lab", "]"}], "[", 
          "\"\<q\>\"", "]"}], "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
             "]"}], "[", "dataset", "]"}], "[", "lab", "]"}], "[", 
          "\"\<x\>\"", "]"}], "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"S", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
          RowBox[{"Dl", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"QParts", "[", 
         RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lhs", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
           RowBox[{"Dl", "[", "zv", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "zv"}], ")"}], "^", "2"}], " ", 
          RowBox[{
           RowBox[{"p", "[", "\"\<d2\>\"", "]"}], "/", 
           RowBox[{"Dl", "[", "zv", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "qv", "-", "x"}], ")"}], " ", "S"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rhs", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}], " ", 
         RowBox[{"p", "[", "\"\<\[CapitalOmega]m\>\"", "]"}], " ", 
         RowBox[{"p", "[", "\"\<Q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"lhs", "-", "rhs"}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "lhs", "]"}], ",", 
          RowBox[{"Abs", "[", "rhs", "]"}], ",", "$MinMachineNumber"}], 
         "]"}]}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
