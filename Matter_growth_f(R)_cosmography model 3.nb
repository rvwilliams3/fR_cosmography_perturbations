Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"j0Func", "[", "z_", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"j1", "[", "z_", "]"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "\[Epsilon]", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"q", "[", "z", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
