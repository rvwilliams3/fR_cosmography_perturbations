Cell[TextData[{
 "Following 21 cm paper: (2606.03729v1)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "(", "1000", ")"}], "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d605bc5-35d9-4594-8381-59d13c549d24"],
 ", \t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "'"}], 
     RowBox[{"(", "1000", ")"}]}], "=", 
    RowBox[{
     RowBox[{"-", "9.99"}], "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "9"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9da5d800-ed9f-4be5-8391-d60f3db63cb9"],
 "\n\nAt high redshift indistuinguishable from GR -->\n\[ScriptCapitalR]hat = \
3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "2"], 
    SubscriptBox["\[CapitalOmega]", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bcef6da6-183c-41da-a62e-7d5eac6978f0"],
 "\[CapitalDelta],\t\t\[ScriptCapitalR]hat \[OpenCurlyQuote] = 3(1-3w) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "^", "2"}], " ", 
    SubscriptBox["\[CapitalOmega]", "m"], 
    FractionBox["\[CapitalDelta]", 
     RowBox[{"1", "+", "z"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47c67e78-d2ad-4e8d-83c4-6009b4a337d7"],
 "[3+(1+z) ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", "'"}], "\[CapitalDelta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0dfaff45-55ef-4400-9ebb-f1e5e16be05f"],
 "]"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.996577682534783*^9, 3.996577688698234*^9}, {
  3.9965777312002993`*^9, 3.996577791059173*^9}, {3.9965778289009027`*^9, 
  3.996577918528096*^9}, {3.996581973940897*^9, 3.9965819882665586`*^9}, {
