         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
