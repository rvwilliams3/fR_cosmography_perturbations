Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FEndpointTableSM", "[", 
    RowBox[{"datasets_List", ",", 
     RowBox[{"model_String", ":", "\"\<Model 3\>\""}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "rows", "}"}], ",", 
     RowBox[{
      RowBox[{"rows", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"sols", ",", "Om0mean", ",", "Om0sm"}], "}"}], ",", 
             RowBox[{
              RowBox[{"sols", "=", 
               RowBox[{"SortedSols", "[", "dataset", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Om0mean", "=", 
               RowBox[{"Om0MeanData", "[", "dataset", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Om0sm", "=", 
               RowBox[{"Om0SourceMatch", "[", 
                RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Fmean", ",", "Fsm", ",", "zi"}], "}"}], ",", 
                  RowBox[{
                   RowBox[{"Fmean", "=", 
                    RowBox[{"FOfz", "[", 
                    RowBox[{"dataset", ",", "s", ",", "Om0mean"}], "]"}]}], 
                   ";", "\[IndentingNewLine]", 
                   RowBox[{"Fsm", "=", 
                    RowBox[{"FOfz", "[", 
                    RowBox[{"dataset", ",", "s", ",", "Om0sm"}], "]"}]}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"zi", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"s", ",", "\"\<zinitial\>\"", ",", "1000"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"dataset", ",", 
                    RowBox[{"ScientificForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"s", "[", "\"\<xi\>\"", "]"}]}], ",", "3"}], 
                    "]"}], ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"Fmean", "[", "0", "]"}]}], ",", "6"}], "]"}], 
                    ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"Fmean", "[", "zi", "]"}]}], ",", "6"}], "]"}], 
                    ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"Fsm", "[", "0", "]"}]}], ",", "6"}], "]"}], ",", 
                    
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"Fsm", "[", "zi", "]"}]}], ",", "6"}], "]"}]}], 
                    "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{"\"\<Dataset\>\"", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
             "\"\<F(0) [MCMC]\>\"", ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<F(\>\"", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                "\"\<) [MCMC]\>\""}], "}"}], "]"}], ",", "\"\<F(0) [SM]\>\"", 
             ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<F(\>\"", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                "\"\<) [SM]\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}], ",", 
        RowBox[{"Background", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.9", ",", "0.9", ",", "0.9"}], "]"}], ",", "None"}], 
            "}"}]}], "}"}]}], ",", 
        RowBox[{"ItemStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"FontSize", "->", "11"}], "]"}]}], ",", 
        RowBox[{"Spacings", "->", 
         RowBox[{"{", 
          RowBox[{"1.2", ",", "0.8"}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99560687869497*^9, 3.9956068814251127`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"38fc36a1-7c13-4312-adb5-cb532d7c0c78"],

