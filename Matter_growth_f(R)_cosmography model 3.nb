51f0aca7443d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
       RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unstableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qComponents", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], "<=", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vxOmega", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vxOmega"}], ",", "vxOmega"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vq", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vq"}], ",", "vq"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
        RowBox[{"\"\<vxOmega\>\"", "->", "vxOmega"}], ",", 
        RowBox[{"\"\<vStable\>\"", "->", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", "stableIdx", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaQ\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaXOmega\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996839535509368*^9, 3.996839551256282*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"e55ba3cc-5b2e-43b2-a3ed-3bd971c1c045"]
