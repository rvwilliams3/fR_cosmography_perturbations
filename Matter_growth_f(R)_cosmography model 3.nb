Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildCosmographyExprs", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q0Val", ",", "j0Val", ",", "epsVal", ",", "jExpr", ",", "qpExpr", ",", 
       "sExpr", ",", "lExpr", ",", "jpExpr", ",", "spExpr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", "dataset", ",", "\"\<q0\>\"", ",", "\"\<mean\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", "dataset", ",", "\"\<j0\>\"", ",", "\"\<mean\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qpExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"dq", ",", " ", 
           RowBox[{
            RowBox[{"q", "'"}], "[", "z", "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"j", "[", "z", "]"}], "->", "jExpr"}]}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"q", "'"}], 
        RowBox[{"(", "z", ")"}], " ", "eliminated", " ", "analytically", " ", 
        "via", " ", "dq"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"jpExpr", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"jExpr", ",", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"dj", ",", 
              RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
           RowBox[{
            RowBox[{
             RowBox[{"j", "'"}], "[", "z", "]"}], "->", "jpExpr"}]}], "/.", 
          RowBox[{
           RowBox[{"j", "[", "z", "]"}], "->", "jExpr"}]}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"spExpr", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"sExpr", ",", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"ds", ",", 
             RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "'"}], "[", "z", "]"}], "->", "spExpr"}]}], "/.", 
         " ", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sExpr"}]}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sExpr", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Cancel", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"Rationalize", "[", 
           RowBox[{"sExpr", ",", "0"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lExpr", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Cancel", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"Rationalize", "[", 
           RowBox[{"lExpr", ",", "0"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
        RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
        RowBox[{"\"\<j\>\"", "->", "jExpr"}], ",", 
        RowBox[{"\"\<s\>\"", "->", "sExpr"}], ",", 
        RowBox[{"\"\<l\>\"", "->", "lExpr"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996547962913258*^9, 3.996547980143717*^9}, 
   3.99654807256282*^9, 3.996548124107436*^9, {3.996548160375935*^9, 
