Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotNormalisedD", "[", 
    RowBox[{"dataset_String", ",", "label_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"byK", ",", "curves"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"byK", "=", 
       RowBox[{
        RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "z", "]"}], "/", 
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "0", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"LogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"Automatic", ",", "kLabels", ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"RoundingRadius", "->", "0"}], ",", 
                  RowBox[{"FrameStyle", "->", 
                   RowBox[{"GrayLevel", "[", "0.5", "]"}]}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "10"}], "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.2", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<D(z)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"dataset", ",", "\"\<   \>\"", ",", "label"}], "}"}], 
          "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
