Cell[CellGroupData[{

Cell["Model 3 with error", "Subsubsection",
 CellChangeTimes->{{3.9983555273045797`*^9, 
  3.998355529637808*^9}},ExpressionUUID->"53d3209e-f887-4534-8850-\
d329013bbc71"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildEBand", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"corners", ",", "sols"}], "}"}], ",", 
     RowBox[{
      RowBox[{"corners", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", "\"\<max\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", "\"\<max\>\""}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sols", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"SolveForEh", "[", 
          RowBox[{"model", ",", "dataset", ",", "#"}], "]"}], "&"}], "/@", 
        "corners"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ss", "=", "sols"}], "}"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<mean\>\"", "->", 
           RowBox[{
            RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", 
            "]"}]}], ",", 
          RowBox[{"\"\<lo\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ss", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
          ",", 
          RowBox[{"\"\<hi\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ss", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
          ",", 
          RowBox[{"\"\<corners\>\"", "->", "ss"}]}], "|>"}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998355677925378*^9, 3.998355680879257*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"84e2c7b2-bc03-4013-b89e-31f80a9a6f81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EBandAssoc3", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "->", 
        RowBox[{"BuildEBand", "[", 
         RowBox[{"\"\<Model 3\>\"", ",", "#"}], "]"}]}], "&"}], ",", 
      "plotModels"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"22b3c3ef-45d9-4731-a0dd-b9ab66046f82"],

