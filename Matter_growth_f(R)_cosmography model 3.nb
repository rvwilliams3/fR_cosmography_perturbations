Cell[CellGroupData[{

Cell["Perturbation system", "Subsubsection",
 CellChangeTimes->{{3.9965766337723417`*^9, 3.996576637385913*^9}, {
  3.996583058222735*^9, 
  3.996583061096446*^9}},ExpressionUUID->"419d50a8-4d63-4a05-8941-\
bb12c49b923e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildPertSystem", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "cg", ",", "jE", ",", "sE", ",", "lE", ",", "bg", ",", "label", ",", 
       "xFn", ",", "OmFn", ",", "qFn", ",", "EhFn", ",", "cgRules", ",", 
       "bgRules"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cg", "=", 
       RowBox[{
        RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}]}], " ", 
      
      RowBox[{"(*", 
       RowBox[{"cosmographic", " ", 
        RowBox[{"(", 
         RowBox[{"s", ",", " ", "l"}], ")"}], " ", "functions"}], "*)"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"jE", ",", "sE", ",", "lE"}], "}"}], "=", 
       RowBox[{"cg", "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<j\>\"", ",", "\"\<s\>\"", ",", "\"\<l\>\""}], "}"}]}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{
        RowBox[{"Keys", "[", 
         RowBox[{
          RowBox[{"allBgResultsByModel", "[", "model", "]"}], "[", "dataset", 
          "]"}], "]"}], "[", 
        RowBox[{"[", "idx", "]"}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "idx", " ", "associates", " ", "which", " ", "initial", " ", 
        "condition", " ", "on", " ", "x", " ", "is", " ", "being", " ", 
        "used"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"bg", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"allBgResultsByModel", "[", "model", "]"}], "[", "dataset", 
         "]"}], "[", "label", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"x", " ", "and", " ", "Omega", " ", "functions"}], "*)"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"xFn", "=", 
       RowBox[{"bg", "[", "\"\<x\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"OmFn", "=", 
       RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"bg", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EhFn", "=", 
       RowBox[{
        RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"cgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "jE"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sE"}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", "lE"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"cosmography", " ", 
         RowBox[{"first", ":", " ", "j"}]}], ",", "s", ",", 
        RowBox[{"l", " ", "still", " ", "contain", " ", "free", " ", 
         RowBox[{"q", "[", "z", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"qFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", 
          RowBox[{"xFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", 
          RowBox[{"OmFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "z", "]"}], "->", 
          RowBox[{"EhFn", "[", "z", "]"}]}], ",", 
         RowBox[{"khat", "->", "khatVal"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"then", " ", "bind", " ", "the", " ", "interpolants"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eqR\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ReqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<eqD\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DeltaeqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"bg", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", 
         RowBox[{"bg", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", 
         RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}]}], ",", 
        RowBox[{"\"\<eps\>\"", "->", 
         RowBox[{"cg", "[", "\"\<eps\>\"", "]"}]}], ",", 
        RowBox[{"\"\<q0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<q0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<j0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<j0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", 
         RowBox[{"EhFn", "[", 
          RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}], "]"}]}]}], "|>"}]}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9965772810739937`*^9, 3.996577300952786*^9}, {
  3.996577333689823*^9, 3.996577386791966*^9}, {3.9965774750527782`*^9, 
  3.996577488721834*^9}, {3.996579377334917*^9, 3.9965793792631397`*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"07f0a82a-140e-4a49-8476-30a29d32d4f5"]
}, Closed]],

