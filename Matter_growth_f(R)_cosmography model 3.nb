Cell[CellGroupData[{

Cell["Confirming (numerically) equations and Q(z)", "Subsubsection",
 CellChangeTimes->{{3.9972608611359367`*^9, 3.9972608645159082`*^9}, {
  3.997261782721047*^9, 
  3.997261795171447*^9}},ExpressionUUID->"25d10911-fdf7-4c84-b401-\
d2ac4656b37b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"To", " ", "confirm", " ", "that", " ", "the", " ", "Q", 
    RowBox[{"(", "z", ")"}], " ", "above", " ", "is", " ", "calcualted", " ", 
    "correctly"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"PertResidual", "[", 
     RowBox[{"model_String", ",", "dataset_String", ",", "lab_", ",", 
      RowBox[{"kp_", "?", "NumericQ"}], ",", 
      RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Dl", ",", "qv", ",", "x", ",", "S", ",", "p", ",", "lhs", ",", 
        "rhs"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Dl", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
          "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qv", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
             "]"}], "[", "dataset", "]"}], "[", "lab", "]"}], "[", 
          "\"\<q\>\"", "]"}], "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
             "]"}], "[", "dataset", "]"}], "[", "lab", "]"}], "[", 
          "\"\<x\>\"", "]"}], "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"S", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
          RowBox[{"Dl", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"QParts", "[", 
         RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lhs", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}], " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
           RowBox[{"Dl", "[", "zv", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "zv"}], ")"}], "^", "2"}], " ", 
          RowBox[{
           RowBox[{"p", "[", "\"\<d2\>\"", "]"}], "/", 
           RowBox[{"Dl", "[", "zv", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "qv", "-", "x"}], ")"}], " ", "S"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rhs", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}], " ", 
         RowBox[{"p", "[", "\"\<\[CapitalOmega]m\>\"", "]"}], " ", 
         RowBox[{"p", "[", "\"\<Q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"lhs", "-", "rhs"}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "lhs", "]"}], ",", 
          RowBox[{"Abs", "[", "rhs", "]"}], ",", "$MinMachineNumber"}], 
         "]"}]}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.997258858715939*^9, {3.997258904007265*^9, 3.997259024833378*^9}, {
