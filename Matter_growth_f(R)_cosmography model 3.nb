  3.995339866569749*^9}},ExpressionUUID->"1190c19a-b75f-4041-8fee-\
74b64c424905"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"helper", ":", 
    RowBox[{
    "contiguous", " ", "index", " ", "runs", " ", "of", " ", 
     "\"\<Physical\>\"", " ", "points", " ", "in", " ", "a", " ", "results", 
     " ", "list"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PhysicalRuns", "[", "results_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "idx", "}"}], ",", 
      RowBox[{
       RowBox[{"idx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"results", ",", 
           RowBox[{"r_", "/;", 
            RowBox[{
             RowBox[{"r", "[", "\"\<label\>\"", "]"}], "===", 
             "\"\<Physical\>\""}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"idx", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Split", "[", 
          RowBox[{"idx", ",", 
           RowBox[{
            RowBox[{"#2", "==", 
             RowBox[{"#1", "+", "1"}]}], "&"}]}], "]"}]}], "]"}]}]}], "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{3.995242263862509*^9},
 CellLabel->
  "In[127]:=",ExpressionUUID->"eda73ff5-6509-4933-a115-0c3e9c4b518d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"(*", 
    RowBox[{"default", "-", 
     RowBox[{"zi", " ", "overload"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SweepXInitial", "[", 
      RowBox[{"model_String", ",", "dataset_String", ",", "zinitial_", ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"SweepXInitial", "[", 
      RowBox[{"model", ",", "dataset", ",", "zinitial", ",", "opts"}], 
      "]"}]}], ";"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SweepXInitial", "[", 
     RowBox[{"model_String", ",", "dataset_String", ",", 
      RowBox[{"zi_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<NCoarse\>\"", "->", "100"}], ",", 
         RowBox[{"\"\<LogSpanBelow\>\"", "->", "3"}], ",", 
         RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
         RowBox[{"\"\<NRefine\>\"", "->", "150"}], ",", 
         RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
         RowBox[{"\"\<SingularTol\>\"", "->", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}], ",", 
         RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
         RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
         RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epsVal", ",", "j0Val", ",", "q0Val", ",", "nC", ",", "nR", ",", 
        "nSamp", ",", "singTol", ",", "pg", ",", "ag", ",", "wp", ",", 
        "coarseRange", ",", "nTot", ",", "coarseResults", ",", "runs", ",", 
        "refined", ",", "allPts"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"j0Val", "=", 
        RowBox[{"allParams", "[", 
         RowBox[{
         "model", ",", " ", "dataset", ",", " ", "\"\<j0\>\"", ",", " ", 
          "\"\<mean\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"q0Val", "=", 
        RowBox[{"allParams", "[", 
         RowBox[{
         "model", ",", " ", "dataset", ",", " ", "\"\<q0\>\"", ",", " ", 
          "\"\<mean\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"nC", "=", 
        RowBox[{"OptionValue", "[", "\"\<NCoarse\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nR", "=", 
        RowBox[{"OptionValue", "[", "\"\<NRefine\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nSamp", "=", 
        RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singTol", "=", 
        RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pg", "=", 
        RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ag", "=", 
        RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wp", "=", 
        RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coarseRange", "=", 
        RowBox[{"AutoC2Range", "[", 
         RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi", ",", 
          RowBox[{"\"\<NPerSign\>\"", "->", "nC"}], ",", 
          RowBox[{"\"\<LogSpanBelow\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}], ",", 
          RowBox[{"\"\<LogSpanAbove\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"coarseRange", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
            RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
            RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
            RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
            RowBox[{"\"\<nCoarse\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<nRefined\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<c2Window\>\"", "->", "None"}], ",", 
            RowBox[{"\"\<windows\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<table\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{
            "\"\<note\>\"", "->", "\"\<Degenerate fixed point\>\""}]}], 
           "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"nTot", "=", 
        RowBox[{"Length", "[", "coarseRange", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coarseResults", "=", 
        RowBox[{"ScanICs", "[", 
         RowBox[{
         "model", ",", "dataset", ",", "coarseRange", ",", "zi", ",", 
          RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
          RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}], ",", 
          RowBox[{"\"\<PrecisionGoal\>\"", "->", "pg"}], ",", 
          RowBox[{"\"\<AccuracyGoal\>\"", "->", "ag"}], ",", 
          RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"runs", "=", 
        RowBox[{"PhysicalRuns", "[", "coarseResults", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"runs", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
            RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
            RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
            RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
            RowBox[{"\"\<nCoarse\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<nRefined\>\"", "->", "0"}], ",", 
            RowBox[{"\"\<c2Window\>\"", "->", "None"}], ",", 
            RowBox[{"\"\<windows\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<table\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{
            "\"\<note\>\"", "->", 
             "\"\<No Physical points in coarse pass\>\""}]}], "|>"}], "]"}]}],
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"refined", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"lo", ",", "hi", ",", "rng", ",", "res", ",", "phys"}], 
             "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"lo", "=", 
              RowBox[{"coarseRange", "[", 
               RowBox[{"[", 
                RowBox[{"Max", "[", 
                 RowBox[{"1", ",", 
                  RowBox[{
                   RowBox[{"First", "[", "run", "]"}], "-", "1"}]}], "]"}], 
                "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"hi", "=", 
              RowBox[{"coarseRange", "[", 
               RowBox[{"[", 
                RowBox[{"Min", "[", 
                 RowBox[{"nTot", ",", 
                  RowBox[{
                   RowBox[{"Last", "[", "run", "]"}], "+", "1"}]}], "]"}], 
                "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"rng", "=", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"lo", ",", "hi", ",", 
                RowBox[{"nR", "-", "1"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"res", "=", 
              RowBox[{"ScanICs", "[", 
               RowBox[{"model", ",", "dataset", ",", "rng", ",", "zi", ",", 
                RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
                RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}], ",", 
                RowBox[{"\"\<PrecisionGoal\>\"", "->", "pg"}], ",", 
                RowBox[{"\"\<AccuracyGoal\>\"", "->", "ag"}], ",", 
                RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}]}], "]"}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"phys", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"res", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", "\"\<label\>\"", "]"}], "===", 
                  "\"\<Physical\>\""}], "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<bracket\>\"", "->", 
                RowBox[{"{", 
                 RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
               RowBox[{"\"\<nPhysical\>\"", "->", 
                RowBox[{"Length", "[", "phys", "]"}]}], ",", 
               RowBox[{"\"\<c2Window\>\"", "->", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"phys", "===", 
                   RowBox[{"{", "}"}]}], ",", "None", ",", 
                  RowBox[{"MinMax", "[", 
                   RowBox[{"phys", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<c2\>\""}], "]"}], "]"}], "]"}]}],
                  "]"}]}], ",", 
               RowBox[{"\"\<points\>\"", "->", 
                RowBox[{"Map", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<c2\>\"", "->", 
                    RowBox[{"#", "[", "\"\<c2\>\"", "]"}]}], ",", 
                    RowBox[{"\"\<xi\>\"", "->", 
                    RowBox[{"#", "[", "\"\<xi\>\"", "]"}]}], ",", 
                    RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", 
                    RowBox[{"#", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], 
                    ",", 
                    RowBox[{"\"\<xToday\>\"", "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<sampleData\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<x\>\"", "]"}]}],
                     ",", 
                    RowBox[{"\"\<\[CapitalOmega]Today\>\"", "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<sampleData\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", 
                    "\"\<\[CapitalOmega]\>\"", "]"}]}]}], "|>"}], "&"}], ",", 
                  "phys"}], "]"}]}]}], "|>"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"run", ",", "runs"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"allPts", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"refined", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<points\>\""}], "]"}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
         RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<found\>\"", "->", 
          RowBox[{
           RowBox[{"Length", "[", "allPts", "]"}], ">", "0"}]}], ",", 
         RowBox[{"\"\<nCoarse\>\"", "->", 
          RowBox[{"Total", "[", 
           RowBox[{"Length", "/@", "runs"}], "]"}]}], ",", 
         RowBox[{"\"\<nRefined\>\"", "->", 
          RowBox[{"Length", "[", "allPts", "]"}]}], ",", 
         RowBox[{"\"\<nRuns\>\"", "->", 
          RowBox[{"Length", "[", "runs", "]"}]}], ",", 
         RowBox[{"\"\<c2Window\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"allPts", "===", 
             RowBox[{"{", "}"}]}], ",", "None", ",", 
            RowBox[{"MinMax", "[", 
             RowBox[{"allPts", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "\"\<c2\>\""}], "]"}], "]"}], "]"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<windows\>\"", "->", 
          RowBox[{"refined", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<c2Window\>\""}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<table\>\"", "->", "allPts"}]}], "|>"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.995242252411597*^9, 3.9952422664915543`*^9}, {
   3.995242454407665*^9, 3.995242457199786*^9}, {3.995242617645055*^9, 
