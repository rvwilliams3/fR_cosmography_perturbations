  3.998357740739369*^9}},ExpressionUUID->"6682110b-245a-4b6a-9c26-\
03e396e2ebf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBand", "[", 
    RowBox[{
    "model_String", ",", "bandAssoc_Association", ",", "ylab_String", ",", 
     RowBox[{"legendPos_", ":", 
      RowBox[{"{", 
       RowBox[{"0.6", ",", "0.25"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dsets", ",", "cols", ",", "bands", ",", "means"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dsets", "=", 
       RowBox[{"Keys", "[", "bandAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cols", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", "97", "]"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "dsets", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bands", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
