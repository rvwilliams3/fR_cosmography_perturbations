Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Scale", " ", 
      RowBox[{"conversion", ":", " ", "khat"}]}], "=", 
     RowBox[{"k", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{"a0", " ", "H0"}], ")"}]}]}]}], ",", 
    RowBox[{"H0", "=", 
     RowBox[{"100", " ", "h", " ", 
      RowBox[{
       RowBox[{"km", "/", "s"}], "/", 
       RowBox[{"Mpc", ".", " ", "With"}]}], " ", "k", " ", "in", " ", 
      RowBox[{"h", "/", "Mpc"}]}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "h", " ", 
      RowBox[{"cancels", ":", " ", "khat"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}], "*", 
       RowBox[{"c", "/", "100"}]}], "=", 
      RowBox[{"2997.92", "*", 
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"3", "*", 
      SuperscriptBox["10", "5"]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"c", " ", "in", " ", 
     RowBox[{"km", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"kPhys", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.1", ",", "0.2"}], "}"}]}], ";"}], 
   "              ", 
   RowBox[{"(*", 
    RowBox[{"h", " ", 
     RowBox[{"Mpc", "^", 
      RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khatVals", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"c", " "}], "100"], "kPhys"}]}], ";"}], "                    ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{"29.98", ",", "89.94", ",", "299.79", ",", "599.58"}], "}"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"kLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<k = \>\"", ",", "#", ",", "\"\< h Mpc\>\"", ",", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<\>\"", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
      "kPhys"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.996674875849108*^9, 3.996674906121173*^9}},
 CellLabel->
  "In[303]:=",ExpressionUUID->"4e764064-9879-4801-9962-04c14dc9ed29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolvePerturbations", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<PrecisionGoal\>\"", "->", "8"}], ",", 
        RowBox[{"\"\<AccuracyGoal\>\"", "->", "8"}]}], "}"}], "]"}]}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sys", ",", "ics", ",", "zi", ",", "sol", ",", "DeltaFn", ",", "RFn"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"sys", "=", 
       RowBox[{"BuildPertSystem", "[", 
        RowBox[{"model", ",", "dataset", ",", "idx", ",", "khatVal"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ics", "=", 
       RowBox[{"BuildPertICs", "[", 
        RowBox[{"model", ",", "dataset", ",", "sys"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zi", "=", 
       RowBox[{"ics", "[", "\"\<zi\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sys", "[", "\"\<eqD\>\"", "]"}], ",", 
           RowBox[{"sys", "[", "\"\<eqR\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<\[CapitalDelta]i\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[CapitalDelta]", "'"}], "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<\[CapitalDelta]primei\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[ScriptCapitalR]hat", "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<Ri\>\"", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[ScriptCapitalR]hat", "'"}], "[", "zi", "]"}], "==", 
            RowBox[{"ics", "[", "\"\<Rprimei\>\"", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CapitalDelta]", ",", "\[ScriptCapitalR]hat"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", 
          RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ",", 
         RowBox[{"AccuracyGoal", "->", 
          RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"sol", ",", 
           RowBox[{"{", 
            RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{"\[CapitalDelta]", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"RFn", "=", 
       RowBox[{"\[ScriptCapitalR]hat", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]\>\"", "->", "DeltaFn"}], ",", 
        RowBox[{"\"\<\[ScriptCapitalR]hat\>\"", "->", "RFn"}], ",", 
        RowBox[{"\"\<domainEnd\>\"", "->", 
         RowBox[{
          RowBox[{"DeltaFn", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<label\>\"", "->", 
         RowBox[{"sys", "[", "\"\<label\>\"", "]"}]}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"sys", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<ics\>\"", "->", "ics"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998377250560486*^9, 3.998377250562282*^9}},
 CellLabel->
  "In[307]:=",ExpressionUUID->"f0a7179f-1cc2-4154-b102-e03a8e24951b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveAllPerturbations", "[", 
    RowBox[{"model_String", ",", "datasets_List", ",", "khatList_List", ",", 
     RowBox[{"nIdx_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"dataset", "->", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "label", "}"}], ",", 
            RowBox[{
             RowBox[{"label", "=", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"bgRun", "[", "model", "]"}], "[", 
                  "\"\<bgResults\>\"", "]"}], "[", "dataset", "]"}], "]"}], 
               "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"label", "->", 
              RowBox[{"Association", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"kp", ",", "khv"}], "}"}], ",", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "r", "}"}], ",", 
                    RowBox[{
                    RowBox[{"r", "=", 
                    RowBox[{"SolvePerturbations", "[", 
                    RowBox[{"model", ",", "dataset", ",", "i", ",", "khv"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"r", "===", "$Failed"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "dataset", ",", "\"\<  |  \>\"", ",", "label", ",", 
                    "\"\<  |  k = \>\"", ",", "kp", ",", 
                    "\"\< h/Mpc  (khat = \>\"", ",", "khv", ",", 
                    "\"\<):  FAILED\>\""}], "}"}], "]"}], ",", "Red"}], "]"}],
                     "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"kp", "->", "r"}]}]}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"kPhys", ",", "khatList"}], "}"}]}], "]"}], 
               "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"nIdx", "===", "Automatic"}], ",", 
              RowBox[{"Length", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"bgRun", "[", "model", "]"}], "[", 
                 "\"\<bgResults\>\"", "]"}], "[", "dataset", "]"}], "]"}], 
              ",", "nIdx"}], "]"}]}], "}"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99836500575449*^9, 3.998365031449869*^9}, 
   3.998367361083074*^9},
 CellLabel->
  "In[309]:=",ExpressionUUID->"490981ac-c449-41a6-9d4f-88f6d9761979"],

