Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotQScales", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lab", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Keys", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
           "]"}], "[", "dataset", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QParts", "[", 
            RowBox[{
            "model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
            "]"}], "[", "\"\<Q\>\"", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"zv", ",", "0", ",", "10"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<z\>\"", ",", "\"\<Q(z)\>\""}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
       ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{"kLabels", ",", 
            RowBox[{"LegendFunction", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Background", "->", "White"}], ",", 
                 RowBox[{"FrameStyle", "->", 
                  RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", 
                 RowBox[{"RoundingRadius", "->", "3"}]}], "]"}], "&"}], 
              ")"}]}], ",", 
            RowBox[{"LegendMarkerSize", "->", "20"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.78", ",", "0.7"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "500"}], ",", 
       RowBox[{"PlotLabel", "->", "dataset"}]}], "]"}]}], "]"}]}], 
