Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "zi", ",", "ic", ",", "xi", ",", 
       "\[CapitalOmega]i", ",", "qi", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd", ",", "wp", ",", "q0Val", ",", 
       "j0Val"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", "30"}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"qSolPlanckSets3", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zi", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]i", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}], ",", "wp"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"qi", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "14"}], ",", 
               RowBox[{"AccuracyGoal", "->", "14"}], ",", 
               RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], ",", 
        RowBox[{"\"\<qi\>\"", "->", "qi"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953427219563*^9, 3.99534275611684*^9}, {
   3.9953464884480033`*^9, 3.995346488690901*^9}, {3.995346702465871*^9, 
   3.995346704343001*^9}, 3.9953467417432957`*^9, {3.995347706655174*^9, 
   3.99534774703548*^9}, {3.9953480832919803`*^9, 3.995348257670144*^9}, {
   3.995600668737981*^9, 3.9956006742782993`*^9}, {3.995600725939093*^9, 
   3.995600840228261*^9}, 3.995600874182691*^9, 3.99560102012549*^9, {
   3.995601064504258*^9, 3.9956010955772743`*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"f958fc57-2cd7-416a-9884-2ad67d7c1bab"],

