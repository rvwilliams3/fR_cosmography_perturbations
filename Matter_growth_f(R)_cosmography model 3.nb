Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GammaFn", "[", 
    RowBox[{"dataset_", ",", "label_", ",", "kp_"}], "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"DeltaFn", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}],
           "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ",", 
       RowBox[{"OmmFn", "=", 
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "\"\<Model 3\>\"", "]"}], "[", "dataset",
          "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Function", "[", 
      RowBox[{"z", ",", 
       FractionBox[
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "+", "z"}], ")"}]}], " ", 
          FractionBox[
           RowBox[{
            RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], 
           RowBox[{"DeltaFn", "[", "z", "]"}]]}], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"OmmFn", "[", "z", "]"}], "]"}]]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996652242357788*^9, 3.996652250261537*^9}, {
  3.996652429707982*^9, 3.9966524948144617`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"ecbb66c1-4efc-40fd-9e2b-46e61e69d8eb"],

