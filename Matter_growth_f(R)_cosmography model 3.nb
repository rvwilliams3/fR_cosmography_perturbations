 CellLabel->"In[73]:=",ExpressionUUID->"a03fadee-e520-497a-846a-ad3eaf9f5130"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Amatch", "[", 
    RowBox[{"\[Epsilon]val_", ",", " ", "q0val_"}], "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"3", "\[Epsilon]val"}], "-", "2", "-", 
