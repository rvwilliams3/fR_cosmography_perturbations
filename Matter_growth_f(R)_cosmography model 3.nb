Cell[TextData[{
 "Using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[CapitalOmega]", "m"], "\[Gamma]"], 
     RowBox[{
      SuperscriptBox["Q", "\[Eta]"], ":"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c29407f-d6d2-4f08-95cc-0df4e70ed931"],
 "\n\t Log(S) = \[Gamma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "(", 
    SubscriptBox["\[CapitalOmega]", "m"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f96f432-8621-424f-897b-d4a701073fa9"],
 " + \[Eta] ",
