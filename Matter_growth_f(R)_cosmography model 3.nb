             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<F(\>\"", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", "\"\<init\>\""}], "]"}], ",", 
                "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}], ",", 
        RowBox[{"Background", "->", 
         RowBox[{"{", 
