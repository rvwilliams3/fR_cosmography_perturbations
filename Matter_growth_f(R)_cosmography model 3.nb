     RowBox[{"e", ".", "g", ".", "x_i"}], "=", 
     RowBox[{
      RowBox[{"-", "3.32"}], "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"XiLabel", "[", "sol_", "]"}], ":=", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", "\"\< = \>\"", 
      ",", 
      RowBox[{"ScientificForm", "[", 
       RowBox[{
        RowBox[{"N", "@", 
