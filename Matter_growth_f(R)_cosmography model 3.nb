          RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"LogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
