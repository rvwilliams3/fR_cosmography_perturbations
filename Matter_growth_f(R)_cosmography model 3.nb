Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DTableAtZ", "[", 
     RowBox[{"zval_", ":", "10"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rows", "}"}], ",", 
      RowBox[{
       RowBox[{"rows", "=", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"byK", ",", "vals"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"byK", "=", 
                RowBox[{
                 RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"vals", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "zval", "]"}], "/", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "0", "]"}]}], ",", 
                  
                  RowBox[{"{", 
                   RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"dataset", ",", "label"}], "}"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"NumberForm", "[", 
