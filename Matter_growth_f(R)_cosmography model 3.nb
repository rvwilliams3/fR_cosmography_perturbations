   3.9914719879513206`*^9}, {3.991707403008647*^9, 3.991707403266122*^9}, {
   3.991707498576212*^9, 3.991707558737364*^9}, {3.9953345037878532`*^9, 
   3.995334565691124*^9}, {3.995334605181372*^9, 3.9953346063637943`*^9}, 
