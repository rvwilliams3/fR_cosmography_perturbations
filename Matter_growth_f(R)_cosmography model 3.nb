   RowBox[{
    RowBox[{"kPhys", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.1", ",", "0.2"}], "}"}]}], ";"}], 
   "              ", 
   RowBox[{"(*", 
    RowBox[{"h", " ", 
     RowBox[{"Mpc", "^", 
      RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khatVals", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"c", " "}], "100"], "kPhys"}]}], ";"}], "                    ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{"29.98", ",", "89.94", ",", "299.79", ",", "599.58"}], "}"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"kLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<k = \>\"", ",", "#", ",", "\"\< h Mpc\>\"", ",", 
          RowBox[{"Superscript", "[", 
