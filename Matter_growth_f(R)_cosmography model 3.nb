Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Checking", " ", "that", " ", "Rhat", " ", "is", " ", "correct", " ", "in",
     " ", "GR", " ", "limit"}], "*)"}], 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"grLimit", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ReqnSolveDust", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", "0"}], ",", 
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"1", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "1"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", 
          RowBox[{
           RowBox[{"-", "7"}], "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", 
          RowBox[{"35", "/", "2"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", "1"}]}], "}"}]}], 
      "//", "Cancel"}]}], ",", " ", 
    RowBox[{"z", ">=", "0"}]}], "]"}]}]], "Input",
