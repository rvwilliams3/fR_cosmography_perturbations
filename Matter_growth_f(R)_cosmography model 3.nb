Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QParts", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "lab_", ",", 
     RowBox[{"kp_", "?", "NumericQ"}], ",", 
     RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bg", ",", "pr", ",", "Dl", ",", "Rh", ",", "khat", ",", "S", ",", "T", 
       ",", "x", ",", "Om", ",", "qv", ",", "Eh", ",", "j", ",", "s", ",", 
       "Ommat", ",", "fR", ",", "DD", ",", "M", ",", "P", ",", "\[Tau]", ",", 
       "brk", ",", "A3", ",", "A4", ",", "d2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bg", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
          "]"}], "[", "dataset", "]"}], "[", "lab", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
        "[", "kp", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Dl", "=", 
       RowBox[{"pr", "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ";", 
      RowBox[{"Rh", "=", 
       RowBox[{"pr", "[", "\"\<\[ScriptCapitalR]hat\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"khat", "=", 
       RowBox[{"pr", "[", "\"\<khat\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<x\>\"", "]"}], "[", "zv", "]"}]}], ";", 
      RowBox[{"Om", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "[", "zv", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qv", "=", 
       RowBox[{
        RowBox[{"bg", "[", "\"\<q\>\"", "]"}], "[", "zv", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Eh", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", "s"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
            "[", "\"\<j\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
            "[", "\"\<s\>\"", "]"}]}], "}"}], "/.", " ", 
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", "qv"}]}], "/.", " ", 
        RowBox[{"z", "->", "zv"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Ommat", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zv", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fR", "=", 
       RowBox[{"Ommat", "/", "Om"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DD", "=", 
       RowBox[{"j", "-", "qv", "-", "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Dl", "'"}], "[", "zv", "]"}], "/", 
         RowBox[{"Dl", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"T", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Rh", "'"}], "[", "zv", "]"}], "/", 
         RowBox[{"Rh", "[", "zv", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"M", "=", 
       FractionBox[
        RowBox[{
         SuperscriptBox["khat", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}], "2"], "x"}], 
        RowBox[{"6", " ", "DD", " ", 
         SuperscriptBox["Eh", "2"]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{
        SuperscriptBox["j", "2"], "-", 
        RowBox[{"8", " ", "x"}], "-", 
        RowBox[{"s", " ", "x"}], "-", 
        RowBox[{
         SuperscriptBox["qv", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "x"}]}], ")"}]}], "+", 
        RowBox[{"6", " ", "Om"}], "+", 
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "qv"}], ")"}], " ", "x"}], "-", 
           RowBox[{"3", " ", "Om"}]}], ")"}]}], "+", 
        RowBox[{"qv", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "-", 
           RowBox[{"11", " ", "x"}], "+", 
           RowBox[{"3", " ", "Om"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A3", "=", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["khat", "2"], " ", "x"}], 
           RowBox[{"6", " ", "DD", " ", 
            SuperscriptBox["Eh", "4"]}]], "+", 
          FractionBox["P", 
           RowBox[{"2", " ", 
            SuperscriptBox["DD", "2"], " ", 
            SuperscriptBox["Eh", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", "zv"}], ")"}], "2"]}]]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A4", "=", 
       FractionBox["x", 
        RowBox[{"2", " ", "DD", " ", 
         SuperscriptBox["Eh", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zv"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d2", "=", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"qv", "+", "x"}], ")"}]}], 
          RowBox[{"(", 
           RowBox[{"1", "+", "zv"}], ")"}]], " ", 
         RowBox[{
          RowBox[{"Dl", "'"}], "[", "zv", "]"}]}], "+", 
        RowBox[{
         FractionBox[
          RowBox[{"3", " ", "Om", " "}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "zv"}], ")"}], "2"]], 
         RowBox[{"Dl", "[", "zv", "]"}]}], "+", 
        RowBox[{"A3", " ", 
         RowBox[{"Rh", "[", "zv", "]"}]}], "+", 
        RowBox[{"A4", " ", 
         RowBox[{
          RowBox[{"Rh", "'"}], "[", "zv", "]"}]}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", "''"}], " ", "equation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[Tau]", "=", 
       RowBox[{
        RowBox[{"Rh", "[", "zv", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"3", " ", 
          RowBox[{"Eh", "^", "2"}], " ", "Ommat", " ", 
          RowBox[{"Dl", "[", "zv", "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"brk", "=", 
       RowBox[{
        RowBox[{"2", " ", "M"}], "+", 
        RowBox[{"P", "/", 
         RowBox[{"DD", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", " ", "T"}], ")"}], "/", "DD"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "->", "S"}], ",", 
        RowBox[{"\"\<T\>\"", "->", "T"}], ",", 
        RowBox[{"\"\<\[Tau]\>\"", "->", "\[Tau]"}], ",", 
        RowBox[{"\"\<M\>\"", "->", "M"}], ",", 
        RowBox[{"\"\<fR\>\"", "->", "fR"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]m\>\"", "->", "Ommat"}], ",", 
        RowBox[{"\"\<d2\>\"", "->", "d2"}], ",", 
        RowBox[{"\"\<Qgrav\>\"", "->", 
         RowBox[{"2", "/", "fR"}]}], ",", 
        RowBox[{"\"\<Qcurv\>\"", "->", 
         RowBox[{
          RowBox[{"-", "\[Tau]"}], " ", "brk"}]}], ",", 
        RowBox[{"\"\<Q\>\"", "->", 
         RowBox[{
          RowBox[{"2", "/", "fR"}], "-", 
          RowBox[{"\[Tau]", " ", "brk"}]}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9972601502662697`*^9, 3.997260158204157*^9}, {
  3.9972606144459133`*^9, 3.9972607343238473`*^9}, {3.997261108991887*^9, 
