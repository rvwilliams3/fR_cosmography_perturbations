Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Amatch", "[", 
    RowBox[{"\[Epsilon]val_", ",", " ", "q0val_"}], "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"3", "\[Epsilon]val"}], "-", "2", "-", 
     RowBox[{"2", "q0val"}]}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"\[Epsilon]val", "-", "1"}], ")"}]}]]}], ";"}]], "Input",
