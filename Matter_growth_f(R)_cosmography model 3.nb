Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "zi", ",", "ic", ",", "xi", ",", 
       "\[CapitalOmega]i", ",", "qi", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd", ",", "wp", ",", "q0Val", ",", 
       "j0Val"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", "30"}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"\"\<q0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"\"\<j0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"qSolPlanckSets3", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zi", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]i", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}], ",", "wp"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"qi", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"q", "[", "z_", "]"}], "=", 
           RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[Epsilon]", "=", 
           RowBox[{"EpsFast", "[", 
            RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "14"}], ",", 
               RowBox[{"AccuracyGoal", "->", "14"}], ",", 
               RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "zi"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<x0\>\"", "->", "xi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]0\>\"", "->", "\[CapitalOmega]i"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "qi"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953427219563*^9, 3.99534275611684*^9}, {
   3.9953464884480033`*^9, 3.995346488690901*^9}, {3.995346702465871*^9, 
   3.995346704343001*^9}, 3.9953467417432957`*^9, {3.995347706655174*^9, 
   3.99534774703548*^9}, {3.9953480832919803`*^9, 3.995348257670144*^9}},
 CellLabel->
