Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotQ", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"qa", ",", "dsets"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qa", "=", 
       RowBox[{"qAssocByModel", "[", "model", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dsets", "=", 
       RowBox[{"Keys", "[", "qa", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"qa", "[", "d", "]"}], "[", "z", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "dsets"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"dsets", ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"LegendLayout", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<Column\>\"", ",", "2"}], "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.55", ",", "0.25"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<q(z)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotLabel", "->", "model"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
