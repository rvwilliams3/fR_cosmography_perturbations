     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "+", "1"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
