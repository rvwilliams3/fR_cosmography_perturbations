Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Load", " ", "raw", " ", "MCMC", " ", 
     RowBox[{"observables", ".", "eps"}], " ", "is", " ", "NOT", " ", 
     "stored", " ", "as", " ", "an", " ", "independent", " ", "parameter"}], 
    "-", 
    RowBox[{"it", " ", "is", " ", "derived", " ", "from", " ", 
     RowBox[{"(", 
      RowBox[{"q0", ",", "j0"}], ")"}], " ", "via", " ", "the", " ", 
     "closure", " ", 
     RowBox[{"relation", ".", "eps_mean"}], " ", "from", " ", "the", " ", 
     "CSV", " ", "is", " ", "kept", " ", "only", " ", "as", " ", 
     "\"\<epsMC\>\"", " ", "for", " ", "cross"}], "-", 
    RowBox[{"checking", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"BuildModelParamRanges", "[", "file_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "header", ",", "rows"}], "}"}], ",", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"file", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"header", "=", 
        RowBox[{"First", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Rest", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"row", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"assocFull", ",", "datasetName", ",", "mkRange"}], 
               "}"}], ",", 
              RowBox[{
               RowBox[{"assocFull", "=", 
                RowBox[{"AssociationThread", "[", 
                 RowBox[{"header", "->", "row"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"datasetName", "=", 
                RowBox[{"assocFull", "[", "\"\<dataset\>\"", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"mkRange", "[", "base_String", "]"}], ":=", 
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"mean", ",", "plusErr", ",", "minusErr"}], "}"}], 
                  ",", 
                  RowBox[{
                   RowBox[{"mean", "=", 
                    RowBox[{"assocFull", "[", 
                    RowBox[{"base", "<>", "\"\<_mean\>\""}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"plusErr", "=", 
                    RowBox[{"assocFull", "[", 
                    RowBox[{"base", "<>", "\"\<_plus\>\""}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"minusErr", "=", 
                    RowBox[{"assocFull", "[", 
                    RowBox[{"base", "<>", "\"\<_minus\>\""}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<mean\>\"", "->", "mean"}], ",", 
                    RowBox[{"\"\<min\>\"", "->", 
                    RowBox[{"mean", "-", "minusErr"}]}], ",", 
                    RowBox[{"\"\<max\>\"", "->", 
                    RowBox[{"mean", "+", "plusErr"}]}]}], "|>"}]}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
               RowBox[{"datasetName", "->", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<q0\>\"", "->", 
                   RowBox[{"mkRange", "[", "\"\<q0\>\"", "]"}]}], ",", 
                  RowBox[{"\"\<j0\>\"", "->", 
                   RowBox[{"mkRange", "[", "\"\<j0\>\"", "]"}]}], ",", 
                  RowBox[{"\"\<Om0\>\"", "->", 
                   RowBox[{"mkRange", "[", "\"\<Om0\>\"", "]"}]}], ",", 
                  RowBox[{"\"\<epsMC\>\"", "->", 
                   RowBox[{"mkRange", "[", "\"\<eps\>\"", "]"}]}]}], 
                 "|>"}]}]}]}], "]"}]}], "]"}], ",", "rows"}], "]"}], 
        "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"b5626d63-a40f-4b86-bed6-6dade7d2c680"],

