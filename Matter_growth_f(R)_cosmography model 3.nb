Cell[CellGroupData[{

Cell["Determine c2 range", "Subsubsection",
 CellChangeTimes->{{3.995339846683264*^9, 
  3.995339849718623*^9}},ExpressionUUID->"46c80304-e63f-4cdc-a1d5-\
77d4150a366e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AutoC2Scale", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fp", ",", "classified"}], "}"}], ",", 
     RowBox[{
      RowBox[{"fp", "=", 
       RowBox[{"MatterDominatedFPEps", "[", 
        RowBox[{"model", ",", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"classified", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"classified", "===", "$Failed"}], ",", "$Failed", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "zi"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", 
           RowBox[{"classified", "[", "\"\<lambdaXOmega\>\"", "]"}]}], 
          ")"}]}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085328072864*^9, 3.995085335534656*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"ef99ccbd-d995-449e-a3f9-6608c3a4f184"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AutoC2Range", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LogSpanBelow\>\"", "->", "4"}], ",", 
        RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<NPerSign\>\"", "->", "40"}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scale", ",", "expMin", ",", "expMax", ",", "positive"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"scale", "=", 
       RowBox[{"AutoC2Scale", "[", 
        RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"scale", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMin", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "-", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMax", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "+", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"positive", "=", 
       RowBox[{"10", "^", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"expMin", ",", "expMax", ",", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<NPerSign\>\"", "]"}], "-", 
           "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Reverse", "[", "positive", "]"}]}], ",", "positive"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085336897839*^9, 3.995085338852072*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"3a5d3f0c-d2ed-4214-b63f-361adca2a042"]
}, Closed]],

Cell[CellGroupData[{

Cell["Determine physical results", "Subsubsection",
 CellChangeTimes->{{3.995339859835041*^9, 
  3.995339866569749*^9}},ExpressionUUID->"1190c19a-b75f-4041-8fee-\
74b64c424905"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"helper", ":", 
    RowBox[{
    "contiguous", " ", "index", " ", "runs", " ", "of", " ", 
     "\"\<Physical\>\"", " ", "points", " ", "in", " ", "a", " ", "results", 
     " ", "list"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PhysicalRuns", "[", "results_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "idx", "}"}], ",", 
      RowBox[{
       RowBox[{"idx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"results", ",", 
           RowBox[{"r_", "/;", 
            RowBox[{
             RowBox[{"r", "[", "\"\<label\>\"", "]"}], "===", 
             "\"\<Physical\>\""}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"idx", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Split", "[", 
          RowBox[{"idx", ",", 
           RowBox[{
            RowBox[{"#2", "==", 
             RowBox[{"#1", "+", "1"}]}], "&"}]}], "]"}]}], "]"}]}]}], "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{3.995242263862509*^9},
