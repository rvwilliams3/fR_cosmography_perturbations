Cell[CellGroupData[{

Cell["Plotting with source matching values added", "Subsubsection",
 CellChangeTimes->{{3.995606727399263*^9, 3.995606732440528*^9}, {
  3.9972541812858553`*^9, 
  3.9972541817827044`*^9}},ExpressionUUID->"ec1c294c-29d1-4b0e-856b-\
a636cb346756"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"MakeFPlotSM", "[", 
     RowBox[{"dataset_", ",", "model_String", ",", 
      RowBox[{"zMax_", ":", "2"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sols", ",", "colors", ",", "Om0mean", ",", "Om0sm", ",", "curvesMean",
         ",", "curvesSM"}], "}"}], ",", 
      RowBox[{
       RowBox[{"sols", "=", 
        RowBox[{"SortedSols", "[", "dataset", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"colors", "=", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"Length", "[", "sols", "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Om0mean", "=", 
        RowBox[{"Om0MeanData", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Om0sm", "=", 
        RowBox[{"Om0SourceMatch", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curvesMean", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FOfz", "[", 
            RowBox[{"dataset", ",", "s", ",", "Om0mean"}], "]"}], "[", "z", 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curvesSM", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FOfz", "[", 
            RowBox[{"dataset", ",", "s", ",", "Om0sm"}], "]"}], "[", "z", 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"curvesMean", ",", "curvesSM"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zMax"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Join", "[", 
           RowBox[{"colors", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{"#", ",", "Dashed", ",", 
                RowBox[{"Thickness", "[", "0.002", "]"}]}], "]"}], "&"}], "/@",
              "colors"}]}], "]"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"LineLegend", "[", 
                RowBox[{"colors", ",", 
                 RowBox[{"XiLabel", "/@", "sols"}], ",", 
                 RowBox[{"LegendFunction", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Framed", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                    RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                   ")"}]}]}], "]"}], ",", 
               RowBox[{"LineLegend", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Directive", "[", "Gray", "]"}], ",", 
                   RowBox[{"Directive", "[", 
                    RowBox[{"Gray", ",", "Dashed", ",", 
                    RowBox[{"Thickness", "[", "0.002", "]"}]}], "]"}]}], 
                  "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(m0\)]\) = \
\>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", "Om0mean"}], ",", "5"}], "]"}], ",", 
                    "\"\< (MCMC)\>\""}], "}"}], "]"}], ",", 
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(m0\)]\) = \
\>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", "Om0sm"}], ",", "5"}], "]"}], ",", 
                    "\"\< (source match)\>\""}], "}"}], "]"}]}], "}"}], ",", 
                 RowBox[{"LegendFunction", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Framed", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                    RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                   ")"}]}]}], "]"}]}], "}"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.78", ",", "0.35"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<f '(R)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", "dataset", "]"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.995606624153158*^9, 3.995606678675617*^9}, {
  3.9956067699037523`*^9, 3.995606784157555*^9}, {3.995606819133096*^9, 
  3.995606871621099*^9}, {3.995606951479446*^9, 3.995606951673977*^9}, {
