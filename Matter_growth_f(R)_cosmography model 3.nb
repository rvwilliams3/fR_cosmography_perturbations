Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"SolveForOmegaM", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"params", ",", "Om0", ",", "EhSol"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"params", "=", 
        RowBox[{"allParams", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Om0", "=", 
        RowBox[{
         RowBox[{"params", "[", "\"\<Om0\>\"", "]"}], "[", "\"\<mean\>\"", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"EhSol", "=", 
        RowBox[{"EAssocByModel", "[", 
         RowBox[{"model", ",", " ", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Om0val", "=", "Om0"}], "}"}], ",", 
         RowBox[{"Function", "[", 
          RowBox[{"zval", ",", 
           RowBox[{"Om0val", "*", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "zval"}], ")"}], "^", "3"}], "/", 
             RowBox[{
              RowBox[{"EhSol", "[", "zval", "]"}], "^", "2"}]}]}]}], "]"}]}], 
        "]"}]}]}], "]"}]}], ";"}], "*)"}]], "Input",
