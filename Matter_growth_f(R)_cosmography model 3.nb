Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QOf", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"zv_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"QParts", "[", 
     RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
     "]"}], "[", "\"\<Q\>\"", "]"}]}], ";"}]], "Input",
