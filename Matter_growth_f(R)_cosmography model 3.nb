68b6317b6274"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeXOmegaTodayPlot", "[", 
    RowBox[{
    "model_String", ",", "ds_String", ",", "sweepResult_Association", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{"ImageSize", "->", "350"}], "}"}], "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"table", ",", "xiVals", ",", "x0Vals", ",", "Omega0Vals"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"sweepResult", "[", "\"\<found\>\"", "]"}]}], "||", 
         RowBox[{
          RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], "===", 
          RowBox[{"{", "}"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{"\"\<No viable points: \>\"", "<>", "ds"}], "]"}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"OptionValue", "[", "ImageSize", "]"}]}]}], "]"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"table", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiVals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0Vals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Omega0Vals", "=", 
       RowBox[{"table", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<\[CapitalOmega]Today\>\""}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xiVals", ",", "x0Vals"}], "}"}], "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xiVals", ",", "Omega0Vals"}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<x\[Null](0)\>\"", ",", 
               "\"\<\[CapitalOmega]\[Null](0)\>\""}], "}"}], ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.2", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(x\), \(\(i\)\(\\\ \)\)]\)= x(\>\"", "<>", 
            RowBox[{"ToString", "[", "zinitial", "]"}], "<>", "\"\<)\>\""}], 
           ",", "\"\<\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "5"}], ",", "5"}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"model", "<>", "\"\<, \>\"", "<>", "ds"}]}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"ImageSize", "->", 
         RowBox[{"OptionValue", "[", "ImageSize", "]"}]}], ",", 
        RowBox[{"AspectRatio", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"PlotMarkers", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", "Small"}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953418420395603`*^9, 3.995341844800688*^9}, {
  3.995342408474128*^9, 3.99534250921637*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"c87f072b-9fcd-4a71-b5ce-44386d294e11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xOmegaPlots", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeXOmegaTodayPlot", "[", 
      RowBox[{"model", ",", "#", ",", 
       RowBox[{"sweepResults", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
    "viablePlanckDatasets"}]}], ";"}]], "Input",
