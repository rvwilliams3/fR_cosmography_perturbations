        RowBox[{
         RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qpExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"dq", ",", " ", 
           RowBox[{
            RowBox[{"q", "'"}], "[", "z", "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"j", "[", "z", "]"}], "->", "jExpr"}]}]}], ";", 
