Cell[CellGroupData[{

Cell["Results", "Subsubsection",
 CellChangeTimes->{{3.995346574769201*^9, 3.9953465782355833`*^9}, {
  3.995346706596957*^9, 3.99534670706794*^9}, {3.995597073406927*^9, 
  3.995597073944547*^9}},ExpressionUUID->"083c5b23-dfa6-45cd-baa8-\
a62a21977816"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RunBackgroundForModel", "[", 
    RowBox[{"model_String", ",", "datasets_List", ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NPoints\>\"", ":>", "nPoints"}], ",", 
        RowBox[{"\"\<Print\>\"", "->", "True"}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nPts", ",", "doPrint", ",", "selectedAll", ",", "bgAll", ",", 
       "plotsAll"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nPts", "=", 
       RowBox[{"OptionValue", "[", "\"\<NPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"doPrint", "=", 
       RowBox[{"OptionValue", "[", "\"\<Print\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"selectedAll", "=", 
       RowBox[{"<|", "|>"}]}], ";", 
      RowBox[{"bgAll", "=", 
       RowBox[{"<|", "|>"}]}], ";", 
      RowBox[{"plotsAll", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "selected", ",", "bgRes", ",", "xiLabels", ",", "checkTable", ",", 
            "pX", ",", "pOmega"}], "}"}], ",", 
          RowBox[{
           RowBox[{"selected", "=", 
            RowBox[{"SelectEvenXi", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sweepResultsByModel", "[", "model", "]"}], "[", 
               "dataset", "]"}], ",", "nPts"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"selectedAll", "[", "dataset", "]"}], "=", "selected"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"selected", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"If", "[", 
              RowBox[{"doPrint", ",", 
               RowBox[{"Print", "[", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{
                  "model", "<>", "\"\<, \>\"", "<>", "dataset", "<>", 
                   "\"\<: no points with xToday >= \>\"", "<>", 
                   RowBox[{"ToString", "[", "xTodayThreshold", "]"}]}], ",", 
                  "Red"}], "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"(*", "else", "*)"}], 
             RowBox[{
              RowBox[{"bgRes", "=", 
               RowBox[{"Association", "[", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"Module", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "xi0", ",", "Omega0", ",", "label", ",", "calibratedICs", 
                    ",", "res"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"xi0", "=", 
                    RowBox[{"row", "[", "\"\<xi\>\"", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Omega0", "=", 
                    RowBox[{"row", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], 
                    ";", "\[IndentingNewLine]", 
                    RowBox[{"label", "=", 
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Subscript", "[", 
                    RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                    "\"\< = \>\"", ",", 
                    RowBox[{"ScientificForm", "[", 
                    RowBox[{"xi0", ",", "3"}], "]"}]}], "}"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"calibratedICs", "=", 
                    RowBox[{"<|", 
                    RowBox[{"dataset", "->", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<xIn\>\"", "->", "xi0"}], ",", 
                    RowBox[{"\"\<OmegaIn\>\"", "->", "Omega0"}]}], "|>"}]}], 
                    "|>"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"res", "=", 
                    RowBox[{"SolveBackground", "[", 
                    RowBox[{"model", ",", "dataset", ",", "calibratedICs"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"label", "->", "res"}]}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"row", ",", "selected"}], "}"}]}], "]"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"bgAll", "[", "dataset", "]"}], "=", "bgRes"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"xiLabels", "=", 
               RowBox[{"Keys", "[", "bgRes", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"pX", ",", "pOmega"}], "}"}], "=", 
               RowBox[{"PlotBackgroundSolutions", "[", 
                RowBox[{"model", ",", "bgRes", ",", "xiLabels"}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"plotsAll", "[", "dataset", "]"}], "=", 
               RowBox[{"{", 
                RowBox[{"pX", ",", "pOmega"}], "}"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"doPrint", ",", 
                RowBox[{
                 RowBox[{"checkTable", "=", 
                  RowBox[{"Grid", "[", 
                   RowBox[{
                    RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#1", "[", "\"\<xi\>\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"\<\[CapitalOmega]i\>\"", "]"}], ",", 
                    RowBox[{"#1", "[", "\"\<xToday\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"bgRes", "[", "#2", "]"}], "[", "\"\<x\>\"", 
                    "]"}], "[", "0", "]"}], ",", 
                    RowBox[{"#1", "[", "\"\<\[CapitalOmega]Today\>\"", "]"}], 
                    ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"bgRes", "[", "#2", "]"}], "[", 
                    "\"\<\[CapitalOmega]\>\"", "]"}], "[", "0", "]"}]}], 
                    "}"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"selected", ",", "xiLabels"}], "}"}]}], "]"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<xi\>\"", ",", "\"\<\[CapitalOmega]i\>\"", ",", 
                    "\"\<xToday (sweep)\>\"", ",", "\"\<x(0) (NDSolve)\>\"", 
                    ",", "\"\<\[CapitalOmega]Today (sweep)\>\"", ",", 
                    "\"\<\[CapitalOmega](0) (NDSolve)\>\""}], "}"}]}], "]"}], 
                    ",", 
                    RowBox[{"Frame", "->", "All"}], ",", 
                    RowBox[{"Alignment", "->", "\"\<.\>\""}]}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{
                    "model", "<>", "\"\<, \>\"", "<>", "dataset", "<>", 
                    "\"\<  (\>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"Length", "[", "selected", "]"}], "]"}], "<>", 
                    "\"\< points)\>\""}], ",", "Bold"}], "]"}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Print", "[", "checkTable", "]"}], ";", 
                 RowBox[{"Print", "[", "pX", "]"}], ";", 
                 RowBox[{"Print", "[", "pOmega", "]"}]}]}], "]"}]}]}], 
            "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<selected\>\"", "->", "selectedAll"}], ",", 
        RowBox[{"\"\<bgResults\>\"", "->", "bgAll"}], ",", 
        RowBox[{"\"\<plots\>\"", "->", "plotsAll"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997186510445859*^9, 3.997186510447974*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"b54d5a10-192f-47d5-8674-741e1b9321d5"],

