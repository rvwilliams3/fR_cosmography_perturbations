Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Scale", " ", 
      RowBox[{"conversion", ":", " ", "khat"}]}], "=", 
     RowBox[{"k", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{"a0", " ", "H0"}], ")"}]}]}]}], ",", 
    RowBox[{"H0", "=", 
     RowBox[{"100", " ", "h", " ", 
      RowBox[{
       RowBox[{"km", "/", "s"}], "/", 
       RowBox[{"Mpc", ".", " ", "With"}]}], " ", "k", " ", "in", " ", 
      RowBox[{"h", "/", "Mpc"}]}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "h", " ", 
      RowBox[{"cancels", ":", " ", "khat"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}], "*", 
       RowBox[{"c", "/", "100"}]}], "=", 
      RowBox[{"2997.92", "*", 
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"3", "*", 
      SuperscriptBox["10", "5"]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"c", " ", "in", " ", 
     RowBox[{"km", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"kPhys", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.1", ",", "0.2"}], "}"}]}], ";"}], 
   "              ", 
   RowBox[{"(*", 
    RowBox[{"h", " ", 
     RowBox[{"Mpc", "^", 
      RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khatVals", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"c", " "}], "100"], "kPhys"}]}], ";"}], "                    ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{"29.98", ",", "89.94", ",", "299.79", ",", "599.58"}], "}"}], 
    "*)"}], "\n", 
   RowBox[{
