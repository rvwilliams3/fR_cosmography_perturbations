Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeFPlot", "[", 
    RowBox[{"dataset_", ",", "Om0_", ",", 
     RowBox[{"zMax_", ":", "2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sols", ",", "colors"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sols", "=", 
       RowBox[{"SortedSols", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "sols", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FOfz", "[", 
             RowBox[{"dataset", ",", "s", ",", "Om0"}], "]"}], "[", "z", 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "sols"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zMax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colors"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"colors", ",", 
             RowBox[{"XiLabel", "/@", "sols"}], ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.8", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<f '(R)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", "dataset", "]"}]}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
