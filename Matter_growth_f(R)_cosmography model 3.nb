Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
       RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unstableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qComponents", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
