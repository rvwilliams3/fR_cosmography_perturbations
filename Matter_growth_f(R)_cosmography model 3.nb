  3.991726537972209*^9}},ExpressionUUID->"d36db1ab-80c6-471f-9372-\
84e92e6dd1da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Extract", " ", "the", " ", "matter"}], "-", 
      RowBox[{"dominated", " ", "fixed", " ", 
       RowBox[{"point", ":", 
        RowBox[{"the", " ", "one", " ", "closest", " ", "to", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], ")"}]}]}]}]}], "=", 
     RowBox[{"(", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "eps"}], "->", 
     RowBox[{"0", " ", "EdS", " ", "limit"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractMatterDominatedFP", "[", "fps_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"target", ",", "distances", ",", "bestIdx"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"target", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"pt", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "vals", "}"}], ",", 
              RowBox[{
               RowBox[{"vals", "=", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.",
                  " ", "pt"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"N", "[", "vals", "]"}], "-", 
                 RowBox[{"N", "[", "target", "]"}]}], "]"}]}]}], "]"}]}], 
           "]"}], ",", "fps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "[", 
        RowBox[{"[", "bestIdx", "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.991726394589164*^9, 3.991726403343553*^9}, {
  3.991726454918*^9, 3.991726457287413*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"5b4651c1-cea0-4953-a36e-6b64c4378357"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFP", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fpResult", ",", "fps", ",", "bestFP", ",", "vals", ",", "eig", ",", 
       "eigvecs", ",", "type", ",", "Jac", ",", "jAlg", ",", "epsVal"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fpResult", "=", 
       RowBox[{"FixedPointsStability", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"fpResult", "[", "\"\<eps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bestFP", "=", 
       RowBox[{"ExtractMatterDominatedFP", "[", "fps", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ", 
        "bestFP"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "\[Epsilon]", "}"}], ",", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
         RowBox[{"jAlg", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}], "/.", 
           " ", 
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Jac", "[", 
           RowBox[{"xx_", ",", "OOmega_", ",", "qq_"}], "]"}], "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"Fq", "[", 
               RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"xx", ",", "OOmega", ",", "qq"}], "}"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
          RowBox[{
           RowBox[{"Eigensystem", "[", 
            RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"type", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"eig", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], ",", 
         "\"\<Stable node/spiral\>\"", ",", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"eig", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
         "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
        RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<x\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<q\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<eigenvalues\>\"", "->", "eig"}], ",", 
        RowBox[{"\"\<eigenvectors\>\"", "->", "eigvecs"}], ",", 
        RowBox[{"\"\<type\>\"", "->", "type"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991733168215328*^9, 3.991733224686933*^9}, {
  3.995504675697311*^9, 3.9955046791734667`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"46596a15-b338-497f-b7b8-23b4693c9a91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matterDominatedFPs", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"model", ",", 
