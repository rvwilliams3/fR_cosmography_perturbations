Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 0\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 1\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "+", "1"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
