Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Need", " ", "a", " ", "smoothed", " ", "delta", " ", "since", " ", "when",
     " ", "differentiating", " ", "then", " ", "the", " ", "original", " ", 
    "caused", " ", "little", " ", "spikes"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"smoothDelta", "[", 
      RowBox[{"dataset_String", ",", "lab_", ",", "kp_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"smoothDelta", "[", 
       RowBox[{"dataset", ",", "lab", ",", "kp"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"DeltaFn", ",", "zi", ",", "grid"}], "}"}], ",", 
        RowBox[{
         RowBox[{"DeltaFn", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}],
             "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"zi", "=", 
          RowBox[{
           RowBox[{"DeltaFn", "[", "\"\<Domain\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"grid", "=", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"0", ",", "zi", ",", "20000"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"grid", ",", 
              RowBox[{"DeltaFn", "/@", "grid"}]}], "}"}], "]"}], ",", 
           RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SFunc", "[", 
      RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
       RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"DeltaFn", "=", 
         RowBox[{"smoothDelta", "[", 
          RowBox[{"dataset", ",", "lab", ",", "kp"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], "/", 
         RowBox[{"DeltaFn", "[", "z", "]"}]}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.99840525702567*^9, 3.99840532004312*^9}},
 CellLabel->
  "In[379]:=",ExpressionUUID->"c2ba8817-cfe9-4d51-a108-105993296913"],

