Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Scale", " ", 
      RowBox[{"conversion", ":", " ", "khat"}]}], "=", 
     RowBox[{"k", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{"a0", " ", "H0"}], ")"}]}]}]}], ",", 
    RowBox[{"H0", "=", 
     RowBox[{"100", " ", "h", " ", 
      RowBox[{
       RowBox[{"km", "/", "s"}], "/", 
       RowBox[{"Mpc", ".", " ", "With"}]}], " ", "k", " ", "in", " ", 
      RowBox[{"h", "/", "Mpc"}]}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "h", " ", 
