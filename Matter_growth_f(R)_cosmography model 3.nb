                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
