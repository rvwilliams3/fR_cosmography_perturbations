         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotwDE", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"wDEAllSetsModel", "[", "d", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
