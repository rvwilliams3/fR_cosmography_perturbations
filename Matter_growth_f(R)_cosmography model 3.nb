Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SubscriptBox["f\[Sigma]", "8"], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"9f4d72f0-665d-4ba1-9e75-1de81d9f5fb0"]], \
"Section",
 CellChangeTimes->{{3.998403394849019*^9, 
  3.998403398048993*^9}},ExpressionUUID->"d0f79438-b8e2-49da-beee-\
f3d8b2c9183c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sigma80", "=", "0.78"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FS8Func", "[", 
    RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
         "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], "}"}], 
     ",", 
     RowBox[{"sigma80", " ", 
      RowBox[{"SFunc", "[", 
       RowBox[{"dataset", ",", "lab", ",", "kp", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"DeltaFn", "[", "z", "]"}], "/", 
       RowBox[{"DeltaFn", "[", "0", "]"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998405064391531*^9, 3.9984050675343847`*^9}, {
  3.998405906577951*^9, 3.998405907888296*^9}},
 CellLabel->
  "In[366]:=",ExpressionUUID->"c9e766f3-2f75-40ba-ab35-f8528964f484"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFS8", "[", 
    RowBox[{"dataset_String", ",", "kIdx_List", ",", 
     RowBox[{"zmax_", ":", "2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "kSel", ",", "kSelLabels", ",", "curves", ",", "styles", 
       ",", "legFn", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kSel", "=", 
       RowBox[{"kPhys", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kSelLabels", "=", 
       RowBox[{"kLabels", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"FS8Func", "[", 
           RowBox[{"dataset", ",", "lab", ",", "kp", ",", "zz"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"lab", ",", "labels"}], "}"}], ",", 
          RowBox[{"{", 
