Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalR]hat", "[", "z", "]"}], "\[Equal]", 
  RowBox[{"3", " ", 
   SuperscriptBox[
    RowBox[{"Eh", "[", "z", "]"}], "2"], " ", 
   RowBox[{"\[CapitalDelta]", "[", "z", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.996578911891279*^9, 3.996578942710918*^9}, 
