         RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "0.1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
