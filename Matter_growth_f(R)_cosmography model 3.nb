Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"core", " ", "\[CapitalOmega]mFun", " ", "builder"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]mFun", "[", 
     RowBox[{"\[CapitalOmega]m0_", ",", "Efunc_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Om0", "=", "\[CapitalOmega]m0"}], ",", 
        RowBox[{"Ef", "=", "Efunc"}]}], "}"}], ",", 
      RowBox[{"Function", "[", 
       RowBox[{"zz", ",", 
        FractionBox[
         RowBox[{"Om0", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", "zz"}], ")"}], "3"]}], 
         SuperscriptBox[
          RowBox[{"Ef", "[", "zz", "]"}], "2"]]}], "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
