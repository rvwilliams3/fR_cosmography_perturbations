Cell[BoxData[
 RowBox[{
  RowBox[{"xInitModel3Assoc", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "->", 
       RowBox[{"xiModel3", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", 
            "]"}], "[", "\"\<q0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}], ",", 
         
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", 
            "]"}], "[", "\"\<j0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}], ",", 
         
         RowBox[{
          RowBox[{"qAssocByModel", "[", "\"\<Model 3\>\"", "]"}], "[", "#", 
          "]"}]}], "]"}]}], "&"}], "/@", "viablePlanckDatasets"}], "]"}]}], 
  ";"}]], "Input",
