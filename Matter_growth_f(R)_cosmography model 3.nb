      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], "<=", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
