       RowBox[{
        RowBox[{
         RowBox[{"allBgResultsByModel", "[", "model", "]"}], "[", "dataset", 
         "]"}], "[", "label", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"x", " ", "and", " ", "Omega", " ", "functions"}], "*)"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"xFn", "=", 
       RowBox[{"bg", "[", "\"\<x\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"OmFn", "=", 
       RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"bg", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EhFn", "=", 
       RowBox[{
        RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"cgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "jE"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sE"}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", "lE"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"cosmography", " ", 
         RowBox[{"first", ":", " ", "j"}]}], ",", "s", ",", 
        RowBox[{"l", " ", "still", " ", "contain", " ", "free", " ", 
         RowBox[{"q", "[", "z", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"qFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", 
          RowBox[{"xFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", 
          RowBox[{"OmFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "z", "]"}], "->", 
          RowBox[{"EhFn", "[", "z", "]"}]}], ",", 
         RowBox[{"khat", "->", "khatVal"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"then", " ", "bind", " ", "the", " ", "interpolants"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eqR\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ReqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<eqD\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DeltaeqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"bg", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", 
         RowBox[{"bg", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", 
         RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}]}], ",", 
        RowBox[{"\"\<eps\>\"", "->", 
         RowBox[{"cg", "[", "\"\<eps\>\"", "]"}]}], ",", 
        RowBox[{"\"\<q0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<q0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<j0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<j0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", 
         RowBox[{"EhFn", "[", 
          RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}], "]"}]}]}], "|>"}]}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996577281073994*^9, 3.996577300952786*^9}, {
  3.996577333689823*^9, 3.996577386791966*^9}, {3.996577475052778*^9, 
