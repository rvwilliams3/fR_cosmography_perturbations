            RowBox[{"ds", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colours"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"1.05", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<z\>\"", ",", 
           "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(m\)]\)(z)\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", "model"}], ",", 
        RowBox[{"ImageSize", "->", "1000"}]}], "]"}]}]}], "]"}]}], 
