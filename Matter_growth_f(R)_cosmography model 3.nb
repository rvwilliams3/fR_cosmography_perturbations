  3.991797621100827*^9}},ExpressionUUID->"10be2a4e-709b-4708-b01e-\
a2c5a0326987"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForOmegaM", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "Om0", ",", "EhSol"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Om0", "=", 
       RowBox[{
        RowBox[{"params", "[", "\"\<Om0\>\"", "]"}], "[", "\"\<mean\>\"", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EhSol", "=", 
       RowBox[{"EAssocByModel", "[", 
        RowBox[{"model", ",", " ", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Om0val", "=", "Om0"}], "}"}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"zval", ",", 
          RowBox[{"Om0val", "*", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "zval"}], ")"}], "^", "3"}], "/", 
            RowBox[{
             RowBox[{"EhSol", "[", "zval", "]"}], "^", "2"}]}]}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991797259348854*^9, 3.991797299738673*^9}, {
  3.992251896107728*^9, 3.992251906759664*^9}, {3.995337120063747*^9, 
  3.995337121412181*^9}, {3.995337401110384*^9, 3.995337402234537*^9}, {
  3.996580266821259*^9, 3.996580313494464*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"84ca55b9-8a2f-4352-822a-1e6124785ec6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotOmegaM", "[", 
    RowBox[{"model_String", ",", "OmegaMAllSetsModel_Association", ",", 
     RowBox[{"zmax_", ":", "zPlot"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
