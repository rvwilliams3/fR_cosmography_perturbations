Cell[CellGroupData[{

Cell["Adding j=1 Model", "Section",
 CellChangeTimes->{{3.996833291834002*^9, 
  3.996833298199903*^9}},ExpressionUUID->"187bf93d-4e77-4282-a787-\
4324252ea368"],

Cell[CellGroupData[{

Cell["Adding q0 vals", "Subsubsection",
 CellChangeTimes->{{3.9968334998916693`*^9, 
  3.9968335043834*^9}},ExpressionUUID->"c52611b1-daff-4e89-88a0-52db2e08c54b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Using", " ", "q0", " ", "values", " ", "from", " ", "Model", " ", "3", 
    " ", "MCMC", " ", "analysis", " ", "for", " ", "model", " ", "0"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"allParams", "[", "\"\<Model 0\>\"", "]"}], "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MapAt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"1", "&"}], ",", "#"}], "]"}], "&"}], ",", "#", ",", 
         RowBox[{"{", 
          RowBox[{"Key", "[", "\"\<j0\>\"", "]"}], "}"}]}], "]"}], "&"}], ",", 
      RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9968334964704723`*^9, 3.996833535924609*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"2daa9882-63b9-490f-9235-302e1bdeb99a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["q(z)", "Subsection",
 CellChangeTimes->{{3.9968333041945467`*^9, 
  3.9968333056525993`*^9}},ExpressionUUID->"9ddac63c-05d8-47c9-b287-\
1476aa925e91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qLCDMFunc", "[", 
    RowBox[{"q0_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "j", "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"j", "[", "zz_", "]"}], ":=", "1"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"dq", ",", 
              RowBox[{
               RowBox[{"q", "[", "0", "]"}], "==", 
               RowBox[{"SetPrecision", "[", 
                RowBox[{"q0", ",", "40"}], "]"}]}]}], "}"}], ",", "q", ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
            RowBox[{"PrecisionGoal", "->", "20"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}], ",", 
            RowBox[{"WorkingPrecision", "->", "40"}], ",", 
            RowBox[{"MaxSteps", "->", 
             SuperscriptBox["10", "6"]}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99683331287101*^9, 3.996833331048517*^9}, {
  3.996833559977558*^9, 3.99683357368818*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"528ed651-eeb7-4cbf-afba-74d5c5c2b74b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qAssocByModel", "[", "\"\<Model 0\>\"", "]"}], "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "->", 
       RowBox[{"qLCDMFunc", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "[", "#", "]"}],
          "[", 
         RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Keys", "[", 
      RowBox[{"allParams", "[", "\"\<Model 3\>\"", "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"c7e0baf2-2d2a-4a19-8842-e35939f3443b"],

