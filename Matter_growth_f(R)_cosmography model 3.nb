                    RowBox[{"ks", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "zv"}], "]"}], "[", 
                   "\"\<Q\>\"", "]"}], "^", "e"}]}]}], "]"}], ",", 
