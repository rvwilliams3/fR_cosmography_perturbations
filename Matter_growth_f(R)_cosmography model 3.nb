Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"xiModel0", "=", 
    RowBox[{"-", 
     SuperscriptBox["10", 
      RowBox[{"-", "14"}]]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"value", " ", "form", " ", "21", "cm"}], "*)"}]}]], "Input",
