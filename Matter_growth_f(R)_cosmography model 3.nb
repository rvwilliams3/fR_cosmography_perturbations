     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "j0"}]}], ";", 
