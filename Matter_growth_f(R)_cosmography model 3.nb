        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", "dataset", ",", "\"\<j0\>\"", ",", "\"\<mean\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"jExpr", "=", 
