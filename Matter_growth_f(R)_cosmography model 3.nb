Cell[TextData[{
 "Plots against ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5363b8b7-904d-41e7-b95e-2bbce51ebf2a"]
