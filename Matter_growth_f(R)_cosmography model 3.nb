Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "two", " ", "Om0", " ", "sources"}], ",", " ", 
    RowBox[{"from", " ", "MCMC", " ", "and", " ", "SM"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Om0MeanData", "[", 
      RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], "[", 
       "\"\<Om0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Om0SourceMatch", "[", 
      RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q0", ",", "j0"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"q0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
           "[", "\"\<q0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"j0", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
           "[", "\"\<j0\>\"", "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Amatch", "[", 
