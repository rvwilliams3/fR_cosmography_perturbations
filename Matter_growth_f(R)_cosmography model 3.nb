Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"\[CapitalDelta]i\"\>", "\[Rule]", 
    FractionBox["1", "100000"]}], ",", 
   RowBox[{"\<\"\[CapitalDelta]primei\"\>", "\[Rule]", 
    RowBox[{"-", "9.990009857082353`*^-9"}]}], ",", 
   RowBox[{"\<\"Ri\"\>", "\[Rule]", "9815.43541989276`"}], ",", 
   RowBox[{"\<\"Rprimei\"\>", "\[Rule]", "19.61125971067958`"}], ",", 
