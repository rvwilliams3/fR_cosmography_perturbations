      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "kPhys", "]"}], "]"}]}], ",", "kLabels", 
           ",", 
           RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
           RowBox[{"LegendLabel", "->", "\"\<scale\>\""}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"{", 
             RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", "dashings"}], 
           ",", "labels", ",", 
           RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
           RowBox[{"LegendLabel", "->", "\"\<initial condition\>\""}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"{", 
             RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99672453947688*^9, 3.996724541707395*^9}},
