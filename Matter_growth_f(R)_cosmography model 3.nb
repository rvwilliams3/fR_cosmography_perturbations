Cell[CellGroupData[{

Cell["Module to classify trajectory viability", "Subsubsection",
 CellChangeTimes->{{3.994748097312368*^9, 
  3.994748107179188*^9}},ExpressionUUID->"e80c0148-7b43-4780-9e2a-\
9ea67c73aff3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Trajectory", "-", 
     RowBox[{"wide", " ", "viability", " ", "classifier", " ", 
      RowBox[{"Condition", ":", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "/", 
         RowBox[{"(", 
          RowBox[{"j", "-", "q", "-", "2"}], ")"}]}], ">=", 
        RowBox[{"0", "  ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"assuming", " ", "f_R"}], ">", "0"}], ")"}]}]}]}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
      "checked", " ", "along", " ", "the", " ", "WHOLE", " ", "trajectory", 
       " ", "\[IndentingNewLine]", "denom"}], " ", "=", " ", 
      RowBox[{"j", "-", "q", "-", "2"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"tol", "=", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Checks", ":", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"1.", " ", "abs", 
         RowBox[{"(", "denom", ")"}]}], "<", " ", "tol"}]}], " ", "->", " ", 
      RowBox[{
       RowBox[{"near", " ", "singular"}], " ", "->", " ", 
       RowBox[{"denominator", " ", "vanishing", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "point", " ", "is", " ", "near", " ", "a", " ", "fp", " ", "or", 
           " ", "coordinate", " ", "singluarity", " ", "of", " ", 
           RowBox[{"(", 
            RowBox[{"q", ",", "j"}], ")"}]}], "->", " ", 
          RowBox[{"x", " ", "map"}]}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"2.", " ", 
        RowBox[{"x", "/", "denom"}]}], " ", "<", " ", "0"}], " ", "->", " ", 
      RowBox[{"sign", " ", "violation", " ", 
       RowBox[{"(", "unphysical", ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"3.", " ", "\[CapitalOmega]"}], "\[LessEqual]", "0"}], " ", "->",
       " ", 
      RowBox[{"Omega", " ", "violation", " ", 
       RowBox[{"(", "unphysical", ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"else", ":", " ", "physical"}]}]}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClassifyTrajectoryViability", "[", 
     RowBox[{"model_String", ",", 
      RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"q0Val_", "?", "NumericQ"}], ",", "xFn_", ",", 
      "\[CapitalOmega]Fn_", ",", "qFn_", ",", 
      RowBox[{"zi_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<NSamples\>\"", "->", "150"}], ",", 
         RowBox[{"\"\<SingularTol\>\"", "->", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}], ",", 
         RowBox[{"\"\<ZMin\>\"", "->", 
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}]}], ",", 
         RowBox[{"\"\<MaxAbsX\>\"", "->", 
          RowBox[{"10", "^", "3"}]}], ",", 
         RowBox[{"\"\<MaxOmega\>\"", "->", "10"}], ",", 
         RowBox[{"\"\<DomainTol\>\"", "->", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}]}], "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epsVal", ",", "nSamples", ",", "singTol", ",", "zMinSample", ",", 
        "maxAbsX", ",", "maxOm", ",", "domainTol", ",", "domain", ",", 
        "domainMin", ",", "domainMax", ",", "zSamples", ",", "sampleData", 
        ",", "hasSignViolation", ",", "hasNearSingular", ",", 
        "hasOmegaViolation", ",", "hasDivergence", ",", "isPhysical", ",", 
        "label"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nSamples", "=", 
        RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"singTol", "=", 
        RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zMinSample", "=", 
        RowBox[{"OptionValue", "[", "\"\<ZMin\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxAbsX", "=", 
        RowBox[{"OptionValue", "[", "\"\<MaxAbsX\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxOm", "=", 
        RowBox[{"OptionValue", "[", "\"\<MaxOmega\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domainTol", "=", 
        RowBox[{"OptionValue", "[", "\"\<DomainTol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"domain", "=", 
        RowBox[{
         RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"domainMin", "=", 
        RowBox[{"domain", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"domainMax", "=", 
        RowBox[{"domain", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "solution", " ", "must", " ", "actually", " ", "reach", " ", "z"}], 
          "=", 
          RowBox[{
           RowBox[{"0", " ", "and", " ", "z"}], "=", 
           RowBox[{
            RowBox[{"zi", "--"}], " ", "no", " ", 
            RowBox[{"extrapolation", ".", "DomainTol"}], " ", 
            RowBox[{"(", "strict", ")"}], " ", "judges", " ", 
            "validity"}]}]}], ";", 
         RowBox[{
         "ZMin", " ", "only", " ", "sets", " ", "sample", " ", "spacing", " ", 
          RowBox[{"below", "."}]}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"domainMin", ">", "domainTol"}], "||", 
          RowBox[{"domainMax", "<", "zi"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<label\>\"", "->", "\"\<Diverged\>\""}], ",", 
            RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
            RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
            RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
            RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
            RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
            RowBox[{"\"\<sampleData\>\"", "->", 
             RowBox[{"{", "}"}]}]}], "|>"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zSamples", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"Log10", "[", "zMinSample", "]"}], ",", 
             RowBox[{"Log10", "[", 
              RowBox[{"Min", "[", 
               RowBox[{"zi", ",", "domainMax"}], "]"}], "]"}], ",", 
             RowBox[{"nSamples", "-", "2"}]}], "]"}]}], ",", "0"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"sampleData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "xVal", ",", "\[CapitalOmega]Val", ",", "qVal", ",", "jVal", ",",
               "denom", ",", "ratio", ",", "pointLabel"}], "}"}], ",", 
            RowBox[{
             RowBox[{"xVal", "=", 
              RowBox[{"xFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"\[CapitalOmega]Val", "=", 
              RowBox[{"\[CapitalOmega]Fn", "[", "zPt", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"qVal", "=", 
              RowBox[{"qFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"jVal", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"jModelMap", "[", "model", "]"}], "[", "zPt", "]"}],
                  "/.", " ", 
                 RowBox[{"\[Epsilon]", "->", "epsVal"}]}], ")"}], "/.", " ", 
               RowBox[{
                RowBox[{"q", "[", "zPt", "]"}], "->", "qVal"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"denom", "=", 
              RowBox[{"jVal", "-", "qVal", "-", "2"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"pointLabel", "=", 
              RowBox[{"Which", "[", 
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"NumericQ", "[", "xVal", "]"}], "&&", 
                   RowBox[{"NumericQ", "[", "\[CapitalOmega]Val", "]"}]}], 
                  ")"}]}], ",", "\"\<Divergent\>\"", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "xVal", "]"}], ">", "maxAbsX"}], "||", 
                 RowBox[{"\[CapitalOmega]Val", ">", "maxOm"}]}], ",", 
                "\"\<Divergent\>\"", ",", 
                RowBox[{
                 RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
                "\"\<NearSingular\>\"", ",", 
                RowBox[{"\[CapitalOmega]Val", "<=", "0"}], ",", 
                "\"\<OmegaViolation\>\"", ",", 
                RowBox[{
                 RowBox[{"xVal", "/", "denom"}], "<", "0"}], ",", 
                "\"\<SignViolation\>\"", ",", "True", ",", "\"\<OK\>\""}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"ratio", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
                "Indeterminate", ",", 
                RowBox[{"xVal", "/", "denom"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<z\>\"", "->", "zPt"}], ",", 
               RowBox[{"\"\<x\>\"", "->", "xVal"}], ",", 
               RowBox[{
               "\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Val"}], ",", 
               RowBox[{"\"\<q\>\"", "->", "qVal"}], ",", 
               RowBox[{"\"\<j\>\"", "->", "jVal"}], ",", 
               RowBox[{"\"\<denom\>\"", "->", "denom"}], ",", 
               RowBox[{"\"\<ratio\>\"", "->", "ratio"}], ",", 
               RowBox[{"\"\<pointLabel\>\"", "->", "pointLabel"}]}], 
              "|>"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"zPt", ",", "zSamples"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hasDivergence", "=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{"sampleData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
            "\"\<Divergent\>\""}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hasNearSingular", "=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{"sampleData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
            "\"\<NearSingular\>\""}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hasOmegaViolation", "=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{"sampleData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
            "\"\<OmegaViolation\>\""}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hasSignViolation", "=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{"sampleData", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
            "\"\<SignViolation\>\""}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"isPhysical", "=", 
        RowBox[{"!", 
         RowBox[{"(", 
          RowBox[{
          "hasDivergence", "||", "hasNearSingular", "||", "hasOmegaViolation",
            "||", "hasSignViolation"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"label", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
         "isPhysical", ",", "\"\<Physical\>\"", ",", "hasDivergence", ",", 
          "\"\<Divergent\>\"", ",", "hasNearSingular", ",", 
          "\"\<NearSingular\>\"", ",", "hasOmegaViolation", ",", 
          "\"\<OmegaViolation\>\"", ",", "hasSignViolation", ",", 
          "\"\<SignViolation\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
         RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
         RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<hasDivergence\>\"", "->", "hasDivergence"}], ",", 
         RowBox[{"\"\<hasSignViolation\>\"", "->", "hasSignViolation"}], ",", 
         
         RowBox[{"\"\<hasNearSingular\>\"", "->", "hasNearSingular"}], ",", 
         RowBox[{"\"\<hasOmegaViolation\>\"", "->", "hasOmegaViolation"}], 
         ",", 
         RowBox[{"\"\<minRatio\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"sampleData", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "\"\<ratio\>\""}], "]"}], "]"}], ",", 
             RowBox[{"_", "?", "NumericQ"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<minOmega\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<maxOmega\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<maxAbsX\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"sampleData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "\"\<x\>\""}], "]"}], "]"}], "]"}], "]"}]}],
          ",", 
         RowBox[{"\"\<minAbsDenom\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"sampleData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "\"\<denom\>\""}], "]"}], "]"}], "]"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
         RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
         RowBox[{"\"\<sampleData\>\"", "->", "sampleData"}]}], "|>"}]}]}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.994743934973697*^9, 3.994744013979355*^9}, {
   3.994744117690578*^9, 3.9947441563946238`*^9}, {3.99476114587543*^9, 
   3.9947612294244556`*^9}, {3.9947614538243637`*^9, 3.994761520432472*^9}, {
   3.994761588533358*^9, 3.994761708823436*^9}, 3.994994871843858*^9, 
   3.994995587304584*^9, 3.9950852439596357`*^9, {3.995085348575189*^9, 
   3.995085348730777*^9}, {3.995244322336978*^9, 3.995244331564878*^9}, {
   3.995244914621324*^9, 3.995244914788275*^9}, {3.995264084014765*^9, 
   3.9952640898260508`*^9}, {3.995339707776859*^9, 3.99533971178736*^9}},
