Cell["\<\
Unweighted linear best fit, using Mathematica function LinearModelFit[] to \
determine best fit values for \[Gamma] and \[Eta]\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.997409410788245*^9, 3.99740941677775*^9}, {
  3.997409732159932*^9, 3.997409775184292*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"bba026c0-a790-40f2-ba23-562ea86f53d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitGamEta", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "lm", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Comstruct", " ", "the", " ", "linear", " ", "model", " ", "fit"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lm", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"data", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "v"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"basis", " ", "functions"}], " ", "-", " ", 
            RowBox[{"model", " ", "is", " ", "y"}]}], "=", 
           RowBox[{"\[Gamma]u", "+", "\[Eta]v"}]}], "*)"}], " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "v"}], "}"}], ",", " ", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"variables", " ", "-", " ", 
            RowBox[{"column", " ", "1", " ", 
             RowBox[{"(", "x1", ")"}], " ", "maps", " ", "to", " ", "u"}]}], 
           ",", " ", 
           RowBox[{"column", " ", "2", " ", 
            RowBox[{"(", "x2", ")"}], " ", "maps", " ", "to", " ", "v"}]}], 
          "*)"}], " ", 
         RowBox[{"IncludeConstantBasis", "->", "False"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{"No", " ", "intercept"}], "*)"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<gamma\>\"", "->", 
         RowBox[{
          RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<eta\>\"", "->", 
         RowBox[{
          RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<R2\>\"", "->", 
         RowBox[{"lm", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
        RowBox[{"\"\<fit\>\"", "->", "lm"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997346513963874*^9, 3.997346514392867*^9}, 
   3.99740918820774*^9, {3.997409514250834*^9, 3.997409690277553*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"53e596f5-2c11-4ef5-87ce-1fb06f00ddf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitDataOne", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"zmin_", ":", "0.0"}], ",", 
     RowBox[{"zmax_", ":", "6"}], ",", 
     RowBox[{"dz_", ":", "0.05"}]}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", "=", 
         RowBox[{"QParts", "[", 
          RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}],
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<\[CapitalOmega]m\>\"", "]"}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<Q\>\"", "]"}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<S\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     
     RowBox[{"(*", 
      RowBox[{"writing", " ", "data", " ", "as", " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", " ", 
         SubscriptBox["x", "2"], ",", " ", "y"}], ")"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"zv", ",", "zmin", ",", "zmax", ",", "dz"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997411427810939*^9, 3.997411452698987*^9}, 
   3.9974123840772867`*^9},
 CellLabel->
  "In[221]:=",ExpressionUUID->"09fbfe1a-257b-4925-a5a1-6ccef3dd6b57"],

