Cell[CellGroupData[{

Cell["Model 3 with errors", "Subsubsection",
 CellChangeTimes->{{3.9983576538374434`*^9, 
  3.998357666189493*^9}},ExpressionUUID->"4c7e895e-7e2f-4a99-b229-\
7759b95748f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Om0CornerSourceMatch", "[", 
     RowBox[{"model_String", ",", "dataset_String", ",", "keys_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q0", ",", "j0"}], "}"}], ",", 
      RowBox[{
       RowBox[{"q0", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
          "[", "\"\<q0\>\"", "]"}], "[", 
         RowBox[{"keys", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"j0", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], 
          "[", "\"\<j0\>\"", "]"}], "[", 
         RowBox[{"keys", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Amatch", "[", 
         RowBox[{
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0", ",", "j0"}], "]"}], ",", "q0"}], "]"}],
         "}"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Om0CornerData", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "keys_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], "[", 
       "\"\<Om0\>\"", "]"}], "[", "\"\<min\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}], "[", 
       "\"\<Om0\>\"", "]"}], "[", "\"\<max\>\"", "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998357671361331*^9, 3.998357671363447*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"cffad8fb-1c22-464e-9043-c8779c5cb653"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildOmegaMBand", "[", 
    RowBox[{
    "model_String", ",", "Om0CornerFn_", ",", "Om0MeanFn_", ",", 
     "EBand_Association", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"corners", ",", "Ecorners", ",", "fns", ",", "meanFn"}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"corners", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", "\"\<max\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<min\>\"", ",", "\"\<max\>\""}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Ecorners", "=", 
       RowBox[{
        RowBox[{"EBand", "[", "dataset", "]"}], "[", "\"\<corners\>\"", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fns", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalOmega]mFun", "[", 
             RowBox[{"#", ",", 
              RowBox[{"Ecorners", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "&"}], "/@", 
           RowBox[{"Om0CornerFn", "[", 
            RowBox[{"model", ",", "dataset", ",", 
             RowBox[{"corners", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "corners", "]"}]}], "}"}]}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"meanFn", "=", 
       RowBox[{"\[CapitalOmega]mFun", "[", 
        RowBox[{
         RowBox[{"Om0MeanFn", "[", 
          RowBox[{"model", ",", "dataset"}], "]"}], ",", 
         RowBox[{
          RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ff", "=", "fns"}], ",", 
          RowBox[{"mf", "=", "meanFn"}]}], "}"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<mean\>\"", "->", "mf"}], ",", 
          RowBox[{"\"\<lo\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ff", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
          ",", 
          RowBox[{"\"\<hi\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Through", "[", 
               RowBox[{"ff", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
          ",", 
          RowBox[{"\"\<corners\>\"", "->", "ff"}]}], "|>"}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998357684197811*^9, 3.998357684200747*^9}, {
  3.998357913635952*^9, 3.998357916582205*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"68452de6-f154-4ab8-af19-8f6af712628b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OmBandData3", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "->", 
        RowBox[{"BuildOmegaMBand", "[", 
         RowBox[{
         "\"\<Model 3\>\"", ",", "Om0CornerData", ",", "Om0MeanData", ",", 
          "EBandAssoc3", ",", "#"}], "]"}]}], "&"}], ",", "plotModels"}], 
     "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"25852359-f19f-4654-bc31-a9ea0fbf0726"],

