        RowBox[{"h", "/", "Mpc"}], "]"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"3", "*", 
      SuperscriptBox["10", "5"]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"c", " ", "in", " ", 
     RowBox[{"km", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"kPhys", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.1", ",", "0.2"}], "}"}]}], ";"}], 
   "              ", 
   RowBox[{"(*", 
    RowBox[{"h", " ", 
     RowBox[{"Mpc", "^", 
      RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khatVals", "=", 
