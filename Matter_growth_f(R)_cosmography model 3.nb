Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
