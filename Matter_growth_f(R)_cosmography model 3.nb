           RowBox[{"LegendLabel", "->", "\"\<scale\>\""}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"{", 
             RowBox[{"FontSize", "->", "9"}], "}"}]}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
