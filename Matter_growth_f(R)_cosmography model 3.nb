Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotOmegaM", "[", 
    RowBox[{
    "model_String", ",", "OmAssoc_Association", ",", "label_String", ",", 
     RowBox[{"zmax_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"datasets", ",", "colours", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"Keys", "[", "OmAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"colours", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{"colours", ",", "datasets", ",", 
         RowBox[{"LegendMarkerSize", "->", "20"}], ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"RoundingRadius", "->", "0"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"FrameStyle", "->", "Gray"}]}], "]"}], "&"}], ")"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OmAssoc", "[", "dset", "]"}], "[", "z", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dset", ",", "datasets"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colours"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
