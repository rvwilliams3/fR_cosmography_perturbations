 RowBox[{
  RowBox[{"cgAssoc", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"model", "->", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"dataset", "->", 
           RowBox[{"BuildCosmographyExprs", "[", 
            RowBox[{"model", ",", "dataset"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], "]"}], 
        "]"}]}], ",", 
