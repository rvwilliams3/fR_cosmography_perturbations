Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFitPercDiff", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_"}], "]"}], ":=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f", "=", 
            RowBox[{"fitOne", "[", 
             RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"g", "=", 
               RowBox[{"f", "[", "\"\<gamma\>\"", "]"}]}], ",", 
              RowBox[{"e", "=", 
               RowBox[{"f", "[", "\"\<eta\>\"", "]"}]}]}], "}"}], ",", 
            RowBox[{"100", "*", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox[
                  RowBox[{
                   RowBox[{"QParts", "[", 
                    RowBox[{
                    "model", ",", "dataset", ",", "lab", ",", "kp", ",", 
                    "zv"}], "]"}], "[", "\"\<\[CapitalOmega]m\>\"", "]"}], 
                  "g"], "*", 
                 SuperscriptBox[
                  RowBox[{
                   RowBox[{"QParts", "[", 
                    RowBox[{
                    "model", ",", "dataset", ",", "lab", ",", "kp", ",", 
                    "zv"}], "]"}], "[", "\"\<Q\>\"", "]"}], "e"]}], "-", 
                RowBox[{
                 RowBox[{"QParts", "[", 
                  RowBox[{
                  "model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}],
                   "]"}], "[", "\"\<S\>\"", "]"}]}], ")"}], "/", 
              RowBox[{
               RowBox[{"QParts", "[", 
                RowBox[{
                "model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}], 
                "]"}], "[", "\"\<S\>\"", "]"}]}]}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"zv", ",", "0.05", ",", "6"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.6", "]"}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<z\>\"", ",", "\"\<Percentage difference\>\""}], "}"}]}], 
     ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"kLabels", ",", 
          RowBox[{"LegendFunction", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Framed", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Background", "->", "White"}], ",", 
               RowBox[{"FrameStyle", "->", 
                RowBox[{"Directive", "[", 
                 RowBox[{"GrayLevel", "[", "0.35", "]"}], "]"}]}], ",", 
               RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
            ")"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.7", ",", "0.75"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "500"}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"dataset", ",", "\"\<, \>\"", ",", "lab"}], "}"}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99734669590333*^9, 3.997346696404895*^9}, {
