Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotQScales", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lab", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Keys", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
           "]"}], "[", "dataset", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QParts", "[", 
