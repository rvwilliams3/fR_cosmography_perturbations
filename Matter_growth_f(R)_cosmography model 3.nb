Cell[CellGroupData[{

Cell["Determining stability of fixed points", "Section",
 CellChangeTimes->{{3.991726073605884*^9, 
  3.991726081347526*^9}},ExpressionUUID->"1345fc42-8bde-4fb1-bdbf-\
805467690e6c"],

Cell[CellGroupData[{

Cell["General fixed points for each model and specified dataset", \
"Subsubsection",
 CellChangeTimes->{{3.9917263179368277`*^9, 3.991726321213921*^9}, {
  3.99172635272196*^9, 
  3.991726359340672*^9}},ExpressionUUID->"c4613f84-97ad-4c53-86af-\
0b4d7dca7a28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FixedPointsStability", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "epsVal", ",", "q0Val", ",", "j0Val", ",", "jExpr", ",", 
       "jAlg", ",", "fps", ",", "Jac", ",", "classify", ",", 
       "stabilityGrid"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<q0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", " ", 
        RowBox[{"\"\<j0\>\"", ",", " ", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "\[Epsilon]", "}"}], ",", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
         RowBox[{"jAlg", "=", 
          RowBox[{"jExpr", "/.", " ", 
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "turn", " ", "into", " ", "algebraic", " ", "expression", " ", "in",
            " ", "q"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fps", "=", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Fx", "[", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
               "0"}], ",", 
              RowBox[{
               RowBox[{"F\[CapitalOmega]", "[", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
               "0"}], ",", 
              RowBox[{
               RowBox[{"Fq", "[", 
                RowBox[{"q", ",", "jAlg"}], "]"}], "==", "0"}]}], "}"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
            "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Jac", "[", 
           RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
              RowBox[{"Fq", "[", 
               RowBox[{"q", ",", "jAlg"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "}"}]}],
            "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"classify", "[", "pt_", "]"}], ":=", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"vals", ",", "eig", ",", "type"}], "}"}], ",", 
            RowBox[{
             RowBox[{"vals", "=", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", 
               " ", "pt"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"eig", "=", 
              RowBox[{
               RowBox[{"Eigenvalues", "[", 
                RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"type", "=", 
              RowBox[{"Which", "[", 
               RowBox[{
                RowBox[{"AllTrue", "[", 
                 RowBox[{"eig", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}],
                 ",", "\"\<Stable node/spiral\>\"", ",", 
                RowBox[{"AllTrue", "[", 
                 RowBox[{"eig", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}],
                 ",", "\"\<Unstable\>\"", ",", "True", ",", 
                "\"\<Saddle\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"vals", ",", "eig", ",", "type"}], "}"}]}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"stabilityGrid", "=", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"classify", "/@", "fps"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<(x*, \[CapitalOmega]*, q*)\>\"", ",", 
                "\"\<Eigenvalues\>\"", ",", "\"\<Type\>\""}], "}"}]}], "]"}], 
            ",", 
            RowBox[{"Frame", "->", "All"}]}], "]"}]}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
        RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<fixedPoints\>\"", "->", "fps"}], ",", 
        RowBox[{"\"\<stabilityGrid\>\"", "->", "stabilityGrid"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991726082177257*^9, 3.991726141855951*^9}, {
  3.995504430321677*^9, 3.9955044314121037`*^9}, {3.995504465526683*^9, 
  3.995504469879191*^9}, {3.995504518587843*^9, 3.995504522805877*^9}, {
  3.995504557570842*^9, 3.995504664607073*^9}, {3.995600614452514*^9, 
  3.995600614899388*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"3dde53a7-91e8-477a-8ebf-c41b7c07b462"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fixedPointResults", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"model", ",", 
        RowBox[{"model", "->", 
         RowBox[{"Association", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "->", 
              RowBox[{"FixedPointsStability", "[", 
               RowBox[{"model", ",", "#"}], "]"}]}], "&"}], ",", 
            RowBox[{"AvailableDatasets", "[", "model", "]"}]}], "]"}], 
          "]"}]}]}], "]"}], ",", 
      RowBox[{"AvailableModels", "[", "]"}]}], "]"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.991726156646961*^9, 3.991726156648535*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"f46fcee4-2c14-443d-b4a9-b2c0f45b2de2"]
}, Closed]],

