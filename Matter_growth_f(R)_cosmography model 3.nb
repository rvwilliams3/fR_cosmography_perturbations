Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitOne", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_", ",", "kp_"}], "]"}], ":=", 
   RowBox[{"fitGamEta", "[", 
    RowBox[{"fitDataOne", "[", 
     RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp"}], "]"}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.997411517790804*^9, 3.997411517792264*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"1ac5d90e-0fb4-4cc0-ad41-28c7ebb66830"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFitOverlay", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_", ",", 
     RowBox[{"kps_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ks", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kps", "===", "Automatic"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "@", "kPhys"}], ",", 
           RowBox[{"Last", "@", "kPhys"}]}], "}"}], ",", "kps"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"fitOne", "[", 
            RowBox[{"model", ",", "dataset", ",", "lab", ",", "#"}], "]"}], 
           "&"}], "/@", "ks"}]}], "}"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "@", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"QParts", "[", 
                RowBox[{"model", ",", "dataset", ",", "lab", ",", 
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "zv"}], "]"}], "[", 
               "\"\<S\>\"", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"g", "=", 
                   RowBox[{
                    RowBox[{"fs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<gamma\>\"", 
                    "]"}]}], ",", 
                  RowBox[{"e", "=", 
                   RowBox[{
                    RowBox[{"fs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<eta\>\"", 
                    "]"}]}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"QParts", "[", 
                    RowBox[{"model", ",", "dataset", ",", "lab", ",", 
                    RowBox[{"ks", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "zv"}], "]"}], "[", 
                   "\"\<\[CapitalOmega]m\>\"", "]"}], "^", "g"}], "*", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"QParts", "[", 
                    RowBox[{"model", ",", "dataset", ",", "lab", ",", 
                    RowBox[{"ks", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "zv"}], "]"}], "[", 
                   "\"\<Q\>\"", "]"}], "^", "e"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"zv", ",", "0.05", ",", "6"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}], 
         ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ",", 
                "Dashed"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<S(z)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{
              RowBox[{"Column", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"LineLegend", "[", 
                   RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}], ",", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<k = \>\"", ",", 
                    RowBox[{"ks", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    "\"\<, \[Gamma] = \>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<gamma\>\"", 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", 
                    "\"\<, \[Eta] = \>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<eta\>\"", "]"}],
                     ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "@", "ks"}]}], "}"}]}], "]"}]}], "]"}], 
                  ",", 
                  RowBox[{"LineLegend", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Directive", "[", "Black", "]"}], ",", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", "Dashed"}], "]"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<Numerical S(z)\>\"", ",", 
                    "\"\<\!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(\[Gamma]\
\)]\)\!\(\*SuperscriptBox[\(Q\), \(\[Eta]\)]\) best fit\>\""}], "}"}]}], 
                   "]"}]}], "}"}], ",", 
                RowBox[{"Spacings", "->", "0.3"}]}], "]"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"FrameStyle", "->", 
               RowBox[{"Directive", "[", 
                RowBox[{"GrayLevel", "[", "0.35", "]"}], "]"}]}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.62", ",", "0.24"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"ImageSize", "->", "500"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "\"\<, \>\"", ",", "lab"}], "}"}], 
           "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99741171588411*^9, 3.997411731248232*^9}, 
   3.997411858345948*^9, {3.997411935256378*^9, 3.997411961248147*^9}},
