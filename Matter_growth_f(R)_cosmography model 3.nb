Cell[CellGroupData[{

Cell["Building cosmo variables", "Subsubsection",
 CellChangeTimes->{{3.9965757753355293`*^9, 3.9965757798340883`*^9}, {
  3.99657662596938*^9, 
  3.996576627765847*^9}},ExpressionUUID->"68bea13a-af02-41a3-870b-\
9c35658f0a46"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildCosmographyExprs", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q0Val", ",", "j0Val", ",", "epsVal", ",", "jExpr", ",", "qpExpr", ",", 
       "sExpr", ",", "lExpr", ",", "jpExpr", ",", "spExpr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", "dataset", ",", "\"\<q0\>\"", ",", "\"\<mean\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{
        "model", ",", "dataset", ",", "\"\<j0\>\"", ",", "\"\<mean\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qpExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"dq", ",", " ", 
           RowBox[{
            RowBox[{"q", "'"}], "[", "z", "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
        RowBox[{
         RowBox[{"j", "[", "z", "]"}], "->", "jExpr"}]}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"q", "'"}], 
        RowBox[{"(", "z", ")"}], " ", "eliminated", " ", "analytically", " ", 
        "via", " ", "dq"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"jpExpr", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"jExpr", ",", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"dj", ",", 
              RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
           RowBox[{
            RowBox[{
             RowBox[{"j", "'"}], "[", "z", "]"}], "->", "jpExpr"}]}], "/.", 
          RowBox[{
           RowBox[{"j", "[", "z", "]"}], "->", "jExpr"}]}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"spExpr", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"sExpr", ",", "z"}], "]"}], "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "'"}], "[", "z", "]"}], "->", "qpExpr"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"ds", ",", 
             RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "'"}], "[", "z", "]"}], "->", "spExpr"}]}], "/.", 
         " ", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sExpr"}]}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sExpr", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Cancel", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"Rationalize", "[", 
           RowBox[{"sExpr", ",", "0"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lExpr", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Cancel", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"Rationalize", "[", 
           RowBox[{"lExpr", ",", "0"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
        RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
        RowBox[{"\"\<j\>\"", "->", "jExpr"}], ",", 
        RowBox[{"\"\<s\>\"", "->", "sExpr"}], ",", 
        RowBox[{"\"\<l\>\"", "->", "lExpr"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996547962913258*^9, 3.996547980143717*^9}, 
   3.99654807256282*^9, 3.996548124107436*^9, {3.996548160375935*^9, 
   3.996548177646298*^9}, {3.9965482162374487`*^9, 3.996548242807096*^9}, {
   3.9965483556414433`*^9, 3.996548383097829*^9}, {3.996548421719468*^9, 
   3.99654845565613*^9}, {3.9965485033127527`*^9, 3.996548520253413*^9}, {
   3.996548906150378*^9, 3.996548906484234*^9}, 3.996548960626481*^9, {
   3.996574558445432*^9, 3.9965745753861322`*^9}, {3.9965746163099823`*^9, 
   3.9965749870349417`*^9}, {3.996575040873722*^9, 3.996575183734396*^9}, {
   3.996575215855798*^9, 3.996575267887788*^9}, {3.996575307758801*^9, 
   3.996575349033598*^9}, {3.996575684016683*^9, 3.996575688605921*^9}, {
   3.996575930193912*^9, 3.996575936083586*^9}, {3.996575976797491*^9, 
   3.996575995437084*^9}, 3.996576026787492*^9, 3.9965760809304457`*^9, {
   3.996577002009845*^9, 3.9965770053579683`*^9}},
 CellLabel->
