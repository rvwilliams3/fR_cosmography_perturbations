Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SelectEvenXi", "[", 
    RowBox[{"sweepResult_Association", ",", "nPoints_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filtered", ",", "xiVals", ",", "targets", ",", "idx"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"filtered", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], ">=", 
           "xTodayThreshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"filtered", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"filtered", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiVals", "=", 
       RowBox[{"filtered", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "filtered", "]"}], "<=", "nPoints"}], ",", 
        RowBox[{"Return", "[", "filtered", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"targets", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"Min", "[", "xiVals", "]"}], ",", 
         RowBox[{"Max", "[", "xiVals", "]"}], ",", 
         RowBox[{"nPoints", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"xiVals", "-", "#"}], "]"}], ",", "1"}], "]"}], "]"}], 
          "&"}], "/@", "targets"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995342581787116*^9, 3.995342593687205*^9}, {
   3.995342780847473*^9, 3.995342781419993*^9}, {3.995343085279057*^9, 
   3.995343087267094*^9}, 3.9953433559472427`*^9, {3.995345706032874*^9, 
   3.995345708231103*^9}, 3.995345876303337*^9, 3.996542488825172*^9},
 CellLabel->
  "In[127]:=",ExpressionUUID->"dbcb93d7-2bbf-4e60-bf5b-66dfec5e9c60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "zi", ",", "ic", ",", "xi", ",", 
       "\[CapitalOmega]i", ",", "qi", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd", ",", "wp", ",", "q0Val", ",", 
       "j0Val"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", "30"}], ";", "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<q0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Val", "=", 
       RowBox[{"params", "[", 
        RowBox[{"\"\<j0\>\"", ",", "\"\<mean\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{
        RowBox[{"qAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"zi", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]i", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}], ",", "wp"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"qi", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"EpsFast", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "14"}], ",", 
               RowBox[{"AccuracyGoal", "->", "14"}], ",", 
               RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], ",", 
        RowBox[{"\"\<qi\>\"", "->", "qi"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953427219563*^9, 3.99534275611684*^9}, {
   3.995346488448003*^9, 3.995346488690901*^9}, {3.995346702465871*^9, 
   3.995346704343001*^9}, 3.9953467417432957`*^9, {3.995347706655174*^9, 
   3.99534774703548*^9}, {3.99534808329198*^9, 3.995348257670144*^9}, {
   3.995600668737981*^9, 3.995600674278298*^9}, {3.995600725939093*^9, 
   3.995600840228261*^9}, 3.995600874182691*^9, 3.99560102012549*^9, {
   3.995601064504258*^9, 3.9956010955772743`*^9}, {3.996542338134515*^9, 
   3.996542339071118*^9}, {3.996542664528526*^9, 3.996542668534398*^9}, {
   3.996543333473983*^9, 3.996543350714696*^9}, {3.996543401747546*^9, 
   3.996543404432798*^9}, {3.99683944059057*^9, 3.996839449224405*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"f958fc57-2cd7-416a-9884-2ad67d7c1bab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBackgroundSolutions", "[", 
    RowBox[{
    "model_String", ",", "bgResults_Association", ",", "datasets_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "plotX", ",", "plotOmega"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotX", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
             "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotOmega", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", 
              "\"\<\[CapitalOmega]\>\"", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<\[CapitalOmega](z)\>\""}], "}"}]}], 
         ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"plotX", ",", "plotOmega"}], "}"}]}]}], "]"}]}], 
