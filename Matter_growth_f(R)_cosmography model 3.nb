Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Scale", " ", 
      RowBox[{"conversion", ":", " ", "khat"}]}], "=", 
     RowBox[{"k", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{"a0", " ", "H0"}], ")"}]}]}]}], ",", 
    RowBox[{"H0", "=", 
     RowBox[{"100", " ", "h", " ", 
      RowBox[{
       RowBox[{"km", "/", "s"}], "/", 
       RowBox[{"Mpc", ".", " ", "With"}]}], " ", "k", " ", "in", " ", 
      RowBox[{"h", "/", "Mpc"}]}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "h", " ", 
      RowBox[{"cancels", ":", " ", "khat"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}], "*", 
       RowBox[{"c", "/", "100"}]}], "=", 
      RowBox[{"2997.92", "*", 
       RowBox[{"k", "[", 
        RowBox[{"h", "/", "Mpc"}], "]"}]}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"3", "*", 
      SuperscriptBox["10", "5"]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"c", " ", "in", " ", 
     RowBox[{"km", "/", "s"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"kPhys", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.1", ",", "0.2"}], "}"}]}], ";"}], 
   "              ", 
   RowBox[{"(*", 
    RowBox[{"h", " ", 
     RowBox[{"Mpc", "^", 
      RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khatVals", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"c", " "}], "100"], "kPhys"}]}], ";"}], "                    ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{"29.98", ",", "89.94", ",", "299.79", ",", "599.58"}], "}"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"kLabels", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<k = \>\"", ",", "#", ",", "\"\< h Mpc\>\"", ",", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<\>\"", ",", 
            RowBox[{"-", "1"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
      "kPhys"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.996674875849108*^9, 3.996674906121173*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"4e764064-9879-4801-9962-04c14dc9ed29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolvePerturbations", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sys", ",", "ics", ",", "zi", ",", "sol", ",", "DeltaFn", ",", "RFn"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"sys", "=", 
       RowBox[{"BuildPertSystem", "[", 
        RowBox[{"model", ",", "dataset", ",", "idx", ",", "khatVal"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ics", "=", 
       RowBox[{"BuildPertICs", "[", 
        RowBox[{"model", ",", "dataset", ",", "sys"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zi", "=", 
       RowBox[{"ics", "[", "\"\<zi\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"sol", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"sys", "[", "\"\<eqD\>\"", "]"}], ",", 
             RowBox[{"sys", "[", "\"\<eqR\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"\[CapitalDelta]", "[", "zi", "]"}], "==", 
              RowBox[{"ics", "[", "\"\<\[CapitalDelta]i\>\"", "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalDelta]", "'"}], "[", "zi", "]"}], "==", 
              RowBox[{"ics", "[", "\"\<\[CapitalDelta]primei\>\"", "]"}]}], 
             ",", 
             RowBox[{
              RowBox[{"\[ScriptCapitalR]hat", "[", "zi", "]"}], "==", 
              RowBox[{"ics", "[", "\"\<Ri\>\"", "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[ScriptCapitalR]hat", "'"}], "[", "zi", "]"}], "==", 
              
              RowBox[{"ics", "[", "\"\<Rprimei\>\"", "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[CapitalDelta]", ",", "\[ScriptCapitalR]hat"}], "}"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"z", ",", "0", ",", "zi"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NDSolve", "::", "ndsz"}], ",", 
           RowBox[{"NDSolve", "::", "mxst"}], ",", 
           RowBox[{"NDSolve", "::", "ndcf"}], ",", 
           RowBox[{"NDSolve", "::", "precw"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"sol", ",", 
           RowBox[{"{", 
            RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{"\[CapitalDelta]", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"RFn", "=", 
       RowBox[{"\[ScriptCapitalR]hat", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]\>\"", "->", "DeltaFn"}], ",", 
        RowBox[{"\"\<\[ScriptCapitalR]hat\>\"", "->", "RFn"}], ",", 
        RowBox[{"\"\<domainEnd\>\"", "->", 
         RowBox[{
          RowBox[{"DeltaFn", "[", "\"\<Domain\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<label\>\"", "->", 
         RowBox[{"sys", "[", "\"\<label\>\"", "]"}]}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"sys", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<ics\>\"", "->", "ics"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996660037597343*^9, 3.996660037599374*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"36e64a24-155d-498b-bf4e-42b0c42f56d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveAllPerturbations", "[", 
    RowBox[{"model_String", ",", "datasets_List", ",", "khatList_List", ",", 
     RowBox[{"nIdx_", ":", "3"}]}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"dataset", "->", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "label", "}"}], ",", 
            RowBox[{
             RowBox[{"label", "=", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{
                 RowBox[{"allBgResultsByModel", "[", "model", "]"}], "[", 
                 "dataset", "]"}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"label", "->", 
              RowBox[{"Association", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"kp", ",", "khv"}], "}"}], ",", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "r", "}"}], ",", 
                    RowBox[{
                    RowBox[{"r", "=", 
                    RowBox[{"SolvePerturbations", "[", 
                    RowBox[{"model", ",", "dataset", ",", "i", ",", "khv"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"r", "===", "$Failed"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "dataset", ",", "\"\<  |  \>\"", ",", "label", ",", 
                    "\"\<  |  k = \>\"", ",", "kp", ",", 
                    "\"\< h/Mpc  (khat = \>\"", ",", "khv", ",", 
                    "\"\<):  FAILED\>\""}], "}"}], "]"}], ",", "Red"}], "]"}],
                     "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"kp", "->", "r"}]}]}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"kPhys", ",", "khatList"}], "}"}]}], "]"}], 
               "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nIdx"}], "}"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996583023086899*^9, 3.99658302308991*^9}, 
   3.996583068187023*^9, {3.996584095889985*^9, 3.996584101240359*^9}, {
   3.996584141339388*^9, 3.996584156057295*^9}, {3.996584223143985*^9, 
   3.99658423241151*^9}, {3.996584614334627*^9, 3.996584614702086*^9}, {
   3.996652822476924*^9, 3.996652833724143*^9}, {3.996653332261831*^9, 
   3.996653333692518*^9}, 3.996659871715125*^9, 3.99665994575765*^9},
 CellLabel->
  "In[188]:=",ExpressionUUID->"f2a6a787-6d0f-4943-b8e0-269fd7501cfb"],

