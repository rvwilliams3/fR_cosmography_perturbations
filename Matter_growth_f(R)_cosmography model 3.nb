Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Scale", " ", 
      RowBox[{"conversion", ":", " ", "khat"}]}], "=", 
     RowBox[{"k", " ", 
      RowBox[{"c", "/", 
