Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"helper", ":", 
    RowBox[{
    "contiguous", " ", "index", " ", "runs", " ", "of", " ", 
     "\"\<Physical\>\"", " ", "points", " ", "in", " ", "a", " ", "results", 
     " ", "list"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PhysicalRuns", "[", "results_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "idx", "}"}], ",", 
      RowBox[{
       RowBox[{"idx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"results", ",", 
           RowBox[{"r_", "/;", 
            RowBox[{
             RowBox[{"r", "[", "\"\<label\>\"", "]"}], "===", 
             "\"\<Physical\>\""}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"idx", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Split", "[", 
          RowBox[{"idx", ",", 
           RowBox[{
            RowBox[{"#2", "==", 
             RowBox[{"#1", "+", "1"}]}], "&"}]}], "]"}]}], "]"}]}]}], "]"}]}],
    ";"}]}]], "Input",
