Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"S", 
     RowBox[{"(", "z", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}]}], 
     FractionBox[
      RowBox[{
       RowBox[{"\[CapitalDelta]", "'"}], 
       RowBox[{"(", "z", ")"}]}], 
      RowBox[{"\[CapitalDelta]", 
       RowBox[{"(", "z", ")"}]}]], " ", "groes", " ", "larger", " ", "than", 
     " ", "1"}]}], ",", " ", 
   RowBox[{"so", " ", "unliek", " ", "with", " ", "GR"}], ",", " ", 
   RowBox[{"cannot", " ", "use", " ", 
    SuperscriptBox["\[CapitalOmega]", "\[Gamma]"], " ", "approx"}]}], 
  "*)"}]], "Input",
