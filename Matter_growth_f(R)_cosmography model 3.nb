Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xiModel3", "[", 
     RowBox[{"q0_", ",", "j0_", ",", " ", "qfunc_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", " ", "qi"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Epsilon]", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"\"\<Model 3\>\"", ",", "q0", ",", "j0"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Use", " ", "values", " ", "of", " ", "q0"}], ",", " ", 
         RowBox[{
         "j0", " ", "today", " ", "from", " ", "MCMC", " ", "to", " ", 
          "determine", " ", "\[Epsilon]"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"qi", "=", 
        RowBox[{"qfunc", "[", "1000", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xiModel0", " ", "*", " ", 
        FractionBox[
         RowBox[{"1", "+", 
          RowBox[{
           FractionBox["3", "2"], "\[Epsilon]"}], "+", 
          RowBox[{"qi", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"3", "\[Epsilon]"}]}], ")"}]}]}], 
         RowBox[{"qi", "+", "1"}]]}]}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"xi", " ", "evaluated", " ", "at", " ", "intial", " ", "z"}], "=", 
    RowBox[{
     RowBox[{"1000", " ", "-", " ", 
      RowBox[{"so", " ", "use", " ", "qi"}]}], "=", 
     RowBox[{"q", 
      RowBox[{"(", "1000", ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9974249601324053`*^9, 3.997425060403088*^9}, {
  3.99743155345728*^9, 3.997431595519557*^9}, {3.99743189571504*^9, 
  3.997431909828464*^9}, {3.9974328532463827`*^9, 3.997432891106628*^9}, {
