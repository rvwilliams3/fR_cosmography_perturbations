Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SLegend", "[", "dataset_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"labels", ",", "dashings"}], "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
