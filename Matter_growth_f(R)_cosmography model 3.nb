d03fad99f570"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForwDE", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "qSol_", ",", "OmegaMSol_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"Function", "[", 
      RowBox[{"zval", ",", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", 
           RowBox[{"qSol", "[", "zval", "]"}]}], "-", "1"}], ")"}], 
        RowBox[{"3", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"OmegaMSol", "[", "zval", "]"}]}], ")"}]}]]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991805971779762*^9, 3.991805975645005*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"b819bc94-7edb-4ac2-8406-a09e5705ab85"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotwDE", "[", 
    RowBox[{
    "model_String", ",", "wDEAllSetsModel_Association", ",", 
     "datasets_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "plotwDE"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotwDE", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"wDEAllSetsModel", "[", "d", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", "Right"}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<z\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(w\), \(DE\)]\)(z)\>\""}], "}"}]}], ",", 
         
         RowBox[{"PlotLabel", "->", "model"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "Automatic"}], ",", 
         RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "plotwDE"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991798688568277*^9, 3.991798721763912*^9}, {
   3.991798755131542*^9, 3.991798755705574*^9}, {3.991802338699371*^9, 
