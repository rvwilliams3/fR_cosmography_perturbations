       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
