Cell["Determing \[Epsilon] from j0", "Subsubsection",
 CellChangeTimes->{{3.9950810705842648`*^9, 
  3.995081081415485*^9}},ExpressionUUID->"119a685f-0ab7-461b-902f-\
d06ff6cdad3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 0\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 1\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "+", "1"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 2\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "j0"}]}], ";", 
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"j0", "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"q0", "-", 
       FractionBox["1", "2"]}], ")"}]}]]}], ";"}]}], "Input",
