         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<z\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(w\), \(DE\)]\)(z)\>\""}], "}"}]}], ",", 
         
         RowBox[{"PlotLabel", "->", "model"}], ",", 
