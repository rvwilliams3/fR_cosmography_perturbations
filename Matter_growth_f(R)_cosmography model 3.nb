Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "selected", ",", "bgRes", ",", "xiLabels", ",", "checkTable", ",", 
        "pX", ",", "pOmega"}], "}"}], ",", 
      RowBox[{
       RowBox[{"selected", "=", 
        RowBox[{"SelectEvenXi", "[", 
         RowBox[{
          RowBox[{"sweepResults", "[", "dataset", "]"}], ",", "nPoints"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allSelected", "[", "dataset", "]"}], "=", "selected"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"selected", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"dataset", "<>", "\"\<: no points with xToday >= \>\"", "<>", 
              RowBox[{"ToString", "[", "xTodayThreshold", "]"}]}], ",", 
             "Red"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bgRes", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "xi0", ",", "Omega0", ",", "label", ",", "calibratedICs", ",", 
               "res"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"xi0", "=", 
               RowBox[{"row", "[", "\"\<xi\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Omega0", "=", 
               RowBox[{"row", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"label", "=", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}], ",", 
                  "\"\< = \>\"", ",", 
                  RowBox[{"ScientificForm", "[", 
                   RowBox[{"xi0", ",", "3"}], "]"}]}], "}"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"calibratedICs", "=", 
               RowBox[{"<|", 
                RowBox[{"dataset", "->", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<xIn\>\"", "->", "xi0"}], ",", 
                   RowBox[{"\"\<OmegaIn\>\"", "->", "Omega0"}]}], "|>"}]}], 
                "|>"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"res", "=", 
               RowBox[{"SolveBackground", "[", 
                RowBox[{"model", ",", "dataset", ",", "calibratedICs"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"label", "->", "res"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"row", ",", "selected"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allBgResults3", "[", "dataset", "]"}], "=", "bgRes"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xiLabels", "=", 
        RowBox[{"Keys", "[", "bgRes", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "consistency", " ", "check", " ", "against", " ", "the", " ", 
         RowBox[{"sweep", "'"}], "s", " ", "own", " ", 
         RowBox[{"xToday", "/", "OmegaToday"}]}], "*)"}], 
       RowBox[{"checkTable", "=", 
        RowBox[{"Grid", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#1", "[", "\"\<xi\>\"", "]"}], ",", 
                 RowBox[{"#1", "[", "\"\<\[CapitalOmega]i\>\"", "]"}], ",", 
                 RowBox[{"#1", "[", "\"\<xToday\>\"", "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"bgRes", "[", "#2", "]"}], "[", "\"\<x\>\"", "]"}],
                   "[", "0", "]"}], ",", 
                 RowBox[{"#1", "[", "\"\<\[CapitalOmega]Today\>\"", "]"}], 
                 ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"bgRes", "[", "#2", "]"}], "[", 
                   "\"\<\[CapitalOmega]\>\"", "]"}], "[", "0", "]"}]}], "}"}],
