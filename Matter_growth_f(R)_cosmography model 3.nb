Cell[CellGroupData[{

Cell["Modules", "Subsubsection",
 CellChangeTimes->{{3.991797620196929*^9, 
  3.991797621100827*^9}},ExpressionUUID->"10be2a4e-709b-4708-b01e-\
a2c5a0326987"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForOmegaM", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "EhSol_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "Om0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"allParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Om0", "=", 
       RowBox[{
        RowBox[{"params", "[", "\"\<Om0\>\"", "]"}], "[", "\"\<mean\>\"", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Om0val", "=", "Om0"}], "}"}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"zval", ",", 
          RowBox[{"Om0val", "*", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "zval"}], ")"}], "^", "3"}], "/", 
            RowBox[{
             RowBox[{"EhSol", "[", "zval", "]"}], "^", "2"}]}]}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991797259348854*^9, 3.991797299738673*^9}, {
  3.992251896107728*^9, 3.992251906759664*^9}, {3.995337120063747*^9, 
  3.995337121412181*^9}, {3.995337401110384*^9, 3.995337402234537*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"84ca55b9-8a2f-4352-822a-1e6124785ec6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotOmegaM", "[", 
    RowBox[{"model_String", ",", "OmegaMAllSetsModel_Association", ",", 
     RowBox[{"zmax_", ":", "zPlot"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"datasets", ",", "colours", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"Keys", "[", "OmegaMAllSetsModel", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"colours", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{"colours", ",", "datasets", ",", 
         RowBox[{"LegendMarkerSize", "->", "20"}], ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"RoundingRadius", "->", "0"}], ",", 
              RowBox[{"Background", "->", "White"}], ",", 
              RowBox[{"FrameStyle", "->", "Gray"}]}], "]"}], "&"}], ")"}]}]}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OmegaMAllSetsModel", "[", "ds", "]"}], "[", "z", "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"ds", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "colours"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"1.05", ",", "0.5"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<z\>\"", ",", 
           "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(m\)]\)(z)\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", "model"}], ",", 
        RowBox[{"ImageSize", "->", "1000"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991797580556682*^9, 3.991797580559007*^9}, {
  3.9917978138890953`*^9, 3.991797846168994*^9}, {3.991797901576439*^9, 
