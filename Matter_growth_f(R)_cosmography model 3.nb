Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DTableAtZ", "[", 
     RowBox[{"zval_", ":", "10"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rows", "}"}], ",", 
      RowBox[{
       RowBox[{"rows", "=", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"byK", ",", "vals"}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"byK", "=", 
                RowBox[{
                 RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"vals", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "zval", "]"}], "/", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "0", "]"}]}], ",", 
                  
                  RowBox[{"{", 
                   RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"dataset", ",", "label"}], "}"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"NumberForm", "[", 
                    RowBox[{"#", ",", "6"}], "]"}], "&"}], "/@", "vals"}]}], 
                "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"label", ",", 
              RowBox[{"Keys", "[", 
               RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], 
             "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{"rows", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Dataset\>\"", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<x\>\"", ",", "\"\<i\>\""}], "]"}]}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"ToString", "[", "#", "]"}], "<>", 
                 "\"\< h/Mpc\>\""}], "&"}], "/@", "kPhys"}]}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"Frame", "->", "All"}], ",", 
         RowBox[{"Alignment", "->", "Left"}], ",", 
         RowBox[{"ItemStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"FontSize", "->", "11"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"DTableAtZ", "[", "10", "]"}]}], "Input",
 CellChangeTimes->{{3.996589005635829*^9, 3.996589005637906*^9}, {
  3.9965890692812777`*^9, 3.996589072416823*^9}, {3.996589134745347*^9, 
