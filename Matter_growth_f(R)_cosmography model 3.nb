           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "dataset"}], ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"OptionValue", "[", "ImageSize", "]"}]}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"1", "/", "2"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
