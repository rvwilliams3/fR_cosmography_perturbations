Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotQBand", "[", 
    RowBox[{"model_String", ",", "bandAssoc_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dsets", ",", "cols", ",", "bands", ",", "means"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dsets", "=", 
       RowBox[{"Keys", "[", "bandAssoc", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cols", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", "97", "]"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "dsets", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bands", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"bandAssoc", "[", 
               RowBox[{"dsets", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"c", "=", 
              RowBox[{"cols", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "[", "\"\<lo\>\"", "]"}], "[", "z", "]"}], ",", 
               RowBox[{
                RowBox[{"b", "[", "\"\<hi\>\"", "]"}], "[", "z", "]"}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
             RowBox[{"Filling", "->", 
              RowBox[{"{", 
               RowBox[{"1", "->", 
                RowBox[{"{", "2", "}"}]}], "}"}]}], ",", 
             RowBox[{"FillingStyle", "->", 
              RowBox[{"Directive", "[", 
               RowBox[{"c", ",", 
                RowBox[{"Opacity", "[", "0.18", "]"}]}], "]"}]}], ",", 
             RowBox[{"PlotStyle", "->", 
              RowBox[{"Directive", "[", 
               RowBox[{"c", ",", 
                RowBox[{"Opacity", "[", "0.35", "]"}], ",", "Thin"}], "]"}]}],
              ",", 
             RowBox[{"PlotPoints", "->", "60"}], ",", 
             RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "dsets", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"means", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bandAssoc", "[", "d", "]"}], "[", "\"\<mean\>\"", 
              "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "dsets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "cols"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Legended", "[", 
       RowBox[{
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"bands", ",", 
            RowBox[{"{", "means", "}"}]}], "]"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<z\>\"", ",", "\"\<q(z)\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", "model"}], ",", 
          RowBox[{"GridLines", "->", "Automatic"}], ",", 
          RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{"cols", ",", "dsets", ",", 
            RowBox[{"LegendFunction", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                 RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
              ")"}]}], ",", 
            RowBox[{"LegendLayout", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Column\>\"", ",", "1"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.6", ",", "0.25"}], "}"}]}], "]"}]}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",
