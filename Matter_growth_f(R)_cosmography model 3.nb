                    "}"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"s", ",", "sols"}], "}"}]}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"dataset", ",", "datasets"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
