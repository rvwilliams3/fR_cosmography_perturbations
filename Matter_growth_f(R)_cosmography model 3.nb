Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BuildwDEBand", "[", 
     RowBox[{
     "model_String", ",", "dataset_String", ",", "qBand_Association", ",", 
      "OmBand_Association"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qc", ",", "omc", ",", "nOm", ",", "fns", ",", "meanFn"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"qc", "=", 
        RowBox[{
         RowBox[{"qBand", "[", "dataset", "]"}], "[", "\"\<corners\>\"", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"omc", "=", 
        RowBox[{
         RowBox[{"OmBand", "[", "dataset", "]"}], "[", "\"\<corners\>\"", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nOm", "=", 
        RowBox[{
         RowBox[{"Length", "[", "omc", "]"}], "/", 
         RowBox[{"Length", "[", "qc", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fns", "=", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"SolveForwDE", "[", 
            RowBox[{"model", ",", "dataset", ",", 
             RowBox[{"qc", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"omc", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], " ", "nOm"}], "+", "b"}], 
               "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "qc", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"b", ",", "nOm"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanFn", "=", 
        RowBox[{"SolveForwDE", "[", 
         RowBox[{"model", ",", "dataset", ",", 
          RowBox[{
           RowBox[{"qBand", "[", "dataset", "]"}], "[", "\"\<mean\>\"", "]"}],
           ",", 
          RowBox[{
           RowBox[{"OmBand", "[", "dataset", "]"}], "[", "\"\<mean\>\"", 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ff", "=", "fns"}], ",", 
           RowBox[{"mf", "=", "meanFn"}]}], "}"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<mean\>\"", "->", "mf"}], ",", 
           RowBox[{"\"\<lo\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Through", "[", 
                RowBox[{"ff", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
           ",", 
           RowBox[{"\"\<hi\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Through", "[", 
                RowBox[{"ff", "[", "#", "]"}], "]"}], "]"}], "&"}], ")"}]}], 
           ",", 
           RowBox[{"\"\<corners\>\"", "->", "ff"}]}], "|>"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"wBand3", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "->", 
        RowBox[{"BuildwDEBand", "[", 
         RowBox[{
         "\"\<Model 3\>\"", ",", "#", ",", "qBandAssoc3", ",", 
          "OmBandData3"}], "]"}]}], "&"}], ",", "plotModels"}], "]"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9983580676678147`*^9, 3.998358067670337*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"3376851a-dd32-47a4-80e2-f63901db8c9a"],

