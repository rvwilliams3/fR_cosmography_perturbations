292c379a477f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kLabels", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<k = \>\"", ",", "#", ",", "\"\< h Mpc\>\"", ",", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<\>\"", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
    "kPhys"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996588495528636*^9, 3.996588499050249*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"f061cb6b-4ab1-4f0d-a032-2858f0475e64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotNormalisedD", "[", 
    RowBox[{"dataset_String", ",", "label_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"byK", ",", "curves"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"byK", "=", 
       RowBox[{
        RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "z", "]"}], "/", 
          RowBox[{
           RowBox[{
            RowBox[{"byK", "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", 
            "]"}], "[", "0", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"LogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"Automatic", ",", "kLabels", ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"RoundingRadius", "->", "0"}], ",", 
                  RowBox[{"FrameStyle", "->", 
                   RowBox[{"GrayLevel", "[", "0.5", "]"}]}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "10"}], "}"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.2", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<D(z)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"dataset", ",", "\"\<   \>\"", ",", "label"}], "}"}], 
          "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9965885264646883`*^9, 3.996588576543861*^9}, {
  3.996588946972764*^9, 3.9965889821548347`*^9}, {3.9966240679730062`*^9, 
