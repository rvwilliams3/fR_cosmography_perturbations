  RowBox[{
   RowBox[{"FEndpointTable", "[", 
    RowBox[{"datasets_List", ",", "Om0Func_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "rows", "}"}], ",", 
     RowBox[{
      RowBox[{"rows", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
