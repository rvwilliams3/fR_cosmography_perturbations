                 RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "label", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"vals", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"byK", "[", "kp", "]"}], "[", 
                    "\"\<\[CapitalDelta]\>\"", "]"}], "[", "zval", "]"}], "/", 
