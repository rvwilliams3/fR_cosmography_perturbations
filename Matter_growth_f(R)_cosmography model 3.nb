   3.995085503068851*^9}, {3.995085631528084*^9, 3.995085631723854*^9}, {
   3.99524484729762*^9, 3.995244857942257*^9}, {3.995244892243965*^9, 
   3.995244893351142*^9}, {3.995340453135955*^9, 3.995340496305465*^9}, {
