Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", "z", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["khat", "2"], " ", "w", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], "2"]}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox[
        RowBox[{"Eh", "[", "z", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "w", " ", 
          RowBox[{"q", "[", "z", "]"}]}], "+", 
         RowBox[{"2", " ", "w", " ", 
          RowBox[{"x", "[", "z", "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "w"}], ")"}], " ", 
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}]}]}], ")"}]}]}], ")"}]}], 
   "-", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"6", " ", 
      SuperscriptBox[
       RowBox[{"Eh", "[", "z", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", "-", 
         RowBox[{"j", "[", "z", "]"}], "+", 
         RowBox[{"q", "[", "z", "]"}]}], ")"}], "2"]}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "w"}], ")"}], " ", 
     RowBox[{"\[ScriptCapitalR]hat", "[", "z", "]"}], " ", 
     RowBox[{"(", 
