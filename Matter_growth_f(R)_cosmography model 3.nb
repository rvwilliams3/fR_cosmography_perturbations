77963c8799b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SFunc", "[", 
    RowBox[{"dataset_String", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"z_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"DeltaFn", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"pertResults3", "[", "dataset", "]"}], "[", "lab", "]"}], 
         "[", "kp", "]"}], "[", "\"\<\[CapitalDelta]\>\"", "]"}]}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"DeltaFn", "'"}], "[", "z", "]"}], "/", 
       RowBox[{"DeltaFn", "[", "z", "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996735267359165*^9, 3.996735271140725*^9}},
 CellLabel->
  "In[254]:=",ExpressionUUID->"c96cea70-f234-4689-a443-f77b3242cb36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kDashings", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Dashing", "[", 
      RowBox[{"{", "}"}], "]"}], ",", 
     RowBox[{"Dashing", "[", 
      RowBox[{"{", 
       RowBox[{"0.02", ",", "0.015"}], "}"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PlotSAllModes", "[", 
    RowBox[{"dataset_String", ",", "kIdx_List", ",", 
     RowBox[{"zmax_", ":", "6"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "labels", ",", "legLabels", ",", "kSel", ",", "kSelLabels", ",", 
       "curves", ",", "styles", ",", "legFn", ",", "legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legLabels", "=", 
       RowBox[{"labels", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"tag", " ", "only"}], ";", 
        RowBox[{
        "use", " ", "\"\<labels\>\"", " ", "for", " ", "the", " ", "full", 
         " ", "x_i", " ", "text"}]}], "*)"}], 
      RowBox[{"kSel", "=", 
       RowBox[{"kPhys", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"kSelLabels", "=", 
       RowBox[{"kLabels", "[", 
        RowBox[{"[", "kIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"SFunc", "[", 
           RowBox[{"dataset", ",", "lab", ",", "kp", ",", "zz"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"lab", ",", "labels"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"kp", ",", "kSel"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "i", "]"}], ",", 
             RowBox[{"kDashings", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "labels", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "kSel", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"legFn", "=", 
       RowBox[{
        RowBox[{"Framed", "[", 
         RowBox[{"#", ",", 
          RowBox[{"RoundingRadius", "->", "0"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"GrayLevel", "[", "0.5", "]"}]}], ",", 
          RowBox[{"Background", "->", 
           RowBox[{"GrayLevel", "[", 
            RowBox[{"1", ",", "0.9"}], "]"}]}], ",", 
          RowBox[{"FrameMargins", "->", "4"}]}], "]"}], "&"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"legend", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "labels", "]"}], "]"}]}], ",", 
             "legLabels", ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}], ",", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "#"}], "]"}], "&"}], "/@", 
              "kDashings"}], ",", "kSelLabels", ",", 
             RowBox[{"LegendFunction", "->", "legFn"}], ",", 
             RowBox[{"LabelStyle", "->", 
              RowBox[{"{", 
               RowBox[{"FontSize", "->", "9"}], "}"}]}], ",", 
             RowBox[{"LegendMargins", "->", "0"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"Spacings", "->", "0.3"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"zz", ",", "0", ",", "zmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "styles"}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"legend", ",", 
           RowBox[{"{", 
            RowBox[{"0.83", ",", "0.32"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", "1", "}"}]}], "}"}]}], ",", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", "Dashed", ",", 
           RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<z\>\"", ",", "\"\<S(z)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"dataset", ",", "\"\<  \[LongDash]  \>\"", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"kIdx", "===", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}]}], ",", "\"\<large scales\>\"",
               ",", "\"\<small scales\>\""}], "]"}]}], "}"}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9983669965664597`*^9, 3.998367009438573*^9}},
 CellLabel->
  "In[255]:=",ExpressionUUID->"e202a19d-866a-43af-99ec-70d2aa16f23b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SLegend", "[", 
    RowBox[{"dataset_String", ",", "kIdx_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "labels", "}"}], ",", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"pertResults3", "[", "dataset", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
