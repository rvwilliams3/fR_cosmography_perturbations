Cell[TextData[{
 "Note that for building the pert ICs then we get a bigger ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "i"], "'"}], " ", "than", " "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41392729-5686-4712-87e4-1ce5f8b188eb"],
 "for example 21cm paper (our ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "m"], "(", 
    SubscriptBox["z", "i"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "206b1523-9cb9-4b0a-9bbd-4966f3916c7c"],
 " is slightly larger) --> this is probably what is causing the larger \
deviation from LCDM"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.998658150497353*^9, 3.998658217868279*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"3afa6179-b5d6-4f1e-b6a1-d3e10de5c45e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildPertICs", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "sys_Association", ",", 
     RowBox[{"DeltaIn_", ":", 
      SuperscriptBox["10", 
       RowBox[{"-", "5"}]]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "zi", ",", "Omi", ",", "Oi", ",", "Ehi", ",", "DeltaPrimei", ",", "Ri", 
       ",", "RPrimei"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zi", "=", 
       RowBox[{"sys", "[", "\"\<zinitial\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Ehi", "=", 
       RowBox[{"sys", "[", "\"\<Ehi\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Omi", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"OmegamAssoc", "[", "model", "]"}], "[", "dataset", "]"}], 
        "[", "zi", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"MCMC", " ", "\[CapitalOmega]m", 
        RowBox[{"(", "z", ")"}]}], "*)"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Oi", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
            "]"}], "[", "dataset", "]"}], "[", 
          RowBox[{"sys", "[", "\"\<label\>\"", "]"}], "]"}], "[", 
         "\"\<\[CapitalOmega]\>\"", "]"}], "[", "zi", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DeltaPrimei", "=", 
       FractionBox[
        RowBox[{"-", "DeltaIn"}], 
        RowBox[{"1", "+", "zi"}]]}], ";", "          ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"growing", " ", "mode", " ", "S_i"}], "=", "1"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Ri", "=", 
       RowBox[{"3", " ", 
        SuperscriptBox["Ehi", "2"], "Oi", " ", "DeltaIn"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RPrimei", "=", 
       RowBox[{
        FractionBox["Ri", 
         RowBox[{"(", 
          RowBox[{"1", "+", "zi"}], ")"}]], " ", 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "zi"}], ")"}], " ", 
           FractionBox["DeltaPrimei", "DeltaIn"]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<\[CapitalDelta]i\>\"", "->", "DeltaIn"}], ",", 
        RowBox[{"\"\<\[CapitalDelta]primei\>\"", "->", "DeltaPrimei"}], ",", 
        RowBox[{"\"\<Ri\>\"", "->", "Ri"}], ",", 
        RowBox[{"\"\<Rprimei\>\"", "->", "RPrimei"}], ",", 
        RowBox[{"\"\<zi\>\"", "->", "zi"}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", "Ehi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]mi\>\"", "->", "Omi"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "Oi"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996579416288781*^9, 3.996579416290544*^9}, {
  3.996579592835923*^9, 3.996579631460242*^9}, {3.996580731653688*^9, 
