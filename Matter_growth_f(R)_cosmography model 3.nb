Cell[CellGroupData[{

Cell["Fitting parameterisation", "Subsection",
 CellChangeTimes->{{3.9973465008392572`*^9, 
  3.9973465058648567`*^9}},ExpressionUUID->"53c435d3-07d6-488f-b8e1-\
54dd4ae3e74e"],

Cell[TextData[{
 "Using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[CapitalOmega]", "m"], "\[Gamma]"], 
     RowBox[{
      SuperscriptBox["Q", "\[Eta]"], ":"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c29407f-d6d2-4f08-95cc-0df4e70ed931"],
 "\n\t Log(S) = \[Gamma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "(", 
    SubscriptBox["\[CapitalOmega]", "m"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f96f432-8621-424f-897b-d4a701073fa9"],
 " + \[Eta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Log", "(", "Q", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "250d0724-e9c2-496a-8767-4685a29658d7"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9974092638311453`*^9, 3.9974093813552523`*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"938e8890-267d-4ee6-86a7-87f98204f444"],

Cell["\<\
Unweighted linear best fit, using Mathematica function LinearModelFit[] to \
determine best fit values for \[Gamma] and \[Eta]\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.997409410788245*^9, 3.99740941677775*^9}, {
  3.997409732159932*^9, 3.997409775184292*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"bba026c0-a790-40f2-ba23-562ea86f53d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitGamEta", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "lm", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Comstruct", " ", "the", " ", "linear", " ", "model", " ", "fit"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lm", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"data", ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "v"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"basis", " ", "functions"}], " ", "-", " ", 
            RowBox[{"model", " ", "is", " ", "y"}]}], "=", 
           RowBox[{"\[Gamma]u", "+", "\[Eta]v"}]}], "*)"}], " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "v"}], "}"}], ",", " ", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"variables", " ", "-", " ", 
            RowBox[{"column", " ", "1", " ", 
             RowBox[{"(", "x1", ")"}], " ", "maps", " ", "to", " ", "u"}]}], 
           ",", " ", 
           RowBox[{"column", " ", "2", " ", 
            RowBox[{"(", "x2", ")"}], " ", "maps", " ", "to", " ", "v"}]}], 
          "*)"}], " ", 
         RowBox[{"IncludeConstantBasis", "->", "False"}]}], " ", 
        RowBox[{"(*", 
         RowBox[{"No", " ", "intercept"}], "*)"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<gamma\>\"", "->", 
         RowBox[{
          RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<eta\>\"", "->", 
         RowBox[{
          RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<R2\>\"", "->", 
         RowBox[{"lm", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
        RowBox[{"\"\<fit\>\"", "->", "lm"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997346513963874*^9, 3.997346514392867*^9}, 
   3.99740918820774*^9, {3.997409514250834*^9, 3.997409690277553*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"53e596f5-2c11-4ef5-87ce-1fb06f00ddf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitDataOne", "[", 
    RowBox[{"model_", ",", "dataset_", ",", "lab_", ",", "kp_", ",", 
     RowBox[{"zmin_", ":", "0.0"}], ",", 
     RowBox[{"zmax_", ":", "6"}], ",", 
     RowBox[{"dz_", ":", "0.05"}]}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", "=", 
         RowBox[{"QParts", "[", 
          RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp", ",", "zv"}],
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<\[CapitalOmega]m\>\"", "]"}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<Q\>\"", "]"}], "]"}], ",", 
         RowBox[{"Log", "[", 
          RowBox[{"p", "[", "\"\<S\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     
     RowBox[{"(*", 
      RowBox[{"writing", " ", "data", " ", "as", " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", " ", 
         SubscriptBox["x", "2"], ",", " ", "y"}], ")"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"zv", ",", "zmin", ",", "zmax", ",", "dz"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997411427810939*^9, 3.997411452698987*^9}, 
   3.9974123840772867`*^9},
 CellLabel->
  "In[275]:=",ExpressionUUID->"09fbfe1a-257b-4925-a5a1-6ccef3dd6b57"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fitTable", "[", 
    RowBox[{"model_", ",", "dataset_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"labs", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
          "]"}], "[", "dataset", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Prepend", "[", 
           RowBox[{"kLabels", ",", "\"\<\>\""}], "]"}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"f", "=", 
                   RowBox[{"fitGamEta", "[", 
                    RowBox[{"fitDataOne", "[", 
                    RowBox[{"model", ",", "dataset", ",", "lab", ",", "kp"}], 
                    "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"Column", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<\[Gamma] = \>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"f", "[", "\"\<gamma\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], 
                    ",", 
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<\[Eta] = \>\"", ",", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"f", "[", "\"\<eta\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
                    "}"}], "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"kp", ",", "kPhys"}], "}"}]}], "]"}], ",", "lab"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"lab", ",", "labs"}], "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"Frame", "->", "All"}], ",", 
       RowBox[{"Alignment", "->", "Left"}], ",", 
       RowBox[{"Background", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           RowBox[{"LightGray", ",", 
            RowBox[{"{", "None", "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997411317334583*^9, 3.997411317337128*^9}, {
  3.997411423286209*^9, 3.997411433047305*^9}, {3.997411470612935*^9, 
  3.997411471000742*^9}},
 CellLabel->
  "In[276]:=",ExpressionUUID->"17e7af1d-1eae-4669-ae90-d03935f52dc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"dataset", ",", "Bold"}], "]"}], ",", 
       RowBox[{"fitTable", "[", 
        RowBox[{"\"\<Model 3\>\"", ",", "dataset"}], "]"}]}], "}"}], "]"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], 
