Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SelectEvenXi", "[", 
    RowBox[{"sweepResult_Association", ",", "nPoints_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filtered", ",", "xiVals", ",", "targets", ",", "idx"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"filtered", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"sweepResult", "[", "\"\<table\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<xToday\>\"", "]"}], ">=", 
           "xTodayThreshold"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"filtered", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"filtered", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<xi\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xiVals", "=", 
       RowBox[{"filtered", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "filtered", "]"}], "<=", "nPoints"}], ",", 
        RowBox[{"Return", "[", "filtered", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"targets", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"Min", "[", "xiVals", "]"}], ",", 
         RowBox[{"Max", "[", "xiVals", "]"}], ",", 
         RowBox[{"nPoints", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"xiVals", "-", "#"}], "]"}], ",", "1"}], "]"}], "]"}], 
          "&"}], "/@", "targets"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"filtered", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995342581787116*^9, 3.995342593687205*^9}, {
   3.995342780847473*^9, 3.995342781419993*^9}, {3.995343085279057*^9, 
   3.995343087267094*^9}, 3.9953433559472427`*^9, {3.995345706032874*^9, 
