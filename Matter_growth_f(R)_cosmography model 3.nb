Cell[CellGroupData[{

Cell["Perturbation system", "Subsubsection",
 CellChangeTimes->{{3.9965766337723413`*^9, 3.996576637385913*^9}, {
  3.996583058222735*^9, 
  3.996583061096446*^9}},ExpressionUUID->"419d50a8-4d63-4a05-8941-\
bb12c49b923e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BuildPertSystem", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "idx_Integer", ",", 
     RowBox[{"khatVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "store", ",", "cg", ",", "jE", ",", "sE", ",", "lE", ",", "bg", ",", 
       "label", ",", "xFn", ",", "OmFn", ",", "qFn", ",", "EhFn", ",", 
       "cgRules", ",", "bgRules"}], "}"}], ",", 
     RowBox[{
      RowBox[{"store", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"bgRun", "[", "model", "]"}], "[", "\"\<bgResults\>\"", 
         "]"}], "[", "dataset", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cg", "=", 
       RowBox[{
        RowBox[{"cgAssoc", "[", "model", "]"}], "[", "dataset", "]"}]}], " ", 
      
      RowBox[{"(*", 
       RowBox[{"cosmographic", " ", 
        RowBox[{"(", 
         RowBox[{"s", ",", "l"}], ")"}], " ", "functions"}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"jE", ",", "sE", ",", "lE"}], "}"}], "=", 
       RowBox[{"cg", "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<j\>\"", ",", "\"\<s\>\"", ",", "\"\<l\>\""}], "}"}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "store", "]"}], "[", 
        RowBox[{"[", "idx", "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "idx", " ", "associates", " ", "which", " ", "initial", " ", 
        "condition", " ", "on", " ", "x", " ", "is", " ", "being", " ", 
        "used"}], "*)"}], 
      RowBox[{"bg", "=", 
       RowBox[{"store", "[", "label", "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"x", " ", "and", " ", "Omega", " ", "functions"}], "*)"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"xFn", "=", 
       RowBox[{"bg", "[", "\"\<x\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"OmFn", "=", 
       RowBox[{"bg", "[", "\"\<\[CapitalOmega]\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"bg", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"EhFn", "=", 
       RowBox[{
        RowBox[{"EAssocByModel", "[", "model", "]"}], "[", "dataset", "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"cgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "[", "z", "]"}], "->", "jE"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "z", "]"}], "->", "sE"}], ",", 
         RowBox[{
          RowBox[{"l", "[", "z", "]"}], "->", "lE"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"cosmography", " ", 
         RowBox[{"first", ":", " ", "j"}]}], ",", "s", ",", 
        RowBox[{"l", " ", "still", " ", "contain", " ", "free", " ", 
         RowBox[{"q", "[", "z", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"bgRules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z", "]"}], "->", 
          RowBox[{"qFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "z", "]"}], "->", 
          RowBox[{"xFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "->", 
          RowBox[{"OmFn", "[", "z", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Eh", "[", "z", "]"}], "->", 
          RowBox[{"EhFn", "[", "z", "]"}]}], ",", 
         RowBox[{"khat", "->", "khatVal"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"then", " ", "bind", " ", "the", " ", "interpolants"}], "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eqR\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ReqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<eqD\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DeltaeqnSolveDust", "/.", " ", "cgRules"}], "/.", " ", 
           "bgRules"}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<khat\>\"", "->", "khatVal"}], ",", 
        RowBox[{"\"\<xi\>\"", "->", 
         RowBox[{"bg", "[", "\"\<xi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", 
         RowBox[{"bg", "[", "\"\<\[CapitalOmega]i\>\"", "]"}]}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", 
         RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}]}], ",", 
        RowBox[{"\"\<eps\>\"", "->", 
         RowBox[{"cg", "[", "\"\<eps\>\"", "]"}]}], ",", 
        RowBox[{"\"\<q0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<q0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<j0\>\"", "->", 
         RowBox[{"cg", "[", "\"\<j0\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Ehi\>\"", "->", 
         RowBox[{"EhFn", "[", 
          RowBox[{"bg", "[", "\"\<zinitial\>\"", "]"}], "]"}]}]}], "|>"}]}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996577281073994*^9, 3.996577300952786*^9}, {
  3.996577333689823*^9, 3.996577386791966*^9}, {3.996577475052778*^9, 
  3.996577488721834*^9}, {3.996579377334917*^9, 3.996579379263138*^9}, {
  3.997255009879788*^9, 3.9972550696026297`*^9}},
