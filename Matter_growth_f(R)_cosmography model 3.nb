                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"F", ",", "zi"}], "}"}], ",", 
                  RowBox[{
                   RowBox[{"F", "=", 
                    RowBox[{"FOfz", "[", 
                    RowBox[{"dataset", ",", "s", ",", 
                    RowBox[{"Om0Func", "[", "dataset", "]"}]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"zi", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"s", ",", "\"\<zinitial\>\"", ",", "1000"}], 
