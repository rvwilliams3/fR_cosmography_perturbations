               RowBox[{
                RowBox[{"h", "[", "zinitial", "]"}], "==", 
                RowBox[{"hLCDM", "[", "zinitial", "]"}]}]}], "}"}], ",", 
             RowBox[{"{", "h", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "zinitial", ",", "0"}], "}"}], ",", " ", 
             RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
             RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"hFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sol", "=", 
              RowBox[{"h", "/.", "hsol"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
              RowBox[{"sol", "[", "z", "]"}]}], "]"}]}], "]"}]}], ";"}]}], 
       "\n", "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
