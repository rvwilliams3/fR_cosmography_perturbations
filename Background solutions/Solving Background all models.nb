Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{"jModel_", ",", "ICs_List", ",", " ", "\[Epsilon]Val_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "z0", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0", ",", "sExpr", ",", 
       "lExpr", ",", "solFwd", ",", "solBwd", ",", " ", "hsolFwd", ",", " ", 
       "hsolBwd", ",", " ", "xFn", ",", " ", "\[CapitalOmega]Fn", ",", " ", 
       "qFn", ",", " ", "hFn"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z0", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0"}], "}"}], 
       "=", "ICs"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "s", ",", "l", ",", " ", "\[Epsilon]"}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "\[Epsilon]Val"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", "jModel"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Solve", "[", 
              RowBox[{"ds", ",", 
               RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"q", "'"}], "[", "z", "]"}], "->", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{"dq", ",", 
                RowBox[{
                 RowBox[{"q", "'"}], "[", "z", "]"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}]}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Forward", ":", "z0"}], "->", "0"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"solFwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dx", ",", "d\[CapitalOmega]", ",", "dq", ",", 
               RowBox[{
                RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
               RowBox[{
                RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                "\[CapitalOmega]0"}], ",", 
               RowBox[{
                RowBox[{"q", "[", "z0", "]"}], "==", "q0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "0"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Backward", ":", "z0"}], "->", "zinitial"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"solBwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dx", ",", "d\[CapitalOmega]", ",", "dq", ",", 
               RowBox[{
                RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
               RowBox[{
                RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                "\[CapitalOmega]0"}], ",", 
               RowBox[{
                RowBox[{"q", "[", "z0", "]"}], "==", "q0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "zinitial"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"hsolFwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dh", "/.", " ", "solFwd"}], ",", 
               RowBox[{
                RowBox[{"h", "[", "z0", "]"}], "==", "hi"}]}], "}"}], ",", 
             RowBox[{"{", "h", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "0"}], "}"}], ",", " ", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
