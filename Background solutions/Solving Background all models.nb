   RowBox[{"\[CapitalOmega]m", "[", "z_", "]"}], " ", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalOmega]m0", " "}], 
     SuperscriptBox[
      RowBox[{"h", "[", "z", "]"}], "2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], "3"]}]}], ";"}]}], "Input",
