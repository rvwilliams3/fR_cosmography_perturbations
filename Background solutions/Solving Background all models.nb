                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", "<=", "z0val"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
         RowBox[{"qFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"q", "/.", " ", "solFwd"}]}], ",", 
              RowBox[{"bwd", "=", 
               RowBox[{"q", "/.", " ", "solBwd"}]}], ",", 
              RowBox[{"z0val", "=", "z0"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
