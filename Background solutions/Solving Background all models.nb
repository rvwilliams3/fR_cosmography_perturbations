  RowBox[{
   RowBox[{"weff", "[", "z_", "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"2", 
      RowBox[{"q", "[", "z", "]"}]}], "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
