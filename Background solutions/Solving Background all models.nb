Cell[BoxData[{
 RowBox[{"RDotplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements1"}], "/.", 
        "replacements1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements2"}], "/.", 
        "replacements2"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements3"}], "/.", 
        "replacements3"}], ",", 
       RowBox[{
        RowBox[{"Rdot", "[", "z", "]"}], "/.", "LCDMreplacements"}]}], "}"}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ImageSize", "->", "500"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "z0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10000"}], ",", 
         RowBox[{"-", "10"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"OverDot", "[", "\"\<R\>\"", "]"}], ",", 
          "\"\<(z) * \!\(\*SubscriptBox[\(H\), \(0\)]\)\>\""}], "}"}], 
        "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
