       RowBox[{"\"\<z\>\"", ",", " ", "\"\<h(z)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hRes0", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"dh", "/.", "replacements0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", " ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<z\>\"", ",", " ", "\"\<Residuals\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotRange", "->", "All"}], ",", " ", 
     RowBox[{"Frame", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"hPlot0", "=", 
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"hplot0", ",", " ", "hRes0"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "1100"}]}], "]"}]}], "\[IndentingNewLine]", 
