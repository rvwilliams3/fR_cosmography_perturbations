Cell[BoxData[{
 RowBox[{"RDotplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements1"}], "/.", 
        "replacements1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements2"}], "/.", 
        "replacements2"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements3"}], "/.", 
        "replacements3"}], ",", 
       RowBox[{
        RowBox[{"Rdot", "[", "z", "]"}], "/.", "LCDMreplacements"}]}], "}"}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ImageSize", "->", "500"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "z0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10000"}], ",", 
         RowBox[{"-", "10"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"OverDot", "[", "\"\<R\>\"", "]"}], ",", 
          "\"\<(z) * \!\(\*SubscriptBox[\(H\), \(0\)]\)\>\""}], "}"}], 
        "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Model 0\>\"", ",", "\"\<Model 1\>\"", ",", " ", 
           "\"\<Model 2\>\"", ",", " ", "\"\<Model 3\>\"", ",", " ", 
           "\"\<\[CapitalLambda]CDM\>\""}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"FrameStyle", "->", "Gray"}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
           ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"0.2", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Append", "[", 
      RowBox[{"colour", ",", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed", ",", 
         RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}], ",", " ", 
    RowBox[{"PlotRangePadding", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", " ", 
       RowBox[{"Scaled", "[", ".05", "]"}]}], "}"}]}]}], 
