Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{"jModel_", ",", "ICs_List", ",", " ", "\[Epsilon]Val_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "z0", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0", ",", "sExpr", ",", 
       "lExpr", ",", "solFwd", ",", "solBwd", ",", " ", "hsolFwd", ",", " ", 
       "hsolBwd", ",", " ", "xFn", ",", " ", "\[CapitalOmega]Fn", ",", " ", 
       "qFn", ",", " ", "hFn"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z0", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0"}], "}"}], 
       "=", "ICs"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"j", ",", "s", ",", "l", ",", " ", "\[Epsilon]"}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "\[Epsilon]Val"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", "jModel"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Solve", "[", 
              RowBox[{"ds", ",", 
               RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"q", "'"}], "[", "z", "]"}], "->", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{"dq", ",", 
                RowBox[{
                 RowBox[{"q", "'"}], "[", "z", "]"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}]}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Forward", ":", "z0"}], "->", "0"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"solFwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dx", ",", "d\[CapitalOmega]", ",", "dq", ",", 
               RowBox[{
                RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
               RowBox[{
                RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                "\[CapitalOmega]0"}], ",", 
               RowBox[{
                RowBox[{"q", "[", "z0", "]"}], "==", "q0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "0"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Backward", ":", "z0"}], "->", "zinitial"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"solBwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dx", ",", "d\[CapitalOmega]", ",", "dq", ",", 
               RowBox[{
                RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
               RowBox[{
                RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                "\[CapitalOmega]0"}], ",", 
               RowBox[{
                RowBox[{"q", "[", "z0", "]"}], "==", "q0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "zinitial"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"hsolFwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dh", "/.", " ", "solFwd"}], ",", 
               RowBox[{
                RowBox[{"h", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
             RowBox[{"{", "h", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", " ", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"hsolBwd", "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dh", "/.", " ", "solBwd"}], ",", 
               RowBox[{
                RowBox[{"h", "[", "z0", "]"}], "==", 
                RowBox[{
                 RowBox[{"hsolFwd", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", "z0", 
                 "]"}]}]}], "}"}], ",", 
             RowBox[{"{", "h", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "z0", ",", "zinitial"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], 
           "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"x", "/.", " ", "solFwd"}]}], ",", 
              RowBox[{"bwd", "=", 
               RowBox[{"x", "/.", " ", "solBwd"}]}], ",", 
              RowBox[{"z0val", "=", "z0"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
              RowBox[{"Piecewise", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", "<=", "z0val"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"\[CapitalOmega]", "/.", " ", "solFwd"}]}], ",", 
              RowBox[{"bwd", "=", 
               RowBox[{"\[CapitalOmega]", "/.", " ", "solBwd"}]}], ",", 
              RowBox[{"z0val", "=", "z0"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
              RowBox[{"Piecewise", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", "<=", "z0val"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"qFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"q", "/.", " ", "solFwd"}]}], ",", 
              RowBox[{"bwd", "=", 
               RowBox[{"q", "/.", " ", "solBwd"}]}], ",", 
              RowBox[{"z0val", "=", "z0"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
              RowBox[{"Piecewise", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", "<=", "z0val"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"hFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"h", "/.", " ", "hsolFwd"}]}], ",", 
              RowBox[{"bwd", "=", 
               RowBox[{"h", "/.", " ", "hsolBwd"}]}], ",", 
              RowBox[{"z0val", "=", "z0"}]}], "}"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"z", ",", 
              RowBox[{"Piecewise", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", "<=", "z0val"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";"}]}], "\n", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
