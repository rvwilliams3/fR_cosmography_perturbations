Cell[CellGroupData[{

Cell["Effective equation of state", "Subsubsection",
 CellChangeTimes->{{3.986970127042567*^9, 3.9869701311112537`*^9}, {
  3.988690517122257*^9, 
  3.988690518194172*^9}},ExpressionUUID->"b8edb2cb-f58f-4e8c-933d-\
e9dc3899eb46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wDE", "[", "z_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"2", 
      RowBox[{"q", "[", "z", "]"}]}], "-", "1"}], 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"\[CapitalOmega]m", "[", "z", "]"}]}], ")"}]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]m", "[", "z_", "]"}], " ", ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalOmega]m0", " "}], 
     SuperscriptBox[
      RowBox[{"h", "[", "z", "]"}], "2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], "3"]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987149255763071*^9, 3.9871494037525997`*^9}, {
   3.987159066212615*^9, 3.987159066731738*^9}, 3.9872387872564*^9, {
