Cell[BoxData[{
 RowBox[{"wDEplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
     RowBox[{"{", 
