       RowBox[{"h3", "[", "z", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"hLCDM", "[", "z", "]"}], "/.", "LCDMreplacements"}]}], "}"}],
      "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "500"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
