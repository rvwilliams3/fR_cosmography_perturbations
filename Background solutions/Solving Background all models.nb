Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[CapitalLambda]CDM", " ", "parameters"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]m0", "=", "0.3"}], ";"}], "   ", "\n", 
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CapitalLambda]0", "=", 
     RowBox[{"1", "-", "\[CapitalOmega]m0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hLCDM", "[", "z_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[CapitalOmega]m0", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       "\[CapitalOmega]\[CapitalLambda]0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLCDM", "[", "z_", "]"}], "=", 
     RowBox[{"H0", " ", 
      RowBox[{"hLCDM", "[", "z", "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.98705476183501*^9, 3.98705478899225*^9}, {
  3.987055652480273*^9, 3.98705568659084*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"755644ec-1471-41f3-bb11-62c2515a759f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qLCDM", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}], 
    FractionBox[
     RowBox[{
      RowBox[{"HLCDM", "'"}], "[", "z", "]"}], 
     RowBox[{"HLCDM", "[", "z", "]"}]]}]}]}]], "Input",
