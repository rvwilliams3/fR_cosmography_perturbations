Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"hplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h0", "[", "z", "]"}], ",", 
       RowBox[{"h1", "[", "z", "]"}], ",", 
       RowBox[{"h2", "[", "z", "]"}], ",", 
       RowBox[{"h3", "[", "z", "]"}], ",", " ", 
       RowBox[{"hLCDM", "[", "z", "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "500"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "z0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"h0", "[", "z0", "]"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<h(z)\>\""}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Model 0\>\"", ",", "\"\<Model 1\>\"", ",", " ", 
           "\"\<Model 2\>\"", ",", " ", "\"\<Model 3\>\"", ",", " ", 
           "\"\<\[CapitalLambda]CDM\>\""}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"FrameStyle", "->", "Gray"}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
           ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
