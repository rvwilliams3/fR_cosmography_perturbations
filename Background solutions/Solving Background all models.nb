Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"xplotCombined", "=", 
   RowBox[{"Plot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"sol0", "[", "\"\<x\>\"", "]"}], "[", "z", "]"}], ",", 
        RowBox[{
         RowBox[{"sol1", "[", "\"\<x\>\"", "]"}], "[", "z", "]"}], ",", 
        RowBox[{
         RowBox[{"sol2", "[", "\"\<x\>\"", "]"}], "[", "z", "]"}], ",", 
        RowBox[{
         RowBox[{"sol3", "[", "\"\<x\>\"", "]"}], "[", "z", "]"}], " ", ",", 
        RowBox[{"xLCDM", "[", "z", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "500"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<Model 0\>\"", ",", "\"\<Model 1\>\"", ",", " ", 
            "\"\<Model 2\>\"", ",", " ", "\"\<Model 3\>\"", ",", " ", 
            "\"\<\[CapitalLambda]CDM\>\""}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"LegendFunction", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Framed", "[", 
              RowBox[{"#", ",", 
               RowBox[{"FrameStyle", "->", "Gray"}], ",", 
               RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
            ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"0.85", ",", "0.3"}], "}"}]}], "]"}]}], ",", 
