Cell[BoxData[{
 RowBox[{"RDotplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Rdot", "[", "z", "]"}], "/.", "replacements1"}], "/.", 
        "replacements1"}], ",", 
       RowBox[{
