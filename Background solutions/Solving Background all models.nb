  RowBox[{"hplot0", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"sol0", "[", "\"\<h\>\"", "]"}], "[", "z", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "400"}], ",", " ", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
