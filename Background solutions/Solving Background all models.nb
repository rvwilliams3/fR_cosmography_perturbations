         RowBox[{"-", "10000"}], ",", 
         RowBox[{"-", "10"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", 
       RowBox[{"Row", "[", 
