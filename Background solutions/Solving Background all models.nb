                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"bwd", "[", "z", "]"}], ",", 
                   RowBox[{"z", ">", "z0val"}]}], "}"}]}], "}"}], "]"}]}], 
             "]"}]}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
         RowBox[{"hFn", "=", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fwd", "=", 
               RowBox[{"h", "/.", " ", "hsolFwd"}]}], ",", 
