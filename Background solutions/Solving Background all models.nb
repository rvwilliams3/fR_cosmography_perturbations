Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qplotCombined", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Abs", "[", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"sol0", "[", "\"\<q\>\"", "]"}], "[", "z", "]"}], "-", " ", 
          RowBox[{"qLCDM", "[", "z", "]"}]}], 
         RowBox[{" ", 
          RowBox[{"qLCDM", "[", "z", "]"}]}]], "]"}], "*", "100"}], "}"}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", " ", "zinitial"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "500"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<percentage diff (model 0 - LCDM)\>\""}], 
      "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}], ",", " ", 
    RowBox[{"PlotRangePadding", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", " ", 
       RowBox[{"Scaled", "[", ".05", "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
