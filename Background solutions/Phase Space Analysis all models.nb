55918ae77bb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FixedPointsStability", "[", 
   RowBox[{"jExpr_", ",", " ", "\[Epsilon]Val_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", "fps", ",", "Jac", ",", "classify", ",", "stabilityGrid"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]", "=", "\[Epsilon]Val"}], ";", "\[IndentingNewLine]", 
     RowBox[{"j", "=", 
      RowBox[{"jExpr", "/.", 
       RowBox[{
        RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Fq", "[", 
        RowBox[{"x", ",", "j"}], "]"}], "==", "0"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Fixed", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"fps", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
              "0"}], ",", 
             RowBox[{
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
              "0"}], ",", 
             RowBox[{
              RowBox[{"Fq", "[", 
               RowBox[{"q", ",", "j"}], "]"}], "==", "0"}]}], "}"}], "/.", 
           RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
          "Reals"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fps", "=", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Fx", "[", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"F\[CapitalOmega]", "[", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"Fq", "[", 
             RowBox[{"q", ",", "j"}], "]"}], "==", "0"}]}], "}"}], "/.", 
         RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
        "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<=== Fixed Points ===\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"fps", "//", "N"}], "//", "TableForm"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", "Jacobian", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Jac", "[", 
       RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], "=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Fx", "[", 
           RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
          RowBox[{"F\[CapitalOmega]", "[", 
           RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
          RowBox[{"Fq", "[", 
           RowBox[{"q", ",", "j"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Classify", " ", "each", " ", "fixed", " ", "point"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"classify", "[", "pt_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "eig", ",", "type"}], "}"}], ",", 
        RowBox[{
         RowBox[{"vals", "=", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ",
            "pt"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"eig", "=", 
          RowBox[{
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"type", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{"eig", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], 
            ",", "\"\<Stable node/spiral\>\"", ",", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"eig", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], 
            ",", "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"vals", ",", "eig", ",", "type"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stabilityGrid", "=", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
