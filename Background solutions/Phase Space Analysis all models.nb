            ",", "\"\<Type\>\""}], "}"}]}], "]"}], ",", 
        RowBox[{"Frame", "->", "All"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<=== Stability ===\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
