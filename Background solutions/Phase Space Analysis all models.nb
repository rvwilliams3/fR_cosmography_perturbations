           RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
          RowBox[{"Fq", "[", 
           RowBox[{"q", ",", "j"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Classify", " ", "each", " ", "fixed", " ", "point"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"classify", "[", "pt_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
