Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeSL", "[", "jFunc_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "jPrime", ",", "qPrime", ",", " ", "qDPrime", ",", "sExpr", ",", 
      "lExpr"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Express", " ", "j", " ", "and", " ", "its", " ", "derivative", " ", 
      "in", " ", "terms", " ", "of", " ", "q"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"jPrime", "=", 
      RowBox[{"D", "[", 
       RowBox[{"jFunc", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qPrime", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{"dq", ",", 
          RowBox[{
           RowBox[{"q", "'"}], "[", "n", "]"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"j", "[", "n", "]"}], "->", "jFunc"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qDPrime", " ", "=", " ", 
      RowBox[{"D", "[", 
       RowBox[{"qPrime", ",", " ", "n"}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Solve", " ", "for", " ", "s", " ", "and", " ", "l", " ", 
       "symbolically"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sExpr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"dj", "/.", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"j", "'"}], "[", "n", "]"}], "->", "jPrime"}]}], ",", 
            RowBox[{"s", "[", "n", "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "'"}], "[", "n", "]"}], "->", "qPrime"}]}], "/.", 
        RowBox[{
         RowBox[{"j", "[", "n", "]"}], "->", "jFunc"}]}], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"lExpr", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"ds", ",", 
         RowBox[{"l", "[", "n", "]"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lExpr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"lExpr", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", "n", "]"}], "->", "sExpr"}], ",", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"s", "'"}], "[", "n", "]"}], "->", 
             RowBox[{"D", "[", 
              RowBox[{"sExpr", ",", "n"}], "]"}]}]}], "}"}]}], "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "'"}], "[", "n", "]"}], "->", "qPrime"}]}], "/.", 
        RowBox[{
         RowBox[{"j", "[", "n", "]"}], "->", "jFunc"}]}], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<s[n] = \>\"", ",", "sExpr"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<l[n] = \>\"", ",", "lExpr"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"sExpr", ",", "lExpr"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.985998961769936*^9, 3.985999115104649*^9}, {
  3.98599919226952*^9, 3.985999226339898*^9}, {3.985999260967072*^9, 
