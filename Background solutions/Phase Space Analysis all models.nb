           RowBox[{"{", 
            RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ",
            "pt"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"eig", "=", 
          RowBox[{
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"type", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{"eig", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], 
            ",", "\"\<Stable node/spiral\>\"", ",", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"eig", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], 
            ",", "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"vals", ",", "eig", ",", "type"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
