Cell[BoxData[
 RowBox[{
  RowBox[{"FixedPointsStability", "[", 
   RowBox[{"jExpr_", ",", " ", "\[Epsilon]Val_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "j", ",", "fps", ",", "Jac", ",", "classify", ",", "stabilityGrid"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]", "=", "\[Epsilon]Val"}], ";", "\[IndentingNewLine]", 
     RowBox[{"j", "=", 
      RowBox[{"jExpr", "/.", 
       RowBox[{
        RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Fq", "[", 
        RowBox[{"x", ",", "j"}], "]"}], "==", "0"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Fixed", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"fps", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
              "0"}], ",", 
             RowBox[{
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
              "0"}], ",", 
             RowBox[{
              RowBox[{"Fq", "[", 
               RowBox[{"q", ",", "j"}], "]"}], "==", "0"}]}], "}"}], "/.", 
           RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
          "Reals"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"fps", "=", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Fx", "[", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"F\[CapitalOmega]", "[", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"Fq", "[", 
             RowBox[{"q", ",", "j"}], "]"}], "==", "0"}]}], "}"}], "/.", 
         RowBox[{"\[Epsilon]", "->", "\[Epsilon]Val"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
        "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<=== Fixed Points ===\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"fps", "//", "N"}], "//", "TableForm"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", "Jacobian", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Jac", "[", 
       RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], "=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Fx", "[", 
