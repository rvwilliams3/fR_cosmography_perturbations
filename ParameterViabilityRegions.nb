Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qFnP", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
