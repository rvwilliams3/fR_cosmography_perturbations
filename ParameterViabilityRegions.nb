Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qClosed", "[", 
    RowBox[{"q0Val_", ",", "epsVal_", ",", "zz_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "u", "}"}], ",", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        FractionBox[
         RowBox[{"(", 
          RowBox[{"q0Val", "-", 
           FractionBox["1", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"q0Val", "+", "1", "-", 
           RowBox[{
            FractionBox["3", "2"], " ", "epsVal"}]}], ")"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "zz"}], ")"}], 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsVal"}], ")"}]}]]}]}], ";", 
      "\[IndentingNewLine]", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         RowBox[{"u", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             FractionBox["3", "2"], " ", "epsVal"}]}], ")"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "u"}], ")"}]]}]}], "]"}]}], ";"}]], "Input",
