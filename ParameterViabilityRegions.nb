                  RowBox[{"First", "[", "run", "]"}], "-", "1"}]}], "]"}], 
               "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"hi", "=", 
             RowBox[{"coarseRange", "[", 
              RowBox[{"[", 
               RowBox[{"Min", "[", 
                RowBox[{"nTot", ",", 
                 RowBox[{
                  RowBox[{"Last", "[", "run", "]"}], "+", "1"}]}], "]"}], 
               "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"rng", "=", 
             RowBox[{"Subdivide", "[", 
              RowBox[{"lo", ",", "hi", ",", 
               RowBox[{"nR", "-", "1"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"res", "=", 
