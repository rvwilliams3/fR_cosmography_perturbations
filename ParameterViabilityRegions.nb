          RowBox[{"model", ",", "dataset", ",", "\"\<q0\>\""}], "]"}]}], ",", 
        
        RowBox[{"jj", "=", 
         RowBox[{"allParams", "[", 
          RowBox[{"model", ",", "dataset", ",", "\"\<j0\>\""}], "]"}]}]}], 
       "}"}], ",", 
      RowBox[{"Switch", "[", 
       RowBox[{"vary", ",", "\"\<j0\>\"", ",", 
