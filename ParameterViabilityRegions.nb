Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AutoC2Scale", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fp", ",", "classified"}], "}"}], ",", 
     RowBox[{
      RowBox[{"fp", "=", 
       RowBox[{"MatterDominatedFPEps", "[", 
        RowBox[{"model", ",", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"classified", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"classified", "===", "$Failed"}], ",", "$Failed", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "zi"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", 
           RowBox[{"classified", "[", "\"\<lambdaXOmega\>\"", "]"}]}], 
          ")"}]}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085328072864*^9, 3.995085335534656*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"0b437864-23b1-4216-b64e-0b3463133706"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AutoC2Range", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LogSpanBelow\>\"", "->", "4"}], ",", 
        RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<NPerSign\>\"", "->", "40"}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scale", ",", "expMin", ",", "expMax", ",", "positive"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"scale", "=", 
       RowBox[{"AutoC2Scale", "[", 
        RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"scale", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMin", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "-", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMax", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "+", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"positive", "=", 
       RowBox[{"10", "^", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"expMin", ",", "expMax", ",", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<NPerSign\>\"", "]"}], "-", 
           "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Reverse", "[", "positive", "]"}]}], ",", "positive"}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085336897839*^9, 3.995085338852072*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"7f1c1043-e270-47fa-a931-465508cd1308"]
}, Open  ]],

