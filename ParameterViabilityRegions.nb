Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"kinLabels", ",", "kinColors", ",", "kinNames", ",", "flip"}], 
    "}"}], ",", 
   RowBox[{
    RowBox[{"kinLabels", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<mean\>\"", ",", "\"\<q-j-\>\"", ",", "\"\<q-j+\>\"", ",", 
       "\"\<q+j-\>\"", ",", "\"\<q+j+\>\""}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"kinColors", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"kinLabels", ",", 
       RowBox[{"{", 
        RowBox[{"Black", ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "3", "]"}], ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"kinNames", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{"kinLabels", ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<mean\>\"", ",", 
         "\"\<\!\(\*SubscriptBox[\(q\), \(0\)]\)-\[Sigma], \
\\!\\(\\*SubscriptBox[\\(j\\), \\(0\\)]\\)-\[Sigma]\>\"", ",", 
         "\"\<\\!\\(\\*SubscriptBox[\\(q\\), \\(0\\)]\\)-\[Sigma], \
\\!\\(\\*SubscriptBox[\\(j\\), \\(0\\)]\\)+\[Sigma]\>\"", ",", 
         "\"\<\\!\\(\\*SubscriptBox[\\(q\\), \\(0\\)]\\)+\[Sigma], \
\\!\\(\\*SubscriptBox[\\(j\\), \\(0\\)]\\)-\[Sigma]\>\"", ",", 
         "\"\<\\!\\(\\*SubscriptBox[\\(q\\), \\(0\\)]\\)+\[Sigma], \
\\!\\(\\*SubscriptBox[\\(j\\), \\(0\\)]\\)+\[Sigma]\>\""}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", ",", "m"}], ")"}], "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "r"}], ",", "m"}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"with", "-", "r"}], "=", 
       RowBox[{"R", " ", 
        RowBox[{"f_R", "/", "f"}]}]}]}], "*)"}], 
    RowBox[{
     RowBox[{"flip", "[", "pts_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "#"}], ")"}], "&"}], "/@", 
      "pts"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Legended", "[", 
       RowBox[{
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Flatten", "@", 
           RowBox[{"{", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"region", " ", "swept", " ", "by", " ", "viable", " ", 
               RowBox[{"trajectories", ":", 
                RowBox[{"lower", " ", "edge", " ", 
                 RowBox[{"(", 
                  RowBox[{"zi", "->", "0"}], ")"}]}]}]}], ",", 
              RowBox[{
               RowBox[{"today", "'"}], "s", " ", "segment"}], ",", 
              RowBox[{"upper", " ", "edge", " ", 
               RowBox[{"(", 
                RowBox[{"0", "->", "zi"}], ")"}]}]}], "*)"}], 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"TrueQ", "[", 
                  RowBox[{"figAData", "[", 
                   RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"curves", "=", 
                    RowBox[{"flip", "/@", 
                    RowBox[{"figAData", "[", 
                    RowBox[{"dataset", ",", "lab", ",", "\"\<rmCurves\>\""}], 
                    "]"}]}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Graphics", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FaceForm", "[", 
                    RowBox[{"Opacity", "[", 
                    RowBox[{"0.15", ",", 
                    RowBox[{"kinColors", "[", "lab", "]"}]}], "]"}], "]"}], 
                    ",", 
                    RowBox[{"EdgeForm", "[", 
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"kinColors", "[", "lab", "]"}], ",", "Thick"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"Polygon", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"Reverse", "[", 
                    RowBox[{"First", "[", "curves", "]"}], "]"}], ",", 
                    RowBox[{"flip", "[", 
                    RowBox[{"figAData", "[", 
                    RowBox[{"dataset", ",", "lab", ",", "\"\<rmToday\>\""}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"Last", "[", "curves", "]"}]}], "]"}], "]"}]}], 
                    "}"}], "]"}], ",", 
                    RowBox[{"ListLinePlot", "[", 
                    RowBox[{"curves", ",", 
                    RowBox[{"PlotStyle", "->", 
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"kinColors", "[", "lab", "]"}], ",", "Thin", ",", 
                    
                    RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}]}], 
                    "]"}]}], "}"}]}], "]"}], ",", "Nothing"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"lab", ",", "kinLabels"}], "}"}]}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"references", ":", 
                RowBox[{"matter", " ", "point", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", ",", "0"}], ")"}]}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"de", " ", "Sitter"}], "-", "r"}], "=", "2"}], ",", 
               RowBox[{
                RowBox[{"P6", " ", "line", " ", "m"}], "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "r"}], "-", "1"}], "->", "m"}], "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "r"}], ")"}], "-", "1"}]}]}]}], "*)"}], 
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
            "}"}]}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<r\>\"", ",", "\"\<m\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Abbrev", "[", "dataset", "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"Values", "[", "kinColors", "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"TrueQ", "[", 
                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], 
                  "]"}], "]"}], ",", 
                RowBox[{"kinNames", "[", "lab", "]"}], ",", 
                RowBox[{
                 RowBox[{"kinNames", "[", "lab", "]"}], "<>", 
                 "\"\< (no window)\>\""}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"lab", ",", "kinLabels"}], "}"}]}], "]"}], ",", 
            RowBox[{"LegendFunction", "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"FrameStyle", "->", 
                  RowBox[{"Darker", "[", "Gray", "]"}]}], ",", 
                 RowBox[{"RoundingRadius", "->", "0"}], ",", 
                 RowBox[{"Background", "->", "White"}]}], "]"}], "&"}], 
              ")"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.8", ",", "0.8"}], "}"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"dataset", ",", 
        RowBox[{"{", 
         RowBox[{"viablePlanckDatasets", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
