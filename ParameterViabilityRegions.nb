Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"x", "'"}], "[", "z", "]"}]}], "-", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"x", "[", "z", "]"}], "2"], "-", 
       RowBox[{
        RowBox[{"x", "[", "z", "]"}], 
        RowBox[{"(", 
         RowBox[{"2", "+", 
          RowBox[{"q", "[", "z", "]"}]}], ")"}]}], "-", "2", "-", 
       RowBox[{"2", 
        RowBox[{"q", "[", "z", "]"}]}], "+", 
       RowBox[{"3", 
        RowBox[{"\[CapitalOmega]", "[", "z", "]"}]}]}], ")"}]}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[CapitalOmega]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"\[CapitalOmega]", "'"}], "[", "z", "]"}]}], "-", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", "[", "z", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", "z", "]"}], "+", "1", "-", 
        RowBox[{"2", 
         RowBox[{"q", "[", "z", "]"}]}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"q", "'"}], "[", "z", "]"}]}], "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"j", "[", "z", "]"}], "-", 
       RowBox[{"q", "[", "z", "]"}], "-", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"q", "[", "z", "]"}], "2"]}]}], ")"}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dj", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"j", "'"}], "[", "z", "]"}]}], "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"s", "[", "z", "]"}]}], "-", 
       RowBox[{
        RowBox[{"j", "[", "z", "]"}], 
        RowBox[{"(", 
         RowBox[{"2", "+", 
          RowBox[{"3", 
           RowBox[{"q", "[", "z", "]"}]}]}], ")"}]}]}], ")"}]}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ds", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"s", "'"}], "[", "z", "]"}]}], "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"l", "[", "z", "]"}]}], "-", 
       RowBox[{
        RowBox[{"s", "[", "z", "]"}], 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"4", 
           RowBox[{"q", "[", "z", "]"}]}]}], ")"}]}]}], ")"}]}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
