      RowBox[{"Eh", "[", "z", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"q", "[", "z", "]"}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.967512673203826*^9, 3.967512681033255*^9}, {
