Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"qFnP", "[", 
     RowBox[{"model_String", ",", 
      RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"qFnP", "[", 
      RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"epsVal", ",", "odeQ", ",", "sol"}], "}"}], ",", 
       RowBox[{
        RowBox[{"epsVal", "=", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"odeQ", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"dq", "/.", " ", 
             RowBox[{"j", "->", 
              RowBox[{"jModelMap", "[", "model", "]"}]}]}], "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Epsilon]", "->", "epsVal"}], ",", 
              RowBox[{"q0", "->", "q0Val"}], ",", 
              RowBox[{"j0", "->", "j0Val"}]}], "}"}]}], ",", 
           RowBox[{
            RowBox[{"q", "[", "0", "]"}], "==", "q0Val"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{"odeQ", ",", "q", ",", 
           RowBox[{"{", 
            RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
           RowBox[{"PrecisionGoal", "->", "10"}], ",", 
           RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"q", "/.", " ", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]}], ";"}], 
  "*)"}]], "Input",
 CellChangeTimes->{3.998450804219138*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"b55c5005-038c-406d-b364-b6d8963a094a"],

Cell[TextData[{
 "Use the closed form of q(z) for faster running times:\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   FractionBox["dq", 
    RowBox[{"dN", " "}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a20c1606-7e9a-44c1-baf7-15342be28c2d"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"q", "-", 
     FractionBox["1", "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65cc998c-d14a-4dbe-ba63-218e39a39ac9"],
 "(2q+2-3\[Epsilon])  \nu ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    FractionBox[
     RowBox[{"q", "-", 
      FractionBox["1", "2"]}], 
     RowBox[{"q", "+", "1", "-", 
      RowBox[{
       FractionBox["3", "2"], "\[Epsilon]"}]}]], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22eececb-dcfd-45a8-8067-6d07b1f10243"],
 "--> \tu\[CloseCurlyQuote]=3(1-\[Epsilon])  --> \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "u"], 
     FractionBox["du", "da"]}], "=", 
    RowBox[{"3", 
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Epsilon]"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf42b79c-d0a8-4b3f-98f9-0d2cca0e03f4"],
 " -->\tu(z)=u(0) ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], 
     RowBox[{"3", 
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Epsilon]"}], ")"}]}]]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "518de01a-0e28-4772-b3f7-81a8c062cf8d"],
 "\nq=1/2"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.998450805929521*^9, 3.998450823184558*^9}, {
  3.998450876276615*^9, 3.9984510087101297`*^9}, {3.9984510829459677`*^9, 
  3.998451193780057*^9}, {3.9984512578099422`*^9, 3.998451269491584*^9}},
 Background->RGBColor[
  1, 1, 0.85],ExpressionUUID->"c4d09028-73e0-4ee1-b3ec-922c68bcd66e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qClosed", "[", 
    RowBox[{"q0Val_", ",", "epsVal_", ",", "zz_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "u", "}"}], ",", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        FractionBox[
         RowBox[{"(", 
          RowBox[{"q0Val", "-", 
           FractionBox["1", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"q0Val", "+", "1", "-", 
           RowBox[{
            FractionBox["3", "2"], " ", "epsVal"}]}], ")"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "zz"}], ")"}], 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsVal"}], ")"}]}]]}]}], ";", 
      "\[IndentingNewLine]", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         RowBox[{"u", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             FractionBox["3", "2"], " ", "epsVal"}]}], ")"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", "u"}], ")"}]]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998451201310926*^9, 3.998451242068025*^9}, {
  3.998451349325021*^9, 3.998451364442663*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"8e50f008-97cd-4c29-99a0-b1d695ad3315"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qFnP", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
