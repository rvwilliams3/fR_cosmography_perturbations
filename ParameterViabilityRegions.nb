                  RowBox[{"-", "4"}]}]}], ",", "zinitial", ",", 
                RowBox[{"\"\<X0Max\>\"", "->", "0.25"}]}], "]"}], ",", 
              "zinitial"}], "]"}], ",", "900", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<q0\>\"", "->", "q0v"}], ",", 
              RowBox[{"\"\<j0\>\"", "->", 
               RowBox[{"1", "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "4"}]}]}]}], ",", 
              RowBox[{"\"\<todayFound\>\"", "->", "False"}], ",", 
              RowBox[{"\"\<note\>\"", "->", "\"\<timeout\>\""}]}], "|>"}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"-", "0.62"}], ",", 
              RowBox[{"-", "0.40"}], ",", "5"}], "]"}]}], "}"}]}], "]"}]}], 
       ";"}], ",", "q0v"}], "]"}], "\[IndentingNewLine]", 
