    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"combining", " ", "the", " ", "sign", " ", "condition", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", " ", 
          RowBox[{"theorem", ":", 
           RowBox[{"f_R", ">", "0"}]}]}], ",", 
         RowBox[{"f_RR", ">", 
