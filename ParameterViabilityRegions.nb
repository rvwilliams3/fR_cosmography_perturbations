           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                  "\[CapitalOmega]i"}], ",", 
                 RowBox[{"WhenEvent", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "[", "z", "]"}], "]"}], ">", 
