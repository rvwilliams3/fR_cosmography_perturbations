         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MatchQ", "[", 
           RowBox[{"sol", ",", 
            RowBox[{"{", 
             RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", "$Failed", 
         ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
           RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
           RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], 
           ",", 
