Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Resolves", " ", "the", " ", "two", " ", "edge", " ", "trajectories", 
     RowBox[{"(", 
      RowBox[{"c2Lo", ",", "c2Hi"}], ")"}], " ", "and", " ", "reads", " ", 
     "x", 
     RowBox[{"(", "0", ")"}]}], ",", " ", 
    RowBox[{"Omega", 
     RowBox[{"(", "0", ")"}], " ", "off", " ", "each", " ", "then", " ", 
     "forms", " ", "the", " ", "derived", " ", "theory", " ", 
     RowBox[{"quantities", ":", 
      RowBox[{"f_R", 
       RowBox[{
        RowBox[{"(", "0", ")"}], "/", "f_R"}], 
       RowBox[{"(", "z_i", ")"}], " ", "and", " ", "m_", "0", 
       "\[IndentingNewLine]", "Returns", " ", "the", " ", "edge", " ", 
       "values", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{"lo", ",", " ", "hi"}], "}"}], " ", "pairs", " ", "in", " ", 
       "the", " ", "same", " ", "order", " ", "as", " ", 
       RowBox[{"c2Window", "."}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"AttachTodayValues", "[", 
     RowBox[{"model_String", ",", "fw_Association", ",", 
      RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "q0Val", ",", "j0Val", ",", "Ei", ",", "edges", ",", "sols", ",", 
        "x0s", ",", "Om0s", ",", "fr0s", ",", "m0s"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"fw", "[", "\"\<found\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"Return", "[", "fw", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q0Val", "=", 
        RowBox[{"fw", "[", "\"\<q0\>\"", "]"}]}], ";", 
       RowBox[{"j0Val", "=", 
        RowBox[{"fw", "[", "\"\<j0\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Ei", "=", 
        RowBox[{
         RowBox[{"EhFnP", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}], 
         "[", "zi", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fw", "[", "\"\<c2WindowCut\>\"", "]"}], "===", "None"}], 
         ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"fw", ",", 
            RowBox[{"<|", 
             RowBox[{"\"\<todayFound\>\"", "->", "False"}], "|>"}]}], "]"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"fw", "[", "\"\<c2WindowCut\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sols", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ReSolveTrajectory", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "#", ",", "zi"}],
            "]"}], "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"sols", ",", 
           RowBox[{
            RowBox[{"#", "===", "$Failed"}], "&"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"fw", ",", 
            RowBox[{"<|", 
             RowBox[{"\"\<todayFound\>\"", "->", "False"}], "|>"}]}], "]"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"x0s", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<x\>\"", "]"}], "[", "0", "]"}], "&"}], "/@",
          "sols"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Om0s", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "[", "0", 
           "]"}], "&"}], "/@", "sols"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fr0s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"sols", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              "\"\<\[CapitalOmega]i\>\"", "]"}], " ", 
             RowBox[{"Ei", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Om0s", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "zi"}], ")"}], "^", "3"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"m0s", "=", 
        RowBox[{"x0s", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "q0Val"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"j0Val", "-", "q0Val", "-", "2"}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"fw", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<todayFound\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<x0\>\"", "->", "x0s"}], ",", 
           RowBox[{"\"\<\[CapitalOmega]0\>\"", "->", "Om0s"}], ",", 
           RowBox[{"\"\<fR0\>\"", "->", "fr0s"}], ",", 
           RowBox[{"\"\<m0\>\"", "->", "m0s"}]}], "|>"}]}], "]"}]}]}], 
     "]"}]}], ";"}]}]], "Input",
