Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"helper", ":", 
    RowBox[{
    "contiguous", " ", "index", " ", "runs", " ", "of", " ", 
     "\"\<Physical\>\"", " ", "points", " ", "in", " ", "a", " ", "results", 
     " ", "list"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PhysicalRuns", "[", "results_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "idx", "}"}], ",", 
      RowBox[{
       RowBox[{"idx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"results", ",", 
           RowBox[{"r_", "/;", 
            RowBox[{
             RowBox[{"r", "[", "\"\<label\>\"", "]"}], "===", 
             "\"\<Physical\>\""}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"idx", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Split", "[", 
          RowBox[{"idx", ",", 
           RowBox[{
            RowBox[{"#2", "==", 
             RowBox[{"#1", "+", "1"}]}], "&"}]}], "]"}]}], "]"}]}]}], "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{3.995242263862509*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"53e1bc47-291a-4042-a301-eab008bb6ef4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SweepXInitialP", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NCoarse\>\"", "->", "100"}], ",", 
        RowBox[{"\"\<LogSpanBelow\>\"", "->", "3"}], ",", 
        RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<NRefine\>\"", "->", "150"}], ",", 
        RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         SuperscriptBox["10", 
          RowBox[{"-", "3"}]]}], ",", 
        RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
        RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "nC", ",", "nR", ",", "nSamp", ",", "singTol", ",", "pg",
        ",", "ag", ",", "wp", ",", "coarseRange", ",", "nTot", ",", 
       "coarseResults", ",", "runs", ",", "refined", ",", "allPts", ",", 
       "scanOpts"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nC", "=", 
       RowBox[{"OptionValue", "[", "\"\<NCoarse\>\"", "]"}]}], ";", 
      RowBox[{"nR", "=", 
       RowBox[{"OptionValue", "[", "\"\<NRefine\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nSamp", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"scanOpts", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
         RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}], ",", 
         RowBox[{"\"\<PrecisionGoal\>\"", "->", "pg"}], ",", 
         RowBox[{"\"\<AccuracyGoal\>\"", "->", "ag"}], ",", 
         RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coarseRange", "=", 
       RowBox[{"AutoC2Range", "[", 
        RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi", ",", 
         RowBox[{"\"\<NPerSign\>\"", "->", "nC"}], ",", 
         RowBox[{"\"\<LogSpanBelow\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}], ",", 
         RowBox[{"\"\<LogSpanAbove\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"coarseRange", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
           RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
           RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
           RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
           RowBox[{"\"\<c2Window\>\"", "->", "None"}], ",", 
           RowBox[{"\"\<table\>\"", "->", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"\"\<note\>\"", "->", "\"\<Degenerate fixed point\>\""}]}],
           "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"nTot", "=", 
       RowBox[{"Length", "[", "coarseRange", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coarseResults", "=", 
       RowBox[{"ScanICsP", "[", 
        RowBox[{
        "model", ",", "q0Val", ",", "j0Val", ",", "coarseRange", ",", "zi", 
         ",", 
         RowBox[{"Sequence", "@@", "scanOpts"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"runs", "=", 
       RowBox[{"PhysicalRuns", "[", "coarseResults", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"runs", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
           RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
           RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
           RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
           RowBox[{"\"\<c2Window\>\"", "->", "None"}], ",", 
           RowBox[{"\"\<table\>\"", "->", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{
           "\"\<note\>\"", "->", 
            "\"\<No physical points in coarse pass\>\""}]}], "|>"}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"refined", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lo", ",", "hi", ",", "rng", ",", "res", ",", "phys"}], 
