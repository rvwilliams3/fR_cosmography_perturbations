       RowBox[{"edges", "=", 
        RowBox[{"fw", "[", "\"\<c2WindowCut\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sols", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ReSolveTrajectory", "[", 
           RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "#", ",", "zi"}],
            "]"}], "&"}], "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"sols", ",", 
           RowBox[{
            RowBox[{"#", "===", "$Failed"}], "&"}]}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"fw", ",", 
            RowBox[{"<|", 
             RowBox[{"\"\<todayFound\>\"", "->", "False"}], "|>"}]}], "]"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"x0s", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<x\>\"", "]"}], "[", "0", "]"}], "&"}], "/@",
          "sols"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Om0s", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "[", "0", 
           "]"}], "&"}], "/@", "sols"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fr0s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"sols", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              "\"\<\[CapitalOmega]i\>\"", "]"}], " ", 
             RowBox[{"Ei", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Om0s", "[", 
              RowBox[{"[", "k", "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "zi"}], ")"}], "^", "3"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"m0s", "=", 
        RowBox[{"x0s", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "q0Val"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"j0Val", "-", "q0Val", "-", "2"}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"fw", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<todayFound\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<x0\>\"", "->", "x0s"}], ",", 
           RowBox[{"\"\<\[CapitalOmega]0\>\"", "->", "Om0s"}], ",", 
           RowBox[{"\"\<fR0\>\"", "->", "fr0s"}], ",", 
           RowBox[{"\"\<m0\>\"", "->", "m0s"}]}], "|>"}]}], "]"}]}]}], 
     "]"}]}], ";"}]}]], "Input",
