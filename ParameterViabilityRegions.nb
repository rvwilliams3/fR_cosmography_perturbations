3660cf21f73d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EhFnP", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"EhFnP", "[", 
     RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"epsVal", ",", "qFn", ",", "odeEh", ",", "sol"}], "}"}], ",", 
      RowBox[{
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qFn", "=", 
        RowBox[{"qFnP", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"odeEh", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dEh", "/.", " ", 
             RowBox[{"q", "->", "qFn"}]}], "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Epsilon]", "->", "epsVal"}], ",", 
              RowBox[{"q0", "->", "q0Val"}]}], "}"}]}], ")"}], ",", 
          RowBox[{
           RowBox[{"Eh", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{"odeEh", ",", "Eh", ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
          RowBox[{"PrecisionGoal", "->", "10"}], ",", 
          RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Eh", "/.", " ", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9984487537481337`*^9, 3.9984487712998323`*^9}, 
   3.9984488365449247`*^9},
