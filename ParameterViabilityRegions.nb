       "both", " ", "verdicts", " ", "so", " ", "the", " ", "two", " ", "can",
        " ", "be", " ", "reported", " ", 
       RowBox[{"separately", "."}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ViabilityCheck", "[", 
