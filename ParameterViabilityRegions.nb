Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Reference", " ", 
     RowBox[{"slice", ":", 
      RowBox[{"\[CurlyEpsilon]", "\[RightArrow]", 
       RowBox[{"0", " ", "limit"}]}]}]}], ",", 
    RowBox[{"j0", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "4"}]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j0", "=", 
          RowBox[{"1", " ", "exactly", " ", "stalls"}]}], ";", 
         RowBox[{
          RowBox[{"x", "\[Congruent]", 
           RowBox[{
           "0", " ", "is", " ", "invariant", " ", "at", " ", 
            "\[CurlyEpsilon]"}]}], "=", "0"}]}], ")"}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"figBRef", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"TimeConstrained", "[", 
           RowBox[{
            RowBox[{"AttachTodayValues", "[", 
             RowBox[{"\"\<Model 3\>\"", ",", 
              RowBox[{"FindWindow", "[", 
               RowBox[{"\"\<Model 3\>\"", ",", "q0v", ",", 
                RowBox[{"1", "-", 
