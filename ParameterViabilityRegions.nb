              RowBox[{"jj", "[", "\"\<min\>\"", "]"}], ",", 
              RowBox[{"jj", "[", "\"\<max\>\"", "]"}], ",", 
              RowBox[{"n", "-", "1"}]}], "]"}]}], "}"}]}], "]"}], ",", 
        "\"\<q0\>\"", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"jj", "[", "\"\<mean\>\"", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
