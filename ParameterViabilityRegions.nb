Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"colors", ",", "boxes", ",", "legend"}], "}"}], ",", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "97", "]"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "planckDatasets", "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"boxes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", "=", 
            RowBox[{"allParams", "[", 
             RowBox[{"\"\<Model 3\>\"", ",", 
              RowBox[{"planckDatasets", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<q0\>\""}], "]"}]}], 
           ",", 
           RowBox[{"jj", "=", 
            RowBox[{"allParams", "[", 
             RowBox[{"\"\<Model 3\>\"", ",", 
              RowBox[{"planckDatasets", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<j0\>\""}], "]"}]}]}],
           "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", 
            RowBox[{"{", 
