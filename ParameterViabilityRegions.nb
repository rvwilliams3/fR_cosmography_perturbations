Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyTrajectoryViability", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", "xFn_", ",", 
     "\[CapitalOmega]Fn_", ",", "qFn_", ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NSamples\>\"", "->", "150"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", 
        RowBox[{"\"\<ZMin\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "4"}]}]}], ",", 
        RowBox[{"\"\<MaxAbsX\>\"", "->", 
         RowBox[{"10", "^", "3"}]}], ",", 
        RowBox[{"\"\<MaxOmega\>\"", "->", "10"}], ",", 
        RowBox[{"\"\<DomainTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "nSamples", ",", "singTol", ",", "zMinSample", ",", 
       "maxAbsX", ",", "maxOm", ",", "domainTol", ",", "domain", ",", 
       "domainMin", ",", "domainMax", ",", "zSamples", ",", "sampleData", ",",
        "hasSignViolation", ",", "hasNearSingular", ",", "hasOmegaViolation", 
       ",", "hasDivergence", ",", "isPhysical", ",", "label"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nSamples", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zMinSample", "=", 
       RowBox[{"OptionValue", "[", "\"\<ZMin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxAbsX", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxAbsX\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxOm", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"domainTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<DomainTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"domain", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"domainMin", "=", 
       RowBox[{"domain", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"domainMax", "=", 
       RowBox[{"domain", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "solution", " ", "must", " ", "actually", " ", "reach", " ", "z"}], 
         "=", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "z"}], "=", 
          RowBox[{
           RowBox[{"zi", "--"}], " ", "no", " ", 
           RowBox[{"extrapolation", ".", "DomainTol"}], " ", 
           RowBox[{"(", "strict", ")"}], " ", "judges", " ", "validity"}]}]}],
         ";", 
        RowBox[{
        "ZMin", " ", "only", " ", "sets", " ", "sample", " ", "spacing", " ", 
         
         RowBox[{"below", "."}]}]}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"domainMin", ">", "domainTol"}], "||", 
         RowBox[{"domainMax", "<", "zi"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<label\>\"", "->", "\"\<Diverged\>\""}], ",", 
           RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
           RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
           RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
           RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
           RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
           RowBox[{"\"\<sampleData\>\"", "->", 
            RowBox[{"{", "}"}]}]}], "|>"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zSamples", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", "zMinSample", "]"}], ",", 
            RowBox[{"Log10", "[", 
             RowBox[{"Min", "[", 
              RowBox[{"zi", ",", "domainMax"}], "]"}], "]"}], ",", 
            RowBox[{"nSamples", "-", "2"}]}], "]"}]}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"sampleData", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "xVal", ",", "\[CapitalOmega]Val", ",", "qVal", ",", "jVal", ",", 
             "denom", ",", "ratio", ",", "pointLabel"}], "}"}], ",", 
           RowBox[{
            RowBox[{"xVal", "=", 
             RowBox[{"xFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]Val", "=", 
             RowBox[{"\[CapitalOmega]Fn", "[", "zPt", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"qVal", "=", 
             RowBox[{"qFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"jVal", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"jModelMap", "[", "model", "]"}], "[", "zPt", "]"}], 
                "/.", " ", 
                RowBox[{"\[Epsilon]", "->", "epsVal"}]}], ")"}], "/.", " ", 
              RowBox[{
               RowBox[{"q", "[", "zPt", "]"}], "->", "qVal"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"denom", "=", 
             RowBox[{"jVal", "-", "qVal", "-", "2"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pointLabel", "=", 
             RowBox[{"Which", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"NumericQ", "[", "xVal", "]"}], "&&", 
                  RowBox[{"NumericQ", "[", "\[CapitalOmega]Val", "]"}]}], 
                 ")"}]}], ",", "\"\<Divergent\>\"", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "xVal", "]"}], ">", "maxAbsX"}], "||", 
