              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"FaceForm", "[", 
            RowBox[{"Opacity", "[", 
             RowBox[{"0.08", ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Rectangle", "[", 
