    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", ",", "m"}], ")"}], "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "r"}], ",", "m"}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"with", "-", "r"}], "=", 
       RowBox[{"R", " ", 
        RowBox[{"f_R", "/", "f"}]}]}]}], "*)"}], 
    RowBox[{
     RowBox[{"flip", "[", "pts_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], "#"}], ")"}], "&"}], "/@", 
      "pts"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Legended", "[", 
       RowBox[{
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"Flatten", "@", 
           RowBox[{"{", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"region", " ", "swept", " ", "by", " ", "viable", " ", 
               RowBox[{"trajectories", ":", 
                RowBox[{"lower", " ", "edge", " ", 
                 RowBox[{"(", 
                  RowBox[{"zi", "->", "0"}], ")"}]}]}]}], ",", 
              RowBox[{
               RowBox[{"today", "'"}], "s", " ", "segment"}], ",", 
              RowBox[{"upper", " ", "edge", " ", 
               RowBox[{"(", 
                RowBox[{"0", "->", "zi"}], ")"}]}]}], "*)"}], 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"TrueQ", "[", 
                  RowBox[{"figAData", "[", 
                   RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"curves", "=", 
                    RowBox[{"flip", "/@", 
                    RowBox[{"figAData", "[", 
                    RowBox[{"dataset", ",", "lab", ",", "\"\<rmCurves\>\""}], 
                    "]"}]}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Graphics", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FaceForm", "[", 
                    RowBox[{"Opacity", "[", 
                    RowBox[{"0.15", ",", 
                    RowBox[{"kinColors", "[", "lab", "]"}]}], "]"}], "]"}], 
                    ",", 
                    RowBox[{"EdgeForm", "[", 
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"kinColors", "[", "lab", "]"}], ",", "Thick"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"Polygon", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"Reverse", "[", 
                    RowBox[{"First", "[", "curves", "]"}], "]"}], ",", 
                    RowBox[{"flip", "[", 
                    RowBox[{"figAData", "[", 
                    RowBox[{"dataset", ",", "lab", ",", "\"\<rmToday\>\""}], 
