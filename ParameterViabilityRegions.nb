Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "@", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"dataset", "->", 
      RowBox[{"Association", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"lab", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"figAData", "[", 
              RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], "]"}], 
             "]"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"q0v", "=", 
                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<q0\>\""}], "]"}]}],
                 ",", 
                RowBox[{"j0v", "=", 
                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<j0\>\""}], 
                  "]"}]}]}], "}"}], ",", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"sol", "=", 
                    RowBox[{"ReSolveTrajectory", "[", 
                    RowBox[{
                    "\"\<Model 3\>\"", ",", "q0v", ",", "j0v", ",", "#", ",", 
                    "zinitial"}], "]"}]}], "}"}], ",", 
                   RowBox[{"AssociationThread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<x0\>\"", ",", "\"\<z = zi\>\"", ",", 
                    "\"\<z = 100\>\"", ",", "\"\<z = 10\>\"", ",", 
                    "\"\<z = 0\>\""}], "}"}], ",", 
                    RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{"RMOfZ", "[", 
                    RowBox[{
                    RowBox[{"sol", "[", "\"\<x\>\"", "]"}], ",", 
                    RowBox[{"sol", "[", "\"\<\[CapitalOmega]\>\"", "]"}], ",", 
                    RowBox[{"sol", "[", "\"\<q\>\"", "]"}], ",", 
                    "\"\<Model 3\>\"", ",", "q0v", ",", "j0v", ",", 
                    RowBox[{"{", 
                    RowBox[{"zinitial", ",", "100", ",", "10", ",", "0"}], 
                    "}"}]}], "]"}]}], ",", 
                    RowBox[{"N", "@", 
                    RowBox[{
                    RowBox[{"sol", "[", "\"\<x\>\"", "]"}], "[", "0", 
                    "]"}]}]}], "]"}]}], "]"}]}], "]"}], "&"}], ",", 
                RowBox[{"figAData", "[", 
