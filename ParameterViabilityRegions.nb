             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "\"\<max\>\"", "]"}], ",", 
               RowBox[{"jj", "[", "\"\<max\>\"", "]"}]}], "}"}]}], "]"}], ",",
            "Black", ",", 
           RowBox[{"PointSize", "[", "0.012", "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "[", "\"\<mean\>\"", "]"}], ",", 
              RowBox[{"jj", "[", "\"\<mean\>\"", "]"}]}], "}"}], "]"}]}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "planckDatasets", "]"}]}], "}"}]}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
