     "x", 
     RowBox[{"(", "0", ")"}]}], ",", " ", 
    RowBox[{"Omega", 
     RowBox[{"(", "0", ")"}], " ", "off", " ", "each", " ", "then", " ", 
     "forms", " ", "the", " ", "derived", " ", "theory", " ", 
     RowBox[{"quantities", ":", 
      RowBox[{"f_R", 
       RowBox[{
        RowBox[{"(", "0", ")"}], "/", "f_R"}], 
       RowBox[{"(", "z_i", ")"}], " ", "and", " ", "m_", "0", 
       "\[IndentingNewLine]", "Returns", " ", "the", " ", "edge", " ", 
       "values", " ", "as", " ", 
       RowBox[{"{", 
        RowBox[{"lo", ",", " ", "hi"}], "}"}], " ", "pairs", " ", "in", " ", 
       "the", " ", "same", " ", "order", " ", "as", " ", 
       RowBox[{"c2Window", "."}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"AttachTodayValues", "[", 
     RowBox[{"model_String", ",", "fw_Association", ",", 
      RowBox[{"zi_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "q0Val", ",", "j0Val", ",", "Ei", ",", "edges", ",", "sols", ",", 
        "x0s", ",", "Om0s", ",", "fr0s", ",", "m0s"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"fw", "[", "\"\<found\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"Return", "[", "fw", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q0Val", "=", 
        RowBox[{"fw", "[", "\"\<q0\>\"", "]"}]}], ";", 
       RowBox[{"j0Val", "=", 
        RowBox[{"fw", "[", "\"\<j0\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fw", "[", "\"\<c2WindowCut\>\"", "]"}], "===", "None"}], 
