         RowBox[{"\"\<bothOK\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"signOK", "&&", 
            RowBox[{
             RowBox[{"Abs", "[", "x0", "]"}], "<=", 
             RowBox[{"OptionValue", "[", "\"\<X0Max\>\"", "]"}]}]}], 
           ")"}]}]}], "|>"}]}]}], "]"}]}], ";"}]}]], "Input",
