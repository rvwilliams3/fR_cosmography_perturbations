               "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"<|", 
              RowBox[{"\"\<x0\>\"", "->", "\"\<no window\>\""}], "|>"}], 
             "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"lab", ",", 
           RowBox[{"{", 
            RowBox[{
            "\"\<mean\>\"", ",", "\"\<q-j-\>\"", ",", "\"\<q-j+\>\"", ",", 
             "\"\<q+j-\>\"", ",", "\"\<q+j+\>\""}], "}"}]}], "}"}]}], 
        "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], 
    "]"}]}]}]], "Input",
