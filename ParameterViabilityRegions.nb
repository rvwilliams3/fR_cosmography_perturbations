               RowBox[{"jj", "[", "\"\<min\>\"", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "\"\<max\>\"", "]"}], ",", 
               RowBox[{"jj", "[", "\"\<max\>\"", "]"}]}], "}"}]}], "]"}], ",",
            "Black", ",", 
           RowBox[{"PointSize", "[", "0.012", "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "[", "\"\<mean\>\"", "]"}], ",", 
              RowBox[{"jj", "[", "\"\<mean\>\"", "]"}]}], "}"}], "]"}]}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "viablePlanckDatasets", "]"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"legend", "=", 
     RowBox[{"SwatchLegend", "[", 
      RowBox[{"colors", ",", 
       RowBox[{"Abbrev", "/@", "viablePlanckDatasets"}], ",", 
       RowBox[{"LegendMarkerSize", "->", "14"}], ",", 
       RowBox[{"LegendLabel", "->", "None"}], ",", 
       RowBox[{"LegendFunction", "->", 
