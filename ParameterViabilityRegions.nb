Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rebuild", " ", "trajectory", " ", "in", " ", "full"}], ",", " ", 
    
    RowBox[{"returns", " ", "interpolating", " ", "functions"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ReSolveTrajectory", "[", 
     RowBox[{"model_String", ",", 
      RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"c2_", "?", "NumericQ"}], ",", 
      RowBox[{"zi_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
         RowBox[{"\"\<AccuracyGoal\>\"", "->", "25"}], ",", 
         RowBox[{"\"\<MaxSteps\>\"", "->", 
          RowBox[{"10", "^", "8"}]}], ",", 
         RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epsVal", ",", "fp", ",", "cl", ",", "vq", ",", "vxOmega", ",", "qFn", 
        ",", "deltaQ", ",", "c3", ",", "xi", ",", "\[CapitalOmega]i", ",", 
        "sol", ",", "wp"}], "}"}], ",", 
      RowBox[{
       RowBox[{"wp", "=", 
        RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fp", "=", 
        RowBox[{"MatterDominatedFPEps", "[", 
         RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cl", "=", 
        RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"cl", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vq", "=", 
        RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", 
       RowBox[{"vxOmega", "=", 
        RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qFn", "=", 
        RowBox[{"qFnP", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"deltaQ", "=", 
        RowBox[{
         RowBox[{"qFn", "[", "zi", "]"}], "-", 
         RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"c3", "=", 
        RowBox[{"deltaQ", "/", 
         RowBox[{"vq", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xi", "=", 
        RowBox[{"SetPrecision", "[", 
