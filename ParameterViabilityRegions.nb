Cell[CellGroupData[{

Cell["Matter dominated fixed point selection modules", "Subsubsection",
 CellChangeTimes->{{3.991726373941082*^9, 3.9917263874138927`*^9}, {
  3.9917265366132383`*^9, 
  3.991726537972209*^9}},ExpressionUUID->"ac8c6f97-973c-43e7-ba5e-\
f69cc93fca57"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FixedPointsStabilityEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "jExpr", ",", "jAlg", ",", "fps", ",", "jacMat", ",", "jacFn", ",", 
       "xx", ",", "OO", ",", "qq"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"substitute", " ", "onto", " ", "private", " ", 
         RowBox[{"symbols", ":", "qq"}]}], ",", "xx", ",", 
        RowBox[{
        "OO", " ", "cannot", " ", "collide", " ", "with", " ", "the", " ", 
         "global", " ", "x"}], ",", "\[CapitalOmega]", ",", 
        RowBox[{
        "q", " ", "used", " ", "as", " ", "ODE", " ", "function", " ", 
         "names"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"jAlg", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"jExpr", "/.", " ", 
          RowBox[{
           RowBox[{"q", "[", "n", "]"}], "->", "qq"}]}], ")"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Fx", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"F\[CapitalOmega]", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"Fq", "[", 
             RowBox[{"qq", ",", "jAlg"}], "]"}], "==", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], ",", "Reals"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jacMat", "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Fx", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"F\[CapitalOmega]", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"Fq", "[", 
            RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"jacFn", "=", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xv", ",", "Ov", ",", "qv"}], "}"}], ",", 
         RowBox[{"jacMat", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xx", "->", "xv"}], ",", 
            RowBox[{"OO", "->", "Ov"}], ",", 
            RowBox[{"qq", "->", "qv"}]}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<jAlg\>\"", "->", "jAlg"}], ",", 
        RowBox[{"\"\<fixedPoints\>\"", "->", "fps"}], ",", 
        RowBox[{"\"\<vars\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}]}], ",", 
        RowBox[{"\"\<Jac\>\"", "->", "jacFn"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991726082177257*^9, 3.991726141855951*^9}, {
   3.9947424573092327`*^9, 3.994742478304962*^9}, {3.9949201798119*^9, 
   3.994920185127494*^9}, 3.9953396413370256`*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"e5b43392-9fc9-493a-8cf4-d3a46401f6bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFPEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"MatterDominatedFPEps", "[", 
     RowBox[{"model", ",", "epsVal"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "fpResult", ",", "fps", ",", "vars", ",", "Jac", ",", "ptVals", ",", 
        "target", ",", "distances", ",", "bestIdx", ",", "vals", ",", "eig", 
        ",", "eigvecs", ",", "type"}], "}"}], ",", 
      RowBox[{
       RowBox[{"fpResult", "=", 
        RowBox[{"FixedPointsStabilityEps", "[", 
         RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "=", 
        RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
       RowBox[{"vars", "=", 
        RowBox[{"fpResult", "[", "\"\<vars\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Jac", "=", 
        RowBox[{"fpResult", "[", "\"\<Jac\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ptVals", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"vars", "/.", " ", "#"}], "]"}], "&"}], ",", "fps"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"target", "=", 
        RowBox[{"N", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#", "-", "target"}], "]"}], "&"}], ",", "ptVals"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"ptVals", "[", 
         RowBox[{"[", "bestIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
        RowBox[{
         RowBox[{"Eigensystem", "[", 
          RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"type", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Stable node/spiral\>\"", ",", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<jAlg\>\"", "->", 
          RowBox[{"fpResult", "[", "\"\<jAlg\>\"", "]"}]}], ",", 
         RowBox[{"\"\<x\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<q\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<eigenvalues\>\"", "->", "eig"}], ",", 
         RowBox[{"\"\<eigenvectors\>\"", "->", "eigvecs"}], ",", 
         RowBox[{"\"\<type\>\"", "->", "type"}]}], "|>"}]}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9949202320034857`*^9, 3.994920234642846*^9}, 
   3.995242955731804*^9, {3.995339564854842*^9, 3.995339565200104*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"b577a92d-1699-4df7-99b5-bd0e66f61538"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Classification of eigenvectors:", "Subsubsection",
 CellChangeTimes->{{3.991733381294153*^9, 
  3.99173339134886*^9}},ExpressionUUID->"a858ada0-2df1-4a40-a5ed-\
de473684d0b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
       RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unstableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qComponents", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], "<=", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vxOmega", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vxOmega"}], ",", "vxOmega"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vq", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "vq"}], ",", "vq"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
        RowBox[{"\"\<vxOmega\>\"", "->", "vxOmega"}], ",", 
        RowBox[{"\"\<vStable\>\"", "->", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", "stableIdx", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaQ\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaXOmega\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996839535509368*^9, 3.996839551256282*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"10682371-23ff-473a-aadd-6eb91a05d49a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Module to classify trajectory viability", "Subsubsection",
 CellChangeTimes->{{3.994748097312368*^9, 
  3.994748107179188*^9}},ExpressionUUID->"14e0aa2e-6510-4b5e-97d5-\
8ec3f5dc112d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyTrajectoryViability", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", "xFn_", ",", 
     "\[CapitalOmega]Fn_", ",", "qFn_", ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NSamples\>\"", "->", "150"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", 
        RowBox[{"\"\<ZMin\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "4"}]}]}], ",", 
        RowBox[{"\"\<MaxAbsX\>\"", "->", 
         RowBox[{"10", "^", "3"}]}], ",", 
        RowBox[{"\"\<MaxOmega\>\"", "->", "10"}], ",", 
        RowBox[{"\"\<DomainTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "nSamples", ",", "singTol", ",", "zMinSample", ",", 
       "maxAbsX", ",", "maxOm", ",", "domainTol", ",", "domain", ",", 
       "domainMin", ",", "domainMax", ",", "zSamples", ",", "sampleData", ",",
        "hasSignViolation", ",", "hasNearSingular", ",", "hasOmegaViolation", 
       ",", "hasDivergence", ",", "isPhysical", ",", "label"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nSamples", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zMinSample", "=", 
       RowBox[{"OptionValue", "[", "\"\<ZMin\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxAbsX", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxAbsX\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxOm", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"domainTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<DomainTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"domain", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"domainMin", "=", 
       RowBox[{"domain", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"domainMax", "=", 
       RowBox[{"domain", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "solution", " ", "must", " ", "actually", " ", "reach", " ", "z"}], 
         "=", 
         RowBox[{
          RowBox[{"0", " ", "and", " ", "z"}], "=", 
          RowBox[{
           RowBox[{"zi", "--"}], " ", "no", " ", 
           RowBox[{"extrapolation", ".", "DomainTol"}], " ", 
           RowBox[{"(", "strict", ")"}], " ", "judges", " ", "validity"}]}]}],
         ";", 
        RowBox[{
        "ZMin", " ", "only", " ", "sets", " ", "sample", " ", "spacing", " ", 
         
         RowBox[{"below", "."}]}]}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"domainMin", ">", "domainTol"}], "||", 
         RowBox[{"domainMax", "<", "zi"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<label\>\"", "->", "\"\<Diverged\>\""}], ",", 
           RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
           RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
           RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
           RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
           RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
           RowBox[{"\"\<sampleData\>\"", "->", 
            RowBox[{"{", "}"}]}]}], "|>"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zSamples", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log10", "[", "zMinSample", "]"}], ",", 
            RowBox[{"Log10", "[", 
             RowBox[{"Min", "[", 
              RowBox[{"zi", ",", "domainMax"}], "]"}], "]"}], ",", 
            RowBox[{"nSamples", "-", "2"}]}], "]"}]}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"sampleData", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "xVal", ",", "\[CapitalOmega]Val", ",", "qVal", ",", "jVal", ",", 
             "denom", ",", "ratio", ",", "pointLabel"}], "}"}], ",", 
           RowBox[{
            RowBox[{"xVal", "=", 
             RowBox[{"xFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]Val", "=", 
             RowBox[{"\[CapitalOmega]Fn", "[", "zPt", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"qVal", "=", 
             RowBox[{"qFn", "[", "zPt", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"jVal", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"jModelMap", "[", "model", "]"}], "[", "zPt", "]"}], 
                "/.", " ", 
                RowBox[{"\[Epsilon]", "->", "epsVal"}]}], ")"}], "/.", " ", 
              RowBox[{
               RowBox[{"q", "[", "zPt", "]"}], "->", "qVal"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"denom", "=", 
             RowBox[{"jVal", "-", "qVal", "-", "2"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pointLabel", "=", 
             RowBox[{"Which", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"NumericQ", "[", "xVal", "]"}], "&&", 
                  RowBox[{"NumericQ", "[", "\[CapitalOmega]Val", "]"}]}], 
                 ")"}]}], ",", "\"\<Divergent\>\"", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "xVal", "]"}], ">", "maxAbsX"}], "||", 
                RowBox[{"\[CapitalOmega]Val", ">", "maxOm"}]}], ",", 
               "\"\<Divergent\>\"", ",", 
               RowBox[{
                RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
               "\"\<NearSingular\>\"", ",", 
               RowBox[{"\[CapitalOmega]Val", "<=", "0"}], ",", 
               "\"\<OmegaViolation\>\"", ",", 
               RowBox[{
                RowBox[{"xVal", "/", "denom"}], "<", "0"}], ",", 
               "\"\<SignViolation\>\"", ",", "True", ",", "\"\<OK\>\""}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ratio", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
               "Indeterminate", ",", 
               RowBox[{"xVal", "/", "denom"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<z\>\"", "->", "zPt"}], ",", 
              RowBox[{"\"\<x\>\"", "->", "xVal"}], ",", 
              RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Val"}],
               ",", 
              RowBox[{"\"\<q\>\"", "->", "qVal"}], ",", 
              RowBox[{"\"\<j\>\"", "->", "jVal"}], ",", 
              RowBox[{"\"\<denom\>\"", "->", "denom"}], ",", 
              RowBox[{"\"\<ratio\>\"", "->", "ratio"}], ",", 
              RowBox[{"\"\<pointLabel\>\"", "->", "pointLabel"}]}], 
             "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"zPt", ",", "zSamples"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasDivergence", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<Divergent\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasNearSingular", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<NearSingular\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasOmegaViolation", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<OmegaViolation\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasSignViolation", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<SignViolation\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"isPhysical", "=", 
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
         "hasDivergence", "||", "hasNearSingular", "||", "hasOmegaViolation", 
          "||", "hasSignViolation"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
        "isPhysical", ",", "\"\<Physical\>\"", ",", "hasDivergence", ",", 
         "\"\<Divergent\>\"", ",", "hasNearSingular", ",", 
         "\"\<NearSingular\>\"", ",", "hasOmegaViolation", ",", 
         "\"\<OmegaViolation\>\"", ",", "hasSignViolation", ",", 
         "\"\<SignViolation\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<hasDivergence\>\"", "->", "hasDivergence"}], ",", 
        RowBox[{"\"\<hasSignViolation\>\"", "->", "hasSignViolation"}], ",", 
        RowBox[{"\"\<hasNearSingular\>\"", "->", "hasNearSingular"}], ",", 
        RowBox[{"\"\<hasOmegaViolation\>\"", "->", "hasOmegaViolation"}], ",", 
        RowBox[{"\"\<minRatio\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"sampleData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "\"\<ratio\>\""}], "]"}], "]"}], ",", 
            RowBox[{"_", "?", "NumericQ"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<minOmega\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"sampleData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<maxOmega\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"sampleData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<maxAbsX\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<x\>\""}], "]"}], "]"}], "]"}], "]"}]}], 
        ",", 
        RowBox[{"\"\<minAbsDenom\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<denom\>\""}], "]"}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
        RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
        RowBox[{"\"\<sampleData\>\"", "->", "sampleData"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994743934973697*^9, 3.994744013979355*^9}, {
   3.994744117690578*^9, 3.9947441563946238`*^9}, {3.99476114587543*^9, 
   3.9947612294244556`*^9}, {3.9947614538243637`*^9, 3.994761520432472*^9}, {
   3.994761588533358*^9, 3.994761708823436*^9}, 3.994994871843858*^9, 
   3.994995587304584*^9, 3.9950852439596357`*^9, {3.995085348575189*^9, 
   3.995085348730777*^9}, {3.995244322336978*^9, 3.995244331564878*^9}, {
   3.995244914621324*^9, 3.995244914788275*^9}, {3.995264084014765*^9, 
   3.9952640898260508`*^9}, {3.995339707776859*^9, 3.99533971178736*^9}, 
   3.998448972610733*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"06f96746-5f41-4e12-8e59-0fab27956a00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scan of ICs", "Subsubsection",
 CellChangeTimes->{{3.991733431058099*^9, 3.991733439041154*^9}, {
  3.991791735333887*^9, 3.991791737840498*^9}, {3.995339938669035*^9, 
  3.995339940350081*^9}},ExpressionUUID->"80e9934b-19da-4e0f-b508-\
405cd242637c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanICsP", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", "c2Range_List", ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", 
        RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
        RowBox[{"\"\<AccuracyGoal\>\"", "->", "25"}], ",", 
        RowBox[{"\"\<MaxSteps\>\"", "->", 
         RowBox[{"10", "^", "8"}]}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "nSamp", ",", "singTol", ",", "pg", ",", "ag", ",", 
       "maxSt", ",", "wp", ",", "fp", ",", "cl", ",", "vq", ",", "vxOmega", 
       ",", "qFn", ",", "deltaQ", ",", "c3"}], "}"}], ",", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nSamp", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxSt", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxSteps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fp", "=", 
       RowBox[{"MatterDominatedFPEps", "[", 
        RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cl", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cl", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<label\>\"", "->", "\"\<DegenerateFP\>\""}]}], 
            "|>"}], ",", 
           RowBox[{"{", 
            RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"qFnP", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"deltaQ", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "zi", "]"}], "-", 
        RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c3", "=", 
       RowBox[{"deltaQ", "/", 
        RowBox[{"vq", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "xi", ",", "\[CapitalOmega]i", ",", "sol", ",", "xFn", ",", 
            "\[CapitalOmega]Fn", ",", "viability"}], "}"}], ",", 
          RowBox[{
           RowBox[{"xi", "=", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"vxOmega", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "+", 
               RowBox[{"c3", " ", 
                RowBox[{"vq", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"\[CapitalOmega]i", "=", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"vxOmega", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "+", 
               RowBox[{"c3", " ", 
                RowBox[{"vq", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"sol", "=", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", "q", "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"q", "[", "zz_", "]"}], ":=", 
                RowBox[{"qFn", "[", "zz", "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Quiet", "[", 
                RowBox[{
                 RowBox[{"NDSolve", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                    "\[CapitalOmega]i"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "[", "z", "]"}], "]"}], ">", 
                    RowBox[{"10", "^", "3"}]}], ",", 
                    "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], ">", "10"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "<", "0"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
                   RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
                   RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
                   RowBox[{"MaxSteps", "->", "maxSt"}], ",", 
                   RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"NDSolve", "::", "ndsz"}], ",", 
                   RowBox[{"NDSolve", "::", "mxst"}], ",", 
                   RowBox[{"NDSolve", "::", "precw"}], ",", 
                   RowBox[{"NDSolve", "::", "ndtol"}], ",", 
                   RowBox[{"NDSolve", "::", "nlnum"}], ",", 
                   RowBox[{"NDSolve", "::", "ndcf"}]}], "}"}]}], "]"}]}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MatchQ", "[", 
               RowBox[{"sol", ",", 
                RowBox[{"{", 
                 RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
               RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
               RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}],
                ",", 
               RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
               RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
               RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
               RowBox[{"\"\<label\>\"", "->", "\"\<Failed\>\""}]}], "|>"}], 
             ",", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"xFn", "=", 
                RowBox[{"x", "/.", " ", 
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"\[CapitalOmega]Fn", "=", 
                RowBox[{"\[CapitalOmega]", "/.", " ", 
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"viability", "=", 
                RowBox[{"ClassifyTrajectoryViability", "[", 
                 RowBox[{
                 "model", ",", "j0Val", ",", "q0Val", ",", "xFn", ",", 
                  "\[CapitalOmega]Fn", ",", "qFn", ",", "zi", ",", 
                  RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
                  RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
                   RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
                   RowBox[{
                   "\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}]}], 
                  "|>"}], ",", "viability"}], "]"}]}], ")"}]}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998448861323873*^9, 3.998448861326523*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"7b8db0b7-e2b5-4812-9622-9b3bba847d22"]
}, Open  ]]
}, Closed]],

