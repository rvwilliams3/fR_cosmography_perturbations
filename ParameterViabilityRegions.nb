         RowBox[{"ImageSize", "->", "420"}]}], "]"}], ",", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"slice", "===", "\"\<vary q0\>\""}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"Values", "[", "dsColors", "]"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Black", ",", "Dashed"}], "]"}]}], "]"}], ",", 
             RowBox[{"Values", "[", "dsColors", "]"}]}], "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Count", "[", 
                   RowBox[{
                    RowBox[{"figBData", "[", 
                    RowBox[{"dataset", ",", "slice"}], "]"}], ",", 
                    RowBox[{"r_", "/;", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"r", "[", "\"\<todayFound\>\"", "]"}], "]"}]}]}], 
                   "]"}], ">", "1"}], ",", 
                 RowBox[{"Abbrev", "[", "dataset", "]"}], ",", 
                 RowBox[{
                  RowBox[{"Abbrev", "[", "dataset", "]"}], "<>", 
                  "\"\< (no window)\>\""}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], 
              "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"slice", "===", "\"\<vary q0\>\""}], ",", 
               RowBox[{"{", "\"\<j=1\>\"", "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"LegendFunction", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Framed", "[", 
               RowBox[{"#", ",", 
                RowBox[{"FrameStyle", "->", 
                 RowBox[{"Darker", "[", "Gray", "]"}]}], ",", 
                RowBox[{"RoundingRadius", "->", "0"}], ",", 
                RowBox[{"Background", "->", "White"}]}], "]"}], "&"}], 
             ")"}]}]}], "]"}], ",", "legPos"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"panel", "[", 
