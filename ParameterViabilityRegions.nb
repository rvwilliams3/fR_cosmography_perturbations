Cell[BoxData[
 RowBox[{"Dataset", "@", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"dataset", "->", 
      RowBox[{"Association", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"lab", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"figAData", "[", 
              RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], "]"}], 
             "]"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"q0v", "=", 
                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<q0\>\""}], "]"}]}],
                 ",", 
