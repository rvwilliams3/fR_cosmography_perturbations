Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dsColors", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"viablePlanckDatasets", ",", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "viablePlanckDatasets", "]"}], "]"}]}]}], 
       "]"}]}], ",", "panel"}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"panel", "[", 
      RowBox[{
      "slice_String", ",", "xKey_String", ",", "xLabel_", ",", "xRange_", ",",
        "legPos_"}], "]"}], ":=", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"Flatten", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"c", "=", 
                   RowBox[{"dsColors", "[", "dataset", "]"}]}], ",", 
                  RowBox[{"found", "=", 
                   RowBox[{"SortBy", "[", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"figBData", "[", 
                    RowBox[{"dataset", ",", "slice"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"#", "[", "\"\<todayFound\>\"", "]"}], "]"}], 
                    "&"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "xKey", "]"}], "&"}]}], "]"}]}]}], 
                 "}"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "found", "]"}], ">", "1"}], ",", 
                  RowBox[{"With", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"lower", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "xKey", "]"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{"#", "[", "\"\<m0\>\"", "]"}], "]"}]}], "}"}], 
                    "&"}], "/@", "found"}]}], ",", 
                    RowBox[{"upper", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "xKey", "]"}], ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"#", "[", "\"\<m0\>\"", "]"}], "]"}]}], "}"}], 
                    "&"}], "/@", "found"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Graphics", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Opacity", "[", "0.25", "]"}], ",", "c", ",", 
                    RowBox[{"Polygon", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{"lower", ",", 
                    RowBox[{"Reverse", "[", "upper", "]"}]}], "]"}], "]"}]}], 
                    "}"}], "]"}], ",", 
                    RowBox[{"ListLinePlot", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"lower", ",", "upper"}], "}"}], ",", 
                    RowBox[{"PlotStyle", "->", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"c", ",", "Thick"}], "]"}]}]}], "]"}]}], "}"}]}], 
                   "]"}], ",", "Nothing"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"j0", "=", 
               RowBox[{"1", " ", "reference", " ", "band"}]}], ",", 
              RowBox[{"q0", " ", "slice", " ", "only"}]}], "*)"}], 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"slice", "===", "\"\<vary q0\>\""}], ",", 
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"found", "=", 
                  RowBox[{"SortBy", "[", 
                   RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"figBRef", ",", 
                    RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"#", "[", "\"\<todayFound\>\"", "]"}], "]"}], 
                    "&"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<q0\>\"", "]"}], "&"}]}], "]"}]}], 
                 "}"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "found", "]"}], ">", "1"}], ",", 
                  RowBox[{"With", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"lower", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<q0\>\"", "]"}], ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{"#", "[", "\"\<m0\>\"", "]"}], "]"}]}], "}"}], 
                    "&"}], "/@", "found"}]}], ",", 
                    RowBox[{"upper", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<q0\>\"", "]"}], ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"#", "[", "\"\<m0\>\"", "]"}], "]"}]}], "}"}], 
                    "&"}], "/@", "found"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Graphics", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Opacity", "[", "0.12", "]"}], ",", "Black", ",", 
                    
                    RowBox[{"Polygon", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{"lower", ",", 
                    RowBox[{"Reverse", "[", "upper", "]"}]}], "]"}], "]"}]}], 
                    "}"}], "]"}], ",", 
                    RowBox[{"ListLinePlot", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"lower", ",", "upper"}], "}"}], ",", 
                    RowBox[{"PlotStyle", "->", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", "Thick", ",", "Dashed"}], "]"}]}]}],
                     "]"}]}], "}"}]}], "]"}], ",", "Nothing"}], "]"}]}], 
               "]"}], ",", "Nothing"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
