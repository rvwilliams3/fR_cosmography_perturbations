Cell[CellGroupData[{

Cell["Using bisection for faster sweep of grid", "Subsubsection",
 CellChangeTimes->{{3.998458634482603*^9, 
  3.99845864098985*^9}},ExpressionUUID->"436a3097-6a97-4387-b48d-\
739cc8dd081a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Purpose", ":", 
     RowBox[{
     "locate", " ", "the", " ", "viable", " ", "c2", " ", "window", " ", "by",
       " ", "bisection"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"tracking", " ", "two", " ", "nested", " ", 
       RowBox[{"criteria", ".", "\"\<sign\>\""}], " ", "is", " ", "the", " ", 
       "theorem"}], "-", 
      RowBox[{"level", " ", "condition", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f_R", ">", "0"}], ",", 
          RowBox[{"f_RR", ">", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"i", ".", "e", ".", "x"}], "/", 
            RowBox[{"(", 
             RowBox[{"j", "-", "q", "-", "2"}], ")"}]}], ">=", 
           RowBox[{"0", " ", "throughout"}]}], ",", 
          RowBox[{
          "plus", " ", "no", " ", "divergence", " ", "or", " ", "Omega", " ", 
           "violation"}]}], ")"}], ".", "\"\<cut\>\""}], " ", "additionally", 
       " ", "imposes"}]}], "|", 
     RowBox[{"x", 
      RowBox[{"(", "0", ")"}]}], "|", " ", 
     RowBox[{"<=", "X0Max"}]}], ",", 
    RowBox[{
     RowBox[{
     "a", " ", "judgement", " ", "about", " ", "plausible", " ", "present"}], 
     "-", 
     RowBox[{"day", " ", "deviation", " ", "from", " ", 
      RowBox[{"GR", ".", "The"}], " ", "cut", " ", "window", " ", "is", " ", 
      "contained", " ", "in", " ", "the", " ", "sign", " ", "window"}]}], ",", 
    RowBox[{
     RowBox[{
     "so", " ", "both", " ", "are", " ", "bisected", " ", "from", " ", "the", 
      " ", "same", " ", "seed"}], ";", 
     RowBox[{
     "if", " ", "the", " ", "seed", " ", "passes", " ", "sign", " ", "but", 
      " ", "fails", " ", "the", " ", "cut"}]}], ",", 
    RowBox[{
    "the", " ", "cut", " ", "window", " ", "is", " ", "bracketed", " ", 
     "within", " ", "the", " ", "sign", " ", "window", " ", 
     RowBox[{"instead", ".", "Assumes"}], " ", "each", " ", "window", " ", 
     "is", " ", "a", " ", "single", " ", "interval", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"check", " ", "nRuns"}], "==", "1"}], ")"}], "."}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"FindWindow", "[", 
     RowBox[{"model_String", ",", 
      RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"zi_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<NBisect\>\"", "->", "20"}], ",", 
         RowBox[{"\"\<X0Max\>\"", "->", "0.25"}], ",", 
         RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
         RowBox[{"\"\<SingularTol\>\"", "->", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}], ",", 
         RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
         RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
         RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}], ",", 
         RowBox[{"\"\<NLadder\>\"", "->", "8"}], ",", 
         RowBox[{"\"\<MaxExpand\>\"", "->", "40"}]}], "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "epsVal", ",", "fp", ",", "cl", ",", "vq", ",", "vxOmega", ",", "qFn", 
        ",", "c3", ",", "xiKin", ",", "gain", ",", "c2Cut", ",", "scale", ",",
         "chk", ",", "signQ", ",", "bothQ", ",", "cands", ",", "seed", ",", 
        "step", ",", "bisect", ",", "wSign", ",", "wCut", ",", "seedCut", ",",
         "inner"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fp", "=", 
        RowBox[{"MatterDominatedFPEps", "[", 
         RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cl", "=", 
        RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"cl", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
            RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
            RowBox[{"\"\<note\>\"", "->", "\"\<DegenerateFP\>\""}]}], "|>"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"vq", "=", 
        RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", 
       RowBox[{"vxOmega", "=", 
        RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
       RowBox[{"gain", "=", 
        RowBox[{"vxOmega", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"qFn", "=", 
        RowBox[{"qFnP", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"c3", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"qFn", "[", "zi", "]"}], "-", 
           RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}], ")"}], "/", 
         RowBox[{"vq", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xiKin", "=", 
        RowBox[{"c3", " ", 
         RowBox[{"vq", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"c2Cut", "=", 
        RowBox[{
         RowBox[{"-", "xiKin"}], "/", "gain"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"scale", "=", 
        RowBox[{"AutoC2Scale", "[", 
         RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"chk", "[", "c2_", "]"}], ":=", 
        RowBox[{
         RowBox[{"chk", "[", "c2", "]"}], "=", 
         RowBox[{"ViabilityCheck", "[", 
          RowBox[{
          "model", ",", "q0Val", ",", "j0Val", ",", "c2", ",", "zi", ",", 
           RowBox[{"\"\<X0Max\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<X0Max\>\"", "]"}]}], ",", 
           RowBox[{"\"\<NSamples\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ",", 
           RowBox[{"\"\<SingularTol\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ",", 
           RowBox[{"\"\<PrecisionGoal\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ",", 
           RowBox[{"\"\<AccuracyGoal\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ",", 
           
           RowBox[{"\"\<WorkingPrecision\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}]}],
           "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"signQ", "[", "c2_", "]"}], ":=", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"chk", "[", "c2", "]"}], "[", "\"\<signOK\>\"", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bothQ", "[", "c2_", "]"}], ":=", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"chk", "[", "c2", "]"}], "[", "\"\<bothOK\>\"", "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cands", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"xiKin", "<", "0"}], ",", "0.", ",", 
             RowBox[{"c2Cut", " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "3"}]}]}], ")"}]}]}], "]"}], "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"c2Cut", " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"10", "^", 
                RowBox[{"-", "k"}]}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2", ",", "7"}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"c2Cut", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"10", "^", 
                RowBox[{"-", "k"}]}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2", ",", "7"}], "}"}]}], "]"}], ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "scale"}], " ", 
                RowBox[{"10", "^", "e"}]}], ",", 
               RowBox[{"scale", " ", 
                RowBox[{"10", "^", "e"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"e", ",", 
               RowBox[{"Subdivide", "[", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "2", ",", 
                 RowBox[{
                  RowBox[{"OptionValue", "[", "\"\<NLadder\>\"", "]"}], "-", 
                  "1"}]}], "]"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"seed", "=", 
        RowBox[{"SelectFirst", "[", 
         RowBox[{"cands", ",", "signQ", ",", "$Failed"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"seed", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
            RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
            RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
            RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
            RowBox[{"\"\<xiKin\>\"", "->", "xiKin"}], ",", 
            RowBox[{"\"\<c2Cut\>\"", "->", "c2Cut"}], ",", 
            RowBox[{"\"\<note\>\"", "->", "\"\<No viable seed found\>\""}]}], 
           "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "scale", "]"}], ",", 
           RowBox[{"Abs", "[", "seed", "]"}]}], "]"}], "/", "4"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bisect", "[", 
         RowBox[{"pred_", ",", "s_"}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "lo", ",", "hi", ",", "mid", ",", "k", ",", "nExp", ",", "a", ",", 
            "b"}], "}"}], ",", 
          RowBox[{
           RowBox[{"lo", "=", "s"}], ";", 
           RowBox[{"hi", "=", 
            RowBox[{"s", "+", "step"}]}], ";", 
           RowBox[{"nExp", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"pred", "[", "hi", "]"}], "&&", 
              RowBox[{"nExp", "<", 
               RowBox[{"OptionValue", "[", "\"\<MaxExpand\>\"", "]"}]}]}], 
             ",", 
             RowBox[{
              RowBox[{"lo", "=", "hi"}], ";", 
              RowBox[{"hi", "=", 
               RowBox[{"hi", "+", "step"}]}], ";", 
              RowBox[{"nExp", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"lo", "+", "hi"}], ")"}], "/", "2"}]}], ";", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"pred", "[", "mid", "]"}], ",", 
                RowBox[{"lo", "=", "mid"}], ",", 
                RowBox[{"hi", "=", "mid"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"OptionValue", "[", "\"\<NBisect\>\"", "]"}]}], 
              "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"b", "=", "lo"}], ";", "\[IndentingNewLine]", 
           RowBox[{"hi", "=", "s"}], ";", 
           RowBox[{"lo", "=", 
            RowBox[{"s", "-", "step"}]}], ";", 
           RowBox[{"nExp", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"pred", "[", "lo", "]"}], "&&", 
              RowBox[{"nExp", "<", 
               RowBox[{"OptionValue", "[", "\"\<MaxExpand\>\"", "]"}]}]}], 
             ",", 
             RowBox[{
              RowBox[{"hi", "=", "lo"}], ";", 
              RowBox[{"lo", "=", 
               RowBox[{"lo", "-", "step"}]}], ";", 
              RowBox[{"nExp", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mid", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"lo", "+", "hi"}], ")"}], "/", "2"}]}], ";", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"pred", "[", "mid", "]"}], ",", 
                RowBox[{"hi", "=", "mid"}], ",", 
                RowBox[{"lo", "=", "mid"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"OptionValue", "[", "\"\<NBisect\>\"", "]"}]}], 
              "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"a", "=", "hi"}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wSign", "=", 
        RowBox[{"bisect", "[", 
         RowBox[{"signQ", ",", "seed"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"bothQ", "[", "seed", "]"}], ",", 
         RowBox[{"seedCut", "=", "seed"}], ",", 
         RowBox[{
          RowBox[{"inner", "=", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"wSign", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"wSign", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "20"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"seedCut", "=", 
           RowBox[{"SelectFirst", "[", 
            RowBox[{"inner", ",", "bothQ", ",", "$Failed"}], "]"}]}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"wCut", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"seedCut", "===", "$Failed"}], ",", "None", ",", 
          RowBox[{"bisect", "[", 
           RowBox[{"bothQ", ",", "seedCut"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<found\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
         RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
         RowBox[{"\"\<xiKin\>\"", "->", "xiKin"}], ",", 
         RowBox[{"\"\<c2Cut\>\"", "->", "c2Cut"}], ",", 
         RowBox[{"\"\<gain\>\"", "->", "gain"}], ",", 
         RowBox[{"\"\<seed\>\"", "->", "seed"}], ",", 
         RowBox[{"\"\<x0Max\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<X0Max\>\"", "]"}]}], ",", 
         RowBox[{"\"\<c2Window\>\"", "->", "wSign"}], ",", 
         RowBox[{"\"\<c2WindowCut\>\"", "->", "wCut"}], ",", 
         RowBox[{"\"\<xiWindow\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"xiKin", "+", 
              RowBox[{"gain", " ", "#"}]}], "&"}], "/@", "wSign"}], ")"}]}], 
         ",", 
         RowBox[{"\"\<xiWindowCut\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"wCut", "===", "None"}], ",", "None", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"xiKin", "+", 
               RowBox[{"gain", " ", "#"}]}], "&"}], "/@", "wCut"}]}], "]"}]}],
          ",", 
         RowBox[{"\"\<cutBinds\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"wCut", "===", "None"}], ",", "True", ",", 
            RowBox[{"wCut", "=!=", "wSign"}]}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}]}]], "Input",
