Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanICsP", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", "c2Range_List", ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
        RowBox[{"\"\<SingularTol\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", 
        RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
        RowBox[{"\"\<AccuracyGoal\>\"", "->", "25"}], ",", 
        RowBox[{"\"\<MaxSteps\>\"", "->", 
         RowBox[{"10", "^", "8"}]}], ",", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "nSamp", ",", "singTol", ",", "pg", ",", "ag", ",", 
       "maxSt", ",", "wp", ",", "fp", ",", "cl", ",", "vq", ",", "vxOmega", 
       ",", "qFn", ",", "deltaQ", ",", "c3"}], "}"}], ",", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nSamp", "=", 
       RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singTol", "=", 
       RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxSt", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxSteps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fp", "=", 
       RowBox[{"MatterDominatedFPEps", "[", 
        RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cl", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"cl", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<label\>\"", "->", "\"\<DegenerateFP\>\""}]}], 
            "|>"}], ",", 
           RowBox[{"{", 
            RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"qFnP", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val", ",", "zi"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"deltaQ", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "zi", "]"}], "-", 
        RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c3", "=", 
       RowBox[{"deltaQ", "/", 
        RowBox[{"vq", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "xi", ",", "\[CapitalOmega]i", ",", "sol", ",", "xFn", ",", 
            "\[CapitalOmega]Fn", ",", "viability"}], "}"}], ",", 
          RowBox[{
           RowBox[{"xi", "=", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"vxOmega", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "+", 
               RowBox[{"c3", " ", 
                RowBox[{"vq", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"\[CapitalOmega]i", "=", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"vxOmega", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "+", 
               RowBox[{"c3", " ", 
                RowBox[{"vq", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"sol", "=", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", "q", "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"q", "[", "zz_", "]"}], ":=", 
                RowBox[{"qFn", "[", "zz", "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Quiet", "[", 
                RowBox[{
                 RowBox[{"NDSolve", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                    "\[CapitalOmega]i"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "[", "z", "]"}], "]"}], ">", 
                    RowBox[{"10", "^", "3"}]}], ",", 
                    "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], ">", "10"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "<", "0"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
                   RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
                   RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
                   RowBox[{"MaxSteps", "->", "maxSt"}], ",", 
                   RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"NDSolve", "::", "ndsz"}], ",", 
                   RowBox[{"NDSolve", "::", "mxst"}], ",", 
                   RowBox[{"NDSolve", "::", "precw"}], ",", 
                   RowBox[{"NDSolve", "::", "ndtol"}], ",", 
                   RowBox[{"NDSolve", "::", "nlnum"}], ",", 
                   RowBox[{"NDSolve", "::", "ndcf"}]}], "}"}]}], "]"}]}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"MatchQ", "[", 
               RowBox[{"sol", ",", 
                RowBox[{"{", 
                 RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
               RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
               RowBox[{"\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}],
                ",", 
               RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
               RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
               RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
               RowBox[{"\"\<label\>\"", "->", "\"\<Failed\>\""}]}], "|>"}], 
             ",", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"xFn", "=", 
                RowBox[{"x", "/.", " ", 
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"\[CapitalOmega]Fn", "=", 
                RowBox[{"\[CapitalOmega]", "/.", " ", 
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"viability", "=", 
                RowBox[{"ClassifyTrajectoryViability", "[", 
                 RowBox[{
                 "model", ",", "j0Val", ",", "q0Val", ",", "xFn", ",", 
                  "\[CapitalOmega]Fn", ",", "qFn", ",", "zi", ",", 
                  RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
                  RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
                   RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
                   RowBox[{
                   "\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}]}], 
                  "|>"}], ",", "viability"}], "]"}]}], ")"}]}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998448861323873*^9, 3.998448861326523*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"7b8db0b7-e2b5-4812-9622-9b3bba847d22"]
