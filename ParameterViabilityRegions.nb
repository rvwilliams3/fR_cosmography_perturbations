Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Dataset", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q0v", "=", 
              RowBox[{"figAData", "[", 
               RowBox[{"dataset", ",", "lab", ",", "\"\<q0\>\""}], "]"}]}], 
             ",", 
             RowBox[{"j0v", "=", 
              RowBox[{"figAData", "[", 
               RowBox[{"dataset", ",", "lab", ",", "\"\<j0\>\""}], "]"}]}]}], 
            "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"figAData", "[", 
               RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], "]"}], 
              "]"}], ",", 
             RowBox[{"MapIndexed", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"sol", "=", 
                    RowBox[{"ReSolveTrajectory", "[", 
                    RowBox[{
                    "\"\<Model 3\>\"", ",", "q0v", ",", "j0v", ",", "#1", ",",
                     "zinitial"}], "]"}]}], "}"}], ",", 
                  RowBox[{"Join", "[", 
                   RowBox[{
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<point\>\"", "->", "lab"}], ",", 
                    RowBox[{"\"\<\[CurlyEpsilon]\>\"", "->", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"EpsFast", "[", 
                    RowBox[{"\"\<Model 3\>\"", ",", "q0v", ",", "j0v"}], 
                    "]"}], ",", "4"}], "]"}]}], ",", 
                    RowBox[{"\"\<traj\>\"", "->", 
                    RowBox[{"First", "[", "#2", "]"}]}], ",", 
                    RowBox[{"\"\<x0\>\"", "->", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"N", "@", 
                    RowBox[{
                    RowBox[{"sol", "[", "\"\<x\>\"", "]"}], "[", "0", "]"}]}],
                     ",", "4"}], "]"}]}]}], "|>"}], ",", 
                    RowBox[{"AssociationThread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<z = zi\>\"", ",", "\"\<z = 100\>\"", ",", 
                    "\"\<z = 10\>\"", ",", "\"\<z = 0\>\""}], "}"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"#", ",", "4"}], "]"}], "&"}], "/@", 
                    RowBox[{"N", "@", 
                    RowBox[{"RMOfZ", "[", 
                    RowBox[{
                    RowBox[{"sol", "[", "\"\<x\>\"", "]"}], ",", 
                    RowBox[{"sol", "[", "\"\<\[CapitalOmega]\>\"", "]"}], ",", 
                    RowBox[{"sol", "[", "\"\<q\>\"", "]"}], ",", 
                    "\"\<Model 3\>\"", ",", "q0v", ",", "j0v", ",", 
                    RowBox[{"{", 
                    RowBox[{"zinitial", ",", "100", ",", "10", ",", "0"}], 
                    "}"}]}], "]"}]}]}]}], "]"}]}], "]"}]}], "]"}], "&"}], ",", 
               RowBox[{"figAData", "[", 
                RowBox[{"dataset", ",", "lab", ",", "\"\<c2\>\""}], "]"}]}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<point\>\"", "->", "lab"}], ",", 
                RowBox[{"\"\<\[CurlyEpsilon]\>\"", "->", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"EpsFast", "[", 
                    RowBox[{"\"\<Model 3\>\"", ",", "q0v", ",", "j0v"}], 
                    "]"}], ",", "4"}], "]"}]}], ",", 
                RowBox[{"\"\<traj\>\"", "->", "\"\<no window\>\""}], ",", 
                RowBox[{"\"\<x0\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<z = zi\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<z = 100\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<z = 10\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<z = 0\>\"", "->", "\"\<\>\""}]}], "|>"}], 
              "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"lab", ",", 
           RowBox[{"{", 
            RowBox[{
            "\"\<mean\>\"", ",", "\"\<q-j-\>\"", ",", "\"\<q-j+\>\"", ",", 
             "\"\<q+j-\>\"", ",", "\"\<q+j+\>\""}], "}"}]}], "}"}]}], 
        "]"}]}]}], ",", 
