      RowBox[{"0.75", ",", "1.02"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
      "plus", " ", "a", " ", "dense", " ", "j0", " ", "grid", " ", "across", 
       " ", "the", " ", "window"}], "-", 
      RowBox[{"closing", " ", "transition", " ", "near", " ", "j0"}]}], "=", 
     "1"}]}], "*)"}], 
  RowBox[{
   RowBox[{"figBData", "=", 
    RowBox[{"Association", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"dataset", "->", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "=", 
             RowBox[{"allParams", "[", 
              RowBox[{"\"\<Model 3\>\"", ",", "dataset", ",", "\"\<q0\>\""}], 
              "]"}]}], ",", 
            RowBox[{"jj", "=", 
             RowBox[{"allParams", "[", 
              RowBox[{"\"\<Model 3\>\"", ",", "dataset", ",", "\"\<j0\>\""}], 
              "]"}]}], ",", "j0Grid", ",", "q0Grid"}], "}"}], ",", 
          RowBox[{
           RowBox[{"j0Grid", "=", 
            RowBox[{"Union", "[", 
             RowBox[{
              RowBox[{"Subdivide", "[", 
               RowBox[{"0.75", ",", "1.20", ",", "45"}], "]"}], ",", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"0.9995", ",", "1.0135", ",", "14"}], "]"}]}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"q0Grid", "=", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"-", "0.62"}], ",", 
              RowBox[{"-", "0.40"}], ",", "22"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<vary j0\>\"", "->", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"AttachTodayValues", "[", 
                 RowBox[{"\"\<Model 3\>\"", ",", 
                  RowBox[{"FindWindow", "[", 
                   RowBox[{"\"\<Model 3\>\"", ",", 
                    RowBox[{"q", "[", "\"\<mean\>\"", "]"}], ",", "j0v", ",", 
                    "zinitial", ",", 
                    RowBox[{"\"\<X0Max\>\"", "->", "0.25"}]}], "]"}], ",", 
                  "zinitial"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j0v", ",", "j0Grid"}], "}"}]}], "]"}]}], ",", 
             RowBox[{"\"\<vary q0\>\"", "->", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"AttachTodayValues", "[", 
                 RowBox[{"\"\<Model 3\>\"", ",", 
                  RowBox[{"FindWindow", "[", 
                   RowBox[{"\"\<Model 3\>\"", ",", "q0v", ",", 
                    RowBox[{"jj", "[", "\"\<mean\>\"", "]"}], ",", "zinitial",
                     ",", 
                    RowBox[{"\"\<X0Max\>\"", "->", "0.25"}]}], "]"}], ",", 
                  "zinitial"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"q0v", ",", "q0Grid"}], "}"}]}], "]"}]}]}], 
            "|>"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"dataset", ",", "viablePlanckDatasets"}], "}"}]}], "]"}]}]}], 
   ";", "\[IndentingNewLine]", 
   RowBox[{"SetDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", "\n", 
   RowBox[{"DumpSave", "[", 
    RowBox[{"\"\<figBData.mx\>\"", ",", "figBData"}], "]"}], ";"}], 
  "*)"}]], "Input",
