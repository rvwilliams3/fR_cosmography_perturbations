       "\"\<\!\(\*SubscriptBox[\(q\), \(0\)]\)\>\"", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"0.78", ",", "0.85"}], "}"}]}], "]"}], "}"}]}]}], 
