Cell[CellGroupData[{

Cell["Figure A: m(r) plot", "Section",
 CellChangeTimes->{{3.998458968949498*^9, 3.998458970020646*^9}, {
  3.9984590275878067`*^9, 
  3.9984590370351553`*^9}},ExpressionUUID->"27a211a0-8251-4aae-b01c-\
99bf549885d0"],

Cell["\<\
Defined builder functions and variables being used:
qFnP, EpsFast, MatterDominatedFPEps, ClassifyEigenvectors, ReSolveTrajectory, \
FindWindow, jModelMap, allParams, dx, d\[CapitalOmega], zinitial\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.998459285723199*^9, 3.998459324614101*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"60dcc499-ca41-4e62-ab29-a15f9c1613e4"],

Cell[CellGroupData[{

Cell["Obtaining data", "Subsection",
 CellChangeTimes->{{3.998449094197451*^9, 3.998449096947379*^9}, {
  3.9985647370754223`*^9, 
  3.998564739286511*^9}},ExpressionUUID->"31c12e9a-a641-4cb6-9e6e-\
9838aa586572"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"theory", "-", 
    RowBox[{"space", " ", 
     RowBox[{"curve", ":", 
      RowBox[{
      "r", " ", "and", " ", "m", " ", "along", " ", "one", " ", 
       "trajectory"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RMOfZ", "[", 
     RowBox[{
     "xFn_", ",", "\[CapitalOmega]Fn_", ",", "qFn_", ",", "model_", ",", 
      "q0Val_", ",", "j0Val_", ",", "zList_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"epsVal", ",", "jOf"}], "}"}], ",", 
      RowBox[{
       RowBox[{"epsVal", "=", 
        RowBox[{"EpsFast", "[", 
         RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"jOf", "[", "zPt_", "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"jModelMap", "[", "model", "]"}], "[", "zPt", "]"}], "/.", 
           RowBox[{"\[Epsilon]", "->", "epsVal"}]}], ")"}], "/.", " ", 
         RowBox[{
          RowBox[{"q", "[", "zPt", "]"}], "->", 
          RowBox[{"qFn", "[", "zPt", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"qq", "=", 
              RowBox[{"qFn", "[", "zz", "]"}]}], ",", 
             RowBox[{"xx", "=", 
              RowBox[{"xFn", "[", "zz", "]"}]}], ",", 
             RowBox[{"om", "=", 
              RowBox[{"\[CapitalOmega]Fn", "[", "zz", "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "qq"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"qq", "+", "xx", "-", "om"}], ")"}]}], ",", 
             RowBox[{"xx", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "qq"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"jOf", "[", "zz", "]"}], "-", "qq", "-", "2"}], 
                ")"}]}]}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"zz", ",", "zList"}], "}"}]}], "]"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{
  3.998526776054899*^9, 3.998526998889566*^9, {3.998527411271411*^9, 
   3.998527413992765*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"5c8334c8-ad8b-48ae-ae02-d6359294447f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Figure", " ", "A", " ", 
      RowBox[{"data", ":", 
       RowBox[{
       "mean", " ", "and", " ", "four", " ", "1", "\[Sigma]", " ", "corners", 
        " ", "of", " ", 
        RowBox[{"(", 
         RowBox[{"q0", ",", "j0"}], ")"}], " ", "per", " ", "dataset"}]}]}], 
     ";", 
     RowBox[{"FindWindow", " ", "with", " ", "the", " ", "x", 
      RowBox[{"(", "0", ")"}], " ", "cut"}]}], ",", 
    RowBox[{
    "then", " ", "trajectories", " ", "across", " ", "the", " ", "cut", " ", 
     "window"}]}], "*)"}], 
  RowBox[{
   RowBox[{"figAData", "=", 
    RowBox[{"Association", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"dataset", "->", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "=", 
             RowBox[{"allParams", "[", 
              RowBox[{"\"\<Model 3\>\"", ",", "dataset", ",", "\"\<q0\>\""}], 
              "]"}]}], ",", 
            RowBox[{"jj", "=", 
             RowBox[{"allParams", "[", 
