Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Purpose", ":", " ", 
     RowBox[{
      RowBox[{"build", " ", "the", " ", 
       RowBox[{"(", 
        RowBox[{"q0", ",", "j0"}], ")"}], " ", "pairs", " ", "for", " ", 
       "one", " ", "Figure", " ", "B", " ", 
       RowBox[{"panel", ".", "Panel"}], " ", "\"\<j0\>\"", " ", "fixes", " ", 
       "q0", " ", "at", " ", "the", " ", "mean", " ", "and", " ", "walks", 
       " ", "j0", " ", "across", " ", "its", " ", "1"}], "-", "sigma"}]}], 
    ",", 
    RowBox[{
     RowBox[{
     "which", " ", "varies", " ", "only", " ", "the", " ", "closure"}], ";", 
     RowBox[{
     "panel", " ", "\"\<q0\>\"", " ", "fixes", " ", "j0", " ", "and", " ", 
      "walks", " ", "q0"}]}], ",", 
    RowBox[{
    "which", " ", "varies", " ", "the", " ", "closure", " ", "and", " ", 
     "its", " ", "boundary", " ", "condition", " ", 
     RowBox[{"together", ".", "Returns"}], " ", "pairs"}], ",", 
    RowBox[{"not", " ", "eps", " ", "values"}], ",", 
    RowBox[{
    "since", " ", "eps", " ", "is", " ", "derived", " ", "downstream", " ", 
     "via", " ", 
     RowBox[{"EpsFast", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ParamGrid", "[", 
     RowBox[{
     "model_String", ",", "dataset_String", ",", "vary_String", ",", 
      "n_Integer"}], "]"}], ":=", 
