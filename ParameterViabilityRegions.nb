          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "[", "\"\<mean\>\"", "]"}], ",", "j0v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j0v", ",", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"jj", "[", "\"\<min\>\"", "]"}], ",", 
              RowBox[{"jj", "[", "\"\<max\>\"", "]"}], ",", 
              RowBox[{"n", "-", "1"}]}], "]"}]}], "}"}]}], "]"}], ",", 
        "\"\<q0\>\"", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"jj", "[", "\"\<mean\>\"", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"q", "[", "\"\<min\>\"", "]"}], ",", 
