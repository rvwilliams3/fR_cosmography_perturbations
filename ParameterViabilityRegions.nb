Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"colors", ",", "boxes", ",", "legend"}], "}"}], ",", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "97", "]"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "viablePlanckDatasets", "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"boxes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", "=", 
            RowBox[{"allParams", "[", 
             RowBox[{"\"\<Model 3\>\"", ",", 
              RowBox[{"viablePlanckDatasets", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<q0\>\""}], "]"}]}], 
           ",", 
           RowBox[{"jj", "=", 
            RowBox[{"allParams", "[", 
             RowBox[{"\"\<Model 3\>\"", ",", 
              RowBox[{"viablePlanckDatasets", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<j0\>\""}], "]"}]}]}],
           "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", 
            RowBox[{"{", 
             RowBox[{"Thick", ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"FaceForm", "[", 
            RowBox[{"Opacity", "[", 
             RowBox[{"0.08", ",", 
              RowBox[{"colors", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Rectangle", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "\"\<min\>\"", "]"}], ",", 
               RowBox[{"jj", "[", "\"\<min\>\"", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "\"\<max\>\"", "]"}], ",", 
               RowBox[{"jj", "[", "\"\<max\>\"", "]"}]}], "}"}]}], "]"}], ",",
            "Black", ",", 
           RowBox[{"PointSize", "[", "0.012", "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "[", "\"\<mean\>\"", "]"}], ",", 
              RowBox[{"jj", "[", "\"\<mean\>\"", "]"}]}], "}"}], "]"}]}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "viablePlanckDatasets", "]"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"legend", "=", 
     RowBox[{"SwatchLegend", "[", 
      RowBox[{"colors", ",", 
       RowBox[{"Abbrev", "/@", "viablePlanckDatasets"}], ",", 
       RowBox[{"LegendMarkerSize", "->", "14"}], ",", 
       RowBox[{"LegendLabel", "->", "None"}], ",", 
       RowBox[{"LegendFunction", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{"#", ",", 
            RowBox[{"FrameStyle", "->", "Gray"}], ",", 
            RowBox[{"RoundingRadius", "->", "0"}], ",", 
            RowBox[{"Background", "->", "White"}]}], "]"}], "&"}], ")"}]}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Legended", "[", 
     RowBox[{
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"RegionPlot", "[", 
         RowBox[{
          RowBox[{"j0v", ">", 
           RowBox[{"q0v", "+", "2"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"-", "0.75"}], ",", 
            RowBox[{"-", "0.40"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j0v", ",", "0.8", ",", "1.7"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Red", ",", 
             RowBox[{"Opacity", "[", "0.12", "]"}]}], "]"}]}], ",", 
          RowBox[{"BoundaryStyle", "->", "None"}], ",", 
          RowBox[{"PlotPoints", "->", "60"}]}], "]"}], ",", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"q0v", "+", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"q0v", ",", 
            RowBox[{"-", "0.75"}], ",", 
            RowBox[{"-", "0.40"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Black", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"Graphics", "[", 
