               RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
           RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
            RowBox[{"(", 
             RowBox[{"\[CapitalOmega]", "/.", " ", 
              RowBox[{"sol", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", 
           RowBox[{"\"\<q\>\"", "->", "qFn"}]}], "|>"}]}], "]"}]}]}], "]"}]}],
    ";"}]}]], "Input",
