                    RowBox[{"ListLinePlot", "[", 
                    RowBox[{"curves", ",", 
                    RowBox[{"PlotStyle", "->", 
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"kinColors", "[", "lab", "]"}], ",", "Thin", ",", 
                    
                    RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}]}], 
                    "]"}]}], "}"}]}], "]"}], ",", "Nothing"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"lab", ",", "kinLabels"}], "}"}]}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"references", ":", 
                RowBox[{"matter", " ", "point", " ", 
                 RowBox[{"(", 
                  RowBox[{"1", ",", "0"}], ")"}]}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"de", " ", "Sitter"}], "-", "r"}], "=", "2"}], ",", 
               RowBox[{
                RowBox[{"P6", " ", "line", " ", "m"}], "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "r"}], "-", "1"}], "->", "m"}], "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "r"}], ")"}], "-", "1"}]}]}]}], "*)"}], 
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"PointSize", "[", "0.015", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}]}], 
            "}"}]}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
