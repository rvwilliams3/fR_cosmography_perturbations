           RowBox[{"c3", " ", 
            RowBox[{"vq", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
