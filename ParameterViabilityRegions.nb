          RowBox[{"PlotLabel", "->", 
           RowBox[{"Abbrev", "[", "dataset", "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"Values", "[", "kinColors", "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"TrueQ", "[", 
                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<found\>\""}], 
                  "]"}], "]"}], ",", 
