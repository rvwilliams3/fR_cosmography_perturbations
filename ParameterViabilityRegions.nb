               "\"\<Divergent\>\"", ",", 
               RowBox[{
                RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
               "\"\<NearSingular\>\"", ",", 
               RowBox[{"\[CapitalOmega]Val", "<=", "0"}], ",", 
               "\"\<OmegaViolation\>\"", ",", 
               RowBox[{
                RowBox[{"xVal", "/", "denom"}], "<", "0"}], ",", 
               "\"\<SignViolation\>\"", ",", "True", ",", "\"\<OK\>\""}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ratio", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "denom", "]"}], "<", "singTol"}], ",", 
               "Indeterminate", ",", 
               RowBox[{"xVal", "/", "denom"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<z\>\"", "->", "zPt"}], ",", 
              RowBox[{"\"\<x\>\"", "->", "xVal"}], ",", 
              RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Val"}],
               ",", 
              RowBox[{"\"\<q\>\"", "->", "qVal"}], ",", 
              RowBox[{"\"\<j\>\"", "->", "jVal"}], ",", 
              RowBox[{"\"\<denom\>\"", "->", "denom"}], ",", 
              RowBox[{"\"\<ratio\>\"", "->", "ratio"}], ",", 
              RowBox[{"\"\<pointLabel\>\"", "->", "pointLabel"}]}], 
             "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"zPt", ",", "zSamples"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasDivergence", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<Divergent\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasNearSingular", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<NearSingular\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasOmegaViolation", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<OmegaViolation\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hasSignViolation", "=", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"sampleData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<pointLabel\>\"", "]"}], "===", 
           "\"\<SignViolation\>\""}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"isPhysical", "=", 
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
         "hasDivergence", "||", "hasNearSingular", "||", "hasOmegaViolation", 
          "||", "hasSignViolation"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"label", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
        "isPhysical", ",", "\"\<Physical\>\"", ",", "hasDivergence", ",", 
         "\"\<Divergent\>\"", ",", "hasNearSingular", ",", 
         "\"\<NearSingular\>\"", ",", "hasOmegaViolation", ",", 
         "\"\<OmegaViolation\>\"", ",", "hasSignViolation", ",", 
         "\"\<SignViolation\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<label\>\"", "->", "label"}], ",", 
        RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<hasDivergence\>\"", "->", "hasDivergence"}], ",", 
        RowBox[{"\"\<hasSignViolation\>\"", "->", "hasSignViolation"}], ",", 
        RowBox[{"\"\<hasNearSingular\>\"", "->", "hasNearSingular"}], ",", 
        RowBox[{"\"\<hasOmegaViolation\>\"", "->", "hasOmegaViolation"}], ",", 
        RowBox[{"\"\<minRatio\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"sampleData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "\"\<ratio\>\""}], "]"}], "]"}], ",", 
            RowBox[{"_", "?", "NumericQ"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<minOmega\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"sampleData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<maxOmega\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"sampleData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<\[CapitalOmega]\>\""}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<maxAbsX\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<x\>\""}], "]"}], "]"}], "]"}], "]"}]}], 
        ",", 
        RowBox[{"\"\<minAbsDenom\>\"", "->", 
         RowBox[{"Min", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"sampleData", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<denom\>\""}], "]"}], "]"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<domainMin\>\"", "->", "domainMin"}], ",", 
        RowBox[{"\"\<domainMax\>\"", "->", "domainMax"}], ",", 
        RowBox[{"\"\<sampleData\>\"", "->", "sampleData"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]], "Input",
