      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "viablePlanckDatasets", "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"boxes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", "=", 
