           RowBox[{"c3", " ", 
            RowBox[{"vq", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalOmega]i", "=", 
