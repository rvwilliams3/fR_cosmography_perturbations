                 RowBox[{"figAData", "[", 
                  RowBox[{"dataset", ",", "lab", ",", "\"\<j0\>\""}], 
                  "]"}]}]}], "}"}], ",", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"sol", "=", 
                    RowBox[{"ReSolveTrajectory", "[", 
