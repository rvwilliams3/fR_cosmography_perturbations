Cell[BoxData[{
 RowBox[{
  RowBox[{"residual", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"fLCDM", "[", "z", "]"}], "-", 
   SuperscriptBox[
    RowBox[{"\[CapitalOmega]LCDM", "[", "z", "]"}], 
    "gammaLCDM"]}]}], "\[IndentingNewLine]", 
 RowBox[{"resPlotLCDM", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"residual", "[", "z", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "zf"}], "}"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<Residual\>\""}], "}"}]}], ",", " ", 
