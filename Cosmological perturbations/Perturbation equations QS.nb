Cell[BoxData[
 RowBox[{
  RowBox[{"chiSquare", "[", 
   RowBox[{
   "fFunc_", ",", "omegaFunc_", ",", "gamma_", ",", "zMax_", ",", "dz_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zVals", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{"zVals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "zMax", ",", "dz"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fFunc", "[", "z", "]"}], "-", 
           SuperscriptBox[
            RowBox[{"omegaFunc", "[", "z", "]"}], "gamma"]}], ")"}], "2"], 
        ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "zVals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "data", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9887759272768493`*^9, 3.988775941717622*^9}, {
  3.988782952936191*^9, 3.988782958812537*^9}},
