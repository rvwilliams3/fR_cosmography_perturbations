Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}]}], 
    FractionBox[
     RowBox[{
      RowBox[{"\[Delta]", "'"}], "[", "z", "]"}], 
     RowBox[{"\[Delta]", "[", "z", "]"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.988184886043751*^9, 3.988184918637749*^9}, 
