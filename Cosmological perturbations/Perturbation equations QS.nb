Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"residual", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"fLCDM", "[", "z", "]"}], "-", 
   SuperscriptBox[
    RowBox[{"\[CapitalOmega]LCDM", "[", "z", "]"}], 
    "gammaLCDM"]}]}], "\[IndentingNewLine]", 
 RowBox[{"resPlotLCDM", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"residual", "[", "z", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "zf"}], "}"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<Residual\>\""}], "}"}]}], ",", " ", 
    RowBox[{"PlotRangePadding", "->", "None"}], ",", "\[IndentingNewLine]", 
    RowBox[{"GridLines", "->", "Automatic"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
   "\"\</Users/rachelwilliams1/Desktop/Cosmography f(R) project/Report/f(R) \
