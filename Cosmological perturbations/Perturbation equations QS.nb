Cell["LCDM:", "Subsubsection",
 CellChangeTimes->{{3.986261626364752*^9, 3.986261635027611*^9}, {
  3.987054228282802*^9, 3.98705422880774*^9}, {3.989044794028474*^9, 
  3.9890447945176888`*^9}},ExpressionUUID->"d96d099e-7057-49dc-a844-\
2a94e16631d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[CapitalLambda]CDM", " ", "parameters"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CapitalLambda]0", "=", 
     RowBox[{
      RowBox[{"1", "-", "\[CapitalOmega]m0"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]m0", "->", "0.3"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hLCDM", "[", "z_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"\[CapitalOmega]m0", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
        "\[CapitalOmega]\[CapitalLambda]0"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]m0", "->", "0.3"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLCDM", "[", "z_", "]"}], "=", 
     RowBox[{"H0", " ", 
      RowBox[{"hLCDM", "[", "z", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
