   3.989042313903419*^9}, {3.989042781862684*^9, 3.989042817744919*^9}, {
   3.989043140562363*^9, 3.9890431561295233`*^9}, {3.9890432357741137`*^9, 
   3.989043241506133*^9}, {3.989044829423295*^9, 3.989044829686173*^9}, 
   3.989898271817861*^9, {3.9898983264368896`*^9, 3.989898326743662*^9}},
 CellLabel->
  "In[239]:=",ExpressionUUID->"c5752200-54ec-4d8b-ad61-80e6576dfedb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chiSquare", "[", 
   RowBox[{
   "fFunc_", ",", "omegaFunc_", ",", "gamma_", ",", "zMax_", ",", "dz_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zVals", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{"zVals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "zMax", ",", "dz"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fFunc", "[", "z", "]"}], "-", 
           SuperscriptBox[
            RowBox[{"omegaFunc", "[", "z", "]"}], "gamma"]}], ")"}], "2"], 
        ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "zVals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "data", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9887759272768493`*^9, 3.988775941717622*^9}, {
  3.988782952936191*^9, 3.988782958812537*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"c11196a4-b939-4071-b352-420dbbd6c62d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chiTable", "[", 
   RowBox[{"fFunc_", ",", "omegaFunc_", ",", " ", "gammaGrid_"}], "]"}], ":=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", 
      RowBox[{"chiSquare", "[", 
       RowBox[{"fFunc", ",", "omegaFunc", ",", "g", ",", "zf", ",", "0.01"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"g", ",", "gammaGrid"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988775963190959*^9, 3.988775967099039*^9}, {
  3.988776249196587*^9, 3.988776258160095*^9}, {3.988776569739604*^9, 
  3.988776574409194*^9}, {3.988782942973669*^9, 3.988782943192762*^9}},
 CellLabel->
  "In[241]:=",ExpressionUUID->"969c79fc-0e26-47fa-b618-b4f4cb460b5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bestGamma", "[", 
   RowBox[{"fFunc_", ",", "omegaFunc_", ",", "chiTable_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "minRow", ",", "bestG", ",", "bestChi", ",", "nData", ",", "dof"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"minRow", "=", 
      RowBox[{"First", "@", 
       RowBox[{"Ordering", "[", 
        RowBox[{
         RowBox[{"chiTable", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"bestG", "=", 
      RowBox[{"chiTable", "[", 
       RowBox[{"[", 
        RowBox[{"minRow", ",", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bestChi", "=", 
      RowBox[{"chiTable", "[", 
       RowBox[{"[", 
        RowBox[{"minRow", ",", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nData", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "zf", ",", "0.01"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"number", " ", "of", " ", "z", " ", "points"}], ",", 
       RowBox[{"matching", " ", "chiSquare"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dof", "=", 
      RowBox[{"nData", "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gamma\>\"", "->", "bestG"}], ",", 
       RowBox[{"\"\<chiSq\>\"", "->", "bestChi"}], ",", 
       RowBox[{"\"\<dof\>\"", "->", "dof"}], ",", 
       RowBox[{"\"\<chiSqReduced\>\"", "->", 
        RowBox[{"bestChi", "/", "dof"}]}]}], "|>"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988775998905063*^9, 3.988776004279622*^9}, {
  3.988776583637232*^9, 3.988776594251797*^9}, {3.988783966495854*^9, 
  3.98878401142942*^9}, {3.9887891928637857`*^9, 3.988789201864946*^9}, {
  3.988789351801013*^9, 3.988789361881068*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"7d9ec1dc-645b-436b-bc59-54c111e5957a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"approxGamma", "[", 
   RowBox[{
   "fFunc_", ",", "omegaFunc_", ",", "gi_", ",", "zMax_", ",", "dz_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "result", ",", "bestG", ",", "bestChi", ",", "nData", ",", "dof"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"result", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"chiSquare", "[", 
          RowBox[{
          "fFunc", ",", "omegaFunc", ",", "g", ",", "zMax", ",", "dz"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "gi"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bestG", "=", 
      RowBox[{"g", "/.", " ", 
       RowBox[{"result", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bestChi", "=", 
      RowBox[{"result", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nData", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "zMax", ",", "dz"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dof", "=", 
      RowBox[{"nData", "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<gamma\>\"", "->", "bestG"}], ",", 
       RowBox[{"\"\<chiSq\>\"", "->", "bestChi"}], ",", 
       RowBox[{"\"\<dof\>\"", "->", "dof"}], ",", 
       RowBox[{"\"\<chiSqReduced\>\"", "->", 
        RowBox[{"bestChi", "/", "dof"}]}]}], "|>"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988783644318396*^9, 3.988783668594008*^9}, {
   3.98878374366606*^9, 3.988783752382546*^9}, {3.988783882482742*^9, 
   3.988783913391224*^9}, 3.988791902964837*^9, 3.988792732720351*^9},
 CellLabel->
  "In[243]:=",ExpressionUUID->"285cadd8-514a-401e-95c6-90e3251a125f"]
}, Closed]],

