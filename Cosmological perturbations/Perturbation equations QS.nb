Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SolvePerturbation", "[", 
     RowBox[{
     "bgSol_Association", ",", "jModel_", ",", "\[Epsilon]val_", ",", 
      "kval_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "hf", ",", "xf", ",", "\[CapitalOmega]f", ",", "qf", ",", "jf", ",", 
        "ics", ",", "sol", ",", "replacements", ",", "\[ScriptK]val"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"z0", "=", 
         RowBox[{"bgSol", "[", "\"\<z0\>\"", "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"hf", "=", 
        RowBox[{"bgSol", "[", "\"\<h\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xf", "=", 
        RowBox[{"bgSol", "[", "\"\<x\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalOmega]f", "=", 
        RowBox[{"bgSol", "[", "\"\<\[CapitalOmega]\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qf", "=", 
        RowBox[{"bgSol", "[", "\"\<q\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[ScriptK]val", "=", 
        RowBox[{
         FractionBox[
          RowBox[{"3", "*", 
           SuperscriptBox["10", "5"]}], 
          RowBox[{"100", "h"}]], "kval"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"replacements", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"h", "->", "hf"}], ",", " ", 
          RowBox[{"x", "->", "xf"}], ",", " ", 
          RowBox[{"\[CapitalOmega]", "->", "\[CapitalOmega]f"}], ",", " ", 
          RowBox[{"q", "->", "qf"}], ",", " ", 
          RowBox[{
           RowBox[{"j", "[", "z", "]"}], "->", "jModel"}], ",", " ", 
          RowBox[{"\[Kappa]", "->", "\[ScriptK]val"}], ",", " ", 
          RowBox[{"\[Epsilon]", "->", "\[Epsilon]val"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ics", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Delta]", "[", "zinitial", "]"}], "==", 
             FractionBox["1", 
              RowBox[{"1", "+", "zinitial"}]]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Delta]", "'"}], "[", "zinitial", "]"}], "==", 
             FractionBox[
              RowBox[{"-", "1"}], 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "+", "zinitial"}], ")"}], "2"]]}]}], "}"}]}], 
         ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ics", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Delta]", "[", "zinitial", "]"}], "==", 
           SuperscriptBox["10", 
            RowBox[{"-", "5"}]]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Delta]", "'"}], "[", "zinitial", "]"}], "==", "0"}]}], 
         "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"dustODE", "[", "z", "]"}], "/.", "replacements"}], "/.",
               "replacements"}], ",", "ics"}], "}"}], ",", "\[Delta]", ",", 
           RowBox[{"{", 
            RowBox[{"z", ",", "zinitial", ",", "0"}], "}"}], ",", " ", 
           RowBox[{"PrecisionGoal", "->", "MachinePrecision"}]}], "]"}], "[", 
         
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<\[Delta]\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"\[Delta]", "/.", " ", "sol"}], ")"}]}], ",", 
         RowBox[{"\"\<zi\>\"", "->", "zinitial"}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.987497983034037*^9, 3.98749799217039*^9}, {
