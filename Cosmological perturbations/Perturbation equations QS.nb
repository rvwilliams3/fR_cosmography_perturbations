Cell[BoxData[
 RowBox[{"approxgammaLCDM", "=", 
  RowBox[{"approxGamma", "[", 
   RowBox[{
   "fLCDM", ",", "\[CapitalOmega]LCDM", ",", "0.5", ",", "zf", ",", "0.01"}], 
