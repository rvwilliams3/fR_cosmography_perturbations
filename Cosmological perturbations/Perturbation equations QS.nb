Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[CapitalLambda]CDM", " ", "parameters"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CapitalLambda]0", "=", 
     RowBox[{
      RowBox[{"1", "-", "\[CapitalOmega]m0"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]m0", "->", "0.3"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hLCDM", "[", "z_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"\[CapitalOmega]m0", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
        "\[CapitalOmega]\[CapitalLambda]0"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]m0", "->", "0.3"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLCDM", "[", "z_", "]"}], "=", 
     RowBox[{"H0", " ", 
      RowBox[{"hLCDM", "[", "z", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qLCDM", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      FractionBox[
       RowBox[{
        RowBox[{"HLCDM", "'"}], "[", "z", "]"}], 
       RowBox[{"HLCDM", "[", "z", "]"}]]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xLCDM", "[", "z_", "]"}], ":=", "0"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]LCDM", "[", "z_", "]"}], ":=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"\[CapitalOmega]m0", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], "3"]}], 
      RowBox[{
       RowBox[{"\[CapitalOmega]m0", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       "\[CapitalOmega]\[CapitalLambda]0"}]], "/.", 
     RowBox[{"{", 
      RowBox[{"\[CapitalOmega]m0", "->", "0.3"}], "}"}]}]}]}]}]], "Input",
