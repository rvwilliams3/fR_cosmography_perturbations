Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[CapitalLambda]CDM", " ", "parameters"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]m0", "=", "0.3"}], ";"}], "   ", "\n", 
   RowBox[{
    RowBox[{"\[CapitalOmega]\[CapitalLambda]0", "=", 
     RowBox[{"1", "-", "\[CapitalOmega]m0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hLCDM", "[", "z_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[CapitalOmega]m0", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       "\[CapitalOmega]\[CapitalLambda]0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HLCDM", "[", "z_", "]"}], "=", 
     RowBox[{"H0", " ", 
      RowBox[{"hLCDM", "[", "z", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qLCDM", "[", "z_", "]"}], ":=", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      FractionBox[
       RowBox[{
        RowBox[{"HLCDM", "'"}], "[", "z", "]"}], 
       RowBox[{"HLCDM", "[", "z", "]"}]]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xLCDM", "[", "z_", "]"}], ":=", "0"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]LCDM", "[", "z_", "]"}], ":=", " ", 
    FractionBox[
     RowBox[{"\[CapitalOmega]m0", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}], "3"]}], 
     RowBox[{
      RowBox[{"\[CapitalOmega]m0", 
