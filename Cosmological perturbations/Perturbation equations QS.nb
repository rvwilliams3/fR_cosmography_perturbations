Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]matter", "[", "z_", "]"}], " ", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalOmega]m0", " "}], 
     SuperscriptBox[
      RowBox[{"h", "[", "z", "]"}], "2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], "3"]}]}], ";"}]], "Input",
