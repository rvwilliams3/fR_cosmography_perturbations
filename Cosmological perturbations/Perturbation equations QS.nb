Cell[BoxData[
 RowBox[{
  RowBox[{"chiSquare", "[", 
   RowBox[{
   "fFunc_", ",", "omegaFunc_", ",", "gamma_", ",", "zMax_", ",", "dz_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zVals", ",", "data"}], "}"}], ",", 
    RowBox[{
     RowBox[{"zVals", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "zMax", ",", "dz"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fFunc", "[", "z", "]"}], "-", 
           SuperscriptBox[
            RowBox[{"omegaFunc", "[", "z", "]"}], "gamma"]}], ")"}], "2"], 
        ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "zVals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "data", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9887759272768493`*^9, 3.988775941717622*^9}, {
  3.988782952936191*^9, 3.988782958812537*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"c11196a4-b939-4071-b352-420dbbd6c62d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chiTable", "[", 
   RowBox[{"fFunc_", ",", "omegaFunc_", ",", " ", "gammaGrid_"}], "]"}], ":=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", 
      RowBox[{"chiSquare", "[", 
       RowBox[{"fFunc", ",", "omegaFunc", ",", "g", ",", "zf", ",", "0.01"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"g", ",", "gammaGrid"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988775963190959*^9, 3.988775967099039*^9}, {
  3.988776249196587*^9, 3.988776258160095*^9}, {3.988776569739604*^9, 
