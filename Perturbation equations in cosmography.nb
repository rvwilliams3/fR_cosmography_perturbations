Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "'''"}], "[", 
     RowBox[{"R", "[", "t", "]"}], "]"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"R", "'"}], "[", "t", "]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"f", "''"}], "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}], 
        RowBox[{"x", "[", "t", "]"}], 
        RowBox[{"H", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"f", "'"}], "[", 
          RowBox[{"R", "[", "t", "]"}], "]"}], 
         RowBox[{
          RowBox[{"R", "'"}], "[", "t", "]"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}], 
           RowBox[{"H", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], 
           RowBox[{
            RowBox[{"H", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], 
           RowBox[{"H", "[", "t", "]"}], 
           FractionBox[
            RowBox[{
             RowBox[{"R", "''"}], "[", "t", "]"}], 
            RowBox[{
             RowBox[{"R", "'"}], "[", "t", "]"}]]}]}], ")"}]}]}], ")"}]}]}], 
   ";"}], "*)"}]], "Input",
 CellChangeTimes->{{3.992316994464348*^9, 3.9923169956327477`*^9}, {
   3.992317051439678*^9, 3.992317129986536*^9}, 3.99231721486557*^9, {
   3.992317272312489*^9, 3.992317272606041*^9}, 3.99231735545424*^9, {
   3.9923176812627153`*^9, 3.992317687009858*^9}, 3.992318451078595*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"4e8da1f3-4200-445e-86a0-5cc07fade1b7"],

