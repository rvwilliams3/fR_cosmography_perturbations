    RowBox[{
     RowBox[{"Reqn", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "*", 
     RowBox[{
      RowBox[{"f", "''"}], "[", 
      RowBox[{"R", "[", "t", "]"}], "]"}]}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
