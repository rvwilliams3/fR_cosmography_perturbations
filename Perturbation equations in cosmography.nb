Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", "t", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["k", "2"], " ", "w"}], 
       SuperscriptBox[
        RowBox[{"a", "[", "t", "]"}], "2"]], "-", 
      RowBox[{"w", " ", 
       RowBox[{"R", "[", "t", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "w"}], ")"}], " ", 
       RowBox[{"\[Rho]m", "[", "t", "]"}]}]}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      RowBox[{"3", " ", "w"}]}], ")"}], " ", 
    RowBox[{"H", "[", "t", "]"}], " ", 
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}]}], "+", 
   RowBox[{
    SuperscriptBox["\[CapitalDelta]", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}], "\[Equal]", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "2"]}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "w"}], ")"}], " ", 
   RowBox[{"\[ScriptCapitalR]", "[", "t", "]"}]}]}]], "Output",
