Cell[TextData[{
 "In the \[ScriptCapitalR] equation, the terms diverge for f(R) \[Rule] R or  \
f\[CloseCurlyQuote]\[CloseCurlyQuote](R) \[Rule] 0\[LineSeparator]Instead use \
for spatially flat GR: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"3", "w"}]}], ")"}], 
     SubscriptBox["\[Rho]", "m"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a50c727-cfe5-4517-a5bb-17fbb4ece506"]
}], "Text",
