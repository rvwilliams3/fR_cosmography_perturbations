Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "'''"}], "[", 
     RowBox[{"R", "[", "t", "]"}], "]"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"R", "'"}], "[", "t", "]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"f", "''"}], "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}], 
        RowBox[{"x", "[", "t", "]"}], 
        RowBox[{"H", "[", "t", "]"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"f", "'"}], "[", 
          RowBox[{"R", "[", "t", "]"}], "]"}], 
         RowBox[{
          RowBox[{"R", "'"}], "[", "t", "]"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}], 
           RowBox[{"H", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], 
           RowBox[{
            RowBox[{"H", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], 
           RowBox[{"H", "[", "t", "]"}], 
           FractionBox[
            RowBox[{
             RowBox[{"R", "''"}], "[", "t", "]"}], 
            RowBox[{
             RowBox[{"R", "'"}], "[", "t", "]"}]]}]}], ")"}]}]}], ")"}]}]}], 
   ";"}], "*)"}]], "Input",
 CellChangeTimes->{{3.992316994464348*^9, 3.9923169956327477`*^9}, {
