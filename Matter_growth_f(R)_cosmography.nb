    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "z"}], ")"}], 
      RowBox[{
       RowBox[{"s", "'"}], "[", "z", "]"}]}], "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"l", "[", "z", "]"}]}], "-", 
       RowBox[{
        RowBox[{"s", "[", "z", "]"}], 
        RowBox[{"(", 
