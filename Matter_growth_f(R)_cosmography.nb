Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qLCDM", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], 
     FractionBox[
      RowBox[{
       RowBox[{"HLCDM", "'"}], "[", "z", "]"}], 
      RowBox[{"HLCDM", "[", "z", "]"}]]}]}]}], ";"}]], "Input",
