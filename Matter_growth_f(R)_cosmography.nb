  3.991703664151658*^9}},ExpressionUUID->"064c7a44-b21c-4913-ad1a-\
49f380135214"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bgResultsModel1", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Map", "[", 
