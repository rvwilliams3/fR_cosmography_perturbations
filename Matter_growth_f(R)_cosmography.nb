Cell[CellGroupData[{

Cell["Obtaining q(z)", "Subsection",
 CellChangeTimes->{{3.991450281039323*^9, 3.9914502857040863`*^9}, {
  3.991471695077602*^9, 
  3.991471714498495*^9}},ExpressionUUID->"5d05518b-bac5-4483-9c12-\
8c1f7cb78dfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "odeQ", ",", "sol"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"odeQ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"dq", "/.", " ", 
           RowBox[{"j", "->", 
            RowBox[{"params", "[", "\"\<j\>\"", "]"}]}]}], "/.", " ", 
          RowBox[{"\[Epsilon]", "->", 
           RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"q", "[", "0", "]"}], "==", 
          RowBox[{"params", "[", "\"\<q0\>\"", "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeQ", ",", "q", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
  3.991448764350067*^9, 3.99144876680994*^9}, {3.991448918938006*^9, 
  3.991448923543747*^9}, {3.991448978914154*^9, 3.991449107877153*^9}, {
  3.991471440100438*^9, 3.991471448695713*^9}, {3.991471490762517*^9, 
  3.991471491056706*^9}, {3.991706810612037*^9, 3.991706821947378*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"1a9efc7b-7cc9-48d5-b1d3-58ed5749c59a"],

