Cell[CellGroupData[{

Cell["Scan of ICs", "Subsubsection",
 CellChangeTimes->{{3.991733431058099*^9, 
  3.991733439041154*^9}},ExpressionUUID->"7bb38129-07ae-43d4-8f70-\
35fa9fc6a0e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanICs", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "c2Range_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fp", ",", "classified", ",", "vq", ",", "vxOmega", ",", "lambdaQ", ",",
        "qFn", ",", "deltaQ", ",", "c3", ",", "params", ",", "results"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fp", "=", 
       RowBox[{
        RowBox[{"matterDominatedFPs", "[", "model", "]"}], "[", "dataset", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"classified", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"classified", "[", "\"\<vq\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"classified", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lambdaQ", "=", 
       RowBox[{"classified", "[", "\"\<lambdaQ\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deltaQ", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "zinitial", "]"}], "-", 
        RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c3", "=", 
       RowBox[{"deltaQ", "/", 
        RowBox[{"vq", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "x0", ",", "\[CapitalOmega]0", ",", "sol", ",", "xFn", ",", 
             "\[CapitalOmega]Fn", ",", "domainEnd", ",", "xFinal", ",", 
             "\[CapitalOmega]Final"}], "}"}], ",", 
           RowBox[{
            RowBox[{"x0", "=", 
             RowBox[{
              RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
              RowBox[{"c2", " ", 
               RowBox[{"vxOmega", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "+", 
              RowBox[{"c3", " ", 
               RowBox[{"vq", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]0", "=", 
             RowBox[{
              RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
              RowBox[{"c2", " ", 
               RowBox[{"vxOmega", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "+", 
              RowBox[{"c3", " ", 
               RowBox[{"vq", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}],
                "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"q", "[", "zz_", "]"}], ":=", 
                RowBox[{"qFn", "[", "zz", "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"\[Epsilon]", "=", 
                RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"j", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "zz", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"s", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{"Solve", "[", 
                  RowBox[{"dj", ",", 
                   RowBox[{"s", "[", "zz", "]"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"l", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Solve", "[", 
                   RowBox[{"ds", ",", 
                    RowBox[{"l", "[", "zz", "]"}]}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
                 "Simplify"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"sol", "=", 
                RowBox[{"Quiet", "[", 
                 RowBox[{
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{"NDSolve", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zinitial", "]"}], "==", "x0"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zinitial", "]"}], "==", 
                    "\[CapitalOmega]0"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
                    RowBox[{"PrecisionGoal", "->", "10"}], ",", 
                    RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
                    "$Failed"}], "]"}], ",", 
                  RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}]}], ";"}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"sol", "===", "$Failed"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", "Indeterminate",
                 ",", "Indeterminate", ",", "\"\<Failed\>\""}], "}"}], ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xFn", "=", 
                 RowBox[{"x", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"\[CapitalOmega]Fn", "=", 
                 RowBox[{"\[CapitalOmega]", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"domainEnd", "=", 
                 RowBox[{
                  RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"domainEnd", ">", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", 
                    "Indeterminate", ",", "Indeterminate", ",", 
                    RowBox[{"\"\<Diverged at z=\>\"", "<>", 
                    RowBox[{"ToString", "[", "domainEnd", "]"}]}]}], "}"}], 
                  ",", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"xFinal", "=", 
                    RowBox[{"xFn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"\[CapitalOmega]Final", "=", 
                    RowBox[{"\[CapitalOmega]Fn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", "xFinal", 
                    ",", "\[CapitalOmega]Final", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"xFinal", "<", "0"}], "&&", 
                    RowBox[{"\[CapitalOmega]Final", ">", "0"}]}], ",", 
                    "\"\<Physical\>\"", ",", "\"\<Unphysical sign\>\""}], 
                    "]"}]}], "}"}]}], ")"}]}], "]"}]}], ")"}]}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "results"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991734429011071*^9, 3.991734464303492*^9}, {
  3.9917854226253567`*^9, 3.991785442987152*^9}},
 CellLabel->
  "In[332]:=",ExpressionUUID->"d26cd75d-035c-4207-807f-2cbc4e92ec0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanAllDatasetsPhysical", "[", 
    RowBox[{"model_String", ",", "c2Range_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "datasets", ",", "allResults", ",", "physicalRowsByDataset", ",", 
       "bounds"}], "}"}], ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"AvailableDatasets", "[", "model", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"physicalRowsByDataset", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"scanResult", ",", "physicalRows"}], "}"}], ",", 
              RowBox[{
               RowBox[{"scanResult", "=", 
                RowBox[{"ScanICs", "[", 
