            RowBox[{"allParams", "[", "model", "]"}], ",", "dataset"}], 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nodataset"}], ",", "dataset", ",", 
            "model", ",", 
            RowBox[{"AvailableDatasets", "[", "model", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}]}]}], 
     "]"}]}], ";", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GetParams", "::", "nomodel"}], "=", 
    "\"\<Model `1` not found. Available models: `2`\>\""}], ";", "\n", 
   RowBox[{
    RowBox[{"GetParams", "::", "nodataset"}], "=", 
