Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Build", " ", "the", " ", "nested", " ", "association", " ", "for", " ", 
    "a", " ", "single", " ", 
    RowBox[{"model", "'"}], "s", " ", "CSV", " ", "file"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BuildModelParams", "[", "file_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "header", ",", "rows"}], "}"}], ",", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"file", ",", "\"\<Data\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"header", "=", 
        RowBox[{"First", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rows", "=", 
        RowBox[{"Rest", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"row", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"assocFull", ",", "datasetName"}], "}"}], ",", 
              RowBox[{
               RowBox[{"assocFull", "=", 
                RowBox[{"AssociationThread", "[", 
                 RowBox[{"header", "->", "row"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"datasetName", "=", 
                RowBox[{"assocFull", "[", "\"\<dataset\>\"", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"datasetName", "->", 
                RowBox[{"Association", "[", 
                 RowBox[{"KeyValueMap", "[", 
                  RowBox[{
                   RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"oldKey", ",", "newKey"}], "}"}], ",", 
                    RowBox[{"newKey", "->", 
                    RowBox[{"assocFull", "[", "oldKey", "]"}]}]}], "]"}], ",",
                    "paramColumnMap"}], "]"}], "]"}]}]}]}], "]"}]}], "]"}], 
          ",", "rows"}], "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
