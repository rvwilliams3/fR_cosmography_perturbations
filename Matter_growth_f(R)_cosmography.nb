     RowBox[{"(", 
      RowBox[{
       RowBox[{"j", "[", "z", "]"}], "-", 
       RowBox[{"q", "[", "z", "]"}], "-", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"q", "[", "z", "]"}], "2"]}]}], ")"}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dj", "=", " ", 
