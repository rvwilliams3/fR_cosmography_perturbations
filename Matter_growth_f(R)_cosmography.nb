         RowBox[{"3", "+", 
          RowBox[{"4", 
           RowBox[{"q", "[", "n", "]"}]}]}], ")"}]}]}], ")"}]}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dEhn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Eh", "'"}], "[", "n", "]"}], "+", " ", 
     RowBox[{
      RowBox[{"Eh", "[", "n", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"q", "[", "n", "]"}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dHn", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"H", "'"}], "[", "n", "]"}], "+", " ", 
     RowBox[{
      RowBox[{"H", "[", "n", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"q", "[", "n", "]"}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}]}], "Input",
