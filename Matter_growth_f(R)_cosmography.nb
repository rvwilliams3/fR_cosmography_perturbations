       RowBox[{"point", ":", 
        RowBox[{"the", " ", "one", " ", "closest", " ", "to", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], ")"}]}]}]}]}], "=", 
     RowBox[{"(", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "eps"}], "->", 
     RowBox[{"0", " ", "EdS", " ", "limit"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractMatterDominatedFP", "[", "fps_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"target", ",", "distances", ",", "bestIdx"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"target", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"pt", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "vals", "}"}], ",", 
              RowBox[{
               RowBox[{"vals", "=", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.",
                  " ", "pt"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"N", "[", "vals", "]"}], "-", 
                 RowBox[{"N", "[", "target", "]"}]}], "]"}]}]}], "]"}]}], 
           "]"}], ",", "fps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "[", 
        RowBox[{"[", "bestIdx", "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
