Cell[CellGroupData[{

Cell["Obtaining q(z)", "Subsection",
 CellChangeTimes->{{3.991450281039323*^9, 3.9914502857040863`*^9}, {
  3.991471695077602*^9, 
  3.991471714498495*^9}},ExpressionUUID->"5d05518b-bac5-4483-9c12-\
8c1f7cb78dfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "odeQ", ",", "sol"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"odeQ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"dq", "/.", " ", 
           RowBox[{"j", "->", 
            RowBox[{"params", "[", "\"\<j\>\"", "]"}]}]}], "/.", " ", 
          RowBox[{"\[Epsilon]", "->", 
           RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"q", "[", "0", "]"}], "==", 
          RowBox[{"params", "[", "\"\<q0\>\"", "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeQ", ",", "q", ",", 
         RowBox[{"{", 
