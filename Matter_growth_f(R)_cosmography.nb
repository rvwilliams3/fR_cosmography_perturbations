Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"okDatasets3", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"AvailableDatasets", "[", "\"\<Model 3\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel3", "[", "#", "]"}], "[", "\"\<failedAtZ\>\"",
          "]"}], "===", "None"}], "&"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", ":", " ", 
     RowBox[{"successful", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"0", " ", "to", " ", "1000"}]}], ",", 
    RowBox[{"x", 
     RowBox[{"(", "z", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel3", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
        "[", "z", "]"}], ",", 
       RowBox[{"{", 
