Cell[CellGroupData[{

Cell["Plotting for converging solutions", "Subsubsection",
 CellChangeTimes->{{3.991476672534472*^9, 
  3.991476707909467*^9}},ExpressionUUID->"e66fd5ec-d60a-4e7e-9ded-\
3942cc86c3f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"failedDatasets", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"AvailableDatasets", "[", "\"\<Model 2\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel1", "[", "#", "]"}], "[", "\"\<failedAtZ\>\"",
          "]"}], "=!=", "None"}], "&"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plot", " ", "1"}], ":", 
     RowBox[{"failed", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"200", " ", "to", " ", "1000"}]}], ",", 
    RowBox[{"x", 
     RowBox[{"(", "z", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel2", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
        "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "failedDatasets"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "200", ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{"failedDatasets", ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"FrameStyle", "->", "Gray"}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
           ")"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
