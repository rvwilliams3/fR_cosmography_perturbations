       RowBox[{"\[CapitalOmega]", "'"}], "[", "z", "]"}]}], "-", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", "[", "z", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", "z", "]"}], "+", "1", "-", 
        RowBox[{"2", 
         RowBox[{"q", "[", "z", "]"}]}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dq", "=", 
