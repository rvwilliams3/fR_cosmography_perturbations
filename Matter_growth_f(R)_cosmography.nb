Cell[CellGroupData[{

Cell["Module", "Subsubsection",
 CellChangeTimes->{{3.9917036829888067`*^9, 
  3.991703683908509*^9}},ExpressionUUID->"84deba58-59bd-4250-8cd6-\
cb7b1f5429d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "z0", ",", "fp", ",", "x0", ",", 
       "\[CapitalOmega]0", ",", "q0", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z0", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fp", "=", 
       RowBox[{
        RowBox[{"matterDominatedFPs", "[", "model", "]"}], "[", "dataset", 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{
        RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "-", "\[Delta]x"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]0", "=", 
       RowBox[{
        RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "-", 
        "\[Delta]\[CapitalOmega]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                  "\[CapitalOmega]0"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "10"}], ",", 
               RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", " ", 
        RowBox[{"\"\<z0\>\"", "->", "z0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<x0\>\"", "->", "x0"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]0\>\"", "->", "\[CapitalOmega]0"}], ",", 
        " ", 
        RowBox[{"\"\<q0\>\"", "->", "q0"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9917291097746487`*^9, 3.991729129780655*^9}, {
  3.991729166918635*^9, 3.991729168202729*^9}, {3.9917294791287737`*^9, 
  3.991729528343277*^9}, {3.991729691572505*^9, 3.99172970162003*^9}, {
  3.991729839221428*^9, 3.9917298590373707`*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"f51783fe-b5e1-4af8-8b2c-38d9ec377b79"]
}, Open  ]],

