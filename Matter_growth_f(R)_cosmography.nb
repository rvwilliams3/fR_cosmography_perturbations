Cell[CellGroupData[{

Cell["Integrating h(z)", "Subsubsection",
 CellChangeTimes->{{3.991447833541336*^9, 3.991447839118288*^9}, {
  3.9914503200312634`*^9, 3.991450320640971*^9}, {3.9914521647662897`*^9, 
  3.991452164985262*^9}},ExpressionUUID->"bdf4237d-315e-47a0-96a8-\
4e7030e78e31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SolveForh", "[", 
   RowBox[{
    RowBox[{"H0val_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Epsilon]val_", "?", "NumericQ"}], ",", "jModel_", ",", " ", 
    "qFn_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"odeH", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"odeH", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"dh", "/.", 
           RowBox[{"q", "->", "qFn"}]}], "/.", 
          RowBox[{"j", "->", "jModel"}]}], "/.", 
         RowBox[{"\[Epsilon]", "->", "\[Epsilon]val"}]}], ",", 
        RowBox[{
         RowBox[{"h", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{"odeH", ",", "h", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
        RowBox[{"PrecisionGoal", "->", "10"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"h", "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
  3.991448764350067*^9, 3.9914487668099403`*^9}, {3.991448918938006*^9, 
