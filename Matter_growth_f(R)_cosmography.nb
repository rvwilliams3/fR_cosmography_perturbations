Cell[CellGroupData[{

Cell["Modules", "Subsubsection",
 CellChangeTimes->{{3.9917036829888067`*^9, 3.991703683908509*^9}, 
   3.9917950262906303`*^9},ExpressionUUID->"84deba58-59bd-4250-8cd6-\
cb7b1f5429d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "calibratedICs_Association"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "z0", ",", "ic", ",", "x0", ",", 
       "\[CapitalOmega]0", ",", "q0", ",", "sol", ",", "xFn", ",", 
       "\[CapitalOmega]Fn", ",", "domainEnd"}], "}"}], ",", 
     RowBox[{
      RowBox[{"ic", "=", 
       RowBox[{"calibratedICs", "[", "dataset", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ic", "===", "$Failed"}], "||", 
         RowBox[{"ic", "===", "None"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z0", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"ic", "[", "\"\<xIn\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"\[CapitalOmega]0", "=", 
       RowBox[{"ic", "[", "\"\<OmegaIn\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0", "=", 
       RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                  "\[CapitalOmega]0"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "10"}], ",", 
               RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<q\>\"", "->", "qFn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "z0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<x0\>\"", "->", "x0"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]0\>\"", "->", "\[CapitalOmega]0"}], ",", 
        RowBox[{"\"\<q0\>\"", "->", "q0"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991795574880054*^9, 3.991795574882003*^9}},
 CellLabel->
  "In[248]:=",ExpressionUUID->"f129612f-5c45-4cdf-8e51-c3b33d77985c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotBackgroundSolutions", "[", 
    RowBox[{
    "model_String", ",", "bgResults_Association", ",", "datasets_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"colors", ",", "plotX", ",", "plotOmega"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"colors", "=", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "\"\<ColorList\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "datasets", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotX", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
             "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.25"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"model", "<>", "\"\< \[Dash] x(z)\>\""}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotOmega", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"bgResults", "[", "d", "]"}], "[", 
              "\"\<\[CapitalOmega]\>\"", "]"}], "[", "z", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", "datasets"}], "}"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zPlot"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"colors", ",", "datasets", ",", 
              RowBox[{"LegendFunction", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Framed", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                   RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
                ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.8", ",", "0.25"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<z\>\"", ",", "\"\<\[CapitalOmega](z)\>\""}], "}"}]}], 
         ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"model", "<>", "\"\< \[Dash] \[CapitalOmega](z)\>\""}]}], 
         ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"plotX", ",", "plotOmega"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991795853036449*^9, 3.991795867153831*^9}},
 CellLabel->
  "In[267]:=",ExpressionUUID->"be22ea79-572e-4840-a428-9450a6521842"]
