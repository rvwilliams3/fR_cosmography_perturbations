       RowBox[{"Append", "[", 
        RowBox[{"baseParams", ",", 
         RowBox[{"\"\<j\>\"", "->", 
          RowBox[{"jModelMap", "[", "model", "]"}]}]}], "]"}]}]}], "]"}]}], 
