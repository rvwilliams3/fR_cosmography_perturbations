   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"MatterDominatedFP", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "fpResult", ",", "fps", ",", "bestFP", ",", "vals", ",", "eig", ",", 
        "type", ",", "Jac", ",", "jAlg", ",", "epsVal"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fpResult", "=", 
        RowBox[{"FixedPointsStability", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "=", 
        RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"epsVal", "=", 
        RowBox[{"fpResult", "[", "\"\<eps\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "the", " ", "EdS", " ", "FP"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"bestFP", "=", 
        RowBox[{"ExtractMatterDominatedFP", "[", "fps", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ", 
