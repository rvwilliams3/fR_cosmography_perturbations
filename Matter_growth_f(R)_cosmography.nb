   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Module", ":", 
     RowBox[{
      RowBox[{"get", " ", "the", " ", "matter"}], "-", 
      RowBox[{
      "dominated", " ", "fixed", " ", "point", " ", "for", " ", "a", " ", 
       "given", " ", "model", " ", "and", " ", "dataset"}]}]}], ",", 
    RowBox[{
    "including", " ", "its", " ", "stability", " ", "classification"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"MatterDominatedFP", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "fpResult", ",", "fps", ",", "bestFP", ",", "vals", ",", "eig", ",", 
        "type", ",", "Jac", ",", "jAlg", ",", "epsVal"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fpResult", "=", 
        RowBox[{"FixedPointsStability", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "=", 
        RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"epsVal", "=", 
        RowBox[{"fpResult", "[", "\"\<eps\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "the", " ", "EdS", " ", "FP"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"bestFP", "=", 
        RowBox[{"ExtractMatterDominatedFP", "[", "fps", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ", 
         "bestFP"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Recompute", " ", 
         RowBox[{"Jacobian", "/", "eigenvalues"}], " ", "just", " ", "for", 
         " ", "this", " ", "selected", " ", "point"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "\[Epsilon]", "}"}], ",", 
         RowBox[{
          RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
          RowBox[{"jAlg", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"GetParams", "[", 
               RowBox[{"model", ",", "dataset"}], "]"}], "[", "\"\<j\>\"", 
              "]"}], "[", "n", "]"}], "/.", " ", 
            RowBox[{
             RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Jac", "[", 
            RowBox[{"xx_", ",", "OOmega_", ",", "qq_"}], "]"}], "=", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Fx", "[", 
                RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
               RowBox[{"F\[CapitalOmega]", "[", 
                RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
               RowBox[{"Fq", "[", 
                RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "}"}], "}"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eig", "=", 
           RowBox[{
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";"}]}], 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"type", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Stable node/spiral\>\"", ",", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
         RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<x\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
