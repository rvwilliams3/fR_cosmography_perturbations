Cell[CellGroupData[{

Cell["Matter dominated fixed point selection modules", "Subsubsection",
 CellChangeTimes->{{3.991726373941082*^9, 3.9917263874138927`*^9}, {
  3.9917265366132383`*^9, 
  3.991726537972209*^9}},ExpressionUUID->"a2b4b12d-e7e6-4212-a64f-\
4e145efbd7be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Extract", " ", "the", " ", "matter"}], "-", 
      RowBox[{"dominated", " ", "fixed", " ", 
       RowBox[{"point", ":", 
        RowBox[{"the", " ", "one", " ", "closest", " ", "to", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], ")"}]}]}]}]}], "=", 
     RowBox[{"(", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "eps"}], "->", 
     RowBox[{"0", " ", "EdS", " ", "limit"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractMatterDominatedFP", "[", "fps_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"target", ",", "distances", ",", "bestIdx"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"target", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"pt", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "vals", "}"}], ",", 
              RowBox[{
               RowBox[{"vals", "=", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.",
                  " ", "pt"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"N", "[", "vals", "]"}], "-", 
                 RowBox[{"N", "[", "target", "]"}]}], "]"}]}]}], "]"}]}], 
           "]"}], ",", "fps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "[", 
        RowBox[{"[", "bestIdx", "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.991726394589164*^9, 3.991726403343553*^9}, {
  3.9917264549179993`*^9, 3.9917264572874126`*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"416296c6-e159-4374-89b1-63fbe17532f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFP", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fpResult", ",", "fps", ",", "bestFP", ",", "vals", ",", "eig", ",", 
       "eigvecs", ",", "type", ",", "Jac", ",", "jAlg", ",", "epsVal"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fpResult", "=", 
       RowBox[{"FixedPointsStability", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"fpResult", "[", "\"\<eps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bestFP", "=", 
       RowBox[{"ExtractMatterDominatedFP", "[", "fps", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ", 
        "bestFP"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "\[Epsilon]", "}"}], ",", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
         RowBox[{"jAlg", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"GetParams", "[", 
              RowBox[{"model", ",", "dataset"}], "]"}], "[", "\"\<j\>\"", 
             "]"}], "[", "n", "]"}], "/.", " ", 
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Jac", "[", 
           RowBox[{"xx_", ",", "OOmega_", ",", "qq_"}], "]"}], "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"Fq", "[", 
               RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"xx", ",", "OOmega", ",", "qq"}], "}"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
          RowBox[{
