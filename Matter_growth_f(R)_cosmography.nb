         RowBox[{"dq", "/.", 
          RowBox[{"j", "->", "j1"}]}], "/.", 
         RowBox[{"\[Epsilon]", "->", 
          RowBox[{"params10a", "[", "\"\<eps\>\"", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"q", "[", "zinitial", "]"}], "==", "qin"}]}], "}"}], ",", 
      "q", ",", 
