    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "epsVal", ",", "jExpr", ",", "jAlg", ",", "fps", ",", 
       "Jac", ",", "classify", ",", "stabilityGrid"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "\[Epsilon]", "}"}], ",", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
         RowBox[{"jAlg", "=", 
          RowBox[{"jExpr", "/.", " ", 
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "turn", " ", "into", " ", "algebraic", " ", "expression", " ", "in",
            " ", "q"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fps", "=", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Fx", "[", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
               "0"}], ",", 
              RowBox[{
               RowBox[{"F\[CapitalOmega]", "[", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], "==", 
               "0"}], ",", 
              RowBox[{
               RowBox[{"Fq", "[", 
                RowBox[{"q", ",", "jAlg"}], "]"}], "==", "0"}]}], "}"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], ",", 
            "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Jac", "[", 
           RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "]"}], ",", 
              RowBox[{"Fq", "[", 
               RowBox[{"q", ",", "jAlg"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "}"}]}],
            "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"classify", "[", "pt_", "]"}], ":=", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"vals", ",", "eig", ",", "type"}], "}"}], ",", 
            RowBox[{
             RowBox[{"vals", "=", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", 
               " ", "pt"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"eig", "=", 
              RowBox[{
               RowBox[{"Eigenvalues", "[", 
                RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"type", "=", 
              RowBox[{"Which", "[", 
               RowBox[{
                RowBox[{"AllTrue", "[", 
                 RowBox[{"eig", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}],
                 ",", "\"\<Stable node/spiral\>\"", ",", 
                RowBox[{"AllTrue", "[", 
                 RowBox[{"eig", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}],
                 ",", "\"\<Unstable\>\"", ",", "True", ",", 
                "\"\<Saddle\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"vals", ",", "eig", ",", "type"}], "}"}]}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"stabilityGrid", "=", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"classify", "/@", "fps"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "\"\<(x*, \[CapitalOmega]*, q*)\>\"", ",", 
                "\"\<Eigenvalues\>\"", ",", "\"\<Type\>\""}], "}"}]}], "]"}], 
            ",", 
            RowBox[{"Frame", "->", "All"}]}], "]"}]}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
        RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<fixedPoints\>\"", "->", "fps"}], ",", 
        RowBox[{"\"\<stabilityGrid\>\"", "->", "stabilityGrid"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]], "Input",
