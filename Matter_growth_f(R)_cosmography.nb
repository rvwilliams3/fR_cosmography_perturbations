    RowBox[{"(", 
     RowBox[{"x", "+", "1", "-", 
      RowBox[{"2", " ", "q"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Fq", "[", 
    RowBox[{"q_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j", "-", "q", "-", 
      RowBox[{"2", " ", 
