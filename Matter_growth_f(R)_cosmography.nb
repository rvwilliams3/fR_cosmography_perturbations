Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Main", " ", 
     RowBox[{"getter", ":", 
      RowBox[{"GetParams", "[", 
       RowBox[{"\"\<Model 1\>\"", ",", "\"\<DESI\>\""}], "]"}]}]}], "->", 
    RowBox[{"Association", " ", "of", " ", "params"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetParams", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"allParams", ",", "model"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nomodel"}], ",", "model", ",", 
            RowBox[{"AvailableModels", "[", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
