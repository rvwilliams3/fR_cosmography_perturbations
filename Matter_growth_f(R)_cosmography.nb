       SuperscriptBox[
        RowBox[{"x", "[", "z", "]"}], "2"], "-", 
       RowBox[{
        RowBox[{"x", "[", "z", "]"}], 
        RowBox[{"(", 
         RowBox[{"2", "+", 
          RowBox[{"q", "[", "z", "]"}]}], ")"}]}], "-", "2", "-", 
       RowBox[{"2", 
        RowBox[{"q", "[", "z", "]"}]}], "+", 
       RowBox[{"3", 
        RowBox[{"\[CapitalOmega]", "[", "z", "]"}]}]}], ")"}]}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[CapitalOmega]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
