     RowBox[{"\"\<z0\>\"", "->", "z0"}]}], "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LCDMreplacements", "=", 
   RowBox[{"{", 
