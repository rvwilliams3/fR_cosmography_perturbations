Cell[CellGroupData[{

Cell["Integrating H(z)", "Subsubsection",
 CellChangeTimes->{{3.991447833541336*^9, 3.991447839118288*^9}, {
  3.9914503200312634`*^9, 
  3.991450320640971*^9}},ExpressionUUID->"33788f15-3770-4d9a-8c6b-\
0dceef276546"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SolveForH", "[", 
   RowBox[{
    RowBox[{"H0val_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Epsilon]val_", "?", "NumericQ"}], ",", "jModel_", ",", " ", 
    "qFn_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"odeH", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"odeH", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"dH", "/.", 
           RowBox[{"q", "->", "qFn"}]}], "/.", 
          RowBox[{"j", "->", "jModel"}]}], "/.", 
         RowBox[{"\[Epsilon]", "->", "\[Epsilon]val"}]}], ",", 
        RowBox[{
         RowBox[{"H", "[", "0", "]"}], "==", "H0val"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{"odeH", ",", "H", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
        RowBox[{"PrecisionGoal", "->", "10"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"H", "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
  3.991448764350067*^9, 3.9914487668099403`*^9}, {3.991448918938006*^9, 
