Cell[CellGroupData[{

Cell["Scan of ICs (Coarse)", "Subsubsection",
 CellChangeTimes->{{3.991733431058099*^9, 3.991733439041154*^9}, {
  3.991791735333887*^9, 
  3.991791737840498*^9}},ExpressionUUID->"7bb38129-07ae-43d4-8f70-\
35fa9fc6a0e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanICs", "[", 
    RowBox[{"model_String", ",", "dataset_String", ",", "c2Range_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fp", ",", "classified", ",", "vq", ",", "vxOmega", ",", "lambdaQ", ",",
        "qFn", ",", "deltaQ", ",", "c3", ",", "params", ",", "results"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fp", "=", 
       RowBox[{
        RowBox[{"matterDominatedFPs", "[", "model", "]"}], "[", "dataset", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"classified", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"classified", "[", "\"\<vq\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"classified", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lambdaQ", "=", 
       RowBox[{"classified", "[", "\"\<lambdaQ\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deltaQ", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "zinitial", "]"}], "-", 
        RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c3", "=", 
       RowBox[{"deltaQ", "/", 
        RowBox[{"vq", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "x0", ",", "\[CapitalOmega]0", ",", "sol", ",", "xFn", ",", 
             "\[CapitalOmega]Fn", ",", "domainEnd", ",", "xFinal", ",", 
             "\[CapitalOmega]Final"}], "}"}], ",", 
           RowBox[{
            RowBox[{"x0", "=", 
             RowBox[{
              RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
              RowBox[{"c2", " ", 
               RowBox[{"vxOmega", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "+", 
              RowBox[{"c3", " ", 
               RowBox[{"vq", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"\[CapitalOmega]0", "=", 
             RowBox[{
              RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
              RowBox[{"c2", " ", 
               RowBox[{"vxOmega", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "+", 
              RowBox[{"c3", " ", 
               RowBox[{"vq", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}],
                "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"q", "[", "zz_", "]"}], ":=", 
                RowBox[{"qFn", "[", "zz", "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"\[Epsilon]", "=", 
                RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"j", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "zz", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"s", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{"Solve", "[", 
                  RowBox[{"dj", ",", 
                   RowBox[{"s", "[", "zz", "]"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"l", "[", "zz_", "]"}], ":=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Solve", "[", 
                   RowBox[{"ds", ",", 
                    RowBox[{"l", "[", "zz", "]"}]}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
                 "Simplify"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"sol", "=", 
                RowBox[{"Quiet", "[", 
                 RowBox[{
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{"NDSolve", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zinitial", "]"}], "==", "x0"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zinitial", "]"}], "==", 
                    "\[CapitalOmega]0"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
                    RowBox[{"PrecisionGoal", "->", "10"}], ",", 
                    RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
                    "$Failed"}], "]"}], ",", 
                  RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}]}], ";"}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"sol", "===", "$Failed"}], ",", 
              RowBox[{"{", 
               RowBox[{
               "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", "Indeterminate",
                 ",", "Indeterminate", ",", "\"\<Failed\>\""}], "}"}], ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xFn", "=", 
                 RowBox[{"x", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"\[CapitalOmega]Fn", "=", 
                 RowBox[{"\[CapitalOmega]", "/.", " ", 
                  RowBox[{"sol", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"domainEnd", "=", 
                 RowBox[{
                  RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"domainEnd", ">", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", 
                    "Indeterminate", ",", "Indeterminate", ",", 
                    RowBox[{"\"\<Diverged at z=\>\"", "<>", 
                    RowBox[{"ToString", "[", "domainEnd", "]"}]}]}], "}"}], 
                  ",", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"xFinal", "=", 
                    RowBox[{"xFn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"\[CapitalOmega]Final", "=", 
                    RowBox[{"\[CapitalOmega]Fn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    "c2", ",", "x0", ",", "\[CapitalOmega]0", ",", "xFinal", 
                    ",", "\[CapitalOmega]Final", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"xFinal", "<", "0"}], "&&", 
                    RowBox[{"\[CapitalOmega]Final", ">", "0"}]}], ",", 
                    "\"\<Physical\>\"", ",", "\"\<Unphysical sign\>\""}], 
                    "]"}]}], "}"}]}], ")"}]}], "]"}]}], ")"}]}], "]"}]}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"c2", ",", "c2Range"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "results"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991734429011071*^9, 3.991734464303492*^9}, {
  3.991785422625357*^9, 3.991785442987152*^9}},
 CellLabel->
  "In[272]:=",ExpressionUUID->"d26cd75d-035c-4207-807f-2cbc4e92ec0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScanAllDatasetsPhysical", "[", 
    RowBox[{"model_String", ",", "c2Range_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "datasets", ",", "allResults", ",", "fullResultsByDataset", ",", 
       "physicalRowsByDataset", ",", "bounds", ",", "sortedC2Range"}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"datasets", "=", 
       RowBox[{"AvailableDatasets", "[", "model", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sortedC2Range", "=", 
       RowBox[{"Sort", "[", "c2Range", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fullResultsByDataset", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{"dataset", "->", 
             RowBox[{"ScanICs", "[", 
              RowBox[{"model", ",", "dataset", ",", "sortedC2Range"}], 
              "]"}]}]}], "]"}], ",", "datasets"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"physicalRowsByDataset", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{"dataset", "->", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"fullResultsByDataset", "[", "dataset", "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], "===", 
                 "\"\<Physical\>\""}], "&"}]}], "]"}]}]}], "]"}], ",", 
          "datasets"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bounds", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"dataset", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "fullRows", ",", "rows", ",", "c2Vals", ",", "minRow", ",", 
                "maxRow", ",", "c2min", ",", "c2max", ",", "idxMin", ",", 
                "idxMax", ",", "hasLowerBound", ",", "hasUpperBound"}], "}"}],
               ",", 
              RowBox[{
               RowBox[{"fullRows", "=", 
                RowBox[{"fullResultsByDataset", "[", "dataset", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"rows", "=", 
                RowBox[{"physicalRowsByDataset", "[", "dataset", "]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "rows", "]"}], "==", "0"}], ",", 
                 RowBox[{"dataset", "->", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<c2min\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<c2max\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<xInAtMin\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<OmegaInAtMin\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<xInAtMax\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<OmegaInAtMax\>\"", "->", "None"}], ",", 
                    RowBox[{"\"\<count\>\"", "->", "0"}], ",", 
                    RowBox[{"\"\<hasLowerBound\>\"", "->", "False"}], ",", 
                    RowBox[{"\"\<hasUpperBound\>\"", "->", "False"}]}], 
                   "|>"}]}], ",", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"c2Vals", "=", 
                    RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"c2min", "=", 
                    RowBox[{"Min", "[", "c2Vals", "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"c2max", "=", 
                    RowBox[{"Max", "[", "c2Vals", "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"minRow", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Select", "[", 
                    RowBox[{"rows", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", "c2min"}], "&"}]}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"maxRow", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Select", "[", 
                    RowBox[{"rows", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", "c2max"}], "&"}]}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Index", " ", "of", " ", "c2min"}], ",", 
                    RowBox[{
                    "c2max", " ", "within", " ", "the", " ", "FULL", " ", 
                    "sorted", " ", "scan", " ", "range"}]}], "*)"}], 
                   RowBox[{"idxMin", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{"sortedC2Range", ",", "c2min"}], "]"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"idxMax", "=", 
                    RowBox[{"First", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{"sortedC2Range", ",", "c2max"}], "]"}], "]"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "Lower", " ", "bound", " ", "is", " ", "confirmed", " ", 
                    "if", " ", "c2min", " ", 
                    RowBox[{"isn", "'"}], "t", " ", "the", " ", "first", " ", 
                    "tested", " ", "value"}], ",", 
                    RowBox[{
                    RowBox[{
                    "AND", " ", "the", " ", "point", " ", "just", " ", 
                    "below", " ", "it", " ", "is", " ", "non"}], "-", 
                    "Physical"}]}], "*)"}], 
                   RowBox[{"hasLowerBound", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"idxMin", ">", "1"}], ")"}], "&&", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fullRows", "[", 
                    RowBox[{"[", 
                    RowBox[{"idxMin", "-", "1"}], "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "=!=", 
                    "\"\<Physical\>\""}], ")"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "Upper", " ", "bound", " ", "is", " ", "confirmed", " ", 
                    "if", " ", "c2max", " ", 
                    RowBox[{"isn", "'"}], "t", " ", "the", " ", "last", " ", 
                    "tested", " ", "value"}], ",", 
                    RowBox[{
                    RowBox[{
                    "AND", " ", "the", " ", "point", " ", "just", " ", 
                    "above", " ", "it", " ", "is", " ", "non"}], "-", 
                    "Physical"}]}], "*)"}], 
                   RowBox[{"hasUpperBound", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"idxMax", "<", 
                    RowBox[{"Length", "[", "sortedC2Range", "]"}]}], ")"}], "&&", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fullRows", "[", 
                    RowBox[{"[", 
                    RowBox[{"idxMax", "+", "1"}], "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "=!=", 
                    "\"\<Physical\>\""}], ")"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", "hasLowerBound"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "model", ",", "\"\< \>\"", ",", "dataset", ",", 
                    "\"\< does not have a confirmed lower bound \[Dash] widen \
the range downward.\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", "hasUpperBound"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "model", ",", "\"\< \>\"", ",", "dataset", ",", 
                    "\"\< does not have a confirmed upper bound \[Dash] widen \
the range upward.\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"dataset", "->", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<c2min\>\"", "->", "c2min"}], ",", 
                    RowBox[{"\"\<c2max\>\"", "->", "c2max"}], ",", 
                    RowBox[{"\"\<xInAtMin\>\"", "->", 
                    RowBox[{"minRow", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    RowBox[{"\"\<OmegaInAtMin\>\"", "->", 
                    RowBox[{"minRow", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                    RowBox[{"\"\<xInAtMax\>\"", "->", 
                    RowBox[{"maxRow", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    RowBox[{"\"\<OmegaInAtMax\>\"", "->", 
                    RowBox[{"maxRow", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                    RowBox[{"\"\<count\>\"", "->", 
                    RowBox[{"Length", "[", "rows", "]"}]}], ",", 
                    RowBox[{"\"\<hasLowerBound\>\"", "->", "hasLowerBound"}], 
                    ",", 
                    RowBox[{
                    "\"\<hasUpperBound\>\"", "->", "hasUpperBound"}]}], 
                    "|>"}]}]}], ")"}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
          "datasets"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"allResults", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"dataset", ",", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Prepend", "[", 
                 RowBox[{"#", ",", "dataset"}], "]"}], "&"}], ",", 
               RowBox[{"physicalRowsByDataset", "[", "dataset", "]"}]}], 
              "]"}]}], "]"}], ",", "datasets"}], "]"}], ",", "1"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<table\>\"", "->", "allResults"}], ",", 
        RowBox[{"\"\<byDataset\>\"", "->", "physicalRowsByDataset"}], ",", 
        RowBox[{"\"\<bounds\>\"", "->", "bounds"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991789096759477*^9, 3.991789096761094*^9}, 
   3.99178929741772*^9, 3.991791291828036*^9, 3.991791390252541*^9},
 CellLabel->
  "In[273]:=",ExpressionUUID->"b241f16a-6506-4b43-8c99-7ff675bc50bf"]
}, Closed]],

Cell[CellGroupData[{

Cell["Refine Scan and plot:", "Subsubsection",
 CellChangeTimes->{{3.991789245068912*^9, 3.991789247631836*^9}, {
  3.9917918477262907`*^9, 
  3.991791848731298*^9}},ExpressionUUID->"559a833a-60b7-47b1-b6fe-\
41b1ef558f92"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RefineScan", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "scanResults_Association", 
     ",", 
     RowBox[{"nPoints_Integer", ":", "50"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bnds", ",", "refinedRange"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bnds", "=", 
       RowBox[{
        RowBox[{"scanResults", "[", "\"\<bounds\>\"", "]"}], "[", "dataset", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bnds", "[", "\"\<c2min\>\"", "]"}], "===", "None"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"refinedRange", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"bnds", "[", "\"\<c2min\>\"", "]"}], ",", 
         RowBox[{"bnds", "[", "\"\<c2max\>\"", "]"}], ",", 
         RowBox[{"nPoints", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ScanICs", "[", 
       RowBox[{"model", ",", "dataset", ",", "refinedRange"}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991789212381978*^9, 3.991789212384058*^9}, {
  3.991789554279786*^9, 3.991789566000327*^9}, {3.9917897064042053`*^9, 
  3.991789731912451*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"798ed74b-9b19-4778-b554-cedbfa1c6e77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotRefinedScan", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "refinedResults_List"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "physicalRows", ",", "sorted", ",", "xInVals", ",", "x0Vals", ",", 
       "Omega0Vals"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"physicalRows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"refinedResults", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "===", "\"\<Physical\>\""}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "physicalRows", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<No physical points found for \>\"", ",", "dataset", ",", 
           "\"\< in this range.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sorted", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"physicalRows", ",", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"sort", " ", "by", " ", "x_in"}], "*)"}], 
      RowBox[{"xInVals", "=", 
       RowBox[{"sorted", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"x0Vals", "=", 
       RowBox[{"sorted", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Omega0Vals", "=", 
       RowBox[{"sorted", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xInVals", ",", "x0Vals"}], "}"}], "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xInVals", ",", "Omega0Vals"}], "}"}], "]"}]}], "}"}], 
        ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<x\[Null](0)\>\"", ",", 
               "\"\<\[CapitalOmega]\[Null](0)\>\""}], "}"}], ",", 
             RowBox[{"LegendFunction", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Framed", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"FrameStyle", "->", "Gray"}], ",", 
                  RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
               ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.8", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x_in\>\"", ",", "\"\<value\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"model", "<>", "\"\<, \>\"", "<>", "dataset"}]}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"ImageSize", "->", "600"}], ",", 
        RowBox[{"PlotMarkers", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", " ", "Small"}], "}"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991789571169771*^9, 3.991789571172183*^9}, {
  3.991789629828991*^9, 3.991789671822888*^9}, {3.9917897477920113`*^9, 
  3.991789748019888*^9}, {3.991791636588822*^9, 3.991791661132926*^9}},
 CellLabel->
  "In[275]:=",ExpressionUUID->"e22cce1f-9bbe-43c2-9932-793304f58abd"]
}, Closed]],

Cell[CellGroupData[{

Cell["Determining ICs to be used within range", "Subsubsection",
 CellChangeTimes->{{3.99179428122421*^9, 
  3.991794293589984*^9}},ExpressionUUID->"61777169-99d5-4eb9-bc3a-\
b5760052fde4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FindCalibratedIC", "[", 
    RowBox[{
    "model_String", ",", "dataset_String", ",", "scanResults_Association", 
     ",", 
     RowBox[{"tolerance_", ":", "0.05"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bnds", ",", "om0Target", ",", "refined", ",", "physicalRows", ",", 
       "negXRows", ",", "withinTol", ",", "closest"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bnds", "=", 
       RowBox[{
        RowBox[{"scanResults", "[", "\"\<bounds\>\"", "]"}], "[", "dataset", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bnds", "[", "\"\<c2min\>\"", "]"}], "===", "None"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"om0Target", "=", 
       RowBox[{
        RowBox[{"GetParams", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}], "[", "\"\<Om0\>\"", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"refined", "=", 
       RowBox[{"RefineScan", "[", 
        RowBox[{"model", ",", "dataset", ",", "scanResults", ",", "200"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"physicalRows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"refined", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "===", "\"\<Physical\>\""}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "physicalRows", "]"}], "==", "0"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Require", " ", "x_in"}], "<", 
         RowBox[{"0", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"genuine", " ", "GR"}], "-", 
            RowBox[{"viable", " ", "sign"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"not", " ", "just", " ", "x", 
          RowBox[{"(", "0", ")"}]}], "<", "0"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"negXRows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"physicalRows", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "negXRows", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "dataset", ",", 
           "\"\<: no physical point has x_in < 0 (all x_in \[GreaterEqual] 0 \
for this dataset/model) \[Dash] returning None.\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "None", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Among", " ", "x_in"}], "<", 
         RowBox[{"0", " ", "points"}]}], ",", 
        RowBox[{
        "find", " ", "those", " ", "within", " ", "tolerance", " ", "of", " ",
          "Om0_mean"}]}], "*)"}], 
      RowBox[{"withinTol", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"negXRows", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "-", "om0Target"}], "]"}], "/",
             "om0Target"}], "<", "tolerance"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "withinTol", "]"}], ">", "0"}], ",", 
        RowBox[{
         RowBox[{"closest", "=", 
          RowBox[{"First", "[", "withinTol", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<c2\>\"", "->", 
            RowBox[{"closest", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<xIn\>\"", "->", 
            RowBox[{"closest", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<OmegaIn\>\"", "->", 
            RowBox[{"closest", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<x0\>\"", "->", 
            RowBox[{"closest", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Omega0\>\"", "->", 
            RowBox[{"closest", "[", 
             RowBox[{"[", "5", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Om0Target\>\"", "->", "om0Target"}], ",", 
           RowBox[{"\"\<relativeDiff\>\"", "->", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"closest", "[", 
                RowBox[{"[", "5", "]"}], "]"}], "-", "om0Target"}], "]"}], 
             "/", "om0Target"}]}]}], "|>"}]}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"closest", "=", 
           RowBox[{"First", "[", 
            RowBox[{"SortBy", "[", 
             RowBox[{"negXRows", ",", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], "-", "om0Target"}], "]"}], 
               "&"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
