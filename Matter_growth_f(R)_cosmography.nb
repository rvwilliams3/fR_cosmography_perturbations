Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Fx", "[", 
    RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "2"], "-", 
      RowBox[{"x", " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", "q"}], ")"}]}], "-", "2", "-", 
      RowBox[{"2", " ", "q"}], "+", 
      RowBox[{"3", " ", "\[CapitalOmega]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[CapitalOmega]", "[", 
    RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], ":=", 
