Cell[BoxData[{
 RowBox[{
  RowBox[{"solLCDM", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<x\>\"", "->", 
      RowBox[{"xLCDM", "[", "z", "]"}]}], ",", 
     RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
      RowBox[{"\[CapitalOmega]LCDM", "[", "z", "]"}]}], ",", 
