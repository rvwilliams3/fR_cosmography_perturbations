   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"H", "'"}], "[", "n", "]"}], "+", " ", 
     RowBox[{
      RowBox[{"H", "[", "n", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"q", "[", "n", "]"}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}]}], "Input",
