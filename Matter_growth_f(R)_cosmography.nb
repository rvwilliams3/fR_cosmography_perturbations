Cell["Initial conditions", "Subsubsection",
 CellChangeTimes->{{3.991450643928804*^9, 
  3.991450646212244*^9}},ExpressionUUID->"b75b0d10-11eb-482a-967a-\
4eac500cc165"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"-", "0.001"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]0", "=", "0.993243"}], ";"}]}], "Input",
 CellChangeTimes->{{3.991452625129627*^9, 3.991452628718149*^9}, {
  3.99145267444013*^9, 
  3.991452676223444*^9}},ExpressionUUID->"0d79205b-cfe7-4ff6-88c4-\
70ee93a42140"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"IC1a", "=", 
   RowBox[{"{", 
    RowBox[{"zi", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IC2a", "=", 
   RowBox[{"{", 
    RowBox[{"zi", ",", "x0", ",", "\[CapitalOmega]0", ",", "q0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
