3942cc86c3f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"failedDatasets", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"AvailableDatasets", "[", "\"\<Model 2\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel1", "[", "#", "]"}], "[", "\"\<failedAtZ\>\"",
          "]"}], "=!=", "None"}], "&"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plot", " ", "1"}], ":", 
     RowBox[{"failed", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"200", " ", "to", " ", "1000"}]}], ",", 
    RowBox[{"x", 
     RowBox[{"(", "z", ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel2", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
        "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "failedDatasets"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "200", ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{"failedDatasets", ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"FrameStyle", "->", "Gray"}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
           ")"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Model 1 \[Dash] diverging datasets (q_in < 0.5)\>\""}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"ImageSize", "->", "600"}]}], "]"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plot", " ", "2"}], ":", 
     RowBox[{"failed", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"200", " ", "to", " ", "1000"}]}], ",", 
