     RowBox[{"Association", " ", "of", " ", "params"}]}], ",", 
    RowBox[{"including", " ", "\"\<j\>\""}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"GetParams", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "baseParams", "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"allParams", ",", "model"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nomodel"}], ",", "model", ",", 
