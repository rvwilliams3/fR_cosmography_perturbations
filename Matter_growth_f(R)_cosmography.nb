          RowBox[{"modelName", ",", "file"}], "}"}], ",", 
         RowBox[{"modelName", "->", 
          RowBox[{"BuildModelParams", "[", "file", "]"}]}]}], "]"}], ",", 
       "mcmcFiles"}], "]"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{3.99146949618592*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"2a66b171-384e-45fa-b0f9-db4ceb900dc4"],

