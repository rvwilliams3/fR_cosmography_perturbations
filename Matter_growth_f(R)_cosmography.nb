Cell[CellGroupData[{

Cell["Classification of eigenvectors:", "Subsubsection",
 CellChangeTimes->{{3.9917333812941523`*^9, 
  3.9917333913488607`*^9}},ExpressionUUID->"b99d9a95-d02e-4d72-a7b6-\
51f0aca7443d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
       ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vecs", "=", 
       RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"unstableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableIdx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"eig", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Among", " ", "the", " ", "unstable", " ", "ones"}], ",", 
        RowBox[{
         RowBox[{"find", " ", "which", " ", "has", " ", "nonzero", " ", "q"}],
          "-", "component"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"qComponents", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vq", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], ">", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxOmega", "=", 
       RowBox[{"vecs", "[", 
        RowBox[{"[", 
         RowBox[{"unstableIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"qComponents", ",", 
               RowBox[{"_", "?", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", "#", "]"}], "<=", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
            "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
        RowBox[{"\"\<vxOmega\>\"", "->", "vxOmega"}], ",", 
        RowBox[{"\"\<vStable\>\"", "->", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", "stableIdx", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaQ\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<lambdaXOmega\>\"", "->", 
         RowBox[{"eig", "[", 
          RowBox[{"[", 
           RowBox[{"unstableIdx", "[", 
            RowBox[{"[", 
             RowBox[{"First", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"qComponents", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
              "]"}], "]"}], "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9917333919158697`*^9, 3.991733405622898*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"213fd7af-74eb-4ab2-a01d-1a15178a7cc3"]
