             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
         RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
