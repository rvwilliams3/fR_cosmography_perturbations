Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Fx", "[", 
    RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "2"], "-", 
      RowBox[{"x", " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", "q"}], ")"}]}], "-", "2", "-", 
      RowBox[{"2", " ", "q"}], "+", 
      RowBox[{"3", " ", "\[CapitalOmega]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[CapitalOmega]", "[", 
    RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[CapitalOmega]"}], " ", 
    RowBox[{"(", 
     RowBox[{"x", "+", "1", "-", 
      RowBox[{"2", " ", "q"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Fq", "[", 
    RowBox[{"q_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j", "-", "q", "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["q", "2"]}]}], ")"}]}]}], ";"}]}], "Input",
