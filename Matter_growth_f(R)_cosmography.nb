        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], ",", "dataset"}], 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nodataset"}], ",", "dataset", ",", 
            "model", ",", 
            RowBox[{"AvailableDatasets", "[", "model", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"baseParams", "=", 
        RowBox[{
         RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Append", "[", 
        RowBox[{"baseParams", ",", 
         RowBox[{"\"\<j\>\"", "->", 
          RowBox[{"jModelMap", "[", "model", "]"}]}]}], "]"}]}]}], "]"}]}], 
