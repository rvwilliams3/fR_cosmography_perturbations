Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Main", " ", 
     RowBox[{"getter", ":", 
      RowBox[{"GetParams", "[", 
       RowBox[{"\"\<Model 1\>\"", ",", "\"\<DESI\>\""}], "]"}]}]}], "->", 
    RowBox[{"Association", " ", "of", " ", "params"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetParams", "[", 
     RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"allParams", ",", "model"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nomodel"}], ",", "model", ",", 
            RowBox[{"AvailableModels", "[", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"allParams", "[", "model", "]"}], ",", "dataset"}], 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"GetParams", "::", "nodataset"}], ",", "dataset", ",", 
            "model", ",", 
            RowBox[{"AvailableDatasets", "[", "model", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"allParams", "[", "model", "]"}], "[", "dataset", "]"}]}]}], 
     "]"}]}], ";", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GetParams", "::", "nomodel"}], "=", 
    "\"\<Model `1` not found. Available models: `2`\>\""}], ";", "\n", 
   RowBox[{
    RowBox[{"GetParams", "::", "nodataset"}], "=", 
    "\"\<Dataset `1` not found for `2`. Available datasets: `3`\>\""}], ";"}],
   "*)"}]], "Input",
 CellChangeTimes->{3.991469582938128*^9, 3.991469628663713*^9, 
