      RowBox[{"3", " ", "\[CapitalOmega]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F\[CapitalOmega]", "[", 
    RowBox[{"x_", ",", "\[CapitalOmega]_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[CapitalOmega]"}], " ", 
    RowBox[{"(", 
     RowBox[{"x", "+", "1", "-", 
      RowBox[{"2", " ", "q"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Fq", "[", 
    RowBox[{"q_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j", "-", "q", "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["q", "2"]}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9917256594520483`*^9, 3.991725787712503*^9}, {
  3.991726013014138*^9, 3.991726057157393*^9}, {3.991726976442134*^9, 
  3.991727003157297*^9}},
