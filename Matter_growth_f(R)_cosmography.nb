Cell[CellGroupData[{

Cell["Determining ICs to use", "Subsubsection",
 CellChangeTimes->{{3.991794079172884*^9, 
  3.991794082588801*^9}},ExpressionUUID->"8472eac8-9bbc-4186-8f99-\
61b52507c9c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"calibratedICsModel1", "=", 
    RowBox[{"Association", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "->", 
         RowBox[{"FindCalibratedIC", "[", 
          RowBox[{
          "\"\<Model 1\>\"", ",", "#", ",", "scanResultsModel1", ",", 
           "0.05"}], "]"}]}], "&"}], ",", 
       RowBox[{"AvailableDatasets", "[", "\"\<Model 1\>\"", "]"}]}], "]"}], 
     "]"}]}], ";"}], ";"}]], "Input",
 CellChangeTimes->{{3.991794097874189*^9, 3.99179409787599*^9}, 
   3.991794227860133*^9, 3.9917955897778053`*^9},
 CellLabel->
  "In[249]:=",ExpressionUUID->"6b322dd0-ce63-4055-add3-8f832f32099a"],

Cell[CellGroupData[{

Cell[BoxData[
