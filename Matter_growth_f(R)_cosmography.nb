Cell[CellGroupData[{

Cell["Plotting for converging solutions", "Subsubsection",
 CellChangeTimes->{{3.991476672534472*^9, 
  3.991476707909467*^9}},ExpressionUUID->"d1c27bb6-482c-4744-9fce-\
2415454e6d1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"failedDatasets3", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"AvailableDatasets", "[", "\"\<Model 3\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel3", "[", "#", "]"}], "[", "\"\<failedAtZ\>\"",
          "]"}], "=!=", "None"}], "&"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plot", " ", "1"}], ":", 
     RowBox[{"failed", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"200", " ", "to", " ", "1000"}]}], ",", 
    RowBox[{"x", 
     RowBox[{"(", "z", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bgResultsModel3", "[", "d", "]"}], "[", "\"\<x\>\"", "]"}], 
        "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "failedDatasets3"}], "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "5", ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{"failedDatasets3", ",", 
         RowBox[{"LegendFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Framed", "[", 
             RowBox[{"#", ",", 
              RowBox[{"FrameStyle", "->", "Gray"}], ",", 
              RowBox[{"RoundingRadius", "->", "0"}]}], "]"}], "&"}], 
           ")"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<z\>\"", ",", "\"\<x(z)\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Model 1 \[Dash] diverging datasets (q_in < 0.5)\>\""}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"ImageSize", "->", "600"}]}], "]"}], "\n", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Plot", " ", "2"}], ":", 
     RowBox[{"failed", " ", "datasets"}]}], ",", 
    RowBox[{"z", "=", 
     RowBox[{"200", " ", "to", " ", "1000"}]}], ",", 
    RowBox[{"\[CapitalOmega]", 
     RowBox[{"(", "z", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
