Cell[CellGroupData[{

Cell["Obtaining E(z)", "Subsection",
 CellChangeTimes->{{3.991450281039323*^9, 3.9914502857040863`*^9}, {
  3.991471695077602*^9, 3.991471725258513*^9}, {3.991707398906136*^9, 
  3.991707399181655*^9}},ExpressionUUID->"f2dc2991-bf57-4515-9ab8-\
83153e03f64c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForEh", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "qFn", ",", "odeEh", ",", "sol"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"odeEh", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dEh", "/.", " ", 
            RowBox[{"q", "->", "qFn"}]}], ")"}], "/.", " ", 
          RowBox[{"\[Epsilon]", "->", 
           RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}]}], ",", 
         RowBox[{
