       "\[IndentingNewLine]", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "\[Epsilon]", "}"}], ",", 
         RowBox[{
          RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
          RowBox[{"jAlg", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"GetParams", "[", 
               RowBox[{"model", ",", "dataset"}], "]"}], "[", "\"\<j\>\"", 
              "]"}], "[", "n", "]"}], "/.", " ", 
            RowBox[{
             RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Jac", "[", 
            RowBox[{"xx_", ",", "OOmega_", ",", "qq_"}], "]"}], "=", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Fx", "[", 
                RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
               RowBox[{"F\[CapitalOmega]", "[", 
                RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
               RowBox[{"Fq", "[", 
