Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Extract", " ", "the", " ", "matter"}], "-", 
      RowBox[{"dominated", " ", "fixed", " ", 
       RowBox[{"point", ":", 
        RowBox[{"the", " ", "one", " ", "closest", " ", "to", " ", 
         RowBox[{"(", 
          RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], ")"}]}]}]}]}], "=", 
     RowBox[{"(", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "eps"}], "->", 
     RowBox[{"0", " ", "EdS", " ", "limit"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ExtractMatterDominatedFP", "[", "fps_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"target", ",", "distances", ",", "bestIdx"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"target", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"pt", ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "vals", "}"}], ",", 
              RowBox[{
               RowBox[{"vals", "=", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.",
                  " ", "pt"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{"N", "[", "vals", "]"}], "-", 
                 RowBox[{"N", "[", "target", "]"}]}], "]"}]}]}], "]"}]}], 
           "]"}], ",", "fps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "[", 
        RowBox[{"[", "bestIdx", "]"}], "]"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.991726394589164*^9, 3.991726403343553*^9}, {
  3.9917264549179993`*^9, 3.9917264572874126`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"416296c6-e159-4374-89b1-63fbe17532f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFP", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fpResult", ",", "fps", ",", "bestFP", ",", "vals", ",", "eig", ",", 
       "eigvecs", ",", "type", ",", "Jac", ",", "jAlg", ",", "epsVal"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fpResult", "=", 
       RowBox[{"FixedPointsStability", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"epsVal", "=", 
       RowBox[{"fpResult", "[", "\"\<eps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bestFP", "=", 
       RowBox[{"ExtractMatterDominatedFP", "[", "fps", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "\[CapitalOmega]", ",", "q"}], "}"}], "/.", " ", 
        "bestFP"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", "\[Epsilon]", "}"}], ",", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", "epsVal"}], ";", "\[IndentingNewLine]", 
         RowBox[{"jAlg", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"GetParams", "[", 
              RowBox[{"model", ",", "dataset"}], "]"}], "[", "\"\<j\>\"", 
             "]"}], "[", "n", "]"}], "/.", " ", 
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "->", "q"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Jac", "[", 
           RowBox[{"xx_", ",", "OOmega_", ",", "qq_"}], "]"}], "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Fx", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"F\[CapitalOmega]", "[", 
               RowBox[{"xx", ",", "OOmega", ",", "qq"}], "]"}], ",", 
              RowBox[{"Fq", "[", 
               RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"xx", ",", "OOmega", ",", "qq"}], "}"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
          RowBox[{
           RowBox[{"Eigensystem", "[", 
            RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"type", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"eig", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], ",", 
         "\"\<Stable node/spiral\>\"", ",", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"eig", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
         "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
        RowBox[{"\"\<dataset\>\"", "->", "dataset"}], ",", 
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<x\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<q\>\"", "->", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<eigenvalues\>\"", "->", "eig"}], ",", 
        RowBox[{"\"\<eigenvectors\>\"", "->", "eigvecs"}], ",", 
        RowBox[{"\"\<type\>\"", "->", "type"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9917331682153273`*^9, 3.991733224686933*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"0fa35c42-1393-4479-8b58-a5b6f1ce8c4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matterDominatedFPs", "=", 
