Cell[CellGroupData[{

Cell["Module", "Subsubsection",
 CellChangeTimes->{{3.9917036829888067`*^9, 
  3.991703683908509*^9}},ExpressionUUID->"84deba58-59bd-4250-8cd6-\
cb7b1f5429d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveBackground", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "params", ",", "qFn", ",", "z0", ",", "x0", ",", "\[CapitalOmega]0", 
       ",", "sol", ",", "xFn", ",", "\[CapitalOmega]Fn", ",", "domainEnd"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"params", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"qFn", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z0", "=", "zinitial"}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", "xin"}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalOmega]0", "=", "\[CapitalOmega]in"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "[", "z_", "]"}], "=", 
          RowBox[{"qFn", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"j", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "z", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"s", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"dj", ",", 
             RowBox[{"s", "[", "z", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", "[", "z_", "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"ds", ",", 
              RowBox[{"l", "[", "z", "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{
             RowBox[{"NDSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                 RowBox[{
                  RowBox[{"x", "[", "z0", "]"}], "==", "x0"}], ",", 
                 RowBox[{
                  RowBox[{"\[CapitalOmega]", "[", "z0", "]"}], "==", 
                  "\[CapitalOmega]0"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", 
               RowBox[{"PrecisionGoal", "->", "10"}], ",", 
               RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
             RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xFn", "=", 
          RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[CapitalOmega]Fn", "=", 
          RowBox[{"\[CapitalOmega]", "/.", " ", "sol"}]}], ";"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Check", " ", "where", " ", "the", " ", "interpolating", " ", 
        RowBox[{"function", "'"}], "s", " ", "domain", " ", "actually", " ", 
        "ends"}], "*)"}], 
      RowBox[{"domainEnd", "=", 
       RowBox[{
        RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"domainEnd", ">", "0"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "dataset", ",", "\"\< is stiff/diverges at z \[TildeEqual] \>\"", 
          ",", "domainEnd"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<x\>\"", "->", "xFn"}], ",", 
        RowBox[{"\"\<\[CapitalOmega]\>\"", "->", "\[CapitalOmega]Fn"}], ",", 
        RowBox[{"\"\<z0\>\"", "->", "z0"}], ",", 
        RowBox[{"\"\<zinitial\>\"", "->", "zinitial"}], ",", 
        RowBox[{"\"\<failedAtZ\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"domainEnd", ">", "0"}], ",", "domainEnd", ",", "None"}], 
          "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991476557747472*^9, 3.991476557749202*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"59dcf2b6-45f9-4d40-8a0e-9fe56e407577"]
}, Closed]],

