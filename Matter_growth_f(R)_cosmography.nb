      RowBox[{"h", "[", "z", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"q", "[", "z", "]"}]}], ")"}]}]}], "==", "0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
