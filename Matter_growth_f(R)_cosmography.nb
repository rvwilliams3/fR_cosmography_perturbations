Cell[BoxData[
 RowBox[{
  RowBox[{"SolveForq", "[", 
   RowBox[{
    RowBox[{"q0val_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Epsilon]val_", "?", "NumericQ"}], ",", "jModel_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"odeQ", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"odeQ", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"dq", "/.", 
          RowBox[{"j", "->", "jModel"}]}], "/.", 
         RowBox[{"\[Epsilon]", "->", "\[Epsilon]val"}]}], ",", 
        RowBox[{
         RowBox[{"q", "[", "0", "]"}], "==", "q0val"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{"odeQ", ",", "q", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
        RowBox[{"PrecisionGoal", "->", "10"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]], "Input",
