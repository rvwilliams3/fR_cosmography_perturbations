Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[CapitalLambda]CDM", " ", "parameters"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]m0LCDM", "=", "0.3"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hLCDM", "[", "z_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"\[CapitalOmega]m0LCDM", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "3"]}], "+", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[CapitalOmega]m0LCDM"}], ")"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
