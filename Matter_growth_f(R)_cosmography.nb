    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "baseParams", "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
