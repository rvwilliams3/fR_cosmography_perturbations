Cell[CellGroupData[{

Cell["Obtaining h(z)", "Subsection",
 CellChangeTimes->{{3.991450281039323*^9, 3.9914502857040863`*^9}, {
  3.991471695077602*^9, 
  3.991471725258513*^9}},ExpressionUUID->"e263e242-0107-47ea-9e3a-\
56f710e49c7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForh", "[", 
    RowBox[{"model_String", ",", "dataset_String"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"params", ",", "qFn", ",", "odeH", ",", "sol"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"params", "=", 
       RowBox[{"GetParams", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"SolveForq", "[", 
        RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"odeH", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dh", "/.", " ", 
            RowBox[{"q", "->", "qFn"}]}], ")"}], "/.", " ", 
          RowBox[{"\[Epsilon]", "->", 
           RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"h", "[", "0", "]"}], "==", "1"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"odeH", ",", "h", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"h", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991448700029447*^9, 3.991448715412242*^9}, {
  3.991448764350067*^9, 3.99144876680994*^9}, {3.991448918938006*^9, 
  3.991448923543747*^9}, {3.991448978914154*^9, 3.991449107877153*^9}, {
  3.991471440100438*^9, 3.991471448695713*^9}, {3.991471490762517*^9, 
  3.991471491056706*^9}, {3.991471728459805*^9, 3.991471781350174*^9}, {
  3.991471882983693*^9, 3.991471923577379*^9}, {3.991471956762825*^9, 
  3.9914719879513206`*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"0f8168e1-7a1b-47c7-8af0-fe2e14eebf1a"],

