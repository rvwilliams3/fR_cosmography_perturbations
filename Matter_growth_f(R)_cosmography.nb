Cell[CellGroupData[{

Cell["Scan of ICs", "Subsubsection",
 CellChangeTimes->{{3.991733431058099*^9, 
  3.991733439041154*^9}},ExpressionUUID->"7bb38129-07ae-43d4-8f70-\
35fa9fc6a0e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Grid", " ", "scan", " ", "over", " ", "deviations", " ", "from", " ", 
    "the", " ", "fixed", " ", "point"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ScanICGrid", "[", 
     RowBox[{
     "model_String", ",", "dataset_String", ",", "deltaXRange_List", ",", 
      "deltaOmegaRange_List", ",", "signCombos_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fp", ",", "qFn", ",", "params", ",", "results"}], "}"}], ",", 
      
      RowBox[{
       RowBox[{"fp", "=", 
        RowBox[{
         RowBox[{"matterDominatedFPs", "[", "model", "]"}], "[", "dataset", 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"params", "=", 
        RowBox[{"GetParams", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qFn", "=", 
        RowBox[{"SolveForq", "[", 
         RowBox[{"model", ",", "dataset"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"results", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "x0", ",", "\[CapitalOmega]0", ",", "q0", ",", "sol", ",", 
                "xFn", ",", "\[CapitalOmega]Fn", ",", "domainEnd", ",", 
                "xFinal", ",", "\[CapitalOmega]Final", ",", "status"}], "}"}],
               ",", 
              RowBox[{
               RowBox[{"x0", "=", 
                RowBox[{
                 RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
                 RowBox[{"signX", " ", "deltaX"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"\[CapitalOmega]0", "=", 
                RowBox[{
                 RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
                 RowBox[{"signOm", " ", "deltaOm"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"q0", "=", 
                RowBox[{"qFn", "[", "zinitial", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Block", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "q", ",", "j", ",", "s", ",", "l", ",", "\[Epsilon]"}], 
                  "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"q", "[", "zz_", "]"}], ":=", 
                   RowBox[{"qFn", "[", "zz", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"\[Epsilon]", "=", 
                   RowBox[{"params", "[", "\"\<eps\>\"", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"j", "[", "zz_", "]"}], ":=", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<j\>\"", "]"}], "[", "zz", 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"s", "[", "zz_", "]"}], ":=", 
                   RowBox[{
                    RowBox[{"Solve", "[", 
                    RowBox[{"dj", ",", 
                    RowBox[{"s", "[", "zz", "]"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"l", "[", "zz_", "]"}], ":=", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Solve", "[", 
                    RowBox[{"ds", ",", 
                    RowBox[{"l", "[", "zz", "]"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "//", 
                    "Simplify"}]}], ";", "\[IndentingNewLine]", 
                  "\[IndentingNewLine]", 
                  RowBox[{"sol", "=", 
                   RowBox[{"Quiet", "[", 
                    RowBox[{
                    RowBox[{"Check", "[", 
                    RowBox[{
                    RowBox[{"NDSolve", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zinitial", "]"}], "==", "x0"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zinitial", "]"}], "==", 
                    "\[CapitalOmega]0"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zinitial"}], "}"}], ",", 
                    RowBox[{"PrecisionGoal", "->", "10"}], ",", 
                    RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}], ",", 
                    "$Failed"}], "]"}], ",", 
                    RowBox[{"NDSolve", "::", "ndsz"}]}], "]"}]}], ";"}]}], 
                "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"sol", "===", "$Failed"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                  "deltaX", ",", "deltaOm", ",", "signX", ",", "signOm", ",", 
                   "x0", ",", "\[CapitalOmega]0", ",", "Indeterminate", ",", 
                   "Indeterminate", ",", "\"\<Failed\>\""}], "}"}], ",", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"xFn", "=", 
                    RowBox[{"x", "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"\[CapitalOmega]Fn", "=", 
                    RowBox[{"\[CapitalOmega]", "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"domainEnd", "=", 
                    RowBox[{
                    RowBox[{"xFn", "[", "\"\<Domain\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"domainEnd", ">", "0"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    "deltaX", ",", "deltaOm", ",", "signX", ",", "signOm", 
                    ",", "x0", ",", "\[CapitalOmega]0", ",", "Indeterminate", 
                    ",", "Indeterminate", ",", 
                    RowBox[{"\"\<Diverged at z=\>\"", "<>", 
                    RowBox[{"ToString", "[", "domainEnd", "]"}]}]}], "}"}], 
                    ",", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"xFinal", "=", 
                    RowBox[{"xFn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"\[CapitalOmega]Final", "=", 
                    RowBox[{"\[CapitalOmega]Fn", "[", "0", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"status", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"xFinal", "<", "0"}], "&&", 
                    RowBox[{"\[CapitalOmega]Final", ">", "0"}]}], ",", 
                    "\"\<Physical\>\"", ",", "\"\<Unphysical sign\>\""}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    "deltaX", ",", "deltaOm", ",", "signX", ",", "signOm", 
                    ",", "x0", ",", "\[CapitalOmega]0", ",", "xFinal", ",", 
                    "\[CapitalOmega]Final", ",", "status"}], "}"}]}], ")"}]}],
                     "]"}]}], ")"}]}], "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"deltaX", ",", "deltaXRange"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"deltaOm", ",", "deltaOmegaRange"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"signX", ",", "signCombos"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"signOm", ",", "signCombos"}], "}"}]}], "]"}], ",", 
          "2"}], "]"}]}], ";", "\[IndentingNewLine]", "results"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.991733836893866*^9, 3.9917338368957872`*^9}, {
  3.991733877982782*^9, 3.99173388869168*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"4db5c339-6133-48f9-aa14-fcda67f1513e"],

