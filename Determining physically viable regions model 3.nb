Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "orders", " ", "c2", " ", "candidates", " ", "by", " ", "closeness", " ", 
     
     RowBox[{"(", 
      RowBox[{
       RowBox[{"in", " ", "log"}], "-", "magnitude"}], ")"}], " ", "to", " ", 
     "the", " ", "analytic", " ", "scale"}], ",", 
    RowBox[{
     RowBox[{"so", " ", "early"}], "-", 
     RowBox[{
     "exit", " ", "tries", " ", "the", " ", "most", " ", "physically", " ", 
      "likely", " ", "values", " ", "first"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"OrderByProximityToScale", "[", 
     RowBox[{"range_List", ",", 
      RowBox[{"scale_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"SortBy", "[", 
     RowBox[{"range", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Log10", "[", 
          RowBox[{"Abs", "[", "#", "]"}], "]"}], "-", 
         RowBox[{"Log10", "[", "scale", "]"}]}], "]"}], "&"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{3.995250084563827*^9},
