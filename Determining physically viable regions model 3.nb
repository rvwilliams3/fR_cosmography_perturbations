Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatterDominatedFPEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"MatterDominatedFPEps", "[", 
     RowBox[{"model", ",", "epsVal"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "fpResult", ",", "fps", ",", "vars", ",", "Jac", ",", "ptVals", ",", 
        "target", ",", "distances", ",", "bestIdx", ",", "vals", ",", "eig", 
        ",", "eigvecs", ",", "type"}], "}"}], ",", 
      RowBox[{
       RowBox[{"fpResult", "=", 
        RowBox[{"FixedPointsStabilityEps", "[", 
         RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fps", "=", 
        RowBox[{"fpResult", "[", "\"\<fixedPoints\>\"", "]"}]}], ";", 
       RowBox[{"vars", "=", 
        RowBox[{"fpResult", "[", "\"\<vars\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Jac", "=", 
        RowBox[{"fpResult", "[", "\"\<Jac\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ptVals", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"vars", "/.", " ", "#"}], "]"}], "&"}], ",", "fps"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"target", "=", 
        RowBox[{"N", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"distances", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"#", "-", "target"}], "]"}], "&"}], ",", "ptVals"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestIdx", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{"distances", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"ptVals", "[", 
         RowBox[{"[", "bestIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eig", ",", "eigvecs"}], "}"}], "=", 
        RowBox[{
         RowBox[{"Eigensystem", "[", 
          RowBox[{"Jac", "@@", "vals"}], "]"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"type", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Stable node/spiral\>\"", ",", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"eig", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], ",", 
          "\"\<Unstable\>\"", ",", "True", ",", "\"\<Saddle\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<model\>\"", "->", "model"}], ",", 
         RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
         RowBox[{"\"\<jAlg\>\"", "->", 
          RowBox[{"fpResult", "[", "\"\<jAlg\>\"", "]"}]}], ",", 
         RowBox[{"\"\<x\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<q\>\"", "->", 
          RowBox[{"vals", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<eigenvalues\>\"", "->", "eig"}], ",", 
         RowBox[{"\"\<eigenvectors\>\"", "->", "eigvecs"}], ",", 
         RowBox[{"\"\<type\>\"", "->", "type"}]}], "|>"}]}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9949202320034857`*^9, 3.994920234642846*^9}, 
   3.995242955731804*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"8047c469-9196-4d9a-bca2-ba24836ac8cb"]
}, Open  ]]
