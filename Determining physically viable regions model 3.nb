Cell[CellGroupData[{

Cell["Solving using mean", "Chapter",
 CellChangeTimes->{{3.995329550595563*^9, 3.995329551404262*^9}, {
  3.995329885304336*^9, 3.995329886510229*^9}, {3.995334007065254*^9, 
  3.995334008171067*^9}},ExpressionUUID->"84355fd1-94b1-418b-87fb-\
89bbed46d6aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SweepAllMeans", "[", 
    RowBox[{"model_String", ",", "datasets_List", ",", 
     RowBox[{"zi_", ":", "zinitial"}], ",", "opts___Rule"}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ds", "->", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q0m", ",", "j0m", ",", "res"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"q0m", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", 
             "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"j0m", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", 
             "]"}], "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"res", "=", 
           RowBox[{"SweepXInitial", "[", 
            RowBox[{"model", ",", "j0m", ",", "q0m", ",", "zi", ",", "opts"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Join", "[", 
           RowBox[{"res", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<dataset\>\"", "->", "ds"}], ",", 
              RowBox[{"\"\<Om0fit\>\"", "->", 
               RowBox[{
                RowBox[{
                 RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"",
                  "]"}], "[", "\"\<mean\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Om0source\>\"", "->", 
               RowBox[{"AMatch", "[", 
                RowBox[{"j0m", ",", "q0m"}], "]"}]}]}], "|>"}]}], "]"}]}]}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"ds", ",", "datasets"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9953299198210497`*^9, 3.995329930938485*^9}},
 CellLabel->
  "In[271]:=",ExpressionUUID->"4a35b981-4124-4090-b019-56bcc8465979"],

