             RowBox[{"\"\<nCoarse\>\"", "->", "0"}], ",", 
             RowBox[{"\"\<nRefined\>\"", "->", "0"}], ",", 
             RowBox[{"\"\<c2Window\>\"", "->", "None"}], ",", 
