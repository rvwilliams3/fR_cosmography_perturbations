Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FixedPointsStabilityEps", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"epsVal_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "jExpr", ",", "jAlg", ",", "fps", ",", "jacMat", ",", "jacFn", ",", 
       "xx", ",", "OO", ",", "qq"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"jExpr", "=", 
       RowBox[{
        RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"substitute", " ", "onto", " ", "private", " ", 
         RowBox[{"symbols", ":", "qq"}]}], ",", "xx", ",", 
        RowBox[{
        "OO", " ", "cannot", " ", "collide", " ", "with", " ", "the", " ", 
         "global", " ", "x"}], ",", "\[CapitalOmega]", ",", 
        RowBox[{
        "q", " ", "used", " ", "as", " ", "ODE", " ", "function", " ", 
         "names"}]}], "*)"}], 
      RowBox[{"jAlg", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"jExpr", "/.", " ", 
          RowBox[{
           RowBox[{"q", "[", "n", "]"}], "->", "qq"}]}], ")"}], "/.", " ", 
        RowBox[{"\[Epsilon]", "->", "epsVal"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fps", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Fx", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"F\[CapitalOmega]", "[", 
             RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"Fq", "[", 
             RowBox[{"qq", ",", "jAlg"}], "]"}], "==", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], ",", "Reals"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"jacMat", "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Fx", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"F\[CapitalOmega]", "[", 
            RowBox[{"xx", ",", "OO", ",", "qq"}], "]"}], ",", 
           RowBox[{"Fq", "[", 
            RowBox[{"qq", ",", "jAlg"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"jacFn", "=", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xv", ",", "Ov", ",", "qv"}], "}"}], ",", 
         RowBox[{"jacMat", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xx", "->", "xv"}], ",", 
            RowBox[{"OO", "->", "Ov"}], ",", 
            RowBox[{"qq", "->", "qv"}]}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
        RowBox[{"\"\<jAlg\>\"", "->", "jAlg"}], ",", 
        RowBox[{"\"\<fixedPoints\>\"", "->", "fps"}], ",", 
        RowBox[{"\"\<vars\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"xx", ",", "OO", ",", "qq"}], "}"}]}], ",", 
        RowBox[{"\"\<Jac\>\"", "->", "jacFn"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
