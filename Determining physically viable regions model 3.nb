Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ViableRegionPlot", "[", 
    RowBox[{"gridResults_Association", ",", "ds_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "yes", ",", "no", ",", "groups", ",", "styles", ",", "labels", ",", 
       "keep"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yes", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"gridResults", ",", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"#", "[", "\"\<found\>\"", "]"}], "]"}], "&"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"no", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"gridResults", ",", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", "[", "\"\<found\>\"", "]"}], "]"}]}], "&"}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"groups", "=", 
       RowBox[{"{", 
        RowBox[{"yes", ",", "no"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"styles", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Darker", "[", "Green", "]"}], ",", 
           RowBox[{"PointSize", "[", "0.02", "]"}]}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", 
           RowBox[{"PointSize", "[", "0.02", "]"}]}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"labels", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Allows for physical trajectories\>\"", ",", 
         "\"\<No physical trajectories found\>\""}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"keep", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "groups", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"groups", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "]"}], ">", "0"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"keep", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", "}"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<q0\>\"", ",", "\"\<j0\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{
            "\"\<Viable parameter pairs: \>\"", "<>", "ds", "<>", 
             "\"\< (no data)\>\""}]}]}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{"groups", "[", 
         RowBox[{"[", "keep", "]"}], "]"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"styles", "[", 
          RowBox[{"[", "keep", "]"}], "]"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<q0\>\"", ",", "\"\<j0\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<Viable parameter pairs: \>\"", "<>", "ds"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"labels", "[", 
          RowBox[{"[", "keep", "]"}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "420"}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995243026871238*^9, 3.995243026872177*^9}, {
  3.99524697183313*^9, 3.995246972495405*^9}, {3.995263486445777*^9, 
