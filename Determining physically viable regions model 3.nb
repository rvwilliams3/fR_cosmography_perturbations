          RowBox[{"\"\<nRefined\>\"", "->", 
           RowBox[{"Length", "[", "allPts", "]"}]}], ",", 
          RowBox[{"\"\<nRuns\>\"", "->", 
           RowBox[{"Length", "[", "runs", "]"}]}], ",", 
          RowBox[{"\"\<c2Window\>\"", "->", 
