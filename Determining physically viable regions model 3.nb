Cell[TextData[{
 "To loop through the parameter values (\[Epsilon], ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["q", 
       RowBox[{"0", ",", " "}]], 
      SubscriptBox["\[CapitalOmega]", "m0"]}], ")"}], "  ", "within", " ", 
    "1", "\[Sigma]", " ", "and", " ", "det"}], TraditionalForm]],
  ExpressionUUID->"3053b499-1696-4594-ac39-380c71ff410d"],
 "ermine if there is corresponding physical trajectories\nBut: background \
system only depends on \[Epsilon] values, and q(z) depends on \[Epsilon] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "0"], " ", "values", " "}], TraditionalForm]],
  ExpressionUUID->"5f2e3d5b-08bf-47c0-98c0-f36a78ccf591"],
 "\n--> so need a 2D loop through (\[Epsilon], ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "0"], ")"}], TraditionalForm]],ExpressionUUID->
  "4132bcdf-ffe5-4d27-95ac-7a73c487fc11"]
}], "Text",
