Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDatasetPlot", "[", "ds_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q0Mean", ",", "j0Mean", ",", "om0Min", ",", "om0Mean", ",", "om0Max", 
       ",", "q0Min", ",", "q0Max", ",", "j0Min", ",", "j0Max", ",", "q0Pad", 
       ",", "j0Pad", ",", "q0PlotRange", ",", "j0PlotRange", ",", "zSample", 
       ",", "zLo", ",", "zHi", ",", "bandEdges", ",", "fullEdges", ",", 
       "bandColorFunc", ",", "heatmap", ",", "meanSigmaContours", ",", 
       "paramLines", ",", "star", ",", "colorbarLegend", ",", "styleLegend", 
       ",", "q0j0Legend"}], "}"}], ",", 
     RowBox[{
      RowBox[{"q0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Pad", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q0Max", "-", "q0Min"}], ")"}], "/", "10"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Pad", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j0Max", "-", "j0Min"}], ")"}], "/", "10"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0PlotRange", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q0Min", "-", 
          RowBox[{"2", " ", "q0Pad"}]}], ",", 
         RowBox[{"q0Max", "+", 
          RowBox[{"2", " ", "q0Pad"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0PlotRange", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"j0Min", "-", 
          RowBox[{"2", " ", "j0Pad"}]}], ",", 
         RowBox[{"j0Max", "+", 
          RowBox[{"2", " ", "j0Pad"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"zSample", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"AMatch", "[", 
           RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j0Plot", ",", 
            RowBox[{"j0PlotRange", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"j0PlotRange", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "40"}]}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"q0Plot", ",", 
            RowBox[{"q0PlotRange", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"q0PlotRange", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"q0PlotRange", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"q0PlotRange", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "40"}]}], 
           "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"zLo", ",", "zHi"}], "}"}], "=", 
       RowBox[{"MinMax", "[", "zSample", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"bandEdges", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"zLo", "+", 
          RowBox[{"k", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"zHi", "-", "zLo"}], ")"}], "/", "nBands"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"nBands", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fullEdges", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "zLo", "}"}], ",", "bandEdges", ",", 
         RowBox[{"{", "zHi", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "discrete"}]}], " ", "banded", " ", "background"}], 
        ",", 
        RowBox[{
         RowBox[{"lines", " ", "off", " ", "via", " ", "ContourLines"}], "->", 
         RowBox[{
          RowBox[{"False", "--"}], "-"}]}]}], "*)"}], 
      RowBox[{"heatmap", "=", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"AMatch", "[", 
          RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0Plot", ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j0Plot", ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Contours", "->", "bandEdges"}], ",", 
         RowBox[{"ContourShading", "->", "bandPalette"}], ",", 
         RowBox[{"ContourLines", "->", "False"}], ",", 
         RowBox[{"PlotRangePadding", "->", "None"}], ",", 
         RowBox[{"PlotPoints", "->", "60"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "best"}]}], "-", "fit", "+", "1", "-", 
        RowBox[{"sigma", " ", "Omegam0", " ", "branch", " ", "lines", " ", 
         RowBox[{
          RowBox[{"(", "black", ")"}], "--"}]}], "-"}], "*)"}], 
      RowBox[{"meanSigmaContours", "=", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"AMatch", "[", 
          RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0Plot", ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j0Plot", ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Contours", "->", 
          RowBox[{"{", 
           RowBox[{"om0Min", ",", "om0Mean", ",", "om0Max"}], "}"}]}], ",", 
         RowBox[{"ContourShading", "->", "None"}], ",", 
         RowBox[{"ContourStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed", ",", 
              RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}], ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed", ",", 
              RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}]}], "}"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", 
           RowBox[{"Jess", "'"}]}]}], "s", " ", "q0"}], ",", 
        RowBox[{"j0", ":", 
         RowBox[{"solid", " ", "white", " ", "at", " ", "means"}]}], ",", 
        RowBox[{
         RowBox[{"dotted", " ", "white", " ", "at"}], "+", 
         RowBox[{
          RowBox[{"/", 
           RowBox[{"-", "1"}]}], 
          RowBox[{"sigma", "--"}]}], "-"}]}], "*)"}], 
      RowBox[{"paramLines", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"White", ",", 
            RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q0Mean", ",", 
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"q0Mean", ",", 
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}], "]"}], ",", 
          
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q0PlotRange", "[", 
