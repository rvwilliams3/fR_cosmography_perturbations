Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Get1SigmaGrid", "[", 
    RowBox[{"ds_String", ",", 
     RowBox[{"nQ0_Integer", ":", "3"}], ",", 
     RowBox[{"nJ0_Integer", ":", "3"}]}], "]"}], ":=", 
