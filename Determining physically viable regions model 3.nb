Cell[CellGroupData[{

Cell["Determining q(z)", "Subsubsection",
 CellChangeTimes->{{3.995085451271546*^9, 
  3.995085454349411*^9}},ExpressionUUID->"f1b06141-ab2c-4ae7-bf46-\
b69ece1371c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "SolveForq", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
      RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
      RowBox[{"\"\<MaxSteps\>\"", "->", 
       RowBox[{"10", "^", "6"}]}], ",", 
      RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"default", "-", 
    RowBox[{"zi", " ", "overload"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"SolveForq", "[", 
    RowBox[{
    "model", ",", "j0Val", ",", "q0Val", ",", "zinitial", ",", "opts"}], 
    "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.99508574919727*^9, 3.995085749410656*^9}, {
  3.995423376728394*^9, 3.9954233771041117`*^9}, {3.995423550333652*^9, 
  3.995423550731021*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"6fbf496f-a48a-4aff-ab37-a79f448a1e31"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveForq", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsVal", ",", "pg", ",", "ag", ",", "maxSt", ",", "wp", ",", "sol", 
       ",", "qFn", ",", "dom"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFast", "[", 
        RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxSt", "=", 
       RowBox[{"OptionValue", "[", "\"\<MaxSteps\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Block", " ", "returns", " ", "sol"}], ";", 
        RowBox[{"no", " ", 
         RowBox[{"Return", "[", "]"}], " ", "inside", " ", "it"}]}], "*)"}], 
      RowBox[{"sol", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", ",", "z"}], "}"}], ",", 
         RowBox[{"Quiet", "[", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "z"}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"q", "'"}], "[", "z", "]"}]}], "==", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"jModelMap", "[", "model", "]"}], "[", "z", "]"}],
                     "/.", " ", 
                    RowBox[{"\[Epsilon]", "->", "epsVal"}]}], ")"}], "-", 
                  RowBox[{"q", "[", "z", "]"}], "-", 
                  RowBox[{"2", " ", 
                   RowBox[{
                    RowBox[{"q", "[", "z", "]"}], "^", "2"}]}]}], ")"}]}], 
               ",", 
               RowBox[{
                RowBox[{"q", "[", "0", "]"}], "==", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{"q0Val", ",", "wp"}], "]"}]}]}], "}"}], ",", "q", 
             ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
             RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
             RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
             RowBox[{"MaxSteps", "->", "maxSt"}], ",", 
             RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NDSolve", "::", "ndsz"}], ",", 
             RowBox[{"NDSolve", "::", "mxst"}], ",", 
             RowBox[{"NDSolve", "::", "precw"}], ",", 
             RowBox[{"NDSolve", "::", "ndtol"}], ",", 
             RowBox[{"NDSolve", "::", "nlnum"}], ",", 
             RowBox[{"NDSolve", "::", "ndcf"}]}], "}"}]}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"sol", ",", 
           RowBox[{"{", 
            RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qFn", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", "q", "}"}], ",", 
         RowBox[{"q", "/.", " ", 
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dom", "=", 
       RowBox[{
        RowBox[{"qFn", "[", "\"\<Domain\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dom", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "<", "zi"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "qFn"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085462844873*^9, 3.995085464474062*^9}, 
   3.995085591827442*^9, {3.9950857222266703`*^9, 3.995085752787185*^9}, {
   3.995423546920885*^9, 3.9954235682024*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"685313d2-883f-41ad-a5c2-869b2d8b9c5b"]
}, Open  ]]
}, Open  ]],

