        RowBox[{"model", ",", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"classified", "=", 
       RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"classified", "===", "$Failed"}], ",", "$Failed", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "zi"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"-", 
           RowBox[{"classified", "[", "\"\<lambdaXOmega\>\"", "]"}]}], 
          ")"}]}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
