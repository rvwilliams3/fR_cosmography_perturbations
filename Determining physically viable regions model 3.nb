       RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
       RowBox[{"zi_", "?", "NumericQ"}], ",", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<NCoarse\>\"", "->", "60"}], ",", 
          RowBox[{"\"\<LogSpanBelow\>\"", "->", "3"}], ",", 
          RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
          RowBox[{"\"\<NRefine\>\"", "->", "100"}], ",", 
          RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
          RowBox[{"\"\<SingularTol\>\"", "->", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}], ",", 
          RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
          RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
          RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}]}], "}"}], "]"}]}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "epsVal", ",", "nC", ",", "nR", ",", "nSamp", ",", "singTol", ",", 
         "pg", ",", "ag", ",", "wp", ",", "coarseRange", ",", "nTot", ",", 
         "coarseResults", ",", "runs", ",", "refined", ",", "allPts"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"epsVal", "=", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nC", "=", 
         RowBox[{"OptionValue", "[", "\"\<NCoarse\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nR", "=", 
         RowBox[{"OptionValue", "[", "\"\<NRefine\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nSamp", "=", 
         RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"singTol", "=", 
         RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pg", "=", 
