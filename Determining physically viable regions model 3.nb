                    RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<x\>\"", "]"}]}],
                     ",", 
                    RowBox[{"\"\<\[CapitalOmega]Today\>\"", "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<sampleData\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", 
                    "\"\<\[CapitalOmega]\>\"", "]"}]}]}], "|>"}], "&"}], ",", 
