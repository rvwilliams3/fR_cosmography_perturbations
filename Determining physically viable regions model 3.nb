           RowBox[{"\"\<LogSpanAbove\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
