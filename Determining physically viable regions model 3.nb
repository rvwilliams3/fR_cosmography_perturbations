Cell[CellGroupData[{

Cell["Check source match viability (Claude)", "Subsection",
 CellChangeTimes->{{3.99526753170427*^9, 3.995267544179355*^9}, {
  3.995424694002367*^9, 
  3.9954246962871017`*^9}},ExpressionUUID->"85f0c3d4-4a44-4524-a329-\
3d05bf8ec29c"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Claude", "'"}], "s", " ", "analysis", " ", "for", " ", 
     "checking", " ", "source", " ", "matching", " ", 
     RowBox[{"viability", ":", "\[IndentingNewLine]", 
      RowBox[{"SourceMatchTable", " ", "Purpose"}], ":", " ", "locate"}]}], 
    ",", 
    RowBox[{"per", " ", "dataset"}], ",", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"(", 
       RowBox[{"q0", ",", "j0"}], ")"}], " ", "point", " ", "satisfying", " ",
       "BOTH", " ", "\[IndentingNewLine]", 
      RowBox[{"(", "i", ")"}], "  ", "physical", " ", 
      RowBox[{"viability", "--"}], " ", 
      RowBox[{"x", "/", 
       RowBox[{"(", 
        RowBox[{"j", "-", "q", "-", "2"}], ")"}]}]}], ">=", 
     RowBox[{
     "0", " ", "along", " ", "the", " ", "whole", " ", "trajectory"}]}], ",", 
    
    RowBox[{
     RowBox[{
     "established", " ", "by", " ", "the", " ", "grid", " ", "scan", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"(", "ii", ")"}], " ", "source", " ", 
      RowBox[{"matching", "--"}], " ", "AMatch", 
      RowBox[{"(", 
       RowBox[{"q0", ",", "j0"}], ")"}]}], "=", 
     RowBox[{"Om0", 
      RowBox[{"(", "fitted", ")"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"i", ".", "e", ".", "the"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}], "^", "3"}], " ", "coefficient", " ", 
      "of", " ", 
      RowBox[{"h", "^", "2"}], " ", "equals", " ", "the", " ", "fitted", " ", 
      "matter", " ", "density", " ", 
      RowBox[{"(", 
       RowBox[{"GR", " ", "recovery", " ", "at", " ", "high", " ", "z"}], 
       ")"}], " ", "\[IndentingNewLine]", "These", " ", "are", " ", 
      "independent", " ", "conditions", " ", "in", " ", "the", " ", "same", 
      " ", "plane"}], ";", 
     RowBox[{
     "the", " ", "chosen", " ", "operating", " ", "point", " ", "for", " ", 
      "the", " ", "growth", " ", "analysis", " ", "should", " ", "satisfy", 
      " ", 
      RowBox[{"both", "."}]}]}]}], "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.9954245027568817`*^9, 3.995424512256793*^9}, {
  3.995424570767667*^9, 3.995424594324889*^9}, {3.995424632352131*^9, 
  3.9954246614002666`*^9}},ExpressionUUID->"c5c50d9d-8ed6-4143-9618-\
ca5db03561e9"],

