Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XInitDiagnosticPlot", "[", 
    RowBox[{"sweeps_Association", ",", "ds_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "res", ",", "tbl", ",", "xis", ",", "xToday", ",", "omToday", ",", 
       "epsStr", ",", "om0fit"}], "}"}], ",", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"sweeps", ",", "ds", ",", 
         RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tbl", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AssociationQ", "[", "res", "]"}], ",", 
         RowBox[{"Lookup", "[", 
          RowBox[{"res", ",", "\"\<table\>\"", ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsStr", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationQ", "[", "res", "]"}], "&&", 
          RowBox[{"NumericQ", "[", 
           RowBox[{"res", "[", "\"\<eps\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"res", "[", "\"\<eps\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
         "\"\<?\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0fit", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"tbl", ",", 
           RowBox[{"{", "__Association", "}"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"AssociationQ", "[", "res", "]"}], ",", 
                  "\"\<no viable trajectories\>\"", ",", "\"\<not run\>\""}], 
                 "]"}], ",", "14", ",", "Gray"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "}"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameTicks", "->", "None"}], ",", 
           RowBox[{"ImageSize", "->", "420"}], ",", 
           RowBox[{"AspectRatio", "->", "0.6"}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<Model 3, \>\"", "<>", "ds"}], ",", "12"}], 
             "]"}]}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xis", "=", 
       RowBox[{"tbl", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xi\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xToday", "=", 
       RowBox[{"tbl", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<xToday\>\""}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"omToday", "=", 
       RowBox[{"tbl", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<\[CapitalOmega]Today\>\""}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xis", ",", "xToday"}], "}"}], "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xis", ",", "omToday"}], "}"}], "]"}]}], "}"}], ",", 
        RowBox[{"Joined", "->", "False"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\\!\\(\\*SubscriptBox[\\(x\\), \\(i\\)]\\)\>\"", ",", "None"}],
           "}"}]}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<x(0)\>\"", ",", "\"\<\[CapitalOmega](0)\>\""}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0.9", ",", "0.2"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotMarkers", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", "Small"}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<Model 3, \>\"", "<>", "ds"}], ",", "12"}], "]"}]}], 
        ",", 
        RowBox[{"ImageSize", "->", "420"}], ",", 
        RowBox[{"AspectRatio", "->", "0.6"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995333532138452*^9, 3.99533353830341*^9}, {
