Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDatasetPlotViable", "[", 
    RowBox[{"ds_String", ",", "gridResults_Association", ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<ShowGridPoints\>\"", "->", "False"}], ",", 
        RowBox[{"\"\<MaskContourLines\>\"", "->", "True"}]}], "}"}], "]"}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q0Mean", ",", "j0Mean", ",", "om0Min", ",", "om0Mean", ",", "om0Max", 
       ",", "q0Min", ",", "q0Max", ",", "j0Min", ",", "j0Max", ",", "q0Pad", 
       ",", "j0Pad", ",", "q0PlotRange", ",", "j0PlotRange", ",", "zSample", 
       ",", "zLo", ",", "zHi", ",", "bandEdges", ",", "fullEdges", ",", 
       "bandColorFunc", ",", "heatmap", ",", "meanSigmaContours", ",", "star",
        ",", "colorbarLegend", ",", "styleLegend", ",", "q0sUsed", ",", 
       "j0sUsed", ",", "foundMatrix", ",", "viableInterp", ",", "IsViable", 
       ",", "gridDots"}], "}"}], ",", 
     RowBox[{
      RowBox[{"q0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<q0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"j0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<j0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Min", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<min\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Mean", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<mean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"om0Max", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"paramRanges3", "[", "ds", "]"}], "[", "\"\<Om0\>\"", "]"}], 
        "[", "\"\<max\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q0Pad", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q0Max", "-", "q0Min"}], ")"}], "/", "10"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0Pad", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j0Max", "-", "j0Min"}], ")"}], "/", "10"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q0PlotRange", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q0Min", "-", 
          RowBox[{"2", " ", "q0Pad"}]}], ",", 
         RowBox[{"q0Max", "+", 
          RowBox[{"2", " ", "q0Pad"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0PlotRange", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"j0Min", "-", 
          RowBox[{"2", " ", "j0Pad"}]}], ",", 
         RowBox[{"j0Max", "+", 
          RowBox[{"2", " ", "j0Pad"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "build"}]}], " ", "a", " ", 
         RowBox[{"viable", "/", "non"}]}], "-", 
        RowBox[{
        "viable", " ", "test", " ", "from", " ", "the", " ", "dense", " ", 
         RowBox[{"grid", "--"}]}], "-"}], "*)"}], 
      RowBox[{"q0sUsed", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "gridResults", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"j0sUsed", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "gridResults", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"foundMatrix", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Boole", "[", 
          RowBox[{"TrueQ", "[", 
           RowBox[{
            RowBox[{"gridResults", "[", 
             RowBox[{"{", 
              RowBox[{"q0v", ",", "j0v"}], "}"}], "]"}], "[", "\"\<found\>\"",
             "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0v", ",", "q0sUsed"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j0v", ",", "j0sUsed"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"viableInterp", "=", 
       RowBox[{"ListInterpolation", "[", 
        RowBox[{"foundMatrix", ",", 
         RowBox[{"{", 
          RowBox[{"q0sUsed", ",", "j0sUsed"}], "}"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IsViable", "[", 
        RowBox[{
         RowBox[{"q0v_", "?", "NumericQ"}], ",", 
         RowBox[{"j0v_", "?", "NumericQ"}]}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q0v", "<", 
           RowBox[{"First", "[", "q0sUsed", "]"}]}], "||", 
          RowBox[{"q0v", ">", 
           RowBox[{"Last", "[", "q0sUsed", "]"}]}], "||", 
          RowBox[{"j0v", "<", 
           RowBox[{"First", "[", "j0sUsed", "]"}]}], "||", 
          RowBox[{"j0v", ">", 
           RowBox[{"Last", "[", "j0sUsed", "]"}]}]}], ",", "False", ",", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"viableInterp", "[", 
            RowBox[{"q0v", ",", "j0v"}], "]"}], "]"}], ">", "0.5"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "sample"}]}], " ", "AMatch", " ", "to", " ", "fix", 
         " ", "band", " ", "edges", " ", 
         RowBox[{
          RowBox[{"(", "unchanged", ")"}], "--"}]}], "-"}], "*)"}], 
      RowBox[{"zSample", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"AMatch", "[", 
           RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j0Plot", ",", 
            RowBox[{"j0PlotRange", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"j0PlotRange", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"j0PlotRange", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "40"}]}], "}"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"q0Plot", ",", 
            RowBox[{"q0PlotRange", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"q0PlotRange", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"q0PlotRange", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"q0PlotRange", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "40"}]}], 
           "}"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"zLo", ",", "zHi"}], "}"}], "=", 
       RowBox[{"MinMax", "[", "zSample", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"bandEdges", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"zLo", "+", 
          RowBox[{"k", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"zHi", "-", "zLo"}], ")"}], "/", "nBands"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"nBands", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fullEdges", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "zLo", "}"}], ",", "bandEdges", ",", 
         RowBox[{"{", "zHi", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "banded"}]}], " ", "background"}], ",", 
        RowBox[{
         RowBox[{"masked", " ", "to", " ", "the", " ", "viable", " ", 
          RowBox[{"region", "--"}]}], "-"}]}], "*)"}], 
      RowBox[{"heatmap", "=", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"AMatch", "[", 
          RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0Plot", ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j0Plot", ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Contours", "->", "bandEdges"}], ",", 
         RowBox[{"ContourShading", "->", "bandPalette"}], ",", 
         RowBox[{"ContourLines", "->", "False"}], ",", 
         RowBox[{"PlotRangePadding", "->", "None"}], ",", 
         RowBox[{"PlotPoints", "->", "60"}], ",", 
         RowBox[{"RegionFunction", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"q0Plot", ",", "j0Plot"}], "}"}], ",", 
            RowBox[{"IsViable", "[", 
             RowBox[{"q0Plot", ",", "j0Plot"}], "]"}]}], "]"}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "\[CapitalOmega]m0"}]}], " ", 
         RowBox[{"mean", "/", "1"}], "\[Sigma]", " ", "lines"}], ",", 
        RowBox[{
         RowBox[{
         "masked", " ", "the", " ", "same", " ", "way", " ", "by", " ", 
          RowBox[{"default", "--"}]}], "-"}]}], "*)"}], 
      RowBox[{"meanSigmaContours", "=", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"AMatch", "[", 
          RowBox[{"j0Plot", ",", "q0Plot"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q0Plot", ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"q0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j0Plot", ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"j0PlotRange", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Contours", "->", 
          RowBox[{"{", 
           RowBox[{"om0Min", ",", "om0Mean", ",", "om0Max"}], "}"}]}], ",", 
         RowBox[{"ContourShading", "->", "None"}], ",", 
         RowBox[{"ContourStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed", ",", 
              RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}], ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed", ",", 
              RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}]}], "}"}]}], 
         ",", 
         RowBox[{"RegionFunction", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<MaskContourLines\>\"", "]"}], 
            ",", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q0Plot", ",", "j0Plot"}], "}"}], ",", 
              RowBox[{"IsViable", "[", 
               RowBox[{"q0Plot", ",", "j0Plot"}], "]"}]}], "]"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q0Plot", ",", "j0Plot"}], "}"}], ",", "True"}], 
             "]"}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"star", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"Inset", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\[FivePointedStar]\>\"", ",", "24", ",", "Black", ",", 
             "Bold"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"q0Mean", ",", "j0Mean"}], "}"}]}], "]"}], "}"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"gridDots", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<ShowGridPoints\>\"", "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.006", "]"}], ",", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"TrueQ", "[", 
                    RowBox[{"#2", "[", "\"\<found\>\"", "]"}], "]"}], ",", 
                   RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "]"}],
                  ",", 
                 RowBox[{"Point", "[", "#1", "]"}]}], "}"}], "&"}], ",", 
              "gridResults"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bandColorFunc", "[", "s_", "]"}], ":=", 
       RowBox[{"bandPalette", "[", 
        RowBox[{"[", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Ceiling", "[", 
            RowBox[{"nBands", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"s", "-", "zLo"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"zHi", "-", "zLo"}], ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "nBands"}], "}"}]}], "]"}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"colorbarLegend", "=", 
       RowBox[{"BarLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bandColorFunc", ",", 
           RowBox[{"{", 
            RowBox[{"zLo", ",", "zHi"}], "}"}]}], "}"}], ",", 
         RowBox[{"Ticks", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], "&"}], "/@",
             "fullEdges"}], ")"}]}], ",", 
         RowBox[{
         "LegendLabel", "->", "\"\<required matched \[CapitalOmega]m0\>\""}], 
         ",", 
         RowBox[{"LegendMarkerSize", "->", "250"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"styleLegend", "=", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], ",", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", "Dashed", ",", 
             RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<best-fit \[CapitalOmega]m0 = \>\"", "<>", 
            RowBox[{"ToString", "[", "om0Mean", "]"}]}], ",", 
           "\"\<\[PlusMinus]1\[Sigma]\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Legended", "[", 
       RowBox[{
        RowBox[{"Show", "[", 
         RowBox[{
         "heatmap", ",", "meanSigmaContours", ",", "gridDots", ",", "star", 
          ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{"q0PlotRange", ",", "j0PlotRange"}], "}"}]}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<q0\>\"", ",", "\"\<j0\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{
           "\"\<Model 3: \>\"", "<>", "ds", "<>", 
            "\"\< (viable region only)\>\""}]}], ",", 
          RowBox[{"ImageSize", "->", "420"}]}], "]"}], ",", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{"colorbarLegend", ",", "styleLegend"}], "}"}], "]"}], ",",
           "Right"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
