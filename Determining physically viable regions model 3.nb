Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AutoC2Range", "[", 
    RowBox[{"model_String", ",", 
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"zi_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LogSpanBelow\>\"", "->", "4"}], ",", 
        RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<NPerSign\>\"", "->", "40"}]}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scale", ",", "expMin", ",", "expMax", ",", "positive"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"scale", "=", 
       RowBox[{"AutoC2Scale", "[", 
        RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"scale", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMin", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "-", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expMax", "=", 
       RowBox[{
        RowBox[{"Log10", "[", "scale", "]"}], "+", 
        RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"positive", "=", 
       RowBox[{"10", "^", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"expMin", ",", "expMax", ",", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<NPerSign\>\"", "]"}], "-", 
           "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Reverse", "[", "positive", "]"}]}], ",", "positive"}], 
