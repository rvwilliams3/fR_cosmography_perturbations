Cell[CellGroupData[{

Cell["Classification of eigenvectors:", "Subsubsection",
 CellChangeTimes->{{3.991733381294153*^9, 
  3.99173339134886*^9}},ExpressionUUID->"69d5892c-4acf-4150-af91-\
7c9d435993eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "ClassifyEigenvectors", " ", "Splits", " ", "the", " ", "2", " ", 
      "unstable", " ", "eigenvectors", " ", "at", " ", "the", " ", "matter"}],
      "-", 
     RowBox[{
     "dominated", " ", "saddle", " ", "into", " ", "the", " ", "one", " ", 
      "aligned", " ", "with", " ", "q", " ", 
      RowBox[{"(", "vq", ")"}], " ", "and", " ", "the", " ", "one", " ", 
      "spanning", " ", "x"}], "-", 
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"(", "vxOmega", ")"}]}]}], ",", 
    RowBox[{
     RowBox[{
     "based", " ", "on", " ", "which", " ", "has", " ", "a", " ", "near"}], 
     "-", 
     RowBox[{"zero", " ", "q"}], "-", 
     RowBox[{"component", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClassifyEigenvectors", "[", "fp_Association", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "eig", ",", "vecs", ",", "unstableIdx", ",", "stableIdx", ",", "vq", 
        ",", "vxOmega", ",", "qComponents"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eig", "=", 
        RowBox[{"fp", "[", "\"\<eigenvalues\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vecs", "=", 
        RowBox[{"fp", "[", "\"\<eigenvectors\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"unstableIdx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"eig", ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&"}], ")"}]}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"stableIdx", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"eig", ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&"}], ")"}]}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"qComponents", "=", 
        RowBox[{"vecs", "[", 
         RowBox[{"[", 
          RowBox[{"unstableIdx", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vq", "=", 
        RowBox[{"vecs", "[", 
         RowBox[{"[", 
          RowBox[{"unstableIdx", "[", 
           RowBox[{"[", 
            RowBox[{"First", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"qComponents", ",", 
                RowBox[{"_", "?", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
             "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"vxOmega", "=", 
        RowBox[{"vecs", "[", 
         RowBox[{"[", 
          RowBox[{"unstableIdx", "[", 
           RowBox[{"[", 
            RowBox[{"First", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Position", "[", 
               RowBox[{"qComponents", ",", 
                RowBox[{"_", "?", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
             "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<vq\>\"", "->", "vq"}], ",", 
         RowBox[{"\"\<vxOmega\>\"", "->", "vxOmega"}], ",", 
         RowBox[{"\"\<vStable\>\"", "->", 
          RowBox[{"vecs", "[", 
           RowBox[{"[", 
            RowBox[{"First", "[", "stableIdx", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<lambdaQ\>\"", "->", 
          RowBox[{"eig", "[", 
           RowBox[{"[", 
            RowBox[{"unstableIdx", "[", 
             RowBox[{"[", 
              RowBox[{"First", "[", 
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{"qComponents", ",", 
                  RowBox[{"_", "?", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], ">", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
               "]"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<lambdaXOmega\>\"", "->", 
          RowBox[{"eig", "[", 
           RowBox[{"[", 
            RowBox[{"unstableIdx", "[", 
             RowBox[{"[", 
              RowBox[{"First", "[", 
               RowBox[{"Flatten", "[", 
                RowBox[{"Position", "[", 
                 RowBox[{"qComponents", ",", 
                  RowBox[{"_", "?", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "<=", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}], "&"}], ")"}]}]}], "]"}], "]"}], 
               "]"}], "]"}], "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9917333919158697`*^9, 3.991733405622898*^9}, {
   3.991785722201019*^9, 3.9917857368685083`*^9}, {3.991785774516345*^9, 
