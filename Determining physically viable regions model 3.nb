Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EpsFast", "[", 
    RowBox[{"\"\<Model 3\>\"", ",", 
     RowBox[{"q0_", "?", "NumericQ"}], ",", 
     RowBox[{"j0_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"j0", "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{"q0", "-", 
        RowBox[{"1", "/", "2"}]}], ")"}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995085286300021*^9, 3.995085289395958*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"8cd9375a-9c34-4415-b202-060c4320f9d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Invert", " ", "the", " ", "closure", " ", "relation", " ", "at", " ", 
      "z"}], "=", 
     RowBox[{
      RowBox[{"0", ":", "j0"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"j_model", 
         RowBox[{"(", "q0", ")"}]}], "->", 
        RowBox[{
         RowBox[{
          RowBox[{"eps", ".", "Model"}], " ", "1"}], ":", "eps"}]}], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j0", "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"1", "+", "q0"}], ")"}]}], ")"}]}]}]}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"Model", " ", "2"}], ":", "eps"}], "=", 
     RowBox[{"j0", "-", "1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Model", " ", "3"}], ":", "eps"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"j0", "-", "1"}], ")"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"q0", "-", 
            RowBox[{"1", "/", "2"}]}], ")"}]}], ")"}], ".", "Solve"}]}], " ", 
      "handles", " ", "all", " ", 
      RowBox[{"three", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EpsFromJ0Q0", "[", 
     RowBox[{"model_String", ",", 
      RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
      RowBox[{"j0Val_", "?", "NumericQ"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"jExpr", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"jExpr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"jModelMap", "[", "model", "]"}], "[", "n", "]"}], "/.", 
         " ", 
         RowBox[{
          RowBox[{"q", "[", "n", "]"}], "->", "q0Val"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"jExpr", "==", "j0Val"}], ",", "\[Epsilon]"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}], ",", 
         RowBox[{"\[Epsilon]", "/.", " ", 
          RowBox[{"First", "[", "sol", "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}]}]], "Input",
