        "\[IndentingNewLine]", 
        RowBox[{"allPts", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"refined", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<points\>\""}], "]"}], "]"}], ",", "1"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
