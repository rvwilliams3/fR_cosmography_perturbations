Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"default", "-", 
    RowBox[{"zi", " ", "overload"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuickViabilityCheck", "[", 
      RowBox[{"model_String", ",", 
       RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
       RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"QuickViabilityCheck", "[", 
      RowBox[{
      "model", ",", "j0Val", ",", "q0Val", ",", "zinitial", ",", "opts"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"QuickViabilityCheck", "[", 
      RowBox[{"model_String", ",", 
       RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
       RowBox[{"q0Val_", "?", "NumericQ"}], ",", 
       RowBox[{"zi_", "?", "NumericQ"}], ",", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<NCoarse\>\"", "->", "60"}], ",", 
          RowBox[{"\"\<LogSpanBelow\>\"", "->", "3"}], ",", 
          RowBox[{"\"\<LogSpanAbove\>\"", "->", "2"}], ",", 
          RowBox[{"\"\<NSamples\>\"", "->", "80"}], ",", 
          RowBox[{"\"\<SingularTol\>\"", "->", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}], ",", 
          RowBox[{"\"\<PrecisionGoal\>\"", "->", "14"}], ",", 
          RowBox[{"\"\<AccuracyGoal\>\"", "->", "Infinity"}], ",", 
          RowBox[{"\"\<MaxSteps\>\"", "->", 
           RowBox[{"10", "^", "6"}]}], ",", 
          RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}], ",", 
          RowBox[{"\"\<SearchFromScale\>\"", "->", "True"}]}], "}"}], "]"}]}],
       "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "epsVal", ",", "nC", ",", "nSamp", ",", "singTol", ",", "pg", ",", 
         "ag", ",", "maxSt", ",", "wp", ",", "fp", ",", "cl", ",", "vq", ",", 
         "vxOmega", ",", "qFn", ",", "deltaQ", ",", "c3", ",", "scale", ",", 
         "coarseRange", ",", "searchRange", ",", "nTried", ",", "result"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"epsVal", "=", 
         RowBox[{"EpsFast", "[", 
          RowBox[{"model", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nC", "=", 
         RowBox[{"OptionValue", "[", "\"\<NCoarse\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nSamp", "=", 
         RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"singTol", "=", 
         RowBox[{"OptionValue", "[", "\"\<SingularTol\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pg", "=", 
         RowBox[{"OptionValue", "[", "\"\<PrecisionGoal\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ag", "=", 
         RowBox[{"OptionValue", "[", "\"\<AccuracyGoal\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxSt", "=", 
         RowBox[{"OptionValue", "[", "\"\<MaxSteps\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"wp", "=", 
         RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fp", "=", 
         RowBox[{"MatterDominatedFPEps", "[", 
          RowBox[{"model", ",", "epsVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cl", "=", 
         RowBox[{"ClassifyEigenvectors", "[", "fp", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"cl", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<c2\>\"", "->", "None"}], ",", 
             RowBox[{"\"\<nTried\>\"", "->", "0"}], ",", 
             RowBox[{
             "\"\<note\>\"", "->", "\"\<Degenerate fixed point\>\""}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"vq", "=", 
         RowBox[{"cl", "[", "\"\<vq\>\"", "]"}]}], ";", 
        RowBox[{"vxOmega", "=", 
         RowBox[{"cl", "[", "\"\<vxOmega\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qFn", "=", 
         RowBox[{"SolveForq", "[", 
          RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"qFn", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<c2\>\"", "->", "None"}], ",", 
             RowBox[{"\"\<nTried\>\"", "->", "0"}], ",", 
             RowBox[{"\"\<note\>\"", "->", "\"\<q solve failed\>\""}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"deltaQ", "=", 
         RowBox[{
          RowBox[{"qFn", "[", "zi", "]"}], "-", 
          RowBox[{"fp", "[", "\"\<q\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"c3", "=", 
         RowBox[{"deltaQ", "/", 
          RowBox[{"vq", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coarseRange", "=", 
         RowBox[{"AutoC2Range", "[", 
          RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi", ",", 
           RowBox[{"\"\<NPerSign\>\"", "->", "nC"}], ",", 
           RowBox[{"\"\<LogSpanBelow\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<LogSpanBelow\>\"", "]"}]}], ",", 
           
           RowBox[{"\"\<LogSpanAbove\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<LogSpanAbove\>\"", "]"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"coarseRange", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<c2\>\"", "->", "None"}], ",", 
             RowBox[{"\"\<nTried\>\"", "->", "0"}], ",", 
             RowBox[{
             "\"\<note\>\"", "->", "\"\<Degenerate fixed point\>\""}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"scale", "=", 
         RowBox[{"AutoC2Scale", "[", 
          RowBox[{"model", ",", "j0Val", ",", "q0Val", ",", "zi"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"searchRange", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"OptionValue", "[", "\"\<SearchFromScale\>\"", "]"}], 
             "]"}], "&&", 
            RowBox[{"NumericQ", "[", "scale", "]"}]}], ",", 
           RowBox[{"OrderByProximityToScale", "[", 
            RowBox[{"coarseRange", ",", "scale"}], "]"}], ",", 
           "coarseRange"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nTried", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"nTried", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "xi", ",", "\[CapitalOmega]i", ",", "sol", ",", "xFn", ",", 
                  "\[CapitalOmega]Fn", ",", "viability"}], "}"}], ",", 
                RowBox[{
                 RowBox[{"xi", "=", 
                  RowBox[{
                   RowBox[{"fp", "[", "\"\<x\>\"", "]"}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{"vxOmega", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{"vq", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"\[CapitalOmega]i", "=", 
                  RowBox[{
                   RowBox[{"fp", "[", "\"\<\[CapitalOmega]\>\"", "]"}], "+", 
                   RowBox[{"c2", " ", 
                    RowBox[{"vxOmega", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "+", 
                   RowBox[{"c3", " ", 
                    RowBox[{"vq", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"sol", "=", 
                  RowBox[{"Block", "[", 
                   RowBox[{
                    RowBox[{"{", "q", "}"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "zz_", "]"}], ":=", 
                    RowBox[{"qFn", "[", "zz", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Quiet", "[", 
                    RowBox[{
                    RowBox[{"NDSolve", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dx", ",", "d\[CapitalOmega]", ",", 
                    RowBox[{
                    RowBox[{"x", "[", "zi", "]"}], "==", "xi"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "zi", "]"}], "==", 
                    "\[CapitalOmega]i"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"x", "[", "z", "]"}], "]"}], ">", 
                    RowBox[{"10", "^", "3"}]}], ",", 
                    "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], ">", "10"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}], ",", 
                    RowBox[{"WhenEvent", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", "z", "]"}], "<", "0"}], 
                    ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "\[CapitalOmega]"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"z", ",", "0", ",", "zi"}], "}"}], ",", 
                    RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
                    RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
                    RowBox[{"MaxSteps", "->", "maxSt"}], ",", 
                    RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"NDSolve", "::", "ndsz"}], ",", 
                    RowBox[{"NDSolve", "::", "mxst"}], ",", 
                    RowBox[{"NDSolve", "::", "precw"}], ",", 
                    RowBox[{"NDSolve", "::", "ndtol"}], ",", 
                    RowBox[{"NDSolve", "::", "nlnum"}], ",", 
                    RowBox[{"NDSolve", "::", "ndcf"}]}], "}"}]}], "]"}]}]}], 
                   "]"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"MatchQ", "[", 
                    RowBox[{"sol", ",", 
                    RowBox[{"{", 
                    RowBox[{"{", "__Rule", "}"}], "}"}]}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"xFn", "=", 
                    RowBox[{"x", "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"\[CapitalOmega]Fn", "=", 
                    RowBox[{"\[CapitalOmega]", "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"viability", "=", 
                    RowBox[{"ClassifyTrajectoryViability", "[", 
                    RowBox[{
                    "model", ",", "j0Val", ",", "q0Val", ",", "xFn", ",", 
                    "\[CapitalOmega]Fn", ",", "qFn", ",", "zi", ",", 
                    RowBox[{"\"\<NSamples\>\"", "->", "nSamp"}], ",", 
                    RowBox[{"\"\<SingularTol\>\"", "->", "singTol"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"viability", "[", "\"\<label\>\"", "]"}], "===", 
                    "\"\<Physical\>\""}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
                    RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
                    RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
                    RowBox[{"\"\<found\>\"", "->", "True"}], ",", 
                    RowBox[{"\"\<c2\>\"", "->", "c2"}], ",", 
                    RowBox[{"\"\<xi\>\"", "->", "xi"}], ",", 
                    RowBox[{
                    "\"\<\[CapitalOmega]i\>\"", "->", "\[CapitalOmega]i"}], 
                    ",", 
                    RowBox[{"\"\<nTried\>\"", "->", "nTried"}]}], "|>"}], 
                    "]"}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"c2", ",", "searchRange"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<j0\>\"", "->", "j0Val"}], ",", 
             RowBox[{"\"\<q0\>\"", "->", "q0Val"}], ",", 
             RowBox[{"\"\<eps\>\"", "->", "epsVal"}], ",", 
             RowBox[{"\"\<found\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<c2\>\"", "->", "None"}], ",", 
             RowBox[{"\"\<nTried\>\"", "->", "nTried"}], ",", 
             RowBox[{
             "\"\<note\>\"", "->", 
              "\"\<No Physical point in coarse range\>\""}]}], "|>"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "result"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
