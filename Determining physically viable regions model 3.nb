            RowBox[{
             RowBox[{"allPts", "===", 
              RowBox[{"{", "}"}]}], ",", "None", ",", 
             RowBox[{"MinMax", "[", 
              RowBox[{"allPts", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<c2\>\""}], "]"}], "]"}], "]"}]}], 
            "]"}]}], ",", 
          RowBox[{"\"\<windows\>\"", "->", 
           RowBox[{"refined", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<c2Window\>\""}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<table\>\"", "->", "allPts"}]}], "|>"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
