Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AMatch", "[", 
    RowBox[{
     RowBox[{"j0Val_", "?", "NumericQ"}], ",", 
     RowBox[{"q0Val_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "epsVal", "}"}], ",", 
     RowBox[{
      RowBox[{"epsVal", "=", 
       RowBox[{"EpsFromJ0Q0", "[", 
        RowBox[{"\"\<Model 3\>\"", ",", "q0Val", ",", "j0Val"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Model", "-", 
          RowBox[{
          "3", " ", "closed", " ", "form", " ", "if", " ", "you", " ", "want",
            " ", 
           RowBox[{"speed", ":", "epsVal"}]}]}], "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j0Val", "-", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"3", 
            RowBox[{"(", 
             RowBox[{"q0Val", "-", 
              RowBox[{"1", "/", "2"}]}], ")"}]}], ")"}]}]}], ";"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"NumericQ", "[", "epsVal", "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<NoSolution\>\"", "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "q0Val"}], ")"}]}], "-", 
         RowBox[{"3", " ", "epsVal"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "epsVal"}], ")"}]}], ")"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
