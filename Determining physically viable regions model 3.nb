Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuickSweepGrid", "[", 
    RowBox[{"model_String", ",", "ds_String", ",", 
     RowBox[{"nQ0_", ":", "10"}], ",", 
     RowBox[{"nJ0_", ":", "10"}], ",", 
     RowBox[{"zi_", ":", "zinitial"}], ",", "opts___Rule"}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"pt", "->", 
       RowBox[{"QuickViabilityCheck", "[", 
        RowBox[{"model", ",", 
         RowBox[{"pt", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"pt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "zi", ",", "opts"}], "]"}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"pt", ",", 
        RowBox[{"Get1SigmaGrid", "[", 
         RowBox[{"ds", ",", "nQ0", ",", "nJ0"}], "]"}]}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"1f17efa1-61a7-48b7-ade7-c27beeb8cbc1"],

